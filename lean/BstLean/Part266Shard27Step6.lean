    (√(tA 13027 * ((165 : ℝ) ^ 2 / (13027 - 2))) * √((42 / 10 : ℝ) / 13027) *
      energyCoefficient18 13027) ^ 18 * (61 / 100 : ℝ) ^ 18 ≤
