open BstLean.Part130 BstLean.Part153 BstLean.Part157 BstLean.Part160 BstLean.Part169

theorem first_matrix_row (c : Ret 13025) (hc : A1 c ∈ Eop 13025) : OpB (A1 c) 165 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (13025 : ℝ)) ≤ (12391564217 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(13025 : ℝ) ≤ (114127123 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (13025 : ℝ) + 2 * √13025 ≤ (6626627123 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 13025) (hc : c ∈ BstLean.Part164.Eop2 13025) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 13025 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 13025) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 13025 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 13025) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 13025).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 13025) (FirstMatrix 13025))
    (h2 : c ∈ BstLean.Part164.Eop2 13025) (a : BstLean.Part161.Ix 13025) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

end BstLean.Part266.Row13025

