  have hs : √(2 / (12052 : ℝ)) ≤ (6441031761 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12052 : ℝ) ≤ (54890801 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12052 : ℝ) + 2 * √12052 ≤ (3067890801 / 250000) := by linarith
