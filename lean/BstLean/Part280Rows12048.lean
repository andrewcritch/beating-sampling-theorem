  have hn : √(12049 : ℝ) ≤ (54883969 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12049 : ℝ) + 2 * √12049 ≤ (3067133969 / 250000) := by linarith
