    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12052) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12052).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12052) (FirstMatrix 12052))
    (h2 : c ∈ BstLean.Part164.Eop2 12052) (a : BstLean.Part161.Ix 12052) :
