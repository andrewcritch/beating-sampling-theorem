theorem exact_radius_sq_row : exactRadius (12052 - 1 - 1) 80 ^ 2 ≤ (102 / 100 : ℝ) := by
  have hp := exactRadius_pow (d := 12052 - 1 - 1) (j := 80) (by norm_num) (by norm_num)
  have hprod : radialProduct (12052 - 1 - 1) 80 ≤ (12208 : ℝ) ^ 80 := by
    unfold radialProduct
    calc
      (∏ i ∈ Finset.range 80, (((12052 - 1 - 1 : ℕ) : ℝ) + 2 * (i : ℝ)))
          ≤ ∏ i ∈ Finset.range 80, (12208 : ℝ) := by
