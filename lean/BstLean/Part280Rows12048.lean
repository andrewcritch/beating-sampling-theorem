  ∫ a, (stdGauss (Fin (12049 - 1))).real
    {v | sgA (paperDesignP 12049) c a v < rowSigma} ∂muI 12049 ≤ lowMassBudget

noncomputable def hqSplit (c : Ret 12049) : SplitData 12049 :=
