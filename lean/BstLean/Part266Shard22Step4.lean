  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((344997493 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2459338763 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2915057 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((63764711 / 125000000000))) := by
        gcongr
