  removal : ∫ a, removed (stdGauss (Fin (12923 - 1)))
    (rowSplit c wl ws).good a ∂muI 12923 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12923) c (rowSplit c wl ws),
