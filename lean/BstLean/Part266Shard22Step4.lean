    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 12905)]
  exact ⟨by linarith, by linarith [hbulk _ hs.1 hs.2], by nlinarith⟩

theorem node_trace_charge_row {wr : WRet 12905} (hw : windowW wr) :
    (gaussMat (mA 12905) 12905 (2 / (12905 : ℝ))).real {X | ∃ g < Js 12905,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12905 : ℝ)) ∨
