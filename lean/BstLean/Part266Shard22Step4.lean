  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((172531779 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((49158201 / 10000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
