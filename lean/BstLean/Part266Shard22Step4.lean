theorem hq_root_price {c : Ret 12913} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 12913) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12913 - 1))).real
      {v | sgA (paperDesignP 12913) c a v < rowSigma} ∂BstLean.Part161.muI 12913 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
