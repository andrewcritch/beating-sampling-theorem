def LowResidualMass (c : Ret 12915) : Prop :=
  ∫ a, (stdGauss (Fin (12915 - 1))).real
    {v | sgA (paperDesignP 12915) c a v < rowSigma} ∂muI 12915 ≤ lowMassBudget

