theorem hq_output_bounds {c : Ret 12919}
    (hw : WINDOW (paperDesignP 12919) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12919)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
