  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((172551593 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((1228526743 / 250000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1457077 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((254900797 / 500000000000))) := by
        gcongr
