theorem hq_displacement_root {c : Ret 12908} (he : (6 / 10 : ℝ) ≤ eR c)
    {B : ℝ} (hB0 : 0 ≤ B) (hB : B ≤ removalBudget) :
    √(Dpap 12908 B hqCentreCap (locationVarianceBudget c) scaleVarianceBudget eta rowSigma) ≤
