    (gaussMat (mA 12920) 12920 (2 / (12920 : ℝ))).real {X | ∃ g < Js 12920,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12920 : ℝ)) ∨
