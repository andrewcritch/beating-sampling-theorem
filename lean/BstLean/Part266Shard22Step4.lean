def LowResidualMass (c : Ret 12916) : Prop :=
  ∫ a, (stdGauss (Fin (12916 - 1))).real
    {v | sgA (paperDesignP 12916) c a v < rowSigma} ∂muI 12916 ≤ lowMassBudget

