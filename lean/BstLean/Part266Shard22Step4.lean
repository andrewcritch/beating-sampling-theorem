      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5829663 / 1000000000)) ^ 2 * ((1003 / 1000) * ((32012123 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((8625597 / 25000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((307345889 / 62500000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5829663 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((127509657 / 250000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((8625597 / 25000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((3020006813 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
