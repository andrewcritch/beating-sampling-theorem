theorem row_node_geometry {wr : WRet 12914} (hw : windowW wr)
    (θ : AHid 12914) {g : ℕ} (hg : g < Js 12914) :
    0 ≤ nodeS (mkR wr θ) g ∧
      (3969 / 10000 : ℝ) ≤ 1 - nodeS (mkR wr θ) g ^ 2 ∧
      1 - nodeS (mkR wr θ) g ^ 2 ≤ 61 / 100 := by
  let c := mkR wr θ
