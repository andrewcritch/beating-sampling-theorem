theorem low_mass_of_interfaces {c : Ret 13040}
    (hw : WINDOW (paperDesignP 13040) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 13040).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 13040) c M H xi)
    (hE : centreEnergy (paperDesignP 13040) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (13040 : ℝ))))
    (hprice : massBound 13040 M H xi E u mixtureFloor ≤ 13040 * lowMassBudget) :
