      {v | sgA (paperDesignP 13045) c a v < √(2 / (13045 : ℝ) * mixtureFloor)}
      ∂muI 13045 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (13045 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 13045 ≤
        removalBudget := by
