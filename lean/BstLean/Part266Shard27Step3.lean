theorem split_width_bounds {c : Ret 13028} (he : (6 / 10 : ℝ) ≤ eR c) :
    0 < splitLocationWidth c ∧ splitLocationWidth c ≤ (851686857 / 250000000000) ∧
    0 < splitResidualWidth ∧ splitResidualWidth ≤ (8173944663 / 250000000000000) := by
  have hl := (location_budgets_row he).2.2
  have hs := residual_budgets_row.2.2
