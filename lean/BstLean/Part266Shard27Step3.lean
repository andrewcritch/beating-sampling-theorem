      ∂muI 13039 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (13039 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 13039 ≤
        removalBudget := by
