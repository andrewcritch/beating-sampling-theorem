/-- All twenty-eight fields concern the original retained network and latitude measure. -/
noncomputable def latitudeMoments {c : Ret 13029}
    (hw : WINDOW (paperDesignP 13029) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (13029 - 1))).real
      {v | sgA (paperDesignP 13029) c a v < √(2 / (13029 : ℝ) * mixtureFloor)}
      ∂muI 13029 ≤ lowMassBudget) :
    LatMom (paperDesignP 13029) c (√(2 / (13029 : ℝ) * mixtureFloor)) 24 where
