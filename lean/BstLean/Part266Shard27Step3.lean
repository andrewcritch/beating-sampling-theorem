theorem low_mass_of_interfaces {c : Ret 13026}
    (hw : WINDOW (paperDesignP 13026) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 13026).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 13026) c M H xi)
    (hE : centreEnergy (paperDesignP 13026) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (13026 : ℝ))))
    (hprice : massBound 13026 M H xi E u mixtureFloor ≤ 13026 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (13026 - 1))).real
      {v | sgA (paperDesignP 13026) c a v < √(2 / (13026 : ℝ) * mixtureFloor)}
        ∂muI 13026 ≤ lowMassBudget := by
