      (pLat (paperDesignP 12099) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12099 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12099) c (rowSplit c wl ws),
    hellG2 12099 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12099 ≤ displacementBudget

