theorem row_split_floor :
    (2 / (12099 : ℝ)) * biasFloor =
      (1 - eta) * (√(2 / (12099 : ℝ) * mixtureFloor)) ^ 2 := by
  rw [Real.sq_sqrt (by norm_num [mixtureFloor])]
  unfold biasFloor
  ring

/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 12099) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 12099) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (12099 : ℝ)) * eR c * 12099 * chi
  moments : PaperMoments c (keptIx (paperDesignP 12099) c (rowSplit c wl ws))
    varianceMax energyError locationError locationNorm varianceNorm
  removal : ∫ a, removed (stdGauss (Fin (12099 - 1)))
    (rowSplit c wl ws).good a ∂muI 12099 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12099) c (rowSplit c wl ws),
