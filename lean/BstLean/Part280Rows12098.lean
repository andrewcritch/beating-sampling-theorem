  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12098) (hc : A1 c ∈ Eop 12098) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12098 : ℝ)) ≤ (6428774791 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12098 : ℝ) ≤ (109990909 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12098 : ℝ) + 2 * √12098 ≤ (6158990909 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12098) (hc : c ∈ BstLean.Part164.Eop2 12098) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12098 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12098) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12098 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12098) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12098).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12098) (FirstMatrix 12098))
    (h2 : c ∈ BstLean.Part164.Eop2 12098) (a : BstLean.Part161.Ix 12098) :
