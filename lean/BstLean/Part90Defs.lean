import BstLean.Part89QMain
import BstLean.Part82Defs

/-!
# Part 90, frozen definitions: Theorem 1 (the line program) at `(d_M, d_f) = (3, 3)` by a
dedicated conditioning proof in the slice model

Role: `delegations/statements/p90-spec.md`. This file holds definitions and `Prop`-valued interface
statements only. Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

## Plan
The slice model of Part 86 (`modRK m 3 t v E`), the semicircle sphere step of Part 89 (`gmw_of`,
`remezSemiP`) and the polar reduction are reused. The new part is a bound for the variance over `W`
of the within-slice variance `Vdn`, for a cubic `f`, with NO reverse Hölder inequality at degree
`d k = 9` in `x`:

* In one slice (`ν` a distribution on the sphere, mean field `mu`, residual features `ψ`):
  `F_x = f(mu x + W ψ x)`, `Y = Var_x F`, `G_x = ∇f(mu x + W ψ x)`. Gaussian Poincaré, Bessel with
  the feature operator bound `Γ`, and Hölder IN `x` with the fourth moment of `c·ψ` (`Feat4A`):
  `Var_W Y ≤ 4(1+η)‖Ā‖² Γ Ȳ + 4(1+1/η) G4 (E_W Y²)^{1/2} (E_W E_x ‖G_x − Ā‖⁴)^{1/2}`
  for every constant vector `Ā` (`VarBoundC`).
* `G_x − Ā = (A_x − Ā) + 2 H_x r + 3 (T[r,r] − k b)`, `A_x = ∇f(mu x) + 3 k(x) b` (`GradL4`).
* `Var_W F_x = k‖A_x‖² + 2k²‖H_x‖² + 6k³‖T‖²` (`VarWC`); the floor of `Ȳ` is `(1−Λ) E_x Var_W F_x`.
* In a slice of `D_{t,v}` the mean field and the kernel move by `O(R/√m)` in `L⁴`, `L⁸`
  (`SliceMom`); with two Markov events for the anchors this gives the oscillation hypothesis
  (`SliceOscM`).
-/

namespace BstLean.Part90

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss)
open BstLean.Part40 (SphLaw)
open BstLean.Part41 (Mono varU)
open BstLean.Part56 (UnitV kJ tauR polarPoint perpDir axialR axialS)
open BstLean.Part78 (nsq frobH zv)
open BstLean.Part80 (kA FeatOpA)
open BstLean.Part82 (T3 SymT frobT trT cfun aU3 HU3)
open BstLean.Part86
open BstLean.Part89 (Ybar)

/-! ## §1 The abstract cubic conditional model -/

section abstract
variable {n : ℕ} {J : Type} [Fintype J]

/-- `F_W(x) = f(mu(x) + W ψ(x))`, `f = cfun f0 ℓ H T` a cubic. -/
def FC (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ)
    (x : Fin n → ℝ) : ℝ :=
  cfun f0 ℓ H T (fun i => mu x i + zv W (ψ x) i)

/-- `Y(W) = Var_x F_W(x)`. -/
noncomputable def YC (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ) : ℝ := varU ν (FC f0 ℓ H T mu ψ W)

/-- `Ȳ = E_W Y(W)`. -/
noncomputable def YbC (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) : ℝ := ∫ W, YC ν f0 ℓ H T mu ψ W ∂stdGauss (J × Fin n)

/-- `A_x = ∇f(mu x) + 3 k(x) b`, `b = trT T`, `k = kA ψ`: the first-chaos coefficient. -/
def AxC (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (x : Fin n → ℝ) : Fin n → ℝ :=
  fun i => aU3 ℓ H T (mu x) i + 3 * kA ψ x * trT T i

/-- `H_x = H + 3 T[mu x]`. -/
def HxC (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (x : Fin n → ℝ) : Matrix (Fin n) (Fin n) ℝ := HU3 H T (mu x)

/-- `w(x) = Var_W F_W(x) = k‖A_x‖² + 2k²‖H_x‖_F² + 6k³‖T‖_F²`. -/
def wC (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (x : Fin n → ℝ) : ℝ :=
  kA ψ x * nsq (AxC ℓ H T mu ψ x) + 2 * kA ψ x ^ 2 * frobH (HxC H T mu x) +
    6 * kA ψ x ^ 3 * frobT T

/-- `𝒟₄(Ā) = E_W E_x ‖∇f(mu x + W ψ x) − Ā‖⁴`. (`aU3 ℓ H T y = ∇f(y)`.) -/
noncomputable def D4C (ν : Measure (Fin n → ℝ)) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ)
    (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ)
    (Abar : Fin n → ℝ) : ℝ :=
  ∫ W, ∫ x, (∑ i, (aU3 ℓ H T (fun l => mu x l + zv W (ψ x) l) i - Abar i) ^ 2) ^ 2 ∂ν
    ∂stdGauss (J × Fin n)

/-- The fourth-moment feature bound: `E_x (c·ψ(x))⁴ ≤ G4² ‖c‖⁴`. -/
def Feat4A (ν : Measure (Fin n → ℝ)) (ψ : (Fin n → ℝ) → J → ℝ) (G4 : ℝ) : Prop :=
  ∀ c : J → ℝ, ∫ x, (∑ q, c q * ψ x q) ^ 4 ∂ν ≤ G4 ^ 2 * (∑ q, c q ^ 2) ^ 2

end abstract

/-- **Single-point Wick variance** of the cubic: `Var_W F_W(x) = w(x)`. -/
def VarWC : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ),
    H.IsSymm → ∀ T : T3 n, SymT T →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (x : Fin n → ℝ),
      Integrable (fun W => FC f0 ℓ H T mu ψ W x) (stdGauss (J × Fin n)) ∧
      Integrable (fun W => (FC f0 ℓ H T mu ψ W x -
        ∫ W', FC f0 ℓ H T mu ψ W' x ∂stdGauss (J × Fin n)) ^ 2) (stdGauss (J × Fin n)) ∧
      ∫ W, (FC f0 ℓ H T mu ψ W x - ∫ W', FC f0 ℓ H T mu ψ W' x ∂stdGauss (J × Fin n)) ^ 2
        ∂stdGauss (J × Fin n) = wC ℓ H T mu ψ x

/-- **Regularity** of `Y` in `W`. -/
def RegC : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
      (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
      Integrable (YC ν f0 ℓ H T mu ψ) (stdGauss (J × Fin n)) ∧
      Integrable (fun W => YC ν f0 ℓ H T mu ψ W ^ 2) (stdGauss (J × Fin n))

/-- **The variance bound in one slice** (Poincaré, Bessel, Hölder in `x`): for every constant
vector `Ā`, with `𝒟₄(Ā) ≤ D⁴` and `E_W Y² ≤ s²`:
`Var_W Y ≤ 4(1+η) ‖Ā‖² Γ Ȳ + 4(1+1/η) G4 s D²`. -/
def VarBoundC : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
    ∀ Γ G4 : ℝ, 0 ≤ Γ → 0 ≤ G4 → FeatOpA ν ψ Γ → Feat4A ν ψ G4 →
    ∀ (Abar : Fin n → ℝ) (η D s : ℝ), 0 < η → 0 ≤ D → 0 ≤ s →
      D4C ν ℓ H T mu ψ Abar ≤ D ^ 4 →
      ∫ W, YC ν f0 ℓ H T mu ψ W ^ 2 ∂stdGauss (J × Fin n) ≤ s ^ 2 →
      ∫ W, (YC ν f0 ℓ H T mu ψ W - YbC ν f0 ℓ H T mu ψ) ^ 2 ∂stdGauss (J × Fin n) ≤
        4 * (1 + η) * nsq Abar * Γ * YbC ν f0 ℓ H T mu ψ + 4 * (1 + 1 / η) * G4 * s * D ^ 2

/-- **The fourth moment of the gradient fluctuation** (Minkowski in `L⁴`, Gaussian fourth moments
with the constants `3` and `35/2`): with `k ≤ K t` a.e., `‖A_x − Ā‖_{L⁴} ≤ dA`,
`‖H_x − H̄‖_{L⁴} ≤ dH`, `‖H̄‖_F ≤ hb`, `‖T‖_F ≤ tt`, `rt² = t`:
`𝒟₄(Ā) ≤ (dA + cH rt (hb + dH) + cT t tt)⁴` for `cH⁴ ≥ 48 K²`, `cT⁴ ≥ 5670 K⁴`. -/
def GradL4 : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
    ∀ (Abar : Fin n → ℝ) (Hbar : Matrix (Fin n) (Fin n) ℝ) (K t rt cH cT dA dH hb tt : ℝ),
      0 ≤ K → 0 ≤ rt → rt ^ 2 = t → 0 ≤ cH → 0 ≤ cT → 0 ≤ dA → 0 ≤ dH → 0 ≤ hb → 0 ≤ tt →
      48 * K ^ 2 ≤ cH ^ 4 → 5670 * K ^ 4 ≤ cT ^ 4 →
      frobH Hbar ≤ hb ^ 2 → frobT T ≤ tt ^ 2 →
      (∀ᵐ x ∂ν, kA ψ x ≤ K * t) →
      ∫ x, (nsq (fun i => AxC ℓ H T mu ψ x i - Abar i)) ^ 2 ∂ν ≤ dA ^ 4 →
      ∫ x, (frobH (HxC H T mu x - Hbar)) ^ 2 ∂ν ≤ dH ^ 4 →
      D4C ν ℓ H T mu ψ Abar ≤ (dA + cH * rt * (hb + dH) + cT * t * tt) ^ 4

/-! ## §2 The constants of the slice bound -/

/-- `C₁ = 1 + ε₁²/2 + (ε₁ε₄ + ε₂)²/6`. -/
noncomputable def C1c (e1 e2 e4 : ℝ) : ℝ := 1 + e1 ^ 2 / 2 + (e1 * e4 + e2) ^ 2 / 6

/-- `C₃ = (c_H + ε₁)²/2 + (c_T + 2 c_H ε₄ + ε₁ε₄ + ε₂)²/6`. -/
noncomputable def C3c (cH cT e1 e2 e4 : ℝ) : ℝ :=
  (cH + e1) ^ 2 / 2 + (cT + 2 * cH * e4 + e1 * e4 + e2) ^ 2 / 6

/-- `c₁ = 4(1+η)(1+ω) C₁`. -/
noncomputable def c1c (η ω e1 e2 e4 : ℝ) : ℝ := 4 * (1 + η) * (1 + ω) * C1c e1 e2 e4

/-- `c₂ = 4(1+η)(1+1/ω)`. -/
noncomputable def c2c (η ω : ℝ) : ℝ := 4 * (1 + η) * (1 + 1 / ω)

/-- `c₃ = 4 g₄ (1+1/η)(1+ω) C₃`. -/
noncomputable def c3c (g4 η ω cH cT e1 e2 e4 : ℝ) : ℝ :=
  4 * g4 * (1 + 1 / η) * (1 + ω) * C3c cH cT e1 e2 e4

/-- `c₄ = 4 g₄ (1+1/η)(1+1/ω)`. -/
noncomputable def c4c (g4 η ω : ℝ) : ℝ := 4 * g4 * (1 + 1 / η) * (1 + 1 / ω)

/-- The coefficient of `Ȳ`: `Λ c₃/(1−Λ) + ζ/2 + Λ (c₁ + c₃)/((1−Λ) 2ζ)`. -/
noncomputable def kYc (Lam g4 η ω ζ cH cT e1 e2 e4 : ℝ) : ℝ :=
  Lam * c3c g4 η ω cH cT e1 e2 e4 / (1 - Lam) + ζ / 2 +
    Lam * (c1c η ω e1 e2 e4 + c3c g4 η ω cH cT e1 e2 e4) / ((1 - Lam) * (2 * ζ))

/-- The coefficient of the additive term `t z²`: `Λ (c₄ + (c₂ + c₄)/(2ζ))`. -/
noncomputable def kEc (Lam g4 η ω ζ : ℝ) : ℝ :=
  Lam * (c4c g4 η ω + (c2c η ω + c4c g4 η ω) / (2 * ζ))

/-- **The variance bound in one slice, final form.** Level `t = rt²` with `t ≤ k ≤ K t` a.e.,
feature operator bound `Λ t`, fourth-moment bound `g₄ Λ t`, the floor `(1−Λ) E_x w ≤ Ȳ`, and the
oscillation bounds `‖A_x − Ā‖_{L⁴} ≤ ε₁ rt ‖H̄‖ + ε₂ t ‖T‖ + z`, `‖H_x − H̄‖_{L⁴} ≤ ε₄ rt ‖T‖`:
`Var_W Y ≤ (kY · Ȳ + kE · t z²)²`. -/
def CubSliceA : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
    ∀ (Lam g4 K t rt cH cT : ℝ), 0 ≤ Lam → Lam ≤ 1 / 2 → 0 ≤ g4 → 0 ≤ K → 0 ≤ rt → rt ^ 2 = t →
      0 ≤ cH → 0 ≤ cT → 48 * K ^ 2 ≤ cH ^ 4 → 5670 * K ^ 4 ≤ cT ^ 4 →
      FeatOpA ν ψ (Lam * t) → Feat4A ν ψ (g4 * (Lam * t)) →
      (∀ᵐ x ∂ν, t ≤ kA ψ x ∧ kA ψ x ≤ K * t) →
      (1 - Lam) * ∫ x, wC ℓ H T mu ψ x ∂ν ≤ YbC ν f0 ℓ H T mu ψ →
    ∀ (Abar : Fin n → ℝ) (Hbar : Matrix (Fin n) (Fin n) ℝ) (e1 e2 e4 z : ℝ),
      0 ≤ e1 → 0 ≤ e2 → 0 ≤ e4 → 0 ≤ z →
      ∫ x, (nsq (fun i => AxC ℓ H T mu ψ x i - Abar i)) ^ 2 ∂ν ≤
        (e1 * rt * Real.sqrt (frobH Hbar) + e2 * t * Real.sqrt (frobT T) + z) ^ 4 →
      ∫ x, (frobH (HxC H T mu x - Hbar)) ^ 2 ∂ν ≤ (e4 * rt * Real.sqrt (frobT T)) ^ 4 →
    ∀ η ω ζ : ℝ, 0 < η → 0 < ω → 0 < ζ →
      ∫ W, (YC ν f0 ℓ H T mu ψ W - YbC ν f0 ℓ H T mu ψ) ^ 2 ∂stdGauss (J × Fin n) ≤
        (kYc Lam g4 η ω ζ cH cT e1 e2 e4 * YbC ν f0 ℓ H T mu ψ +
          kEc Lam g4 η ω ζ * (t * z ^ 2)) ^ 2

/-! ## §3 The slice model of Part 86 with a cubic -/

section model
variable {n : ℕ} {I J S G : Type} [Fintype I] [Fintype J] [MeasurableSpace S] [MeasurableSpace G]

/-- `P` is the cubic `f = cfun f0 ℓ H T` at `Σ_j b_j(x) A_j + lam · sc · W ψ(x)`. -/
def CubRep (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (A : I → Fin n → ℝ) (sc : ℝ) : Prop :=
  ∀ (lam : ℝ) (W : J × Fin n → ℝ) (x : Fin n → ℝ),
    Fm M P lam W x =
      cfun f0 ℓ H T (fun i => ∑ j, M.b x j * A j i + lam * sc * zv W (M.ps x) i)

/-- The mean field of the model: `mu x = Σ_j b_j(x) A_j`. -/
noncomputable def muM (M : Mod n I J S G) (A : I → Fin n → ℝ) (x : Fin n → ℝ) : Fin n → ℝ :=
  fun i => ∑ j, M.b x j * A j i

/-- The scaled residual features: `ψ x = c · ps x` (`c = lam · sc`). -/
noncomputable def psM (M : Mod n I J S G) (c : ℝ) (x : Fin n → ℝ) : J → ℝ :=
  fun q => c * M.ps x q

/-- **The oscillation of `A_x` and `H_x` in a slice** (for almost every slice): constants `Ā`, `H̄`
and an additive level `z ≥ 0` with `c² τ_p z² ≤ e0`,
`‖A_x − Ā‖_{L⁴(slice)} ≤ ε₁ |c| ρ_p ‖H̄‖_F + ε₂ c² τ_p ‖T‖_F + z` and
`‖H_x − H̄‖_{L⁴(slice)} ≤ ε₄ |c| ρ_p ‖T‖_F`. Here `τ_p = ρ_p²` is the level of the slice. -/
def SliceOscM (M : Mod n I J S G) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (A : I → Fin n → ℝ) (c : ℝ) (tau rho : S → ℝ) (e1 e2 e4 e0 : ℝ) : Prop :=
  ∀ᵐ p ∂M.pi, ∃ (Abar : Fin n → ℝ) (Hbar : Matrix (Fin n) (Fin n) ℝ) (z : ℝ), 0 ≤ z ∧
    c ^ 2 * tau p * z ^ 2 ≤ e0 ∧
    ∫ g, (nsq (fun i => AxC ℓ H T (muM M A) (psM M c) (M.X (p, g)) i - Abar i)) ^ 2 ∂M.ga ≤
      (e1 * (|c| * rho p) * Real.sqrt (frobH Hbar) +
        e2 * (c ^ 2 * tau p) * Real.sqrt (frobT T) + z) ^ 4 ∧
    ∫ g, (frobH (HxC H T (muM M A) (M.X (p, g)) - Hbar)) ^ 2 ∂M.ga ≤
      (e4 * (|c| * rho p) * Real.sqrt (frobT T)) ^ 4

/-- **The variance bound for the within-slice variance** `Vdn = E_p Y_p` of a cubic:
`E_W (Vdn − E_p Ȳ_p)² ≤ (kY + kE ε₃²/(6 c₃ (1−Λ)))² (E_p Ȳ_p)²`, when the additive level of the
oscillation is `e0 = ε₃² c⁶ ‖T‖_F²`. `c₃` is a lower bound of `E_p τ2_p³`, `τ2_p ≤ k` in slice
`p`. -/
def CubVarM (M : Mod n I J S G) (Lam g4 K : ℝ) (tau rho : S → ℝ) (c3 : ℝ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ) (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ)
    (T : T3 n) (A : I → Fin n → ℝ) (sc : ℝ), H.IsSymm → SymT T → CubRep M P f0 ℓ H T A sc →
    ∀ (lam cH cT e1 e2 e4 e3 η ω ζ : ℝ), 0 ≤ cH → 0 ≤ cT → 48 * K ^ 2 ≤ cH ^ 4 →
      5670 * K ^ 4 ≤ cT ^ 4 → 0 ≤ e1 → 0 ≤ e2 → 0 ≤ e4 → 0 ≤ e3 → 0 < η → 0 < ω → 0 < ζ →
      SliceOscM M ℓ H T A (lam * sc) tau rho e1 e2 e4
        (e3 ^ 2 * ((lam * sc) ^ 2) ^ 3 * frobT T) →
      ∫ W, (Vdn M P lam W - ∫ p, Ybar M P lam p ∂M.pi) ^ 2 ∂stdGauss (J × Fin n) ≤
        (kYc Lam g4 η ω ζ cH cT e1 e2 e4 +
          kEc Lam g4 η ω ζ * (e3 ^ 2 / (6 * c3 * (1 - Lam)))) ^ 2 *
          (∫ p, Ybar M P lam p ∂M.pi) ^ 2

end model

/-! ## §4 The instance `D_{t,v}`, `d = 3` -/

section inst
variable {n : ℕ}

/-- The anchor feature `b_j(x) = k_j(x, v)/√k_j(v, v)` at `d = 3`. -/
noncomputable def bF (v : Fin n → ℝ) (j : ℕ) (x : Fin n → ℝ) : ℝ :=
  kJ 3 j x v / Real.sqrt (kJ 3 j v v)

/-- `T[a]`: the matrix `(i, l) ↦ Σ_k T i l k a_k`. -/
def TA (T : T3 n) (a : Fin n → ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.of fun i l => ∑ k, T i l k * a k

end inst

/-- **Closed forms of the block kernels** at degrees `0..3` (complete homogeneous symmetric
polynomials of `x_i y_i`), and the residual kernel on the sphere. -/
def ClosedForms (n : ℕ) : Prop :=
  (∀ x y : Fin n → ℝ,
    kJ 3 0 x y = 1 ∧
    kJ 3 1 x y = ∑ i, x i * y i ∧
    kJ 3 2 x y = ((∑ i, x i * y i) ^ 2 + ∑ i, (x i * y i) ^ 2) / 2 ∧
    kJ 3 3 x y = ((∑ i, x i * y i) ^ 3 + 3 * (∑ i, x i * y i) * (∑ i, (x i * y i) ^ 2) +
      2 * ∑ i, (x i * y i) ^ 3) / 6) ∧
  ∀ v : Fin n → ℝ, UnitV v → ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
    tauR 3 v x = 5 / 3 + ∑ i, x i ^ 4 + (∑ i, x i ^ 6) / 3 -
      bF v 1 x ^ 2 - bF v 2 x ^ 2 - bF v 3 x ^ 2

/-- **Upper bound of the residual kernel** on the sphere: `τ(x) ≤ 6 (1 − (v·x)²)`. -/
def KernelUp3 (n : ℕ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v → ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
    tauR 3 v x ≤ 6 * (1 - (∑ i, v i * x i) ^ 2)

/-- **Lower bound of the residual kernel** on the sphere: `τ(x) ≥ (1 − s²)(3 + s²)/2`. -/
def KernelLow3 (n : ℕ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v → ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
    (1 - (∑ i, v i * x i) ^ 2) * (3 + (∑ i, v i * x i) ^ 2) / 2 ≤ tauR 3 v x

/-- **Slice moments of a linear form perpendicular to `v`**: `L(x) = u · (x − (v·x) v)` on the
slice `x = S v + R w`: `‖L‖_{L^p} ≤ q_p R ‖u‖/√m` for `p = 4, 8, 16`. (The sharp values are
`q₄⁴ = 3`, `q₈⁸ = 105`, `q₁₆¹⁶ = 2027025`; the slice reverse Hölder inequality gives `9`, `9⁴`,
`9¹²`.) -/
def SliceLin (m : ℕ) (q4 q8 q16 : ℝ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, UnitV v → ∀ a r : ℝ, ∀ u : Fin (m + 1) → ℝ,
    ∫ g, (∑ i, u i * (polarPoint v (perpDir v g) a r i -
        (∑ l, v l * polarPoint v (perpDir v g) a r l) * v i)) ^ 4 ∂stdGauss (Fin (m + 1)) ≤
      (q4 * axialR a r) ^ 4 * nsq u ^ 2 / (m : ℝ) ^ 2 ∧
    ∫ g, (∑ i, u i * (polarPoint v (perpDir v g) a r i -
        (∑ l, v l * polarPoint v (perpDir v g) a r l) * v i)) ^ 8 ∂stdGauss (Fin (m + 1)) ≤
      (q8 * axialR a r) ^ 8 * nsq u ^ 4 / (m : ℝ) ^ 4 ∧
    ∫ g, (∑ i, u i * (polarPoint v (perpDir v g) a r i -
        (∑ l, v l * polarPoint v (perpDir v g) a r l) * v i)) ^ 16 ∂stdGauss (Fin (m + 1)) ≤
      (q16 * axialR a r) ^ 16 * nsq u ^ 8 / (m : ℝ) ^ 8

/-- **Slice moments of the anchor features and of the residual kernel**: on the slice
`x = S v + R w` (`a ≠ 0`, `r ≥ 0`, `S = axialS a r`, `R = axialR a r`) there are constants
`β₂, β₃ ∈ [−1, 1]` and `k̄` with
`‖|b₂ − β₂| + |b₃ − β₃|‖_{L⁴} ≤ C4 R/√m`, the same in `L⁸` with `C8`, and
`R ‖τ − k̄‖_{L⁴} ≤ CK/√m`. -/
def SliceMom (m : ℕ) (C4 C8 CK : ℝ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, UnitV v → ∀ a r : ℝ, a ≠ 0 → 0 ≤ r →
    ∃ β2 β3 kb : ℝ, |β2| ≤ 1 ∧ |β3| ≤ 1 ∧
      ∫ g, (|bF v 2 (polarPoint v (perpDir v g) a r) - β2| +
          |bF v 3 (polarPoint v (perpDir v g) a r) - β3|) ^ 4 ∂stdGauss (Fin (m + 1)) ≤
        (C4 * axialR a r) ^ 4 / (m : ℝ) ^ 2 ∧
      ∫ g, (|bF v 2 (polarPoint v (perpDir v g) a r) - β2| +
          |bF v 3 (polarPoint v (perpDir v g) a r) - β3|) ^ 8 ∂stdGauss (Fin (m + 1)) ≤
        (C8 * axialR a r) ^ 8 / (m : ℝ) ^ 4 ∧
      axialR a r ^ 4 * ∫ g, (tauR 3 v (polarPoint v (perpDir v g) a r) - kb) ^ 4
          ∂stdGauss (Fin (m + 1)) ≤ CK ^ 4 / (m : ℝ) ^ 2

end BstLean.Part90
