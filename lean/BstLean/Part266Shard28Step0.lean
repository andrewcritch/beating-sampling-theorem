  have hsum : (13050 : ℝ) + √13050 + gaussMomConst 80 ≤ 13174 := by
    linarith [gaussian80_le]
  exact (mul_le_mul hs hsum
    (add_nonneg (add_nonneg (by norm_num) (sqrt_nonneg _)) (gaussMomConst_nonneg 80))
    (by norm_num)).trans (by norm_num)

theorem jacobian_squared_row : latitudeJacobianSquared160 13050 4 ≤ (81 / 16 : ℝ) := by
  have hs : √(2 / (mA 13050 : ℝ)) ≤ (13546107 / 125000000000) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  have hinner : planeEnvelopeSquared160 13050 4 +
      2 / (mA 13050 : ℝ) * frobEnvelopeSquared160 13050 ≤ (21 / 10 : ℝ) ^ 2 := by
    have hp := plane_squared_row
    norm_num [frobEnvelopeSquared160, mA] at *
    linarith
  have hr : √(planeEnvelopeSquared160 13050 4 +
      2 / (mA 13050 : ℝ) * frobEnvelopeSquared160 13050) ≤ (21 / 10 : ℝ) :=
    (sqrt_le_iff).mpr ⟨by norm_num, hinner⟩
  have ht : transverseConstant160 * √(2 / (mA 13050 : ℝ)) *
