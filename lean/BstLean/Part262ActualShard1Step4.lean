  linarith [he.2]

theorem hq_fluctuation {c : Ret 12263} (t : ℝ)
    (hw : WINDOW (paperDesignP 12263) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12263)) (hm : LowResidualMass c) :
