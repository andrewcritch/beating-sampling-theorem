def LowResidualMass (c : Ret 12273) : Prop :=
  ∫ a, (stdGauss (Fin (12273 - 1))).real
    {v | sgA (paperDesignP 12273) c a v < rowSigma} ∂muI 12273 ≤ lowMassBudget

