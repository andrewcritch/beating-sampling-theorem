/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12264) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12264) c (rowSplit c wl ws),
    ((12264 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12264 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12264) c (rowSplit c wl ws),
    ((12264 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12264 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12264 - 1)))
    (rowSplit c wl ws).good a ∂muI 12264 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12264) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12264 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12264) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12264 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12264) c (rowSplit c wl ws),
    hellG2 12264 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12264 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 12264}
    (hw : WINDOW (paperDesignP 12264) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
