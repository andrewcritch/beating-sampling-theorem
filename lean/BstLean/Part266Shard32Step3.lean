      ∂stdGauss (Fin (13170 - 1)) ∂muI 13170 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 13170).prod (stdGauss (Fin (13170 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 13170) c (hc.1.1.1.1 hw.2.1)
