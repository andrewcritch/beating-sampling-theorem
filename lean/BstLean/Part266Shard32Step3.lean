theorem removal_of_low_mass {c : Ret 13167}
    (hw : WINDOW (paperDesignP 13167) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (13167 - 1))).real
      {v | sgA (paperDesignP 13167) c a v < √(2 / (13167 : ℝ) * mixtureFloor)}
      ∂muI 13167 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (13167 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 13167 ≤
        removalBudget := by
  have hl := locationMomentBudget_pos he (by norm_num : 12 ≤ 12)
  have hs := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
  have h := int_removed (by norm_num) (paperDesignP 13167) c
