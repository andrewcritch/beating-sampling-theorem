  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (13160 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 13160) c p.1 p.2)
      (√(2 / (13160 : ℝ)) * (1 + BstLean.Part222.energyAllowance 13160)) := by
    apply hn.mono (measurable_sgA _ c)
    apply Filter.Eventually.of_forall
