theorem removal_of_low_mass {c : Ret 12352}
    (hw : WINDOW (paperDesignP 12352) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12352 - 1))).real
