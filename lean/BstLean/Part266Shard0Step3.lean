theorem low_mass_of_interfaces {c : Ret 12374}
    (hw : WINDOW (paperDesignP 12374) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12374).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12374) c M H xi)
    (hE : centreEnergy (paperDesignP 12374) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12374 : ℝ))))
    (hprice : massBound 12374 M H xi E u mixtureFloor ≤ 12374 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12374 - 1))).real
      {v | sgA (paperDesignP 12374) c a v < √(2 / (12374 : ℝ) * mixtureFloor)}
        ∂muI 12374 ≤ lowMassBudget := by
