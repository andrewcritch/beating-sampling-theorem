theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (5254603543 / 1000000000000000) ∧
    residualMomentBudget 6 ≤ (129081357 / 20000000000000) ∧
    residualMomentBudget 12 ≤ (8855600599 / 1000000000000000) := by
  refine ⟨?_, ?_, ?_⟩
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
      rotation_four (by norm_num)
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
