theorem residual_sq_le_energy (c : Ret 12366)
    (p : Ix 12366 × (Fin (12366 - 1) → ℝ)) :
    sgA (paperDesignP 12366) c p.1 p.2 ^ 2 ≤
      (2 / (12366 : ℝ)) * wLatitude c p := by
