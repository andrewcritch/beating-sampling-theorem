      ∂stdGauss (Fin (12367 - 1)) ∂muI 12367 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12367).prod (stdGauss (Fin (12367 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
