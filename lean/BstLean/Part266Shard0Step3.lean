theorem low_mass_of_interfaces {c : Ret 12358}
    (hw : WINDOW (paperDesignP 12358) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12358).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12358) c M H xi)
    (hE : centreEnergy (paperDesignP 12358) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12358 : ℝ))))
    (hprice : massBound 12358 M H xi E u mixtureFloor ≤ 12358 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12358 - 1))).real
      {v | sgA (paperDesignP 12358) c a v < √(2 / (12358 : ℝ) * mixtureFloor)}
        ∂muI 12358 ≤ lowMassBudget := by
