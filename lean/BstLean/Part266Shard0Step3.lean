/-- All twenty-eight fields concern the original retained network and latitude measure. -/
noncomputable def latitudeMoments {c : Ret 12355}
    (hw : WINDOW (paperDesignP 12355) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12355 - 1))).real
      {v | sgA (paperDesignP 12355) c a v < √(2 / (12355 : ℝ) * mixtureFloor)}
      ∂muI 12355 ≤ lowMassBudget) :
    LatMom (paperDesignP 12355) c (√(2 / (12355 : ℝ) * mixtureFloor)) 24 where
  Vs := residualVarianceBudget
  Vl := locationVarianceBudget c
  VS := scaleVarianceBudget
