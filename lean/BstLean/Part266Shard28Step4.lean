    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13071 - 1))).real
      {v | sgA (paperDesignP 13071) c a v < rowSigma} ∂BstLean.Part161.muI 13071 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
