def LowResidualMass (c : Ret 13072) : Prop :=
  ∫ a, (stdGauss (Fin (13072 - 1))).real
    {v | sgA (paperDesignP 13072) c a v < rowSigma} ∂muI 13072 ≤ lowMassBudget

