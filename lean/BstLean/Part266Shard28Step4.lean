    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13055) (mA 13055) (tA 13055) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
