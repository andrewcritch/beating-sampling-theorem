      _ ≤ ((60259220279 / 500000) : ℝ) * ((1003 / 1000) * ((2866509 / 1000000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
