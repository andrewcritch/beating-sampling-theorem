def LowResidualMass (c : Ret 13070) : Prop :=
  ∫ a, (stdGauss (Fin (13070 - 1))).real
    {v | sgA (paperDesignP 13070) c a v < rowSigma} ∂muI 13070 ≤ lowMassBudget

noncomputable def hqSplit (c : Ret 13070) : SplitData 13070 :=
  rowSplit c (splitLocationWidth c) splitResidualWidth

theorem hq_output_bounds {c : Ret 13070}
    (hw : WINDOW (paperDesignP 13070) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13070)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
  have he := centre_energy_range hw ha
  have hpass := analyticBaseCertificate.pass_fields ha
  have hcap := pass_centre_of_events c hpass
  have hb : 0 < normSq ((paperCentres 13070).bA c.1 c.2.1.1) := by
    change 0 < normSq (bR c)
