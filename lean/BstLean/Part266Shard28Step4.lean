    (gaussMat (mA 13057) 13057 (2 / (13057 : ℝ))).real {X | ∃ g < Js 13057,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13057 : ℝ)) ∨
