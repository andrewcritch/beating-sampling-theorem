theorem node_trace_charge_row {wr : WRet 13063} (hw : windowW wr) :
    (gaussMat (mA 13063) 13063 (2 / (13063 : ℝ))).real {X | ∃ g < Js 13063,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13063 : ℝ)) ∨
