    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13052 - 1))).real
      {v | sgA (paperDesignP 13052) c a v < rowSigma} ∂BstLean.Part161.muI 13052 ≤ lowMassBudget) :
