/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13062) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13062) c (rowSplit c wl ws),
    ((13062 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13062 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13062) c (rowSplit c wl ws),
    ((13062 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13062 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13062 - 1)))
    (rowSplit c wl ws).good a ∂muI 13062 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13062) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13062 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13062) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13062 ≤ mixtureRoot ^ 2
