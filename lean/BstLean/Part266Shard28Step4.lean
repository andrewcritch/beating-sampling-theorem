    (gaussMat (mA 13070) 13070 (2 / (13070 : ℝ))).real {X | ∃ g < Js 13070,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13070 : ℝ)) ∨
