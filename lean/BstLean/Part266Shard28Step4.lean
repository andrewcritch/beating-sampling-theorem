  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((2896601 / 500000000)) ^ 2 * ((1003 / 1000) * ((15609333 / 500000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((2777367 / 8000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((965164501 / 200000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
