theorem variance_moment_of_latitude {n : ℕ} (hn : 26 ≤ n) (c : Ret n)
    (he : 0 < eR c) {C : ℝ} (hC : 0 < C)
    (hk : agKey (paperDesignP n) c ∈ BstLean.Part212.latitudeEvent n
