  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12197 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12197 : ℝ) * _ ≤ 2 / 12197 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12197)
