  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12193) (hc : A1 c ∈ Eop 12193) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12193 : ℝ)) ≤ (3201840691 / 250000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12193 : ℝ) ≤ (110421919 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12193 : ℝ) + 2 * √12193 ≤ (6206921919 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12193) (hc : c ∈ BstLean.Part164.Eop2 12193) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12193 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12193) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12193 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12193) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12193).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12193) (FirstMatrix 12193))
    (h2 : c ∈ BstLean.Part164.Eop2 12193) (a : BstLean.Part161.Ix 12193) :
