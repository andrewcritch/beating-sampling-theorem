  have hn : √(12195 : ℝ) ≤ (55215487 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12195 : ℝ) + 2 * √12195 ≤ (3103965487 / 250000) := by linarith
