theorem exactTableMoments_of_N {c : Ret 12197} (hw : WINDOW (paperDesignP 12197) c)
    (hθ : BstLean.Part280.m2Guard 12197 c) (hc : c ∈ BstLean.Part280.sharpTableN 12197)
