theorem variance_of_matrix_events (c : Ret 12195) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12195).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12195) (FirstMatrix 12195))
