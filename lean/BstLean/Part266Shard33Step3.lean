theorem removal_of_low_mass {c : Ret 13175}
    (hw : WINDOW (paperDesignP 13175) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (13175 - 1))).real
