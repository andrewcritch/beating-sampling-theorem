noncomputable def fullResidualBudget : ℝ := √(2 / (13192 : ℝ)) * locationNorm

theorem residual_sq_le_energy (c : Ret 13192)
    (p : Ix 13192 × (Fin (13192 - 1) → ℝ)) :
    sgA (paperDesignP 13192) c p.1 p.2 ^ 2 ≤
      (2 / (13192 : ℝ)) * wLatitude c p := by
