  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (13189 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 13189) c p.1 p.2)
      (√(2 / (13189 : ℝ)) * (1 + BstLean.Part222.energyAllowance 13189)) := by
