import BstLean.Part266Parameters
import BstLean.Part266Shard2Step6

/-! Actual root coverage for one prescribed 25-row shard. -/
namespace BstLean.Part266
open Set
theorem root_coverage_shard2 : ∀ n ∈ Icc (12400 : ℕ) 12424,
    ∃ a : BstLean.Part192.AgentParameters,
      Nonempty (BstLean.Part262.ActualRootCertificate n a.root) := by
  intro n hn
  obtain ⟨hlo,hhi⟩ := hn
  interval_cases n
  · exact ⟨agent12400, ⟨actualCertificate12400⟩⟩
  · exact ⟨agent12401, ⟨actualCertificate12401⟩⟩
