theorem geometry10W {n : ℕ} (hn : n ∈ Icc 13225 16199) {θ : ℝ}
    (hθ : B (565958839397 / 1200000000000) (1135383190883 / 2400000000000) θ) :
    OverlapGuard n θ exampleWide (50083597 / 125000000) (6825149 / 10000000) ∧
    radiusMinus n θ exampleWide ≤ (92528399984147741 / 1000000000000000000) := by
  have hn0 : 0 < n := by have := hn.1; omega
  have hnlo : (13225 : ℝ) ≤ n := by exact_mod_cast hn.1
  have hnhi : (n : ℝ) ≤ 16199 := by exact_mod_cast hn.2
  have hx : B (1 / 16199) (1 / 13225) (invN n) := by
    constructor <;> unfold invN <;> gcongr
  have hrm := (geometry10W_hz12 (x := invN n) hx hθ).2
  have hrp := (geometry10W_hz16 (x := invN n) hx hθ).2
  have hbn := (geometry10W_hz21 (x := invN n) hx hθ).2
  have hlo := (geometry10W_hz40 (x := invN n) hx hθ).1
  have hhi := (geometry10W_hz35 (x := invN n) hx hθ).2
  rw [← norm_radiusMinus] at hrm
  rw [← norm_radiusPlus] at hrp
  rw [← norm_planeRatio] at hbn
  rw [← norm_overlap hn0] at hlo hhi
  refine ⟨⟨le_trans (by norm_num) hθ.1, lt_of_le_of_lt hθ.2 (by norm_num),
    lt_of_le_of_lt hbn (by norm_num), lt_of_le_of_lt hrm (by norm_num),
    by norm_num, ?_, ?_⟩, hrm.trans (by norm_num)⟩
  · nlinarith only [hrp,hlo]
  · nlinarith only [hhi,hrm]

