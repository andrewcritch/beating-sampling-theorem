      ∫ w, sA (paperDesignP 12663) c a w ∂stdGauss (Fin (12663 - 1))) ^ 2
      ∂stdGauss (Fin (12663 - 1))) ^ 2 ∂muI 12663 ≤ scaleVarianceBudget ^ 2 :=
