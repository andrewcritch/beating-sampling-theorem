      ∫ w, sA (paperDesignP 12651) c a w ∂stdGauss (Fin (12651 - 1))) ^ 2
      ∂stdGauss (Fin (12651 - 1))) ^ 2 ∂muI 12651 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12651) c
