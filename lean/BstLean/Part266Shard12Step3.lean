theorem removal_of_low_mass {c : Ret 12673}
    (hw : WINDOW (paperDesignP 12673) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12673 - 1))).real
      {v | sgA (paperDesignP 12673) c a v < √(2 / (12673 : ℝ) * mixtureFloor)}
      ∂muI 12673 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12673 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12673 ≤
        removalBudget := by
