theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (633670689 / 125000000000000) ∧
    residualMomentBudget 6 ≤ (3113260901 / 500000000000000) ∧
    residualMomentBudget 12 ≤ (533955449 / 62500000000000) := by
