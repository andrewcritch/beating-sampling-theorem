  have he0 := hε.1
  have hl0 := hL.1
  have hk1 := hκ.2
  have he1 := hε.2
  have hl1 := hL.2
  have hε2 := pow_le_pow_left₀ he0 he1 2
  have hL2 := pow_le_pow_left₀ hl0 hl1 2
  have hb : 12653 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon) ≤
      12653 * ((23340477 / 1000000000) : ℝ) ^ 2 / 2 + ((1650149791 / 1000000000)) ^ 2 * (1 + (23340477 / 1000000000)) := by
    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (12653 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
      _ ≤ (1001 / 1000 : ℝ) * (12653 * ((23340477 / 1000000000)) ^ 2 / 2 + ((1650149791 / 1000000000)) ^ 2 * (1 + (23340477 / 1000000000))) := by
        exact mul_le_mul hk1 hb
