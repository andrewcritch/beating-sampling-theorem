noncomputable def latitudeC : ℝ := freshLatitudeConstant160 12653 4 (55 / 100)

noncomputable def locationMomentBudget (c : Ret 12653) (q : ℕ) : ℝ :=
  rotationConstant q * √((latitudeC / eR c) /
    ((12653 : ℝ) * (12653 - 1 - 2 * q)))

noncomputable def residualMomentBudget (q : ℕ) : ℝ :=
  rotationConstant q * √((2 * latitudeC / 12653) /
