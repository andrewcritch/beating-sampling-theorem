    (hR : 0 ≤ R) (hb : 0 ≤ b) (hr : rotationConstant q ≤ R)
    (hnum : R ^ 2 * ((2 * (16 / 5) / 12651 : ℝ) /
      ((12651 : ℝ) * (12651 - 1 - 2 * q))) ≤ b ^ 2) : residualMomentBudget q ≤ b := by
