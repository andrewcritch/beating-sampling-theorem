theorem sigma_bounds : ((2942311 / 500000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (5884623 / 1000000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
