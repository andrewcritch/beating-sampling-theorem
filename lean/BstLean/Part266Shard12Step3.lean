    (hw : WINDOW (paperDesignP 12670) c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12670) c a v - gbar (paperDesignP 12670) c a| ^ (2 * q)
      ∂stdGauss (Fin (12670 - 1)) ∂muI 12670 ≤ residualMomentBudget q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
