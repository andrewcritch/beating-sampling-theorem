      ∫ w, sA (paperDesignP 12659) c a w ∂stdGauss (Fin (12659 - 1))) ^ 2
      ∂stdGauss (Fin (12659 - 1))) ^ 2 ∂muI 12659 ≤ scaleVarianceBudget ^ 2 :=
