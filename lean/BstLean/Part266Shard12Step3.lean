  have hl := latitude_mass_of_MASS (by norm_num) (paperDesignP 12654) c hw.1 hw.2.1
    (by norm_num [mixtureFloor]) hm
  exact hl.trans ((div_le_div_of_nonneg_right hprice (by norm_num : (0 : ℝ) ≤ 12654)).trans
    (by ring_nf; exact le_rfl))

