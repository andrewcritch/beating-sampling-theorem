      ∂stdGauss (Fin (12672 - 1)) ∂muI 12672 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12672).prod (stdGauss (Fin (12672 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12672) c (hc.1.1.1.1 hw.2.1)
