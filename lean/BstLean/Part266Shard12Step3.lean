theorem variance_budgets_row {c : Ret 12650} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (33336553 / 1000000000000000) ∧ residualVarianceBudget ≤ (3162361 / 1000000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
