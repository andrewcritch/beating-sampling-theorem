  refine ⟨hk, hloc, heps, hexp,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals clear * - hV0 hV1 hE0 hE1 hi80 hi81 hi120 hi121 hc20 hc21 hc30 hc31 hVl hVs hVl0 hVs0 hl4 hl6 hs4 hs6 hl40 hl60 hs40 hs60 hinv hinv0 hσ0 hσ hca0 hroot0 hroot
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((11436226661 / 100000) : ℝ) * ((1003 / 1000) * ((1780589 / 500000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((1190029 / 200000000)) ^ 2 * ((1003 / 1000) * ((36083627 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169087481 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((5379585937 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1190029 / 200000000)) * ((1001 / 1000 + 52 / 1000) * ((270755421 / 500000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169087481 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((1321519361 / 200000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1190029 / 200000000)) * ((1001 / 1000 + 52 / 1000) * ((665122809 / 1000000000000))) := by
