  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12159) (hc : A1 c ∈ Eop 12159) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12159 : ℝ)) ≤ (12825256767 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12159 : ℝ) ≤ (6891741 / 62500) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12159 : ℝ) + 2 * √12159 ≤ (386860491 / 31250) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12159) (hc : c ∈ BstLean.Part164.Eop2 12159) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12159 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12159) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12159 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12159) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12159).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12159) (FirstMatrix 12159))
    (h2 : c ∈ BstLean.Part164.Eop2 12159) (a : BstLean.Part161.Ix 12159) :
    |VR c a| ≤ varianceMax := by
