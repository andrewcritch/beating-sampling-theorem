noncomputable def splitResidualWidth : ℝ := 4 * residualMomentBudget 12
noncomputable def lowMassBudget : ℝ := 4 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 12162}
    (hw : WINDOW (paperDesignP 12162) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12162 - 1))).real
      {v | sgA (paperDesignP 12162) c a v < √(2 / (12162 : ℝ) * mixtureFloor)}
