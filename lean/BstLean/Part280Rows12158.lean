theorem exactTableMoments_of_N {c : Ret 12162} (hw : WINDOW (paperDesignP 12162) c)
    (hθ : BstLean.Part280.m2Guard 12162 c) (hc : c ∈ BstLean.Part280.sharpTableN 12162)
