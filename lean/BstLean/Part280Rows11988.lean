  have hn : √(11992 : ℝ) ≤ (109507991 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11992 : ℝ) + 2 * √11992 ≤ (6105507991 / 500000) := by linarith
