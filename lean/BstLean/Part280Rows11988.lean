theorem second_matrix_row (c : Ret 11988) (hc : c ∈ BstLean.Part164.Eop2 11988) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 11988 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11988) := by
