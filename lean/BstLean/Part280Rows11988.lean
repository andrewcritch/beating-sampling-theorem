      BstLean.Part280.Gen.Row11992.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row11992.locationNorm BstLean.Part280.Gen.Row11992.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
  exact passInputs_of_paperMoments (by norm_num) c BstLean.Part280.Gen.Row11992.eta_pos BstLean.Part280.Gen.Row11992.eta_lt_one
    (sqrt_nonneg _) he BstLean.Part280.Gen.Row11992.bias_floor_ge (by norm_num [BstLean.Part280.Gen.Row11992.epsilon]) BstLean.Part280.Gen.Row11992.bias_threshold_pos
