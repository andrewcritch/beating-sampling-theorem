theorem first_matrix_row (c : Ret 11988) (hc : A1 c ∈ Eop 11988) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11988 : ℝ)) ≤ (2583280861 / 200000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11988 : ℝ) ≤ (54744863 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11988 : ℝ) + 2 * √11988 ≤ (3051744863 / 250000) := by linarith
