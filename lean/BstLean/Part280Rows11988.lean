theorem variance_of_matrix_events (c : Ret 11990) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11990).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11990) (FirstMatrix 11990))
