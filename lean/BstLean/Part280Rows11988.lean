    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11988 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11988) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11988).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11988) (FirstMatrix 11988))
    (h2 : c ∈ BstLean.Part164.Eop2 11988) (a : BstLean.Part161.Ix 11988) :
