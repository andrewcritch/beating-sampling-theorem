  ∫ a, (stdGauss (Fin (11991 - 1))).real
    {v | sgA (paperDesignP 11991) c a v < rowSigma} ∂muI 11991 ≤ lowMassBudget

noncomputable def hqSplit (c : Ret 11991) : SplitData 11991 :=
