theorem variance_of_matrix_events (c : Ret 11992) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11992).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11992) (FirstMatrix 11992))
    (h2 : c ∈ BstLean.Part164.Eop2 11992) (a : BstLean.Part161.Ix 11992) :
