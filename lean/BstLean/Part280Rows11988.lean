  have hsub : keptIx (paperDesignP 11992) c (BstLean.Part280.Gen.Row11992.hqSplit c) ⊆ bulkIx (paperDesignP 11992) c :=
    fun _ h => h.1
  have hfirst : A1 c ∈ BstLean.Part153.Eop 11992 := hc.1.1.2 hw.2.1
  have hsecond : c ∈ BstLean.Part164.Eop2 11992 := hc.1.2
