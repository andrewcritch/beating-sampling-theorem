  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12140) (hc : A1 c ∈ Eop 12140) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12140 : ℝ)) ≤ (6417644541 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12140 : ℝ) ≤ (110181669 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12140 : ℝ) + 2 * √12140 ≤ (6180181669 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12140) (hc : c ∈ BstLean.Part164.Eop2 12140) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12140 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12140) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12140 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12140) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12140).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12140) (FirstMatrix 12140))
    (h2 : c ∈ BstLean.Part164.Eop2 12140) (a : BstLean.Part161.Ix 12140) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
