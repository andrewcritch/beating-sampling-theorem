theorem outputCentre_row {c : Ret 12140}
    (hc : c ∈ outputCentreEvent (paperCentres 12140)) :
    normSq c.2.1.2 ≤ (2 / (12140 : ℝ)) * eR c * 12140 * chi := by
  change normSq c.2.1.2 ≤ 2 / (mA 12140 : ℝ) * normSq (bR c) * chiUp 12140 at hc
  have hn := normSq_nonneg (bR c)
