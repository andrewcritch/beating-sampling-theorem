/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 12139) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 12139) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (12139 : ℝ)) * eR c * 12139 * chi
