      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2977277 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((542313973 / 1000000000000))) := by
        gcongr
