  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((168963801 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((3311150969 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
