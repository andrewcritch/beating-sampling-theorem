theorem variance_of_matrix_events (c : Ret 12138) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12138).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12138) (FirstMatrix 12138))
    (h2 : c ∈ BstLean.Part164.Eop2 12138) (a : BstLean.Part161.Ix 12138) :
