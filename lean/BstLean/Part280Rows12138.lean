      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((2977277 / 500000000)) ^ 2 * ((1003 / 1000) * ((36190713 / 1000000000000000))) := by
        gcongr
