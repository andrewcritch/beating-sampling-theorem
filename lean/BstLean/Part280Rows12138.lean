theorem first_matrix_row (c : Ret 12138) (hc : A1 c ∈ Eop 12138) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12138 : ℝ)) ≤ (2567269297 / 200000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12138 : ℝ) ≤ (6885787 / 62500) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12138 : ℝ) + 2 * √12138 ≤ (386198287 / 31250) := by linarith
