/-! ## §1 Coordinate vectors, slices, and the slice form of the residual kernel -/

section slices
variable {n : ℕ}

/-- `v = ±e_i`. -/
def CoordV (v : Fin n → ℝ) : Prop :=
  ∃ (i0 : Fin n) (e : ℝ), (e = 1 ∨ e = -1) ∧ v = fun i => if i = i0 then e else 0

/-- `s = v · x`. -/
def sx (v x : Fin n → ℝ) : ℝ := ∑ i, v i * x i

/-- The point of the slice `s` at the direction of `g`: `s v + √(1 − s²) w`, `w = perpDir v g`. -/
noncomputable def slicePt (v : Fin n → ℝ) (s : ℝ) (g : Fin n → ℝ) : Fin n → ℝ :=
  s • v + Real.sqrt (1 - s ^ 2) • perpDir v g

/-- `Σ w_i⁴`. -/
def p4 (w : Fin n → ℝ) : ℝ := ∑ i, w i ^ 4

/-- `Σ w_i⁶`. -/
def p6 (w : Fin n → ℝ) : ℝ := ∑ i, w i ^ 6

end slices

/-- The residual kernel on the slice `s`, for a coordinate vector:
`k = 5/3 − s² − (2/3) s⁶ + ρ⁴ σ₄ + ρ⁶ σ₆/3`, `ρ² = 1 − s²`. -/
noncomputable def kS (s σ4 σ6 : ℝ) : ℝ :=
  5 / 3 - s ^ 2 - 2 / 3 * s ^ 6 + (1 - s ^ 2) ^ 2 * σ4 + (1 - s ^ 2) ^ 3 * σ6 / 3

/-- `k_low(q) = (1 − q)(10 + 4q + q²)/6`, `q = s²`. -/
noncomputable def klow (q : ℝ) : ℝ := (1 - q) * (10 + 4 * q + q ^ 2) / 6

/-- `γ₃ = 1 + 3/(m + 2)`. -/
noncomputable def gam3 (m : ℕ) : ℝ := 1 + 3 / ((m : ℝ) + 2)

/-- **Slice resampling** for `D_{t,v}`: the direction inside the slice is uniform and independent
of the slice. -/
def SliceRes93 (m : ℕ) : Prop :=
  ∀ (t : ℝ) (v : Fin (m + 1) → ℝ), UnitV v →
    ∀ h : (Fin (m + 1) → ℝ) → ℝ≥0∞, Measurable h →
      ∫⁻ x, h x ∂lawRK (m + 1) t v =
        ∫⁻ x, ∫⁻ g, h (slicePt v (sx v x) g) ∂stdGauss (Fin (m + 1)) ∂lawRK (m + 1) t v

/-- **Facts of a coordinate vector**: the anchor features are `s^j`; the residual kernel on a slice
is `kS`; the direction `perpDir v g` is almost surely a unit vector; `v · slicePt = s`. -/
def CoordFacts93 (m : ℕ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, CoordV v →
    UnitV v ∧
    (∀ (t : ℝ) (E : JR (m + 1) 3 → Mono (m + 1) 3 → ℝ) (x : Fin (m + 1) → ℝ) (j : Fin (3 + 1)),
      (modRK m 3 t v E).b x j = sx v x ^ (j : ℕ)) ∧
    (∀ᵐ g ∂stdGauss (Fin (m + 1)), ∑ i, perpDir v g i ^ 2 = 1) ∧
    (∀ (s : ℝ) (g : Fin (m + 1) → ℝ), s ^ 2 ≤ 1 → ∑ i, perpDir v g i ^ 2 = 1 →
      sx v (slicePt v s g) = s ∧ ∑ i, slicePt v s g i ^ 2 = 1 ∧
      tauR 3 v (slicePt v s g) = kS s (p4 (perpDir v g)) (p6 (perpDir v g)) ∧
      0 ≤ p4 (perpDir v g) ∧ p4 (perpDir v g) ≤ 1 ∧ 0 ≤ p6 (perpDir v g) ∧ p6 (perpDir v g) ≤ 1)

/-- **Lemma K, slice kernel moments** (coordinate `v`): for every coefficient vector `c` on the
monomials, on the slice `s` (`s² < 1`):
`E_w (c·ψ)² ≤ (γ₃/m)(0.6 + 1.8 s²) k_low(s²) ‖c‖²` and `E_w (c·ψ)⁴ ≤ (L4/m²) k_low(s²)² ‖c‖⁴`.
(`ψ` is the residual feature vector `residualFeature v x`.) -/
def LemK93 (m : ℕ) (L4 : ℝ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, CoordV v → ∀ s : ℝ, s ^ 2 < 1 → ∀ c : Mono (m + 1) 3 → ℝ,
    ∫ g, (∑ p, c p * residualFeature v (slicePt v s g) p) ^ 2 ∂stdGauss (Fin (m + 1)) ≤
      gam3 m / (m : ℝ) * (3 / 5 + 9 / 5 * s ^ 2) * klow (s ^ 2) * ∑ p, c p ^ 2 ∧
    ∫ g, (∑ p, c p * residualFeature v (slicePt v s g) p) ^ 4 ∂stdGauss (Fin (m + 1)) ≤
      L4 / (m : ℝ) ^ 2 * klow (s ^ 2) ^ 2 * (∑ p, c p ^ 2) ^ 2

/-! ## §2 The single-point functions `G` and `G̃` of the cubic -/

section gfun
variable {n : ℕ}

/-- `Φ₀ = f(μ) + k · tr H_μ`: the mean over `W` of `f(μ + r)`, `r ∼ N(0, k I)`. -/
def Phi93 (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (μ : Fin n → ℝ)
    (k : ℝ) : ℝ :=
  cfun f0 ℓ H T μ + k * trH (HU3 H T μ)

/-- `G̃(μ, k) = Var f(μ + r) = k‖∇f(μ) + 3k b‖² + 2k²‖H_μ‖² + 6k³‖T‖²`. -/
def G93t (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (μ : Fin n → ℝ) (k : ℝ) : ℝ :=
  k * nsq (fun i => aU3 ℓ H T μ i + 3 * k * trT T i) + 2 * k ^ 2 * frobH (HU3 H T μ) +
    6 * k ^ 3 * frobT T

/-- `G(μ, k) = E (f(μ + r) − g₀)² = (Φ₀ − g₀)² + G̃`. -/
def G93 (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (g0 : ℝ)
    (μ : Fin n → ℝ) (k : ℝ) : ℝ :=
  (Phi93 f0 ℓ H T μ k - g0) ^ 2 + G93t ℓ H T μ k

/-- `|b|² ≤ ((n+2)/3) ‖T‖²` for a symmetric `T` (`b = trT T`). -/
def TraceT93 : Prop :=
  ∀ (n : ℕ) (T : T3 n), SymT T → nsq (trT T) ≤ ((n : ℝ) + 2) / 3 * frobT T

/-- **Lemma S** (logarithmic derivatives of `G` and `G̃`), in derivative form. For `k > 0`:
`|k ∂_k Γ| ≤ (3 + √(2n+4)) Γ` and `k (∂_e Γ)² ≤ 12 ‖e‖² Γ²` (`∂_e` the derivative in `μ` in the
direction `e`), for `Γ ∈ {G, G̃}`. -/
def LemS93 : Prop :=
  ∀ (n : ℕ) (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∀ T : T3 n, SymT T → ∀ (g0 : ℝ) (μ : Fin n → ℝ),
    Differentiable ℝ (fun κ : ℝ => G93 f0 ℓ H T g0 μ κ) ∧
    Differentiable ℝ (fun κ : ℝ => G93t ℓ H T μ κ) ∧
    (∀ (e : Fin n → ℝ) (k : ℝ),
      Differentiable ℝ (fun τ : ℝ => G93 f0 ℓ H T g0 (fun i => μ i + τ * e i) k) ∧
      Differentiable ℝ (fun τ : ℝ => G93t ℓ H T (fun i => μ i + τ * e i) k)) ∧
    ∀ k : ℝ, 0 < k →
      |k * deriv (fun κ : ℝ => G93 f0 ℓ H T g0 μ κ) k| ≤
        (3 + Real.sqrt (2 * (n : ℝ) + 4)) * G93 f0 ℓ H T g0 μ k ∧
      |k * deriv (fun κ : ℝ => G93t ℓ H T μ κ) k| ≤
        (3 + Real.sqrt (2 * (n : ℝ) + 4)) * G93t ℓ H T μ k ∧
      ∀ e : Fin n → ℝ,
        k * (deriv (fun τ : ℝ => G93 f0 ℓ H T g0 (fun i => μ i + τ * e i) k) 0) ^ 2 ≤
          12 * nsq e * G93 f0 ℓ H T g0 μ k ^ 2 ∧
        k * (deriv (fun τ : ℝ => G93t ℓ H T (fun i => μ i + τ * e i) k) 0) ^ 2 ≤
          12 * nsq e * G93t ℓ H T μ k ^ 2

/-- The mean field on the slice `s`, for a coordinate vector: `A₀ + s A₁ + s² A₂ + s³ A₃`. -/
def muS (A : Fin (3 + 1) → Fin n → ℝ) (s : ℝ) : Fin n → ℝ :=
  fun i => ∑ j : Fin (3 + 1), s ^ (j : ℕ) * A j i

/-- The bound of the logarithmic derivative in `s` of a slice mean:
`ℓ(r) = c_R (1 + 2r + 3r²)/√(1−r²) + 6 (3 + √(2n+4)) r/(1−r²)`, `c_R = 2 √1.8 R √n`. -/
noncomputable def ell93 (n : ℕ) (R r : ℝ) : ℝ :=
  2 * Real.sqrt (9 / 5) * R * Real.sqrt n * (1 + 2 * r + 3 * r ^ 2) / Real.sqrt (1 - r ^ 2) +
    6 * (3 + Real.sqrt (2 * (n : ℝ) + 4)) * r / (1 - r ^ 2)

/-- **Consequence (C)**: the slice means of `G` and `G̃` have a logarithmic derivative in `s` at
most `ℓ(|s|)`. The slice is abstract: a probability space `Ω` with two functions
`σ₄, σ₆ : Ω → [0, 1]`. The anchors `A₁, A₂, A₃` have norm `≤ R √n c`. -/
def LogDer93 (n : ℕ) (R : ℝ) : Prop :=
  ∀ (Ω : Type) [MeasurableSpace Ω] (γ : Measure Ω), IsProbabilityMeasure γ →
    ∀ σ4 σ6 : Ω → ℝ, Measurable σ4 → Measurable σ6 →
    (∀ ω, 0 ≤ σ4 ω ∧ σ4 ω ≤ 1) → (∀ ω, 0 ≤ σ6 ω ∧ σ6 ω ≤ 1) →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∀ T : T3 n, SymT T → ∀ (g0 : ℝ) (A : Fin (3 + 1) → Fin n → ℝ) (c : ℝ), 0 < c →
    (∀ j : Fin (3 + 1), j ≠ 0 → nsq (A j) ≤ R ^ 2 * (n : ℝ) * c ^ 2) →
    ∀ om : ℝ → ℝ,
      (om = (fun s => ∫ ω, G93 f0 ℓ H T g0 (muS A s) (c ^ 2 * kS s (σ4 ω) (σ6 ω)) ∂γ) ∨
       om = (fun s => ∫ ω, G93t ℓ H T (muS A s) (c ^ 2 * kS s (σ4 ω) (σ6 ω)) ∂γ)) →
      Continuous om ∧ (∀ s ∈ Set.Icc (-1 : ℝ) 1, 0 ≤ om s) ∧
      ∀ s ∈ Set.Ioo (-1 : ℝ) 1, DifferentiableAt ℝ om s ∧
        |deriv om s| ≤ ell93 n R |s| * om s

/-- `b = c_R = 2 √1.8 R √n`. -/
noncomputable def bT93 (n : ℕ) (R : ℝ) : ℝ := 2 * Real.sqrt (9 / 5) * R * Real.sqrt n

/-- `A = n/2 − 3 − 6 (3 + √(2n+4)) − 6 b`. -/
noncomputable def AT93 (n : ℕ) (R : ℝ) : ℝ :=
  (n : ℝ) / 2 - 3 - 6 * (3 + Real.sqrt (2 * (n : ℝ) + 4)) - 6 * bT93 n R

/-- `q̄ = (b/A)² + 1/A + 0.8 b/A^{3/2}`. -/
noncomputable def qbar93 (n : ℕ) (R : ℝ) : ℝ :=
  (bT93 n R / AT93 n R) ^ 2 + 1 / AT93 n R +
    4 / 5 * bT93 n R / (AT93 n R * Real.sqrt (AT93 n R))

/-- **Lemma T (tail lemma)**: for a weight `om(s) ≥ 0` with logarithmic derivative at most
`ℓ(|s|)`, under `D_{t,v}`, `0 ≤ t ≤ n/4`: `E[om(s) s²] ≤ q̄ E[om(s)]`. -/
def LemT93 (n : ℕ) (R : ℝ) : Prop :=
  0 < AT93 n R → ∀ t : ℝ, 0 ≤ t → t ≤ (n : ℝ) / 4 → ∀ v : Fin n → ℝ, UnitV v →
    ∀ om : ℝ → ℝ, Continuous om → (∀ s ∈ Set.Icc (-1 : ℝ) 1, 0 ≤ om s) →
      (∀ s ∈ Set.Ioo (-1 : ℝ) 1, DifferentiableAt ℝ om s ∧
        |deriv om s| ≤ ell93 n R |s| * om s) →
      ∫ x, om (sx v x) * sx v x ^ 2 ∂lawRK n t v ≤ qbar93 n R * ∫ x, om (sx v x) ∂lawRK n t v

/-- **Lemma Q (slice ratio)**: on every slice of a coordinate vector, for a fixed mean `μ`:
`E_w G(μ, k)² ≤ (1 + η) (E_w G(μ, k))²`. -/
def LemQ93 (m : ℕ) (η : ℝ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, CoordV v → ∀ s : ℝ, s ^ 2 < 1 →
    ∀ (f0 : ℝ) (ℓ : Fin (m + 1) → ℝ) (H : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ), H.IsSymm →
    ∀ T : T3 (m + 1), SymT T → ∀ (g0 : ℝ) (μ : Fin (m + 1) → ℝ) (c : ℝ), 0 < c →
      ∫ g, G93 f0 ℓ H T g0 μ (c ^ 2 * kS s (p4 (perpDir v g)) (p6 (perpDir v g))) ^ 2
          ∂stdGauss (Fin (m + 1)) ≤
        (1 + η) * (∫ g, G93 f0 ℓ H T g0 μ (c ^ 2 * kS s (p4 (perpDir v g)) (p6 (perpDir v g)))
          ∂stdGauss (Fin (m + 1))) ^ 2

end gfun

/-! ## §3 Chaos calculus without tensors (the definitions of `Part92Defs`, copied) -/

section chaos

/-- `E P(z)`, `z` standard Gaussian. -/
noncomputable def EG93 {ι : Type} [Fintype ι] (P : MvPolynomial ι ℝ) : ℝ :=
  ∫ z, MvPolynomial.eval z P ∂stdGauss ι

/-- `Tn93 c P Q = Σ_{s ∈ ι^c} E[∂_s P] E[∂_s Q]`. -/
noncomputable def Tn93 {ι : Type} [Fintype ι] :
    ℕ → MvPolynomial ι ℝ → MvPolynomial ι ℝ → ℝ
  | 0, P, Q => EG93 P * EG93 Q
  | c + 1, P, Q => ∑ i, Tn93 c (MvPolynomial.pderiv i P) (MvPolynomial.pderiv i Q)

/-- **Basic facts of `Tn93`**: positivity, Cauchy–Schwarz, and vanishing above the degree. -/
def TnFacts93 : Prop :=
  ∀ (ι : Type) [Fintype ι] (c : ℕ) (P Q : MvPolynomial ι ℝ),
    0 ≤ Tn93 c P P ∧ Tn93 c P Q ^ 2 ≤ Tn93 c P P * Tn93 c Q Q ∧
      (P.totalDegree < c → Tn93 c P Q = 0)

/-- **Parseval (bilinear form)**: `E[P Q] = Σ_{c ≤ D} Tn93 c P Q / c!` for `deg P ≤ D`. -/
def Parseval93 : Prop :=
  ∀ (ι : Type) [Fintype ι] (D : ℕ) (P Q : MvPolynomial ι ℝ), P.totalDegree ≤ D →
    EG93 (P * Q) = ∑ c ∈ Finset.range (D + 1), Tn93 c P Q / (c.factorial : ℝ)

/-- **The chaos energies of the square of a cubic Gaussian polynomial**, in three groups of
orders: `{1,2}`, `{3,5}`, `{4,6}` (true suprema `25.649…`, `30.648…`, `79.881…`). -/
def ChaosSq93 (C12 C35 C46 : ℝ) : Prop :=
  ∀ (ι : Type) [Fintype ι] (Y : MvPolynomial ι ℝ), Y.totalDegree ≤ 3 →
    Tn93 1 (Y * Y) (Y * Y) + Tn93 2 (Y * Y) (Y * Y) / 2 ≤ C12 * EG93 (Y * Y) ^ 2 ∧
    Tn93 3 (Y * Y) (Y * Y) / 6 + Tn93 5 (Y * Y) (Y * Y) / 120 ≤ C35 * EG93 (Y * Y) ^ 2 ∧
    Tn93 4 (Y * Y) (Y * Y) / 24 + Tn93 6 (Y * Y) (Y * Y) / 720 ≤ C46 * EG93 (Y * Y) ^ 2

variable {n : ℕ} {J : Type} [Fintype J]

/-- `z_i` as a polynomial in `W`: `Σ_q p_q X_{(q,i)}`. -/
noncomputable def ZpG (p : J → ℝ) (i : Fin n) : MvPolynomial (J × Fin n) ℝ :=
  ∑ q : J, MvPolynomial.C (p q) * MvPolynomial.X (q, i)

/-- `Φ(z)` as a polynomial in `W`, `z = zv W p`. -/
noncomputable def subG (p : J → ℝ) (Φ : MvPolynomial (Fin n) ℝ) : MvPolynomial (J × Fin n) ℝ :=
  MvPolynomial.bind₁ (ZpG p) Φ

/-- `E Φ(√k ξ)`, `ξ` standard Gaussian in `ℝⁿ`. -/
noncomputable def EGk (k : ℝ) (Φ : MvPolynomial (Fin n) ℝ) : ℝ :=
  ∫ ξ, MvPolynomial.eval (fun i => Real.sqrt k * ξ i) Φ ∂stdGauss (Fin n)

/-- `TnK c k k' Φ Ψ = Σ_{i ∈ [n]^c} E[∂_i Φ(√k ξ)] E[∂_i Ψ(√k' ξ)]`. -/
noncomputable def TnK : ℕ → ℝ → ℝ → MvPolynomial (Fin n) ℝ → MvPolynomial (Fin n) ℝ → ℝ
  | 0, k, k', Φ, Ψ => EGk k Φ * EGk k' Ψ
  | c + 1, k, k', Φ, Ψ => ∑ i, TnK c k k' (MvPolynomial.pderiv i Φ) (MvPolynomial.pderiv i Ψ)

/-- **The chain rule for the chaos forms**: for two feature vectors `p, p'`,
`Tn93 c (Φ(W p)) (Ψ(W p')) = (p·p')^c · TnK c ‖p‖² ‖p'‖² Φ Ψ`; Cauchy–Schwarz for `TnK`. -/
def Chain93 : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (p p' : J → ℝ) (Φ Ψ : MvPolynomial (Fin n) ℝ),
    (∀ W : J × Fin n → ℝ, MvPolynomial.eval W (subG p Φ) = MvPolynomial.eval (zv W p) Φ) ∧
    (subG p Φ).totalDegree ≤ Φ.totalDegree ∧
    subG p (Φ * Ψ) = subG p Φ * subG p Ψ ∧
    EG93 (subG p Φ) = EGk (∑ q, p q ^ 2) Φ ∧
    ∀ c : ℕ,
      Tn93 c (subG p Φ) (subG p' Ψ) =
        (∑ q, p q * p' q) ^ c * TnK c (∑ q, p q ^ 2) (∑ q, p' q ^ 2) Φ Ψ ∧
      (∀ k k' : ℝ, 0 ≤ k → 0 ≤ k' →
        0 ≤ TnK c k k Φ Φ ∧ TnK c k k' Φ Ψ ^ 2 ≤ TnK c k k Φ Φ * TnK c k' k' Ψ Ψ)

end chaos

/-! ## §4 The Gaussian model given the anchors: outputs -/

section gauss
variable {n : ℕ} {J : Type} [Fintype J]

/-- `B(W) = E_x F_W(x)`. -/
noncomputable def Bf93 (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ) : ℝ := ∫ x, FC f0 ℓ H T mu ψ W x ∂ν

/-- `Φ(x) = E_W F_W(x)`. -/
noncomputable def Ph93 (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (x : Fin n → ℝ) : ℝ :=
  ∫ W, FC f0 ℓ H T mu ψ W x ∂stdGauss (J × Fin n)

/-- `g = E_x Φ(x)`: the output of the line program (with the exact distribution). -/
noncomputable def g93 (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) : ℝ := ∫ x, Ph93 f0 ℓ H T mu ψ x ∂ν

/-- `V₁(W) = E_x (F_W(x) − g)²`. -/
noncomputable def V1f93 (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ) : ℝ :=
  ∫ x, (FC f0 ℓ H T mu ψ W x - g93 ν f0 ℓ H T mu ψ) ^ 2 ∂ν

/-- `Q₁ = E_W V₁`. -/
noncomputable def Q193 (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) : ℝ := ∫ W, V1f93 ν f0 ℓ H T mu ψ W ∂stdGauss (J × Fin n)

/-- **The error part of the Gaussian model** (Theorem E and the floor): with `V̄ = YbC`,
`E_W (B − g)² ≤ Λ* E_x w`, `(1 − Λ*) E_x w ≤ V̄`, `Var_x Φ ≤ V̄`, `V̄ ≤ Q₁`. -/
structure GaussOutE93 (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) (Lst : ℝ) : Prop where
  intW : Integrable (wC ℓ H T mu ψ) ν
  intE : Integrable (fun W => (Bf93 ν f0 ℓ H T mu ψ W - g93 ν f0 ℓ H T mu ψ) ^ 2)
    (stdGauss (J × Fin n))
  bndE : ∫ W, (Bf93 ν f0 ℓ H T mu ψ W - g93 ν f0 ℓ H T mu ψ) ^ 2 ∂stdGauss (J × Fin n) ≤
    Lst * ∫ x, wC ℓ H T mu ψ x ∂ν
  floor : (1 - Lst) * ∫ x, wC ℓ H T mu ψ x ∂ν ≤ YbC ν f0 ℓ H T mu ψ
  surr : varU ν (Ph93 f0 ℓ H T mu ψ) ≤ YbC ν f0 ℓ H T mu ψ
  qge : YbC ν f0 ℓ H T mu ψ ≤ Q193 ν f0 ℓ H T mu ψ
  intV1 : Integrable (V1f93 ν f0 ℓ H T mu ψ) (stdGauss (J × Fin n))
  v1eq : ∀ W, YC ν f0 ℓ H T mu ψ W =
    V1f93 ν f0 ℓ H T mu ψ W - (Bf93 ν f0 ℓ H T mu ψ W - g93 ν f0 ℓ H T mu ψ) ^ 2

/-- **The variance part of the Gaussian model** (Theorem V):
`E_W (V₁ − Q₁)² ≤ cVn · Q₁²`. -/
structure GaussOutV93 (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) (cVn : ℝ) : Prop where
  intV : Integrable (fun W => (V1f93 ν f0 ℓ H T mu ψ W - Q193 ν f0 ℓ H T mu ψ) ^ 2)
    (stdGauss (J × Fin n))
  bndV : ∫ W, (V1f93 ν f0 ℓ H T mu ψ W - Q193 ν f0 ℓ H T mu ψ) ^ 2 ∂stdGauss (J × Fin n) ≤
    cVn * Q193 ν f0 ℓ H T mu ψ ^ 2

end gauss

/-- `Λ* = (γ₃/m)(0.6 + 1.8 q̄(n))`, `n = m + 1`. -/
noncomputable def Lst93 (m : ℕ) (R : ℝ) : ℝ :=
  gam3 m / (m : ℝ) * (3 / 5 + 9 / 5 * qbar93 (m + 1) R)

/-- `c_V/n = (C12 Λ* + C35 √(Λ* L4/m²) + C46 L4/m²)(1 + η)`. -/
noncomputable def cVn93 (m : ℕ) (R L4 η C12 C35 C46 : ℝ) : ℝ :=
  (C12 * Lst93 m R + C35 * Real.sqrt (Lst93 m R * (L4 / (m : ℝ) ^ 2)) +
    C46 * (L4 / (m : ℝ) ^ 2)) * (1 + η)

/-- **Theorem E for coordinate tilts**, in dimension `m + 1`: for `0 ≤ t ≤ n/4`, `v = ±e_i`, a
cubic with `T ≠ 0`, anchors with `‖A_j‖ ≤ R √n c` (`j = 1, 2, 3`). -/
def GaussE93 (m : ℕ) (R Lst : ℝ) : Prop :=
  ∀ t : ℝ, 0 ≤ t → t ≤ ((m + 1 : ℕ) : ℝ) / 4 → ∀ v : Fin (m + 1) → ℝ, CoordV v →
    ∀ E : JR (m + 1) 3 → Mono (m + 1) 3 → ℝ, RotE v E →
    ∀ (f0 : ℝ) (ℓ : Fin (m + 1) → ℝ) (H : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ), H.IsSymm →
    ∀ T : T3 (m + 1), SymT T → 0 < frobT T →
    ∀ (A : Fin (3 + 1) → Fin (m + 1) → ℝ) (c : ℝ), 0 < c →
      (∀ j : Fin (3 + 1), j ≠ 0 → nsq (A j) ≤ R ^ 2 * ((m + 1 : ℕ) : ℝ) * c ^ 2) →
      GaussOutE93 (lawRK (m + 1) t v) f0 ℓ H T (muM (modRK m 3 t v E) A)
        (psM (modRK m 3 t v E) c) Lst

/-- **Theorem V for coordinate tilts**, same class. -/
def GaussV93 (m : ℕ) (R cVn : ℝ) : Prop :=
  ∀ t : ℝ, 0 ≤ t → t ≤ ((m + 1 : ℕ) : ℝ) / 4 → ∀ v : Fin (m + 1) → ℝ, CoordV v →
    ∀ E : JR (m + 1) 3 → Mono (m + 1) 3 → ℝ, RotE v E →
    ∀ (f0 : ℝ) (ℓ : Fin (m + 1) → ℝ) (H : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ), H.IsSymm →
    ∀ T : T3 (m + 1), SymT T → 0 < frobT T →
    ∀ (A : Fin (3 + 1) → Fin (m + 1) → ℝ) (c : ℝ), 0 < c →
      (∀ j : Fin (3 + 1), j ≠ 0 → nsq (A j) ≤ R ^ 2 * ((m + 1 : ℕ) : ℝ) * c ^ 2) →
      GaussOutV93 (lawRK (m + 1) t v) f0 ℓ H T (muM (modRK m 3 t v E) A)
        (psM (modRK m 3 t v E) c) cVn

/-! ## §5 The sphere transfer -/

section transfer
variable {n : ℕ} {J : Type} [Fintype J]

/-- `D₁ = r · ∇f(μ + r)`, `r = W ψ(x)`. -/
def D193 (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ)
    (x : Fin n → ℝ) : ℝ :=
  ∑ i, zv W (ψ x) i * aU3 ℓ H T (fun l => mu x l + zv W (ψ x) l) i

/-- `D₂ = ½ rᵀ ∇²f(μ + r) r = rᵀ H_{μ+r} r`. -/
def D293 (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ)
    (x : Fin n → ℝ) : ℝ :=
  ∑ i, ∑ j, HU3 H T (fun l => mu x l + zv W (ψ x) l) i j * zv W (ψ x) i * zv W (ψ x) j

/-- `D₃ = T[r, r, r]`. -/
def D393 (T : T3 n) (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  ∑ i, ∑ j, ∑ k, T i j k * zv W (ψ x) i * zv W (ψ x) j * zv W (ψ x) k

/-- `F` with the residual multiplied by `σ`: `f(mu x + σ · W ψ(x))`. -/
def FCs (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (σ : ℝ) (W : J × Fin n → ℝ)
    (x : Fin n → ℝ) : ℝ :=
  cfun f0 ℓ H T (fun i => mu x i + σ * zv W (ψ x) i)

end transfer

/-- **Lemma P** (the perturbation lemma): the exact Taylor formula in `σ`, and
`E_W D_i² ≤ K_i² · Var_W F_x`, `K₁ = 3 + √(2n+4)`, `K₂² = 4.5 n + 18`, `K₃² = (n+4)/2`. -/
def LemP93 : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ),
    H.IsSymm → ∀ T : T3 n, SymT T →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) (x : Fin n → ℝ),
      (∀ (σ : ℝ) (W : J × Fin n → ℝ),
        FCs f0 ℓ H T mu ψ σ W x = FC f0 ℓ H T mu ψ W x + (σ - 1) * D193 ℓ H T mu ψ W x +
          (σ - 1) ^ 2 * D293 H T mu ψ W x + (σ - 1) ^ 3 * D393 T ψ W x) ∧
      Integrable (fun W => D193 ℓ H T mu ψ W x ^ 2) (stdGauss (J × Fin n)) ∧
      Integrable (fun W => D293 H T mu ψ W x ^ 2) (stdGauss (J × Fin n)) ∧
      Integrable (fun W => D393 T ψ W x ^ 2) (stdGauss (J × Fin n)) ∧
      ∫ W, D193 ℓ H T mu ψ W x ^ 2 ∂stdGauss (J × Fin n) ≤
        (3 + Real.sqrt (2 * (n : ℝ) + 4)) ^ 2 * wC ℓ H T mu ψ x ∧
      ∫ W, D293 H T mu ψ W x ^ 2 ∂stdGauss (J × Fin n) ≤
        (9 / 2 * (n : ℝ) + 18) * wC ℓ H T mu ψ x ∧
      ∫ W, D393 T ψ W x ^ 2 ∂stdGauss (J × Fin n) ≤ (((n : ℝ) + 4) / 2) * wC ℓ H T mu ψ x

/-- The transfer constant `K_T(ζ) = ζ K₁ + ζ² K₂ + ζ³ K₃`. -/
noncomputable def KT93 (n : ℕ) (ζ : ℝ) : ℝ :=
  ζ * (3 + Real.sqrt (2 * (n : ℝ) + 4)) + ζ ^ 2 * Real.sqrt (9 / 2 * (n : ℝ) + 18) +
    ζ ^ 3 * Real.sqrt (((n : ℝ) + 4) / 2)

/-- **The sphere step, abstract form.** From the Gaussian model (`GaussOutE93`, `GaussOutV93`), a
scalar field `σ(W)` with `Pr(|σ − 1| > ζ) ≤ p3`, a program value `gq` with
`(gq − g)² ≤ ηQ² Var_x Φ`, and the condition (D_S)
`√δ + ηQ + ηT ≤ ε (√(κ − δ) − ηT)`:
the probability of `ε² Var_x F^σ < (E_x F^σ − gq)²` is at most
`c1n/δ + cVn/(1−κ)² + K_T(ζ)²/(ηT² (1 − Λ*)) + p3`, with `c1n = Λ*/(1 − Λ*)`. -/
def SphereStep93 : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
    ∀ (Lst cVn : ℝ), 0 ≤ Lst → Lst < 1 → 0 ≤ cVn →
      GaussOutE93 ν f0 ℓ H T mu ψ Lst → GaussOutV93 ν f0 ℓ H T mu ψ cVn →
    ∀ (σ : (J × Fin n → ℝ) → ℝ), Measurable σ → ∀ (ζ p3 : ℝ), 0 ≤ ζ → 0 ≤ p3 →
      stdGauss (J × Fin n) {W | ζ < |σ W - 1|} ≤ ENNReal.ofReal p3 →
    ∀ (gq ηQ : ℝ), 0 ≤ ηQ →
      (gq - g93 ν f0 ℓ H T mu ψ) ^ 2 ≤ ηQ ^ 2 * varU ν (Ph93 f0 ℓ H T mu ψ) →
    ∀ (ε κ δ ηT : ℝ), 0 < ε → 0 < δ → δ < κ → κ < 1 → 0 < ηT → ηT ≤ Real.sqrt (κ - δ) →
      Real.sqrt δ + ηQ + ηT ≤ ε * (Real.sqrt (κ - δ) - ηT) →
      stdGauss (J × Fin n)
          {W | ε ^ 2 * varU ν (FCs f0 ℓ H T mu ψ (σ W) W) <
            (∫ x, FCs f0 ℓ H T mu ψ (σ W) W x ∂ν - gq) ^ 2} ≤
        ENNReal.ofReal (Lst / (1 - Lst) / δ + cVn / (1 - κ) ^ 2 +
          KT93 n ζ ^ 2 / (ηT ^ 2 * (1 - Lst)) + p3)

/-! ## §6 Chi-square tails (Chernoff) -/

/-- **Upper tail**: `Pr(‖Z‖² ≥ (1 + x) d) ≤ exp(−d (x − ln(1 + x))/2)`, `d` the dimension. -/
def ChiUp93 : Prop :=
  ∀ (ι : Type) [Fintype ι] (x : ℝ), 0 < x →
    stdGauss ι {Z | (1 + x) * (Fintype.card ι : ℝ) ≤ ∑ i, Z i ^ 2} ≤
      ENNReal.ofReal (Real.exp (-((Fintype.card ι : ℝ) * (x - Real.log (1 + x)) / 2)))

/-- **Lower tail**: `Pr(‖Z‖² ≤ (1 − x) d) ≤ exp(−d (−x − ln(1 − x))/2)`, `0 < x < 1`. -/
def ChiLo93 : Prop :=
  ∀ (ι : Type) [Fintype ι] (x : ℝ), 0 < x → x < 1 →
    stdGauss ι {Z | ∑ i, Z i ^ 2 ≤ (1 - x) * (Fintype.card ι : ℝ)} ≤
      ENNReal.ofReal (Real.exp (-((Fintype.card ι : ℝ) * (-x - Real.log (1 - x)) / 2)))

/-! ## §7 The failure set at accuracy `ε`, and the polar reduction -/

section polar
variable {n : ℕ} {I J S G : Type} [Fintype I] [Fintype J] [MeasurableSpace S] [MeasurableSpace G]

/-- The failure set of Theorem 1 on the coefficient sphere, at accuracy `ε`. -/
def SphereFail93 (n d k K : ℕ) (ε t : ℝ) (v : Fin n → ℝ) (f0 : ℝ) (T : Tens n) :
    Set (CoefIdxD n d → ℝ) :=
  {Z | Z ≠ 0 ∧ ε ^ 2 * varFQ (lawRK n t v) k f0 T (unitOfD Z) <
    (BofQ (lawRK n t v) k f0 T (unitOfD Z) -
      gLineW (surrRK n K t v) k f0 T v (unitOfD Z)) ^ 2}

/-- The failure set over the direction of `W`, at accuracy `ε`. -/
def badSet93 (M : Mod n I J S G) (gq : MvPolynomial (I ⊕ Fin n) ℝ → ℝ)
    (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam ε : ℝ) : Set (J × Fin n → ℝ) :=
  {W | ε ^ 2 * Vm M P lam (Real.sqrt (DWr n J) • unitF53 W) <
    (Bm M P lam (Real.sqrt (DWr n J) • unitF53 W) - gq P) ^ 2}

end polar

/-- **Polar reduction at accuracy `ε`** (`PolarRed86` with `ε` in place of `1/2`). -/
def PolarRed93 (m d k K : ℕ) (ε : ℝ) : Prop :=
  ∀ (t : ℝ) (v : Fin (m + 1) → ℝ), 0 ≤ t → UnitV v →
    ∀ E : JR (m + 1) d → Mono (m + 1) d → ℝ, RotE v E →
    ∀ (f0 : ℝ) (T : Tens (m + 1)), TSymm k T →
      stdGauss (CoefIdxD (m + 1) d) (SphereFail93 (m + 1) d k K ε t v f0 T) ≤
        ∫⁻ U : Fin (d + 1) × Fin (m + 1) → ℝ, ∫⁻ W' : JR (m + 1) d × Fin (m + 1) → ℝ,
          stdGauss (JR (m + 1) d × Fin (m + 1))
            (badSet93 (modRK m d t v E) (gqRK m d K t v E)
              (PU k f0 T U (Real.sqrt (∑ a, U a ^ 2 + radF53 W' ^ 2))
                (1 / Real.sqrt (DD (m + 1) d)))
              (lam0 (DD (m + 1) d) (DWr (m + 1) (JR (m + 1) d)) U (radF53 W')) ε)
          ∂stdGauss (JR (m + 1) d × Fin (m + 1))
          ∂stdGauss (Fin (d + 1) × Fin (m + 1))

end BstLean.Part93
