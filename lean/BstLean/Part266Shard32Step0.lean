/-! The ordinary operator events supply the pointwise variance guard. -/
namespace BstLean.Part266.Row13150
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part130 BstLean.Part153 BstLean.Part157 BstLean.Part160 BstLean.Part169

theorem first_matrix_row (c : Ret 13150) (hc : A1 c ∈ Eop 13150) : OpB (A1 c) 166 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (13150 : ℝ)) ≤ (38539151 / 3125000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(13150 : ℝ) ≤ (2293469 / 20000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (13150 : ℝ) + 2 * √13150 ≤ (133793469 / 10000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 13150) (hc : c ∈ BstLean.Part164.Eop2 13150) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 13150 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 13150) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 13150 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 13150) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 13150).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 13150) (FirstMatrix 13150))
    (h2 : c ∈ BstLean.Part164.Eop2 13150) (a : BstLean.Part161.Ix 13150) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

end BstLean.Part266.Row13150

