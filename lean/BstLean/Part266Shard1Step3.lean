      ∫ w, sA (paperDesignP 12391) c a w ∂stdGauss (Fin (12391 - 1))) ^ 2
      ∂stdGauss (Fin (12391 - 1))) ^ 2 ∂muI 12391 ≤ scaleVarianceBudget ^ 2 :=
