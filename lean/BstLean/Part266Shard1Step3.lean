      ∫ w, sA (paperDesignP 12387) c a w ∂stdGauss (Fin (12387 - 1))) ^ 2
      ∂stdGauss (Fin (12387 - 1))) ^ 2 ∂muI 12387 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12387) c
