theorem removal_of_low_mass {c : Ret 12378}
    (hw : WINDOW (paperDesignP 12378) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12378 - 1))).real
      {v | sgA (paperDesignP 12378) c a v < √(2 / (12378 : ℝ) * mixtureFloor)}
      ∂muI 12378 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12378 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12378 ≤
