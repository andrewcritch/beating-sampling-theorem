      ∫ w, sA (paperDesignP 12376) c a w ∂stdGauss (Fin (12376 - 1))) ^ 2
      ∂stdGauss (Fin (12376 - 1))) ^ 2 ∂muI 12376 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12376) c
