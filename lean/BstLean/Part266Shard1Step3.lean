noncomputable def fullResidualBudget : ℝ := √(2 / (12389 : ℝ)) * locationNorm

theorem residual_sq_le_energy (c : Ret 12389)
    (p : Ix 12389 × (Fin (12389 - 1) → ℝ)) :
    sgA (paperDesignP 12389) c p.1 p.2 ^ 2 ≤
      (2 / (12389 : ℝ)) * wLatitude c p := by
