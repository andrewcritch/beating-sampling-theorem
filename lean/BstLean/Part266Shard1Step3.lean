theorem removal_of_low_mass {c : Ret 12389}
    (hw : WINDOW (paperDesignP 12389) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12389 - 1))).real
