open BstLean.Part169 BstLean.Part242

noncomputable def fullResidualBudget : ℝ := √(2 / (12375 : ℝ)) * locationNorm

theorem residual_sq_le_energy (c : Ret 12375)
    (p : Ix 12375 × (Fin (12375 - 1) → ℝ)) :
    sgA (paperDesignP 12375) c p.1 p.2 ^ 2 ≤
      (2 / (12375 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12375).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12375) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12375 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12375 : ℝ) * _ ≤ 2 / 12375 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12375)
  norm_num [mA]
  linarith

theorem full_residual_eighth {c : Ret 12375}
    (hw : WINDOW (paperDesignP 12375) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12375) c a v ^ 8
      ∂stdGauss (Fin (12375 - 1)) ∂muI 12375 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12375).prod (stdGauss (Fin (12375 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12375) c (hc.1.1.1.1 hw.2.1)
  have h32 := energy_latitude_norm (by norm_num) c hw.1 hw.2.1 hE
  have h8 : LBound μ 8 (fun p => |√(wLatitude c p) - 1|)
      (BstLean.Part222.energyAllowance 12375) :=
    h32.lower (by norm_num) (by norm_num) (by norm_num) (by simp [μ])
  have h1 : LBound μ 8 (fun _ => (1 : ℝ)) 1 :=
    LBound.const (by norm_num : (8 : ℕ) ≠ 0) (by simp [μ]) (by norm_num)
  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (12375 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 12375) c p.1 p.2)
      (√(2 / (12375 : ℝ)) * (1 + BstLean.Part222.energyAllowance 12375)) := by
    apply hn.mono (measurable_sgA _ c)
    apply Filter.Eventually.of_forall
    intro p
    rw [abs_of_nonneg (sgA_nonneg _ _ _ _), abs_of_nonneg (by positivity)]
    have hh := sqrt_le_sqrt (residual_sq_le_energy c p)
    rw [sqrt_sq_eq_abs, abs_of_nonneg (sgA_nonneg _ _ _ _), sqrt_mul (by norm_num)] at hh
    have ht := mul_le_mul_of_nonneg_left (le_abs_self (√(wLatitude c p) - 1))
      (sqrt_nonneg (2 / (12375 : ℝ)))
    nlinarith
  have hs' : LBound μ 8 (fun p => sgA (paperDesignP 12375) c p.1 p.2) fullResidualBudget := by
    refine ⟨hs.measurable, by unfold fullResidualBudget locationNorm; positivity,
      hs.bound.trans (ENNReal.ofReal_le_ofReal ?_)⟩
    apply mul_le_mul_of_nonneg_left _ (sqrt_nonneg _)
    have he := energy_allowance_row
    unfold locationNorm
    linarith
  have hp := (hs'.toMoment (by norm_num : (8 : ℕ) ≠ 0)).power (k := 2) (r := 4)
  have hh := (LBound.ofMoment (by norm_num : (2 : ℕ) ≠ 0) hp).squareIntegral
  simp only [← pow_mul] at hh
  rw [integral_prod _ hh.1] at hh
  exact hh.2

noncomputable def scaleVarianceBudget : ℝ :=
  4 * residualMomentBudget 4 ^ 2 * fullResidualBudget ^ 2

theorem scale_variance_on_event {c : Ret 12375}
    (hw : WINDOW (paperDesignP 12375) c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (sA (paperDesignP 12375) c a v -
      ∫ w, sA (paperDesignP 12375) c a w ∂stdGauss (Fin (12375 - 1))) ^ 2
      ∂stdGauss (Fin (12375 - 1))) ^ 2 ∂muI 12375 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12375) c
    (residualMomentBudget_pos (by norm_num : 4 ≤ 12)).le
    (by unfold fullResidualBudget locationNorm; positivity)
    (residual_moment_on_event hw hc (by norm_num : 1 ≤ 4) (by norm_num))
    (full_residual_eighth hw hc)

end BstLean.Part266.Row12375

/-! The sharp residual-mass interface supplies the low-mass input of the chosen split. -/
namespace BstLean.Part266.Row12375
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part29 (stdGauss)
open BstLean.Part130 BstLean.Part134 BstLean.Part157 BstLean.Part160 BstLean.Part161
open BstLean.Part162 BstLean.Part169 BstLean.Part188 BstLean.Part222

theorem low_mass_of_interfaces {c : Ret 12375}
    (hw : WINDOW (paperDesignP 12375) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12375).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12375) c M H xi)
    (hE : centreEnergy (paperDesignP 12375) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12375 : ℝ))))
    (hprice : massBound 12375 M H xi E u mixtureFloor ≤ 12375 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12375 - 1))).real
      {v | sgA (paperDesignP 12375) c a v < √(2 / (12375 : ℝ) * mixtureFloor)}
        ∂muI 12375 ≤ lowMassBudget := by
  have hb : 0 < normSq ((paperDesignP 12375).bA c.1 c.2.1.1) := by
    change 0 < normSq (bR c)
    unfold eR at he
    exact (div_pos_iff.mp he).elim (fun h => h.1) (fun h => by norm_num at h)
  have hm := sharp_residual_mass (by norm_num) (paperDesignP 12375) c hw.2.1 hb hb0
    hI hE hu hu1 hd hg
  have hl := latitude_mass_of_MASS (by norm_num) (paperDesignP 12375) c hw.1 hw.2.1
    (by norm_num [mixtureFloor]) hm
  exact hl.trans ((div_le_div_of_nonneg_right hprice (by norm_num : (0 : ℝ) ≤ 12375)).trans
    (by ring_nf; exact le_rfl))

end BstLean.Part266.Row12375

