theorem removal_of_low_mass {c : Ret 12384}
    (hw : WINDOW (paperDesignP 12384) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12384 - 1))).real
