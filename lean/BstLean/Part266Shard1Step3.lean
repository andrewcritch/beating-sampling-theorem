theorem removal_of_low_mass {c : Ret 12382}
    (hw : WINDOW (paperDesignP 12382) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12382 - 1))).real
      {v | sgA (paperDesignP 12382) c a v < √(2 / (12382 : ℝ) * mixtureFloor)}
      ∂muI 12382 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12382 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12382 ≤
        removalBudget := by
