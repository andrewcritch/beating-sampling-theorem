theorem variance_budgets_row {c : Ret 12394} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (34728089 / 1000000000000000) ∧ residualVarianceBudget ≤ (336241 / 100000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
  have hce : latitudeC / eR c ≤ 16 / 3 := by
    rw [div_le_iff₀ (by linarith : 0 < eR c)]
