def passEvent : Set (Ret 12850) :=
  agentEv (paperDesignP 12850) (Energy32 12850) ∩
  agentEv (paperDesignP 12850) (freshRetainedEvent160 12850 4) ∩
  agentEv (paperDesignP 12850) (FirstMatrix 12850) ∩
  BstLean.Part164.Eop2 12850 ∩ outputCentreEvent (paperCentres 12850)

theorem passEvent_measurable : MeasurableSet passEvent :=
  ((((measurableSet_agentEv _ (measurableSet_Energy32 _)).inter
    (measurableSet_agentEv _ (measurableSet_freshRetainedEvent160 _ _))).inter
    (measurableSet_agentEv _ (firstMatrix_measurable _))).inter
    (BstLean.Part164.measurableSet_Eop2 _)).inter (outputCentreEvent_measurable _)

theorem first_matrix_charge_row :
    (retDist (paperCentres 12850)).real
      (agentEv (paperDesignP 12850) (FirstMatrix 12850))ᶜ ≤ (1 / 10 ^ 10 : ℝ) := by
  refine (firstMatrix_charge (by norm_num) (paperDesignP 12850)
    (paperDesign_tauWorld _ _ _ _)).trans ?_
  have h : exp (-(12850 : ℝ) / 2) ≤ exp (-12) ^ 2 := by
    rw [← exp_nat_mul]
    apply exp_le_exp.mpr
    norm_num
  exact h.trans ((pow_le_pow_left₀ (exp_pos _).le exp_neg12_row 2).trans (by norm_num))

theorem second_matrix_charge_row :
    (retDist (paperCentres 12850)).real (BstLean.Part164.Eop2 12850)ᶜ ≤
      (373 / 10 ^ 8 : ℝ) := by
  refine (BstLean.Part164.Eop2_charge (by norm_num) (paperCentres 12850)).trans ?_
  have he : (-(25 / 2) : ℝ) = -12 + -(1 / 2) := by norm_num
  rw [he, exp_add]
  exact (mul_le_mul exp_neg12_row BstLean.Part182.exp_neg_half_le
