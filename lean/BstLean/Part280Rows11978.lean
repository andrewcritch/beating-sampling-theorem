  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 11978) (hc : A1 c ∈ Eop 11978) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11978 : ℝ)) ≤ (129217949 / 10000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11978 : ℝ) ≤ (2188881 / 20000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11978 : ℝ) + 2 * √11978 ≤ (121968881 / 10000) := by linarith
