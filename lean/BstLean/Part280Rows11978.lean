  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 11980) (hc : A1 c ∈ Eop 11980) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11980 : ℝ)) ≤ (12920716241 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11980 : ℝ) ≤ (109453187 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11980 : ℝ) + 2 * √11980 ≤ (6099453187 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 11980) (hc : c ∈ BstLean.Part164.Eop2 11980) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 11980 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11980) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11980 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11980) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11980).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11980) (FirstMatrix 11980))
    (h2 : c ∈ BstLean.Part164.Eop2 11980) (a : BstLean.Part161.Ix 11980) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
