  norm_num only [Nat.cast_ofNat] at hs ⊢ <;> linarith

theorem outputCentre_row {c : Ret 11980}
    (hc : c ∈ outputCentreEvent (paperCentres 11980)) :
    normSq c.2.1.2 ≤ (2 / (11980 : ℝ)) * eR c * 11980 * chi := by
  change normSq c.2.1.2 ≤ 2 / (mA 11980 : ℝ) * normSq (bR c) * chiUp 11980 at hc
  have hn := normSq_nonneg (bR c)
  have hm := mul_le_mul_of_nonneg_left chi_row hn
