theorem gaussian80_le : gaussMomConst 80 ≤ 8 := by
  apply le_of_pow_le_pow_left₀ (by norm_num : (160 : ℕ) ≠ 0) (by norm_num : (0 : ℝ) ≤ 8)
  rw [show (160 : ℕ) = 2 * 80 by norm_num, gaussMomConst_pow (by norm_num)]
