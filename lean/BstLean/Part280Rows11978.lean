theorem second_matrix_row (c : Ret 11978) (hc : c ∈ BstLean.Part164.Eop2 11978) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 11978 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11978) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11978 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11978) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11978).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11978) (FirstMatrix 11978))
    (h2 : c ∈ BstLean.Part164.Eop2 11978) (a : BstLean.Part161.Ix 11978) :
