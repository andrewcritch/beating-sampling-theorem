    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11920) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11920).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11920) (FirstMatrix 11920))
    (h2 : c ∈ BstLean.Part164.Eop2 11920) (a : BstLean.Part161.Ix 11920) :
