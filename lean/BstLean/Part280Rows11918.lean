theorem variance_of_matrix_events (c : Ret 11918) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11918).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11918) (FirstMatrix 11918))
