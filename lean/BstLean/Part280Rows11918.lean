  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((334861699 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((5542926841 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((751219 / 125000000)) * ((1001 / 1000 + 52 / 1000) * ((552418779 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((334861699 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((1702061629 / 250000000000000))) := by gcongr
      _ ≤ _ := by norm_num
