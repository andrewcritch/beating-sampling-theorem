theorem low_mass_of_interfaces {c : Ret 12681}
    (hw : WINDOW (paperDesignP 12681) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12681).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12681) c M H xi)
    (hE : centreEnergy (paperDesignP 12681) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12681 : ℝ))))
    (hprice : massBound 12681 M H xi E u mixtureFloor ≤ 12681 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12681 - 1))).real
      {v | sgA (paperDesignP 12681) c a v < √(2 / (12681 : ℝ) * mixtureFloor)}
        ∂muI 12681 ≤ lowMassBudget := by
  have hb : 0 < normSq ((paperDesignP 12681).bA c.1 c.2.1.1) := by
    change 0 < normSq (bR c)
    unfold eR at he
    exact (div_pos_iff.mp he).elim (fun h => h.1) (fun h => by norm_num at h)
  have hm := sharp_residual_mass (by norm_num) (paperDesignP 12681) c hw.2.1 hb hb0
    hI hE hu hu1 hd hg
  have hl := latitude_mass_of_MASS (by norm_num) (paperDesignP 12681) c hw.1 hw.2.1
    (by norm_num [mixtureFloor]) hm
  exact hl.trans ((div_le_div_of_nonneg_right hprice (by norm_num : (0 : ℝ) ≤ 12681)).trans
    (by ring_nf; exact le_rfl))

