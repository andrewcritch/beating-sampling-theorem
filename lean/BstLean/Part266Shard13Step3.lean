theorem split_width_bounds {c : Ret 12681} (he : (6 / 10 : ℝ) ≤ eR c) :
    0 < splitLocationWidth c ∧ splitLocationWidth c ≤ (21875381 / 6250000000) ∧
    0 < splitResidualWidth ∧ splitResidualWidth ≤ (1063994791 / 31250000000000) := by
  have hl := (location_budgets_row he).2.2
  have hs := residual_budgets_row.2.2
