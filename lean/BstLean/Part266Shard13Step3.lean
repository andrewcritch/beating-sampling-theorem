/-- All twenty-eight fields concern the original retained network and latitude measure. -/
noncomputable def latitudeMoments {c : Ret 12682}
    (hw : WINDOW (paperDesignP 12682) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12682 - 1))).real
      {v | sgA (paperDesignP 12682) c a v < √(2 / (12682 : ℝ) * mixtureFloor)}
      ∂muI 12682 ≤ lowMassBudget) :
    LatMom (paperDesignP 12682) c (√(2 / (12682 : ℝ) * mixtureFloor)) 24 where
