theorem residual_moment_on_event {c : Ret 12682}
    (hw : WINDOW (paperDesignP 12682) c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12682) c a v - gbar (paperDesignP 12682) c a| ^ (2 * q)
      ∂stdGauss (Fin (12682 - 1)) ∂muI 12682 ≤ residualMomentBudget q ^ (2 * q) := by
