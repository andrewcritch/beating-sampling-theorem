  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12687 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12687 : ℝ) * _ ≤ 2 / 12687 *
