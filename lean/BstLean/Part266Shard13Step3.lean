theorem removal_of_low_mass {c : Ret 12679}
    (hw : WINDOW (paperDesignP 12679) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12679 - 1))).real
      {v | sgA (paperDesignP 12679) c a v < √(2 / (12679 : ℝ) * mixtureFloor)}
      ∂muI 12679 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12679 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12679 ≤
        removalBudget := by
  have hl := locationMomentBudget_pos he (by norm_num : 12 ≤ 12)
  have hs := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
