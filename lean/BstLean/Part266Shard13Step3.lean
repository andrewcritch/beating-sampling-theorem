      ∂stdGauss (Fin (12687 - 1)) ∂muI 12687 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12687).prod (stdGauss (Fin (12687 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12687) c (hc.1.1.1.1 hw.2.1)
