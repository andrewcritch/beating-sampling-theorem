theorem low_mass_of_interfaces {c : Ret 12691}
    (hw : WINDOW (paperDesignP 12691) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12691).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12691) c M H xi)
    (hE : centreEnergy (paperDesignP 12691) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12691 : ℝ))))
    (hprice : massBound 12691 M H xi E u mixtureFloor ≤ 12691 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12691 - 1))).real
      {v | sgA (paperDesignP 12691) c a v < √(2 / (12691 : ℝ) * mixtureFloor)}
        ∂muI 12691 ≤ lowMassBudget := by
