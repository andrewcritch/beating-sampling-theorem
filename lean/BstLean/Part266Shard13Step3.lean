      ∫ w, sA (paperDesignP 12690) c a w ∂stdGauss (Fin (12690 - 1))) ^ 2
      ∂stdGauss (Fin (12690 - 1))) ^ 2 ∂muI 12690 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12690) c
