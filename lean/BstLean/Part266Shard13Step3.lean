theorem residual_sq_le_energy (c : Ret 12698)
    (p : Ix 12698 × (Fin (12698 - 1) → ℝ)) :
    sgA (paperDesignP 12698) c p.1 p.2 ^ 2 ≤
      (2 / (12698 : ℝ)) * wLatitude c p := by
