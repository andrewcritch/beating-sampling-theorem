theorem variance_budgets_row {c : Ret 12678} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (33189447 / 1000000000000000) ∧ residualVarianceBudget ≤ (3141453 / 1000000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
