    ∫ a, ∫ v, |lA (paperDesignP 12682) c a v - lbar (paperDesignP 12682) c a| ^ (2 * q)
      ∂stdGauss (Fin (12682 - 1)) ∂muI 12682 ≤ locationMomentBudget c q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
