theorem removal_of_low_mass {c : Ret 12681}
    (hw : WINDOW (paperDesignP 12681) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12681 - 1))).real
      {v | sgA (paperDesignP 12681) c a v < √(2 / (12681 : ℝ) * mixtureFloor)}
      ∂muI 12681 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12681 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12681 ≤
