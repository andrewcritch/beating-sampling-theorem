      ∫ w, sA (paperDesignP 12694) c a w ∂stdGauss (Fin (12694 - 1))) ^ 2
      ∂stdGauss (Fin (12694 - 1))) ^ 2 ∂muI 12694 ≤ scaleVarianceBudget ^ 2 :=
