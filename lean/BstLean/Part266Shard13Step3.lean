      ∫ w, sA (paperDesignP 12684) c a w ∂stdGauss (Fin (12684 - 1))) ^ 2
      ∂stdGauss (Fin (12684 - 1))) ^ 2 ∂muI 12684 ≤ scaleVarianceBudget ^ 2 :=
