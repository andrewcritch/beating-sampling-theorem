## The abstract conditional model
* `ν` is a probability distribution on the unit sphere of `ℝⁿ` (`SphLaw n ν`).
* `J` is a finite feature index type; `ψ x : J → ℝ` are the residual features (continuous in `x`);
  `mu x : Fin n → ℝ` is the conditional mean field (continuous in `x`).
* `W : J × Fin n → ℝ` is standard Gaussian; the residual field is `zv W (ψ x)`.
* `f(y) = f₀ + ℓ·y + yᵀHy` (`qfun f0 ℓ H`), `H` symmetric.
* `FA … W x = f(mu x + zv W (ψ x))`, `BA = E_x FA`, `VA = Var_x FA`.
* `kA ψ x = ‖ψ x‖²`, `KA ψ x y = ψ x · ψ y`, `aA ℓ H mu x = ℓ + 2 H mu(x)`,
  `PhiA x = f(mu x) + tr H · kA x = E_W FA`, `gA = E_x PhiA = E_W BA`.
-/

namespace BstLean.Part80

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part36 (CoefIdxD DD unitOfD mapMD)
open BstLean.Part40 (SphLaw)
open BstLean.Part41 (Mono phiM colM varU frob Tens TSymm fval)
open BstLean.Part53 (linZ TF fvA heatA sg)
open BstLean.Part56 (UnitV lawRK surrRK KRK betaJ kJ tauR ancRK mux projA phiB)
open BstLean.Part56.Orth (residualFeature)
open BstLean.Part78 (nsq frobH trH qfun aU zv)

/-! ## §1 The abstract conditional model -/

section abstract
variable {n : ℕ} {J : Type} [Fintype J]

/-- `F_W(x) = f(mu(x) + W ψ(x))`. -/
def FA (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) (W : J × Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  qfun f0 ℓ H (fun i => mu x i + zv W (ψ x) i)

/-- `B(W) = E_x F_W(x)`. -/
noncomputable def BA (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ)
    (W : J × Fin n → ℝ) : ℝ := ∫ x, FA f0 ℓ H mu ψ W x ∂ν

/-- `V(W) = Var_x F_W(x)`. -/
noncomputable def VA (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ)
    (W : J × Fin n → ℝ) : ℝ := varU ν (FA f0 ℓ H mu ψ W)

/-- `k(x) = ‖ψ(x)‖²`. -/
def kA (ψ : (Fin n → ℝ) → J → ℝ) (x : Fin n → ℝ) : ℝ := ∑ q, ψ x q ^ 2

/-- `K(x,y) = ψ(x)·ψ(y)`. -/
def KA (ψ : (Fin n → ℝ) → J → ℝ) (x y : Fin n → ℝ) : ℝ := ∑ q, ψ x q * ψ y q

/-- `a(x) = ℓ + 2 H mu(x) = ∇f(mu(x))`. -/
def aA (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (x : Fin n → ℝ) : Fin n → ℝ := aU ℓ H (mu x)

/-- `Φ(x) = f(mu(x)) + tr H · k(x) = E_W F_W(x)`. -/
def PhiA (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (mu : (Fin n → ℝ) → Fin n → ℝ)
    (ψ : (Fin n → ℝ) → J → ℝ) (x : Fin n → ℝ) : ℝ := qfun f0 ℓ H (mu x) + trH H * kA ψ x

/-- `g = E_x Φ(x) = E_W B(W)`. -/
noncomputable def gA (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) : ℝ :=
  ∫ x, PhiA f0 ℓ H mu ψ x ∂ν

/-- `T_a = E_{x,y} a(x)·a(y) K(x,y)`. -/
noncomputable def TaA (ν : Measure (Fin n → ℝ)) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ)
    (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) : ℝ :=
  ∫ x, ∫ y, (∑ i, aA ℓ H mu x i * aA ℓ H mu y i) * KA ψ x y ∂ν ∂ν

/-- `S₂ = E_{x,y} K(x,y)²`. -/
noncomputable def S2A (ν : Measure (Fin n → ℝ)) (ψ : (Fin n → ℝ) → J → ℝ) : ℝ :=
  ∫ x, ∫ y, KA ψ x y ^ 2 ∂ν ∂ν

/-- `e = E_x k(x)`. -/
noncomputable def eA (ν : Measure (Fin n → ℝ)) (ψ : (Fin n → ℝ) → J → ℝ) : ℝ := ∫ x, kA ψ x ∂ν

/-- `V̄ = E_W V(W)`. -/
noncomputable def VbarA (ν : Measure (Fin n → ℝ)) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ) : ℝ :=
  ∫ W, VA ν f0 ℓ H mu ψ W ∂stdGauss (J × Fin n)

/-- The (uncentred) feature operator bound: `E_x (c·ψ(x))² ≤ Γ ‖c‖²`. -/
def FeatOpA (ν : Measure (Fin n → ℝ)) (ψ : (Fin n → ℝ) → J → ℝ) (Γ : ℝ) : Prop :=
  ∀ c : J → ℝ, ∫ x, (∑ q, c q * ψ x q) ^ 2 ∂ν ≤ Γ * ∑ q, c q ^ 2

end abstract

/-- **The exact conditional identities** (E) and (V) of `omLL-opus-prover.md` §2. -/
def MeanIdsA : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
      Integrable (VA ν f0 ℓ H mu ψ) (stdGauss (J × Fin n)) ∧
      Integrable (fun W => VA ν f0 ℓ H mu ψ W ^ 2) (stdGauss (J × Fin n)) ∧
      Integrable (fun W => (BA ν f0 ℓ H mu ψ W - gA ν f0 ℓ H mu ψ) ^ 2) (stdGauss (J × Fin n)) ∧
      ∫ W, (BA ν f0 ℓ H mu ψ W - gA ν f0 ℓ H mu ψ) ^ 2 ∂stdGauss (J × Fin n) =
        TaA ν ℓ H mu ψ + 2 * frobH H * S2A ν ψ ∧
      VbarA ν f0 ℓ H mu ψ =
        varU ν (PhiA f0 ℓ H mu ψ) +
          (∫ x, nsq (aA ℓ H mu x) * kA ψ x ∂ν - TaA ν ℓ H mu ψ) +
          2 * frobH H * (∫ x, kA ψ x ^ 2 ∂ν - S2A ν ψ)

/-- **Conditional bounds** from the identities and the feature operator bound: the error, two
floors for `V̄`, and `Var_x Φ ≤ V̄`. `S` and `I` are an upper and a lower bound of `‖a(x)‖²`. -/
def CondBoundsA : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
    ∀ Γ S I : ℝ, 0 ≤ Γ → FeatOpA ν ψ Γ →
      (∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
        nsq (aA ℓ H mu x) ≤ S ∧ I ≤ nsq (aA ℓ H mu x) ∧ kA ψ x ≤ 2) →
      ∫ W, (BA ν f0 ℓ H mu ψ W - gA ν f0 ℓ H mu ψ) ^ 2 ∂stdGauss (J × Fin n) ≤
        Γ * (S + 4 * frobH H) ∧
      I * eA ν ψ - Γ * S + 2 * frobH H * (eA ν ψ ^ 2 - Γ * eA ν ψ) ≤ VbarA ν f0 ℓ H mu ψ ∧
      2 * frobH H * (eA ν ψ ^ 2 - Γ * eA ν ψ) ≤ VbarA ν f0 ℓ H mu ψ ∧
      varU ν (PhiA f0 ℓ H mu ψ) ≤ VbarA ν f0 ℓ H mu ψ

/-- **Conditional variance bound** (Poincaré route, `omLL-opus-prover.md` §4.3 steps 1–6):
`Var_W V ≤ 4 Γ √(35/2) ((1+η) S + (1+1/η) 8√3 ‖H‖²) V̄`. -/
def VarBoundA : Prop :=
  ∀ (n : ℕ) (J : Type) [Fintype J] (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∀ (mu : (Fin n → ℝ) → Fin n → ℝ) (ψ : (Fin n → ℝ) → J → ℝ), Continuous mu → Continuous ψ →
    ∀ Γ S η : ℝ, 0 ≤ Γ → 0 < η → FeatOpA ν ψ Γ →
      (∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 → nsq (aA ℓ H mu x) ≤ S ∧ kA ψ x ≤ 2) →
      ∫ W, (VA ν f0 ℓ H mu ψ W - VbarA ν f0 ℓ H mu ψ) ^ 2 ∂stdGauss (J × Fin n) ≤
        4 * Γ * (4184 / 1000) *
          ((1 + η) * S + (1 + 1 / η) * (8 * (1733 / 1000)) * frobH H) * VbarA ν f0 ℓ H mu ψ

/-! ## §2 Sphere geometry for the rank-one concentrated distributions -/

/-- **Symmetric sphere integrals.** For a unit `v`, a weight `h((v·x)²)`, `h ≥ 0` continuous, a
linear form `c·x` with `c ⊥ v` and a quadratic form `xᵀSx` with `vᵀSv = 0`:
`E[h (c·x + xᵀSx)²] ≤ (‖c‖² E[h ρ²] + ‖S‖_F² max(E[h ρ²], E[h]/2))/(n−1)`, `ρ² = 1 − (v·x)²`. -/
def SphSymm (n : ℕ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v → ∀ h : ℝ → ℝ, Continuous h → (∀ s, 0 ≤ h s) →
    ∀ c : Fin n → ℝ, ∑ i, c i * v i = 0 →
    ∀ S : Matrix (Fin n) (Fin n) ℝ, S.IsSymm → ∑ i, ∑ j, S i j * v i * v j = 0 →
      ∫ x, h ((∑ i, v i * x i) ^ 2) * (∑ i, c i * x i + ∑ i, ∑ j, S i j * x i * x j) ^ 2
          ∂uniformSphere n ≤
        ((∑ i, c i ^ 2) *
            ∫ x, h ((∑ i, v i * x i) ^ 2) * (1 - (∑ i, v i * x i) ^ 2) ∂uniformSphere n +
          (∑ i, ∑ j, S i j ^ 2) *
            max (∫ x, h ((∑ i, v i * x i) ^ 2) * (1 - (∑ i, v i * x i) ^ 2) ∂uniformSphere n)
              (1 / 2 * ∫ x, h ((∑ i, v i * x i) ^ 2) ∂uniformSphere n)) / ((n : ℝ) - 1)

/-- `p = E_D (1 − (v·x)²)`, `D = lawRK n t v`. -/
noncomputable def pRK (n : ℕ) (t : ℝ) (v : Fin n → ℝ) : ℝ :=
  ∫ x, (1 - (∑ i, v i * x i) ^ 2) ∂lawRK n t v

/-- **The residual feature operator bound** for `D_{t,v}`, every real `t`, every unit `v`:
`E_D (c·ψ(x))² ≤ max(p, 1/2)/(n−1) · ‖c‖²`. -/
def FeatOpRK (n : ℕ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v → ∀ t : ℝ,
    FeatOpA (lawRK n t v) (fun x => residualFeature (d := 2) v x)
      (max (pRK n t v) (1 / 2) / ((n : ℝ) - 1))

/-- **Second moment of `s = v·x`** for `t ∈ [0, n]`: `E_D s² ≤ 41/80 + 2/n`. -/
def PLowRK (n : ℕ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v → ∀ t : ℝ, 0 ≤ t → t ≤ n →
    ∫ x, (∑ i, v i * x i) ^ 2 ∂lawRK n t v ≤ 41 / 80 + 2 / (n : ℝ)

/-- **Kernel facts** at `d = 2`. -/
def KernelFacts (n : ℕ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v →
    Continuous (fun x : Fin n → ℝ => residualFeature (d := 2) v x) ∧
    Continuous (fun x : Fin n → ℝ => betaJ 2 2 v x) ∧
    0 < kJ 2 2 v v ∧
    (∑ p : Mono n 2, phiB 2 1 v p ^ 2 = 1) ∧
    (∑ p : Mono n 2, phiB 2 2 v p ^ 2 = kJ 2 2 v v) ∧
    (∀ (Z : CoefIdxD n 2 → ℝ) (x : Fin n → ℝ),
      mux Z v x = ancRK Z v 0 + (∑ i, v i * x i) • ancRK Z v 1 + betaJ 2 2 v x • ancRK Z v 2) ∧
    ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
      kA (fun x => residualFeature (d := 2) v x) x = tauR 2 v x ∧
      1 - (∑ i, v i * x i) ^ 2 ≤ tauR 2 v x ∧ tauR 2 v x ≤ 2 ∧
      (∑ i, v i * x i) ^ 2 ≤ 1 ∧
      betaJ 2 2 v x ^ 2 * kJ 2 2 v v ≤ 1

/-- **Surrogate**: for `t ∈ [0, n]`, `Q = surrRK n (KRK 1 n e) t v`, `D = lawRK n t v` and every
continuous `g`: `(E_Q g − E_D g)² ≤ etaQ(e)² Var_D g`. Both are distributions on the sphere. -/
def SurrRK (n : ℕ) (e : ℝ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v → ∀ t : ℝ, 0 ≤ t → t ≤ n →
    SphLaw n (lawRK n t v) ∧ SphLaw n (surrRK n (KRK 1 n e) t v) ∧
    ∀ g : (Fin n → ℝ) → ℝ, Continuous g →
      (∫ x, g x ∂surrRK n (KRK 1 n e) t v - ∫ x, g x ∂lawRK n t v) ^ 2 ≤
        BstLean.Part43.etaQ e ^ 2 * varU (lawRK n t v) g

/-! ## §3 Bridges -/

/-- **Tensor form = `(f₀, ℓ, H)` form** at `d_f = 2`, and the heat form. -/
def TensBridge (n : ℕ) : Prop :=
  ∀ (f0 : ℝ) (T : Tens n), TSymm 2 T →
    ∃ (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm ∧
      (∀ y : Fin n → ℝ, fval 2 f0 T y = qfun f0 ℓ H y) ∧
      frobH H = frob (T 2) ∧
      (∀ (a : ℝ) (y : Fin n → ℝ),
        fvA 2 (heatA 2 a (TF 2 f0 T)) y = qfun f0 ℓ H y + a * trH H)

/-- **Reindexing** the coefficient array as `Mono n 2 × Fin n`. -/
def RixIface (n : ℕ) : Prop :=
  ∃ rix : (CoefIdxD n 2 → ℝ) → (Mono n 2 × Fin n → ℝ), Measurable rix ∧
    Measure.map rix (stdGauss (CoefIdxD n 2)) = stdGauss (Mono n 2 × Fin n) ∧
    ∀ (W : CoefIdxD n 2 → ℝ) (ψ : Mono n 2 → ℝ) (i : Fin n), linZ W ψ i = zv (rix W) ψ i

/-- **Second moment of `H u`**, `u = Z c` an anchor: `E ‖H Z c‖² = ‖H‖_F² ‖c‖²`. -/
def AnchorMom (n : ℕ) : Prop :=
  ∀ (H : Matrix (Fin n) (Fin n) ℝ) (c : Mono n 2 → ℝ),
    Integrable (fun Z : CoefIdxD n 2 → ℝ => nsq (fun i => ∑ j, H i j * linZ Z c j))
      (stdGauss (CoefIdxD n 2)) ∧
    ∫ Z, nsq (fun i => ∑ j, H i j * linZ Z c j) ∂stdGauss (CoefIdxD n 2) =
      frobH H * ∑ p, c p ^ 2

/-- **The homogeneous part**: `E_Z Var_x (m(x)ᵀ H m(x)) ≤ (n/16 + 18) ‖H‖_F²`, `m(x) = Z φ(x)`. -/
def HomVar (n : ℕ) : Prop :=
  ∀ (ν : Measure (Fin n → ℝ)), SphLaw n ν → ∀ H : Matrix (Fin n) (Fin n) ℝ, H.IsSymm →
    Integrable (fun Z : CoefIdxD n 2 → ℝ =>
      varU ν (fun x => ∑ i, ∑ j, H i j * mapMD Z x i * mapMD Z x j)) (stdGauss (CoefIdxD n 2)) ∧
    ∫ Z, varU ν (fun x => ∑ i, ∑ j, H i j * mapMD Z x i * mapMD Z x j) ∂stdGauss (CoefIdxD n 2) ≤
      ((n : ℝ) / 16 + 18) * frobH H

/-- **Regularity** in the coefficient array. -/
def RegRK (n : ℕ) : Prop :=
  ∀ (ν : Measure (Fin n → ℝ)), SphLaw n ν →
    ∀ (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ),
      Continuous (fun Z : CoefIdxD n 2 → ℝ => ∫ x, qfun f0 ℓ H (mapMD Z x) ∂ν) ∧
      Continuous (fun Z : CoefIdxD n 2 → ℝ => varU ν (fun x => qfun f0 ℓ H (mapMD Z x))) ∧
      (∀ x : Fin n → ℝ, Continuous (fun Z : CoefIdxD n 2 → ℝ => mapMD Z x)) ∧
      (∀ Z : CoefIdxD n 2 → ℝ, Continuous (fun x : Fin n → ℝ => mapMD Z x)) ∧
      ∀ v : Fin n → ℝ, UnitV v →
        Continuous (fun Z : CoefIdxD n 2 → ℝ => ∫ x, qfun f0 ℓ H (mux Z v x) ∂ν) ∧
        (∀ Z : CoefIdxD n 2 → ℝ, Continuous (fun x : Fin n → ℝ => mux Z v x))

end BstLean.Part80
