  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12654)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12654) (CentreSources 12654 12654)
  direction : analyticBase ⊆ agentEv (paperDesignP 12654) (DirectionError 12654)
  angles : analyticBase ⊆ worldAngles

