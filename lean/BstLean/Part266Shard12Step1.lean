  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12663)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12663) (CentreSources 12663 12663)
  direction : analyticBase ⊆ agentEv (paperDesignP 12663) (DirectionError 12663)
  angles : analyticBase ⊆ worldAngles

