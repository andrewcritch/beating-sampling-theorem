  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12661)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12661) (CentreSources 12661 12661)
  direction : analyticBase ⊆ agentEv (paperDesignP 12661) (DirectionError 12661)
  angles : analyticBase ⊆ worldAngles

