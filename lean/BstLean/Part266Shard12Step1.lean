    (retDist (paperCentres 12663)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12663)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12663) (paperCentres 12663)
  have he : exp (-(45 / 10000 * (12663 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12663 : ℝ))) ≤ exp (-12) ^ 2 := by
