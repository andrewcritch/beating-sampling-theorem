  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12657)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12657) (CentreSources 12657 12657)
  direction : analyticBase ⊆ agentEv (paperDesignP 12657) (DirectionError 12657)
  angles : analyticBase ⊆ worldAngles

