  unfold worldAngles
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans (add_le_add (h1.trans he)
    (h2.trans exp_neg12_row))).trans (by norm_num)

def analyticBase : Set (Ret 12663) :=
  (passEvent ∩ agentEv (paperDesignP 12663) (DirectionError 12663) ∩
    agentEv (paperDesignP 12663) (CentreSources 12663 12663)) ∩ worldAngles

