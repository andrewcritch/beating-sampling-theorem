open Real

noncomputable def eta : ℝ := 2226 / 10 ^ 6
noncomputable def mixtureFloor : ℝ := 217184 / 10 ^ 6
noncomputable def biasFloor : ℝ := (1 - eta) * mixtureFloor
noncomputable def chi : ℝ := 1065 / 1000
