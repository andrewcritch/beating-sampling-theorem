def passEvent : Set (Ret 12250) :=
  agentEv (paperDesignP 12250) (Energy32 12250) ∩
  agentEv (paperDesignP 12250) (freshRetainedEvent160 12250 4) ∩
  agentEv (paperDesignP 12250) (FirstMatrix 12250) ∩
  BstLean.Part164.Eop2 12250 ∩ outputCentreEvent (paperCentres 12250)

theorem passEvent_measurable : MeasurableSet passEvent :=
  ((((measurableSet_agentEv _ (measurableSet_Energy32 _)).inter
    (measurableSet_agentEv _ (measurableSet_freshRetainedEvent160 _ _))).inter
    (measurableSet_agentEv _ (firstMatrix_measurable _))).inter
    (BstLean.Part164.measurableSet_Eop2 _)).inter (outputCentreEvent_measurable _)

theorem first_matrix_charge_row :
    (retDist (paperCentres 12250)).real
      (agentEv (paperDesignP 12250) (FirstMatrix 12250))ᶜ ≤ (1 / 10 ^ 10 : ℝ) := by
  refine (firstMatrix_charge (by norm_num) (paperDesignP 12250)
    (paperDesign_tauWorld _ _ _ _)).trans ?_
  have h : exp (-(12250 : ℝ) / 2) ≤ exp (-12) ^ 2 := by
    rw [← exp_nat_mul]
    apply exp_le_exp.mpr
    norm_num
  exact h.trans ((pow_le_pow_left₀ (exp_pos _).le exp_neg12_row 2).trans (by norm_num))

theorem second_matrix_charge_row :
    (retDist (paperCentres 12250)).real (BstLean.Part164.Eop2 12250)ᶜ ≤
      (373 / 10 ^ 8 : ℝ) := by
  refine (BstLean.Part164.Eop2_charge (by norm_num) (paperCentres 12250)).trans ?_
  have he : (-(25 / 2) : ℝ) = -12 + -(1 / 2) := by norm_num
