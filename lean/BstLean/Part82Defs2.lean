import BstLean.Part82Defs

/-!
# Part 82, second pass: definitions for the lower threshold

The same route as `Part82Defs.lean`, with the floor `Wf4` (valid from `n ≥ 10⁵`) and the
Gaussian-model bounds `GaussBds2`. Do not edit this file.
-/

namespace BstLean.Part82

open MeasureTheory
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part78 (nsq frobH trH zv)

variable {n : ℕ}

/-- The floor of `E_W V`, second pass: `1.61‖α‖² + 5.55‖H‖² + 27.6‖T‖²`. -/
noncomputable def Wf4 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) : ℝ :=
  161 / 100 * nsq (alphaV a T) + 555 / 100 * frobH H + 276 / 10 * frobT T

/-- **The Gaussian-model bounds given the constant column, second pass**: floor, error, mean
upper bound, and the kernel integral. `α = alphaV a T`. -/
def GaussBds2 (n : ℕ) (CF : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    Wf4 a H T ≤ ∫ W, VG3 a H T W ∂stdGauss (WIdx3 n) ∧
    ∫ W, errG3 a H T W ^ 2 ∂stdGauss (WIdx3 n) ≤
      (104 / 100 * CF * nsq (alphaV a T) + (6 * CF + 907 / 100) * frobH H +
        55 * CF * frobT T) / (n : ℝ) ∧
    ∫ W, VG3 a H T W ∂stdGauss (WIdx3 n) ≤
      16 / 5 * nsq (alphaV a T) + 19 * frobH H + 163 * frobT T ∧
    ∫ x, wQ3 a H T x * tau3 a H T x ∂uniformSphere n ≤ 186 / 100 * Wf4 a H T ^ 2

/-- A fourth-moment constant at degree `≤ 3`: `E P⁴ ≤ K (E P²)²`. -/
def Deg3Fourth (K : ℝ) : Prop :=
  ∀ (ι : Type) [Fintype ι] (P : MvPolynomial ι ℝ), P.totalDegree ≤ 3 →
    ∫ z, (MvPolynomial.eval z P) ^ 4 ∂stdGauss ι ≤
      K * (∫ z, (MvPolynomial.eval z P) ^ 2 ∂stdGauss ι) ^ 2

end BstLean.Part82
