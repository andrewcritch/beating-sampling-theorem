      ∫ w, sA (paperDesignP 12954) c a w ∂stdGauss (Fin (12954 - 1))) ^ 2
      ∂stdGauss (Fin (12954 - 1))) ^ 2 ∂muI 12954 ≤ scaleVarianceBudget ^ 2 :=
