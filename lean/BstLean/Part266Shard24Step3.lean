theorem residual_sq_le_energy (c : Ret 12965)
    (p : Ix 12965 × (Fin (12965 - 1) → ℝ)) :
    sgA (paperDesignP 12965) c p.1 p.2 ^ 2 ≤
      (2 / (12965 : ℝ)) * wLatitude c p := by
