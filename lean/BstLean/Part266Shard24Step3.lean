      ∂stdGauss (Fin (12955 - 1)) ∂muI 12955 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12955).prod (stdGauss (Fin (12955 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12955) c (hc.1.1.1.1 hw.2.1)
