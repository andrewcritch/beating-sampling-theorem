import BstLean.Part86Defs

/-!
# Part 89, frozen definitions: a sharper threshold for the line program (Theorem 1)

Role: `delegations/statements/p89-spec.md`. Definitions and `Prop`-valued interface statements
only. Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

The route is that of Part 86 (conditioning on the anchors, slice by slice). Three constants are
improved for every degree pair:
* the slice reverse Hölder constant `9^D` in place of `8 · 9^D` (`SliceRHRK9`);
* the Gaussian model constant `(104/100) n Λ C_RH` in place of `6 n Λ C_RH`;
* the Markov level `a` and the Chebyshev level `b` of the sphere step are parameters
  (`remezBound89`).
The threshold is `N89 d k = 300 (2k+1)² (d+1)! 9^{dk}` (Part 86: `71000 (2k+1)² (d+1)! 9^{dk}`).
-/

namespace BstLean.Part89

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss)
open BstLean.Part56 (UnitV polarPoint perpDir)
open BstLean.Part86

section model

variable {n : ℕ} {I J S G : Type} [Fintype I] [Fintype J] [MeasurableSpace S] [MeasurableSpace G]

/-- The Gaussian model given the anchors, for ONE polynomial `P` and one scale `lam`
(the body of `Part86.GaussModel86`). -/
def GMP (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam c1 cV efl : ℝ) : Prop :=
  ∃ Lv Vb : ℝ, 0 ≤ Lv ∧ (1 - efl) * Lv ≤ Vb ∧
    Integrable (fun W : J × Fin n → ℝ => Esl M P lam W) (stdGauss (J × Fin n)) ∧
    Integrable (fun W : J × Fin n → ℝ => (Vdn M P lam W - Vb) ^ 2) (stdGauss (J × Fin n)) ∧
    ∫ W : J × Fin n → ℝ, Esl M P lam W ∂stdGauss (J × Fin n) ≤ c1 / (n : ℝ) * Lv ∧
    ∫ W : J × Fin n → ℝ, (Vdn M P lam W - Vb) ^ 2 ∂stdGauss (J × Fin n) ≤
      cV / (n : ℝ) * Lv ^ 2 ∧
    R1 M P ≤ 2 * Lv

/-- The bound of the sphere step with a Markov level `a` (event `Esl > a Lv`) and a Chebyshev
level `b` (event `Vdn < b Vb`). -/
noncomputable def remezBound89 (n k : ℕ) (c1 cV efl a b : ℝ) : ℝ :=
  5 / 2 * ((k : ℝ) + 1) ^ 2 * c1 / (a * n) +
    5 / 2 * (2 * (k : ℝ) + 1) ^ 2 * cV / ((1 - b) ^ 2 * (1 - efl) ^ 2 * n)

end model

/-- **Slice reverse Hölder inequality for `D_{t,v}` with the sharp constant** `9^D`. -/
def SliceRHRK9 (m D : ℕ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, UnitV v → ∀ a r : ℝ,
    ∀ Q : MvPolynomial (Fin (m + 1)) ℝ, Q.totalDegree ≤ D →
      ∫ g, (MvPolynomial.eval (polarPoint v (perpDir v g) a r) Q) ^ 4 ∂stdGauss (Fin (m + 1)) ≤
        9 ^ D * (∫ g, (MvPolynomial.eval (polarPoint v (perpDir v g) a r) Q) ^ 2
          ∂stdGauss (Fin (m + 1))) ^ 2

/-- The threshold of Part 89 for every degree pair: `300 (2k+1)² (d+1)! 9^{dk}`. -/
def N89 (d k : ℕ) : ℕ := 300 * (2 * k + 1) ^ 2 * (d + 1).factorial * 9 ^ (d * k)

end BstLean.Part89
