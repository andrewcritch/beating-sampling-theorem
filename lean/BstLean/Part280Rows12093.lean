theorem variance_of_matrix_events (c : Ret 12093) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12093).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12093) (FirstMatrix 12093))
