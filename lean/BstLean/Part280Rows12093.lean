theorem exactTableMoments_of_N {c : Ret 12097} (hw : WINDOW (paperDesignP 12097) c)
    (hθ : BstLean.Part280.m2Guard 12097 c) (hc : c ∈ BstLean.Part280.sharpTableN 12097)
