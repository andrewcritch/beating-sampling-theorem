  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (12097 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 12097) c p.1 p.2)
