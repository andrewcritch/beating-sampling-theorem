  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((67786407 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((1038157343 / 200000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1483919 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((52876429 / 100000000000))) := by
        gcongr
