  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((67799863 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((3185917827 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1483621 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((129840647 / 200000000000))) := by
