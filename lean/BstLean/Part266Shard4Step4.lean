    (gaussMat (mA 12470) 12470 (2 / (12470 : ℝ))).real {X | ∃ g < Js 12470,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12470 : ℝ)) ∨
