    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 12459) (mA 12459) (tA 12459) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
