theorem node_trace_charge_row {wr : WRet 12463} (hw : windowW wr) :
    (gaussMat (mA 12463) 12463 (2 / (12463 : ℝ))).real {X | ∃ g < Js 12463,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12463 : ℝ)) ∨
