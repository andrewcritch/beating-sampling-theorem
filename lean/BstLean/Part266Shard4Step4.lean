theorem hq_output_bounds {c : Ret 12466}
    (hw : WINDOW (paperDesignP 12466) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12466)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
