def LowResidualMass (c : Ret 12465) : Prop :=
  ∫ a, (stdGauss (Fin (12465 - 1))).real
    {v | sgA (paperDesignP 12465) c a v < rowSigma} ∂muI 12465 ≤ lowMassBudget

