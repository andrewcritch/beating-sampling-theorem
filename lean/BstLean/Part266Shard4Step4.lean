      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5930677 / 1000000000)) ^ 2 * ((1003 / 1000) * ((8572379 / 250000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84803593 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((323604999 / 62500000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5930677 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((263936861 / 500000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84803593 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((6359574919 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
