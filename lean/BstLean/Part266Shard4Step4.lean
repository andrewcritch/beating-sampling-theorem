/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12462) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12462) c (rowSplit c wl ws),
    ((12462 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12462 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12462) c (rowSplit c wl ws),
    ((12462 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12462 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12462 - 1)))
    (rowSplit c wl ws).good a ∂muI 12462 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12462) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12462 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12462) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12462 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12462) c (rowSplit c wl ws),
