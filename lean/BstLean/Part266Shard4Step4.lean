      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((2966647 / 500000000)) ^ 2 * ((1003 / 1000) * ((8587521 / 250000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84766627 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2592269263 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2966647 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((132084959 / 250000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84766627 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((1273599989 / 200000000000000))) := by gcongr
      _ ≤ _ := by norm_num
