    (gaussMat (mA 12455) 12455 (2 / (12455 : ℝ))).real {X | ∃ g < Js 12455,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12455 : ℝ)) ∨
