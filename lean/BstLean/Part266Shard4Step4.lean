      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((2966171 / 500000000)) ^ 2 * ((1003 / 1000) * ((34328041 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169560141 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((129551069 / 25000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2966171 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((105634049 / 200000000000))) := by
        gcongr
