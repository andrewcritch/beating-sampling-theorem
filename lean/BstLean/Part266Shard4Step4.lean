structure RootRemainder (t : ℝ) (c : Ret 12459) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12459) c (rowSplit c wl ws),
    ((12459 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12459 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12459) c (rowSplit c wl ws),
