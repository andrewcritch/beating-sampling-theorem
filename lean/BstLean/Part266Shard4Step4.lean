  removal : ∫ a, removed (stdGauss (Fin (12459 - 1)))
    (rowSplit c wl ws).good a ∂muI 12459 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12459) c (rowSplit c wl ws),
