noncomputable def splitResidualWidth : ℝ := 4 * residualMomentBudget 12
noncomputable def lowMassBudget : ℝ := 4 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 12157}
    (hw : WINDOW (paperDesignP 12157) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12157 - 1))).real
      {v | sgA (paperDesignP 12157) c a v < √(2 / (12157 : ℝ) * mixtureFloor)}
      ∂muI 12157 ≤ lowMassBudget) :
