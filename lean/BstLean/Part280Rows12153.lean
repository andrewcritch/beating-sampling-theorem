theorem variance_of_matrix_events (c : Ret 12157) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12157).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12157) (FirstMatrix 12157))
