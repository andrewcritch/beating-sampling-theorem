      12156 * ((24534131 / 1000000000) : ℝ) ^ 2 / 2 + ((424908681 / 250000000)) ^ 2 * (1 + (24534131 / 1000000000)) := by
    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (12156 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
      _ ≤ (1001 / 1000 : ℝ) * (12156 * ((24534131 / 1000000000)) ^ 2 / 2 + ((424908681 / 250000000)) ^ 2 * (1 + (24534131 / 1000000000))) := by
        exact mul_le_mul hk1 hb
