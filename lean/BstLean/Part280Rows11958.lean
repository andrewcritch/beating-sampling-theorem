theorem exactTableMoments_of_N {c : Ret 11962} (hw : WINDOW (paperDesignP 11962) c)
    (hθ : BstLean.Part280.m2Guard 11962 c) (hc : c ∈ BstLean.Part280.sharpTableN 11962)
