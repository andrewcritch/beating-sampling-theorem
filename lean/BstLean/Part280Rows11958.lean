theorem variance_of_matrix_events (c : Ret 11958) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11958).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11958) (FirstMatrix 11958))
