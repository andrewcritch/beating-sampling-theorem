      funext v
      simp only [zLatitude, sgA, div_eq_mul_inv, mul_comm]
    rw [hfun, conditionalVariance_scale]
    rfl
  rw [hf] at hh
  have hc : (√(2 / (n : ℝ)))⁻¹ ^ 2 * ((2 * C / n) / n / ((n : ℝ) - 2)) =
      C / n / ((n : ℝ) - 2) := by
    rw [inv_pow, sq_sqrt hγ.le]
    field_simp
    <;> ring
  rwa [hc] at hh

noncomputable def varianceTwelve : ℝ := 1 / 44000000

structure LatitudeVarianceCertificate (c : Ret 11960) : Prop where
  location : LBound (muI 11960) 12
    (fun a => conditionalVariance (stdGauss (Fin (11960 - 1))) (fun v => fLatitude c (a, v)))
