## §1 The Bombieri–Weyl inner product (compare `MM.md`, Focus, "By monomial coefficients")

A polynomial map `p : ℝ^k → ℝ^q` of degree at most `d` is given by its monomial coefficients
`b_{a,α}`, `a : Fin q`, `α` a monomial of degree `j ≤ d` in `k` variables. A monomial is a pair
`⟨j, s⟩ : MonoIdx k d` with `s : Sym (Fin k) j` the multiset of its variables (`α_l = s.count l`).
* `monoVal x α = x^α`.
* `bwWeight α = α!/|α|!`.
* `bwInner b c = Σ_{a,α} b_{a,α} c_{a,α} · α!/|α|!`, `bwNormSq b = bwInner b b`.
* `bwEval b x a = p_a(x) = Σ_α b_{a,α} x^α` (the evaluation map).
* `bwOfCoord ξ`: the coefficient vector with coordinates `ξ` in the orthonormal basis
  `e_{a,α} = (|α|!/α!)^{1/2} δ_{a,α}` of `bwInner`.
* `bwGauss k q d σ` (the Gaussian version): the coordinates `ξ` are independent `N(0, σ²)`.
* `bwSphere k q d` (the sphere version): the coordinates `ξ` are uniform on the Euclidean unit
  sphere, so the coefficients are uniform on the unit sphere of `bwNormSq`. It is defined as the
  distribution of `bwOfCoord (ξ/|ξ|)`, `ξ` standard Gaussian.

## §2 Theorem 1 of round oaW1

`W : ℝ^N → ℝ^n` of degree `d` (`N = r·n`, `d = r·d_A`), `u` uniform on the unit sphere of `ℝ^N`.
* `mixW b0 c`: the coefficients of degree `0` and `1` from `b0`, of degree `2` to `d` from `c`.
* `sphProj y = y/|y|`.
* `muW W`: the distribution of `x = W(u)/|W(u)|`.
* `nuW b0 τ`: the distribution of `y/|y|`, `y = W_0 + W_1 u + τ g`, `g` standard Gaussian in `ℝⁿ`.
* `lam0 N d = (1/(d−1)) Σ_{j=2}^{d} E (u·u′)^j`.
-/

namespace BstLean.Part105

open MeasureTheory ProbabilityTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)

/-! ## §1 The Bombieri–Weyl inner product -/

/-- A monomial of degree at most `d` in `k` variables: its degree `j` and the multiset of its
`j` variables. -/
abbrev MonoIdx (k d : ℕ) := Σ j : Fin (d + 1), Sym (Fin k) j

/-- The degree `|α|`. -/
def MonoIdx.deg {k d : ℕ} (m : MonoIdx k d) : ℕ := m.1.val

/-- `x^α`. -/
noncomputable def monoVal {k d : ℕ} (x : Fin k → ℝ) (m : MonoIdx k d) : ℝ := (m.2.1.map x).prod

/-- The Bombieri–Weyl weight `α!/|α|!`. -/
noncomputable def bwWeight {k d : ℕ} (m : MonoIdx k d) : ℝ :=
  (∏ l : Fin k, ((m.2.1.count l).factorial : ℝ)) / (m.deg.factorial : ℝ)

/-- A coefficient index of a map `ℝ^k → ℝ^q` of degree at most `d`: output coordinate and
monomial. -/
abbrev CoefIdx (k q d : ℕ) := Fin q × MonoIdx k d

variable {k q d : ℕ}

/-- The Bombieri–Weyl inner product `Σ_{a,α} b_{a,α} c_{a,α} · α!/|α|!`. -/
noncomputable def bwInner (b c : CoefIdx k q d → ℝ) : ℝ := ∑ i, b i * c i * bwWeight i.2

/-- The squared Bombieri–Weyl norm `Σ_{a,α} b_{a,α}² · α!/|α|!`. -/
noncomputable def bwNormSq (b : CoefIdx k q d → ℝ) : ℝ := bwInner b b

/-- The evaluation map: `p_a(x) = Σ_α b_{a,α} x^α`. -/
noncomputable def bwEval (b : CoefIdx k q d → ℝ) (x : Fin k → ℝ) (a : Fin q) : ℝ :=
  ∑ m : MonoIdx k d, b (a, m) * monoVal x m

/-- The coefficient vector with coordinates `ξ` in the orthonormal basis
`e_{a,α} = (|α|!/α!)^{1/2} δ_{a,α}`. -/
noncomputable def bwOfCoord (ξ : CoefIdx k q d → ℝ) : CoefIdx k q d → ℝ :=
  fun i => ξ i / Real.sqrt (bwWeight i.2)

/-- The Gaussian version: independent `N(0, σ²)` coordinates in the orthonormal basis. -/
noncomputable def bwGauss (k q d : ℕ) (σ : ℝ) : Measure (CoefIdx k q d → ℝ) :=
  (stdGauss (CoefIdx k q d)).map (fun ξ => bwOfCoord (σ • ξ))

/-- The sphere version: uniform on the unit sphere of the Bombieri–Weyl norm. -/
noncomputable def bwSphere (k q d : ℕ) : Measure (CoefIdx k q d → ℝ) :=
  (stdGauss (CoefIdx k q d)).map (fun ξ => bwOfCoord ((1 / Real.sqrt (∑ i, ξ i ^ 2)) • ξ))

/-- `x · y`. -/
def dot {k : ℕ} (x y : Fin k → ℝ) : ℝ := ∑ i, x i * y i

/-! ## §2 Theorem 1 -/

/-- The coefficients of degree `0` and `1` from `b0`, the coefficients of degree `2` to `d`
from `c`. -/
def mixW (b0 c : CoefIdx k q d → ℝ) : CoefIdx k q d → ℝ :=
  fun i => if 2 ≤ i.2.deg then c i else b0 i

/-- `y/|y|` (and `0` at `y = 0`). -/
noncomputable def sphProj {n : ℕ} (y : Fin n → ℝ) : Fin n → ℝ :=
  (1 / Real.sqrt (∑ i, y i ^ 2)) • y

/-- `μ_W`: the distribution of `x = W(u)/|W(u)|`, `u` uniform on the unit sphere of `ℝ^N`. -/
noncomputable def muW {N n d : ℕ} (W : CoefIdx N n d → ℝ) : Measure (Fin n → ℝ) :=
  (uniformSphere N).map (fun u => sphProj (bwEval W u))

/-- `ν_W` (the stand-in): the distribution of `y/|y|`, `y = W_0 + W_1 u + τ g`. It reads only the
coefficients of degree `0` and `1` of `b0`. -/
noncomputable def nuW {N n d : ℕ} (b0 : CoefIdx N n d → ℝ) (τ : ℝ) : Measure (Fin n → ℝ) :=
  ((uniformSphere N).prod (stdGauss (Fin n))).map
    (fun p => sphProj (bwEval (mixW b0 0) p.1 + τ • p.2))

/-- The correlation profile `ρ(t) = (1/(d−1)) Σ_{j=2}^{d} t^j`. -/
noncomputable def rho (d : ℕ) (t : ℝ) : ℝ := (∑ j ∈ Finset.Icc 2 d, t ^ j) / ((d : ℝ) - 1)

/-- `λ_0 = (1/(d−1)) Σ_{j=2}^{d} E (u·u′)^j`, `u, u′` independent and uniform on the unit sphere
of `ℝ^N`. -/
noncomputable def lam0 (N d : ℕ) : ℝ :=
  (∑ j ∈ Finset.Icc 2 d, ∫ u, ∫ u', dot u u' ^ j ∂uniformSphere N ∂uniformSphere N) /
    ((d : ℝ) - 1)

/-! ## §3 Interface statements -/

/-- **The multinomial identity**: `Σ_{|α| = j} (|α|!/α!) x^α y^α = (x·y)^j`. -/
def Multinomial105 : Prop :=
  ∀ (k d : ℕ) (x y : Fin k → ℝ) (j : ℕ), j ≤ d →
    ∑ m : MonoIdx k d, (if m.deg = j then monoVal x m * monoVal y m / bwWeight m else 0) =
      dot x y ^ j

/-- **Centred Gaussian vectors with the same covariance have the same distribution**: for
matrices `A`, `B` with `A Aᵀ = B Bᵀ`, the images of the standard Gaussians agree. -/
def GaussLin105 : Prop :=
  ∀ (ι ι' κ : Type) [Fintype ι] [Fintype ι'] [Fintype κ] (A : Matrix κ ι ℝ) (B : Matrix κ ι' ℝ),
    A * A.transpose = B * B.transpose →
    (stdGauss ι).map (fun ξ => A.mulVec ξ) = (stdGauss ι').map (fun ξ => B.mulVec ξ)

/-- **The pair distribution of the terms of degree 2 to `d`** (Step 2 of the paper proof): for
unit vectors `u, u′`, the pair `(R(u), R(u′))` is `(τ X, τ(ρ X + √(1−ρ²) Z))` in distribution,
`τ = √(d−1)·σ`, `ρ = rho d (u·u′)`. -/
def PairLaw105 : Prop :=
  ∀ (N n d : ℕ) (σ : ℝ) (u u' : Fin N → ℝ), 2 ≤ d → dot u u = 1 → dot u' u' = 1 →
    (bwGauss N n d σ).map
        (fun c => (bwEval (mixW 0 c) u, bwEval (mixW 0 c) u')) =
      ((stdGauss (Fin n)).prod (stdGauss (Fin n))).map
        (fun p => ((Real.sqrt ((d : ℝ) - 1) * σ) • p.1,
          (Real.sqrt ((d : ℝ) - 1) * σ) •
            (rho d (dot u u') • p.1 + Real.sqrt (1 - rho d (dot u u') ^ 2) • p.2)))

/-- `0 ≤ ρ(t) ≤ 1` on `[−1, 1]` (Step 1). -/
def RhoBounds105 : Prop :=
  ∀ (d : ℕ) (t : ℝ), 2 ≤ d → |t| ≤ 1 → 0 ≤ rho d t ∧ rho d t ≤ 1

/-- **The mean of `ρ(u·u′)` over `u′`** does not depend on the unit vector `u` (Step 7). -/
def LamRow105 : Prop :=
  ∀ (N d : ℕ) (u : Fin N → ℝ), 1 ≤ N → dot u u = 1 →
    ∫ u', rho d (dot u u') ∂uniformSphere N = lam0 N d

/-- **The value and the bound of `λ_0`** (Step 9), at degree `6`. -/
def LamValue105 : Prop :=
  ∀ N : ℕ, 1 ≤ N →
    lam0 N 6 = (1 / (N : ℝ) + 3 / ((N : ℝ) * (N + 2)) + 15 / ((N : ℝ) * (N + 2) * (N + 4))) / 5

end BstLean.Part105
