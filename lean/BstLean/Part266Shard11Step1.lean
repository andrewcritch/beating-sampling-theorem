theorem energy_lower_components {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
    0 ≤ kappa (meanLowerRoot 12625 θ ^ 2 / gPlus 12625) - 2 / (12625 : ℝ) ^ 2 ∧
    (804 / 1000 : ℝ) ≤
      √(gMinus 12625 * (kappa (meanLowerRoot 12625 θ ^ 2 / gPlus 12625) -
