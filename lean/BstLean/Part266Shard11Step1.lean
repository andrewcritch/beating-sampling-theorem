  have hkp := (kappa_mem (by linarith : -1 ≤ energyRatio 12625 (gMinus 12625) (54 / 100))
    (by linarith : energyRatio 12625 (gMinus 12625) (54 / 100) ≤ 1)).1
  have hmul := mul_le_mul hg.2.2 (show kappa (energyRatio 12625 (gMinus 12625) (54 / 100)) ≤
