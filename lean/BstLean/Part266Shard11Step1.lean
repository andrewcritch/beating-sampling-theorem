          (1 + 0.0005669 + 2 / 3.141592) / 1.29521 := by gcongr <;> linarith
      _ ≤ ((3660681 / 20000) : ℝ) ^ 2 := by norm_num
  have hroot3 : √((12646 : ℝ) / BstLean.Part154.csC) ≤ (98811273 / 1000000) := by
    apply sqrt_le_iff.mpr
