  have hτ := paperDesign_tauWorld (n := 12648) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12648) hτ
  have hC := centreSources_ret_charge_row 12648 (paperDesignP 12648) hτ
