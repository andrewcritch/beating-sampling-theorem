          (1 + 2 * 1.036505 * (81 / 1000 / 12646)) * 12646 := by gcongr <;> linarith
      _ ≤ ((39976987 / 250000) : ℝ) ^ 2 := by norm_num
  have hroot2 : √(2 * (1 + (11 / 1000 : ℝ)) * BstLean.Part153.wn 12646 * 12646 *
      (1 + BstLean.Part154.deltaChi 12646 12 + 2 / π) / BstLean.Part154.csC) ≤
      (3660681 / 20000) := by
