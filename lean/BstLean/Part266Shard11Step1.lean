  have hbr : (65 / 100 : ℝ) - 2 / 12625 ^ 2 ≤
      kappa (meanLowerRoot 12625 θ ^ 2 / gPlus 12625) - 2 / (12625 : ℝ) ^ 2 := by
    linarith
  have hs : (805 / 1000 : ℝ) ≤ √(gMinus 12625 *
      (kappa (meanLowerRoot 12625 θ ^ 2 / gPlus 12625) - 2 / (12625 : ℝ) ^ 2)) := by
    apply le_sqrt_of_sq_le
    have hp := mul_le_mul hg.1 hbr (by norm_num : (0 : ℝ) ≤ 65 / 100 - 2 / 12625 ^ 2)
      (by linarith [hg.1] : 0 ≤ gMinus 12625)
    linarith
  have ht : √(12 * gPlus 12625) ≤ 7 / 2 :=
    sqrt_le_iff.mpr ⟨by norm_num, by linarith [hg.2.2]⟩
  have hn : (110 : ℝ) ≤ √12625 := le_sqrt_of_sq_le (by norm_num)
