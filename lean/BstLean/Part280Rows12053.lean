theorem exactTableMoments_of_N {c : Ret 12057} (hw : WINDOW (paperDesignP 12057) c)
    (hθ : BstLean.Part280.m2Guard 12057 c) (hc : c ∈ BstLean.Part280.sharpTableN 12057)
