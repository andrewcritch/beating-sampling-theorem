theorem first_matrix_row (c : Ret 12054) (hc : A1 c ∈ Eop 12054) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12054 : ℝ)) ≤ (12880994781 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12054 : ℝ) ≤ (10979071 / 100000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12054 : ℝ) + 2 * √12054 ≤ (613679071 / 50000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

