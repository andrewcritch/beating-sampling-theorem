  norm_num only [Nat.cast_ofNat] at hs ⊢ <;> linarith

theorem outputCentre_row {c : Ret 12055}
    (hc : c ∈ outputCentreEvent (paperCentres 12055)) :
    normSq c.2.1.2 ≤ (2 / (12055 : ℝ)) * eR c * 12055 * chi := by
  change normSq c.2.1.2 ≤ 2 / (mA 12055 : ℝ) * normSq (bR c) * chiUp 12055 at hc
  have hn := normSq_nonneg (bR c)
