      BstLean.Part280.Gen.Row12057.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12057.locationNorm BstLean.Part280.Gen.Row12057.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
