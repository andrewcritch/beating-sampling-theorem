theorem residual_sq_le_energy (c : Ret 12057)
    (p : Ix 12057 × (Fin (12057 - 1) → ℝ)) :
    sgA (paperDesignP 12057) c p.1 p.2 ^ 2 ≤
      (2 / (12057 : ℝ)) * wLatitude c p := by
