  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12057 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12057 : ℝ) * _ ≤ 2 / 12057 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12057)
