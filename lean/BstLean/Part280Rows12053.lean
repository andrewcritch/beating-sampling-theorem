  ∫ a, (stdGauss (Fin (12054 - 1))).real
    {v | sgA (paperDesignP 12054) c a v < rowSigma} ∂muI 12054 ≤ lowMassBudget

noncomputable def hqSplit (c : Ret 12054) : SplitData 12054 :=
