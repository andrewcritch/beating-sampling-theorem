theorem firstMatrix_charge {n : ℕ} (hn : 1 ≤ n) (D : Design n) (hτW : TauWorld D) :
    (retDist D.toCentres).real (agentEv D (FirstMatrix n))ᶜ ≤ exp (-(n : ℝ) / 2) := by
  rw [agentEv_compl]
  apply retDist_agent_charge D hτW (firstMatrix_measurable n) (exp_pos _).le
  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 11903) (hc : A1 c ∈ Eop 11903) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11903 : ℝ)) ≤ (12962440653 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11903 : ℝ) ≤ (109100871 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11903 : ℝ) + 2 * √11903 ≤ (6060600871 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 11903) (hc : c ∈ BstLean.Part164.Eop2 11903) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 11903 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11903) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11903 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11903) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11903).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11903) (FirstMatrix 11903))
    (h2 : c ∈ BstLean.Part164.Eop2 11903) (a : BstLean.Part161.Ix 11903) :
    |VR c a| ≤ varianceMax := by
