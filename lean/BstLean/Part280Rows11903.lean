theorem exp_neg12_row : exp (-12) ≤ (6144212354 / 10 ^ 15 : ℝ) := by
  have he : exp (-1) ≤ (36787944117145 / 10 ^ 14 : ℝ) := by
    apply BstLean.Part156.exp_le_taylor (b := 1) 20 <;>
