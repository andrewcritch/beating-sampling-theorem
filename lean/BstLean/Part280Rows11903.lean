  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((167326771 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((6821123671 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
