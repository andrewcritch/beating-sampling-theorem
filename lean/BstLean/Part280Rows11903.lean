  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((167326771 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((5553409587 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((6013537 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((110623027 / 200000000000))) := by
        gcongr
