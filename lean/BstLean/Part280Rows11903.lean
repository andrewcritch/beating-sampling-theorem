theorem outputCentre_row {c : Ret 11905}
    (hc : c ∈ outputCentreEvent (paperCentres 11905)) :
    normSq c.2.1.2 ≤ (2 / (11905 : ℝ)) * eR c * 11905 * chi := by
  change normSq c.2.1.2 ≤ 2 / (mA 11905 : ℝ) * normSq (bR c) * chiUp 11905 at hc
