    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11904) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11904).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11904) (FirstMatrix 11904))
