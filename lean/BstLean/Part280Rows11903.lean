      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((19181 / 10000) : ℝ) / ((6013537 / 1000000000)) ^ 2 * ((1003 / 1000) * ((7529261 / 200000000000000))) := by
        gcongr
