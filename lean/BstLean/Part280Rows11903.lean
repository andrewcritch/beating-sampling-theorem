  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 11905) (hc : A1 c ∈ Eop 11905) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11905 : ℝ)) ≤ (1620168973 / 125000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11905 : ℝ) ≤ (109110037 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11905 : ℝ) + 2 * √11905 ≤ (6061610037 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 11905) (hc : c ∈ BstLean.Part164.Eop2 11905) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 11905 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11905) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11905 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11905) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11905).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11905) (FirstMatrix 11905))
    (h2 : c ∈ BstLean.Part164.Eop2 11905) (a : BstLean.Part161.Ix 11905) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
