import BstLean.Part78Defs4

/-!
# Part 81, frozen definitions: Theorem 4 at `d_f = 2`, every map degree `d = d_M`, uniform `D`

This file is the degree-`d` form of `Part78Defs`–`Part78Defs4`. It holds definitions and
`Prop`-valued interface statements only. Do not edit this file. Do not use `sorry`,
`native_decide` or `axiom`.

The objects that do not depend on the map degree are reused from `Part78`:
`nsq`, `frobH`, `trH`, `qfun`, `aU`, `zv`, `Phi`, and the interfaces `PoincareMv`, `PoincareMv2`,
`WickTwoPoint`, `GaussLin`, `AffFourth`, `Deg2Fourth`.

Conventions. `n` is the input dimension and the width, `d` is the map degree. `JJ n d` is the type
of the non-constant monomials of `Mono n d`; `pf x q = phiM x q.1`; `kap d x y = Σ_q pf x q * pf y q`.
`eD d = Σ_{j=1}^{d} 1/j!` is the smoothing constant of `g₀` (`aH n d = eD d / DD n d`).
-/

namespace BstLean.Part81

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part36 (CoefIdxD DD unitOfD mapMD)
open BstLean.Part41 (Mono phiM colM varU)
open BstLean.Part53 (aH c0)
open BstLean.Part59 (polyEval TopNZ g0Q)
open BstLean.Part78 (nsq frobH trH qfun aU zv Phi)

variable {n d : ℕ}

/-! ## §1 Features -/

/-- The non-constant raw monomials of degree `≤ d`. -/
abbrev JJ (n d : ℕ) := {q : Mono n d // q ≠ default}

/-- The index of the non-constant part of the coefficient matrix: feature, output index. -/
abbrev WIdx (n d : ℕ) := JJ n d × Fin n

/-- The non-constant raw features. -/
noncomputable def pf (x : Fin n → ℝ) (q : JJ n d) : ℝ := phiM x q.1

/-- The kernel `κ(x,y) = Σ_q p_q(x) p_q(y)`. -/
noncomputable def kap (d : ℕ) (x y : Fin n → ℝ) : ℝ := ∑ q : JJ n d, pf x q * pf y q

/-- `tG = E κ(x,x)`. -/
noncomputable def tG (n d : ℕ) : ℝ := ∫ x, kap d x x ∂uniformSphere n

/-- `mm1 = E_{x,y} κ(x,y) = ‖E p‖²`. -/
noncomputable def mm1 (n d : ℕ) : ℝ := ∫ x, ∫ y, kap d x y ∂uniformSphere n ∂uniformSphere n

/-- `kk2 = E κ(x,x)²`. -/
noncomputable def kk2 (n d : ℕ) : ℝ := ∫ x, kap d x x ^ 2 ∂uniformSphere n

/-- `ss2 = E_{x,y} κ(x,y)²`. -/
noncomputable def ss2 (n d : ℕ) : ℝ := ∫ x, ∫ y, kap d x y ^ 2 ∂uniformSphere n ∂uniformSphere n

/-- The smoothing constant `e_d = Σ_{j=1}^{d} 1/j! = c₀(d) − 1`. -/
noncomputable def eD (d : ℕ) : ℝ := c0 d - 1

/-! ## §2 The Gaussian model given the constant column -/

/-- `F_x = a·z(x) + z(x)ᵀHz(x)`, `z(x) = W p(x)`. -/
noncomputable def FG (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (W : WIdx n d → ℝ)
    (x : Fin n → ℝ) : ℝ := Phi a H W (pf x)

/-- `V = Var_x F_x`. -/
noncomputable def VG (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (W : WIdx n d → ℝ) : ℝ :=
  varU (uniformSphere n) (FG a H W)

/-- `B − g₀ = E_x F_x − e_d tr H` (Gaussian model, given `u`). -/
noncomputable def errG (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (W : WIdx n d → ℝ) : ℝ :=
  ∫ x, FG a H W x ∂uniformSphere n - eD d * trH H

/-- `w(x) = E_W (F_x(W) − E_y F_y(W))²`. -/
noncomputable def wQ (d : ℕ) (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (x : Fin n → ℝ) : ℝ :=
  ∫ W, (FG a H W x - ∫ y, FG a H W y ∂uniformSphere n) ^ 2 ∂stdGauss (WIdx n d)

/-- `r_i(x) = a_i tr H (κ(x,x) − tG) + 2 (Ha)_i (κ(x,x) − E_y κ(x,y))`. -/
noncomputable def rT (d : ℕ) (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (i : Fin n)
    (x : Fin n → ℝ) : ℝ :=
  a i * (trH H * (kap d x x - tG n d)) +
    2 * (∑ k, H i k * a k) * (kap d x x - ∫ y, kap d x y ∂uniformSphere n)

/-! ## §3 Interface statements -/

/-- **Regularity**: `V` and the error are continuous in `(a, W)`. -/
def RegIface (n d : ℕ) : Prop :=
  ∀ H : Matrix (Fin n) (Fin n) ℝ,
    Continuous (fun p : (Fin n → ℝ) × (WIdx n d → ℝ) => VG p.1 H p.2) ∧
    Continuous (fun p : (Fin n → ℝ) × (WIdx n d → ℝ) => errG p.1 H p.2)

/-- **The exact conditional identities** (for every `a`, that is, given the constant column). -/
def MeanIds (n d : ℕ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    Integrable (VG a H) (stdGauss (WIdx n d)) ∧
    Integrable (fun W => VG a H W ^ 2) (stdGauss (WIdx n d)) ∧
    Integrable (fun W => errG a H W ^ 2) (stdGauss (WIdx n d)) ∧
    ∫ W, VG a H W ∂stdGauss (WIdx n d) =
      (tG n d - mm1 n d) * nsq a + trH H ^ 2 * (kk2 n d - tG n d ^ 2) +
        2 * frobH H * (kk2 n d - ss2 n d) ∧
    ∫ W, errG a H W ^ 2 ∂stdGauss (WIdx n d) =
      nsq a * mm1 n d + 2 * frobH H * ss2 n d + trH H ^ 2 * (tG n d - eD d) ^ 2

/-- **The pointwise identity for `w`.** -/
def WQId (n d : ℕ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ x : Fin n → ℝ,
    wQ d a H x = nsq a * (kap d x x - 2 * ∫ y, kap d x y ∂uniformSphere n + mm1 n d) +
      trH H ^ 2 * (kap d x x - tG n d) ^ 2 +
      2 * frobH H * (kap d x x ^ 2 - 2 * ∫ y, kap d x y ^ 2 ∂uniformSphere n + ss2 n d)

/-- **Feature operator bound**: `E (c·p(x))² ≤ (CF/n)‖c‖²`. -/
def FeatOp (n d : ℕ) (CF : ℝ) : Prop :=
  ∀ c : JJ n d → ℝ,
    ∫ x, (∑ q, c q * pf x q) ^ 2 ∂uniformSphere n ≤ CF / (n : ℝ) * ∑ q, c q ^ 2

/-- **Conditional variance bound, kernel form**: `w` is continuous, `E_x w = E_W V`, and
`Var_W V ≤ (c/n) E_x[(‖a‖² + 4‖H‖² κ(x,x)) w(x)]`. -/
def VarBoundK (n d : ℕ) (c : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    Continuous (wQ d a H) ∧
    ∫ x, wQ d a H x ∂uniformSphere n = ∫ W, VG a H W ∂stdGauss (WIdx n d) ∧
    ∫ W, (VG a H W - ∫ W', VG a H W' ∂stdGauss (WIdx n d)) ^ 2 ∂stdGauss (WIdx n d) ≤
      c / (n : ℝ) * ∫ x, (nsq a + 4 * frobH H * kap d x x) * wQ d a H x ∂uniformSphere n

/-- **Conditional variance bound, kernel form, first chaos separated.** -/
def VarBoundK2 (n d : ℕ) (c c' : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∫ W, (VG a H W - ∫ W', VG a H W' ∂stdGauss (WIdx n d)) ^ 2 ∂stdGauss (WIdx n d) ≤
      1 / 2 * (c / (n : ℝ) *
        ∫ x, (nsq a + 4 * frobH H * kap d x x) * wQ d a H x ∂uniformSphere n) +
      1 / 2 * (c' / (n : ℝ) * ∫ x, ∑ i, rT d a H i x ^ 2 ∂uniformSphere n)

/-- **Sphere constants of the kernel.** `tG − e_d ≤ B1/n`, `mm1 ≤ M1/n`, `ss2 ≤ S2/n`,
`Var_x κ(x,x) ≤ VK/n`, and on the sphere `e_d ≤ κ(x,x) ≤ sM` and `0 ≤ E_y κ(x,y) ≤ κ(x,x)`. -/
def SphC (n d : ℕ) (M1 S2 B1 VK sM : ℝ) : Prop :=
  eD d ≤ tG n d ∧ tG n d - eD d ≤ B1 / (n : ℝ) ∧
  0 ≤ mm1 n d ∧ mm1 n d ≤ M1 / (n : ℝ) ∧
  0 ≤ ss2 n d ∧ ss2 n d ≤ S2 / (n : ℝ) ∧
  tG n d ^ 2 ≤ kk2 n d ∧ kk2 n d - tG n d ^ 2 ≤ VK / (n : ℝ) ∧
  ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
    eD d ≤ kap d x x ∧ kap d x x ≤ sM ∧
    0 ≤ ∫ y, kap d x y ∂uniformSphere n ∧ ∫ y, kap d x y ∂uniformSphere n ≤ kap d x x

/-- The floor `α‖a‖² + β‖H‖²` of `E_W V`. -/
def Wf (α β : ℝ) (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) : ℝ := α * nsq a + β * frobH H

/-- **Mean bounds** (given the constant column): integrability, the floor `Wf ≤ E_W V`,
`E_W (B − g₀)² ≤ (M1‖a‖² + E2‖H‖²)/n`, and `E_W V ≤ UA‖a‖² + Uv‖H‖²`. -/
def MB (n d : ℕ) (α β M1 E2 UA Uv : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    Integrable (VG (d := d) a H) (stdGauss (WIdx n d)) ∧
    Integrable (fun W : WIdx n d → ℝ => VG a H W ^ 2) (stdGauss (WIdx n d)) ∧
    Integrable (fun W : WIdx n d → ℝ => errG a H W ^ 2) (stdGauss (WIdx n d)) ∧
    Wf α β a H ≤ ∫ W : WIdx n d → ℝ, VG a H W ∂stdGauss (WIdx n d) ∧
    ∫ W : WIdx n d → ℝ, errG a H W ^ 2 ∂stdGauss (WIdx n d) ≤
      (M1 * nsq a + E2 * frobH H) / (n : ℝ) ∧
    ∫ W : WIdx n d → ℝ, VG a H W ∂stdGauss (WIdx n d) ≤ UA * nsq a + Uv * frobH H

/-- **Conditional variance bound, floor form**: `Var_W V ≤ (cW/n) · Wf · E_W V`. -/
def VarBoundW (n d : ℕ) (α β cW : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∫ W : WIdx n d → ℝ, (VG a H W - ∫ W', VG a H W' ∂stdGauss (WIdx n d)) ^ 2
        ∂stdGauss (WIdx n d) ≤
      cW / (n : ℝ) * Wf α β a H * ∫ W : WIdx n d → ℝ, VG a H W ∂stdGauss (WIdx n d)

/-- **Coefficient form = `(f₀, ℓ, H)` form**, and the value of `g₀` at `d_f = 2`, map degree `d`. -/
def CoefBridge (n d : ℕ) : Prop :=
  ∀ c : Mono n 2 → ℝ, ∃ (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm ∧
    (∀ y : Fin n → ℝ, polyEval 2 c y = qfun (c default) ℓ H y) ∧
    (TopNZ 2 c → 0 < frobH H) ∧
    (∀ M : CoefIdxD n d → ℝ,
      g0Q n d 2 c M = qfun (c default) ℓ H (colM M default) + eD d / DD n d * trH H)

/-- **The split** of the coefficient vector into the constant column `u` and the rest `W`, as a
measurable equivalence that preserves the standard Gaussian measure. -/
def SplitIface (n d : ℕ) : Prop :=
  ∃ comb : ((Fin n → ℝ) × (WIdx n d → ℝ)) ≃ᵐ (CoefIdxD n d → ℝ),
    MeasurePreserving comb ((stdGauss (Fin n)).prod (stdGauss (WIdx n d)))
      (stdGauss (CoefIdxD n d)) ∧
    ∀ (u : Fin n → ℝ) (W : WIdx n d → ℝ),
      colM (comb (u, W)) default = u ∧
      (∀ (x : Fin n → ℝ) (i : Fin n), mapMD (comb (u, W)) x i = u i + zv W (pf x) i) ∧
      ∑ α, comb (u, W) α ^ 2 = ∑ i, u i ^ 2 + ∑ β, W β ^ 2

/-- **Radius tail**: `P(|‖Z‖²/𝒟 − 1| > δ) ≤ 2/(𝒟 δ²)`. -/
def RadTail (n d : ℕ) : Prop :=
  ∀ δ : ℝ, 0 < δ →
    stdGauss (CoefIdxD n d) {Z | δ ^ 2 < ((∑ α, Z α ^ 2) / DD n d - 1) ^ 2} ≤
      ENNReal.ofReal (2 / DD n d / δ ^ 2)

/-- **Generic kernel facts**: signs, `(E κ(x,x))² ≤ E κ(x,x)²`, and the consequences of a feature
operator bound: `mm1 ≤ CF/n`, `ss2 ≤ (CF/n) tG`. -/
def KerGen (n d : ℕ) : Prop :=
  0 ≤ mm1 n d ∧ 0 ≤ ss2 n d ∧ tG n d ^ 2 ≤ kk2 n d ∧
  ∀ CF : ℝ, 0 ≤ CF → FeatOp n d CF →
    mm1 n d ≤ CF / (n : ℝ) ∧ ss2 n d ≤ CF / (n : ℝ) * tG n d

end BstLean.Part81
