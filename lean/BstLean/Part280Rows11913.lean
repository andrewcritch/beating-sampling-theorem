    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11915) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11915).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11915) (FirstMatrix 11915))
    (h2 : c ∈ BstLean.Part164.Eop2 11915) (a : BstLean.Part161.Ix 11915) :
