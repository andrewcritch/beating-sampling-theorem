theorem variance_of_matrix_events (c : Ret 11913) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11913).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11913) (FirstMatrix 11913))
