theorem variance_of_matrix_events (c : Ret 12007) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12007).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12007) (FirstMatrix 12007))
    (h2 : c ∈ BstLean.Part164.Eop2 12007) (a : BstLean.Part161.Ix 12007) :
