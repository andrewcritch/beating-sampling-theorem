  have hn : √(12007 : ℝ) ≤ (54788229 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12007 : ℝ) + 2 * √12007 ≤ (3056538229 / 250000) := by linarith
