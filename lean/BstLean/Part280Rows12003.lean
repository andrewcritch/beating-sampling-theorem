    ∫ a, ∫ v, |lA (paperDesignP 12007) c a v - lbar (paperDesignP 12007) c a| ^ (2 * q)
      ∂stdGauss (Fin (12007 - 1)) ∂muI 12007 ≤ locationMomentBudget c q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
