      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((5988437 / 1000000000)) ^ 2 * ((1003 / 1000) * ((37021611 / 1000000000000000))) := by
        gcongr
