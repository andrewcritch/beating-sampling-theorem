  refine hc.trans ?_
  have hs : √(2 / (mA 12004 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12004) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12004 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12004) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12004).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12004) (FirstMatrix 12004))
    (h2 : c ∈ BstLean.Part164.Eop2 12004) (a : BstLean.Part161.Ix 12004) :
