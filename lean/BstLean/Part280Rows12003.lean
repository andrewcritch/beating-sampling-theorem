  ∫ a, (stdGauss (Fin (12004 - 1))).real
    {v | sgA (paperDesignP 12004) c a v < rowSigma} ∂muI 12004 ≤ lowMassBudget

noncomputable def hqSplit (c : Ret 12004) : SplitData 12004 :=
