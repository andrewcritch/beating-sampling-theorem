  have hf8 : sharpAf ^ 8 ≤ BstLean.Part280.Gen.Row12007.locationError ^ 8 :=
    pow_le_pow_left₀ (by norm_num [sharpAf]) (by norm_num [sharpAf, BstLean.Part280.Gen.Row12007.locationError]) 8
  have hpm := BstLean.Part280.Gen.Row12007.pass_moments_of_events c hw he hc _ (htab.1.trans hw8) (htab.2.trans hf8)
  have hm : PaperMoments c (keptIx (paperDesignP 12007) c (BstLean.Part280.Gen.Row12007.hqSplit c))
      BstLean.Part280.Gen.Row12007.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12007.locationNorm BstLean.Part280.Gen.Row12007.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
  exact passInputs_of_paperMoments (by norm_num) c BstLean.Part280.Gen.Row12007.eta_pos BstLean.Part280.Gen.Row12007.eta_lt_one
    (sqrt_nonneg _) he BstLean.Part280.Gen.Row12007.bias_floor_ge (by norm_num [BstLean.Part280.Gen.Row12007.epsilon]) BstLean.Part280.Gen.Row12007.bias_threshold_pos
    (by norm_num [sharpAw]) (by norm_num [sharpAf]) (by norm_num [BstLean.Part280.Gen.Row12007.locationNorm])
    (by norm_num [BstLean.Part280.Gen.Row12007.varianceNorm]) BstLean.Part280.Gen.Row12007.row_split_floor.le
    (BstLean.Part280.Gen.Row12007.pass_centre_of_events c hc) hm

