theorem first_matrix_row (c : Ret 12004) (hc : A1 c ∈ Eop 12004) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12004 : ℝ)) ≤ (1613474171 / 125000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12004 : ℝ) ≤ (6847673 / 62500) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12004 : ℝ) + 2 * √12004 ≤ (381972673 / 31250) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

