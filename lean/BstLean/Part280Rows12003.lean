theorem exactTableMoments_of_N {c : Ret 12007} (hw : WINDOW (paperDesignP 12007) c)
    (hθ : BstLean.Part280.m2Guard 12007 c) (hc : c ∈ BstLean.Part280.sharpTableN 12007)
    (K : Set (Ix 12007)) : ExactTableMoments c K := by
  have h := hc (BstLean.Part280.tightG_of_window (by norm_num) c hw hθ)
  obtain ⟨MF, bF⟩ := bdd_exF (by norm_num) c
  obtain ⟨MW, bW⟩ := bdd_exW (by norm_num) c
  have hF := intOn_of_bdd ((measurable_exF c).pow_const 8) (bdd_pow bF 8) Set.univ
  have hE := intOn_of_bdd ((measurable_exW c).pow_const 8) (bdd_pow bW 8) Set.univ
  rw [integrableOn_univ] at hF hE
  refine ⟨?_, ?_⟩
  · exact (setIntegral_le_integral hF
      (Filter.Eventually.of_forall fun a => by positivity)).trans h.1
  · exact (setIntegral_le_integral hE
      (Filter.Eventually.of_forall fun a => by positivity)).trans h.2

theorem sharp_hq_passes {c : Ret 12007} (hw : WINDOW (paperDesignP 12007) c)
    (ha : c ∈ BstLean.Part280.Gen.Row12007.analyticBase) (hX : ∀ K, ExactTableMoments c K) :
    BstLean.Part241.PassInputs c (BstLean.Part280.Gen.Row12007.hqSplit c) BstLean.Part280.Gen.Row12007.chi BstLean.Part280.Gen.Row12007.biasFloor BstLean.Part280.Gen.Row12007.epsilon
