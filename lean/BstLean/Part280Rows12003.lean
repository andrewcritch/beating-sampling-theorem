  have he : 0 < eR c := by linarith [(BstLean.Part280.Gen.Row12007.centre_energy_range hw ha).1]
  have hc := BstLean.Part280.Gen.Row12007.analyticBaseCertificate.pass_fields ha
  have hK : MeasurableSet (keptIx (paperDesignP 12007) c (BstLean.Part280.Gen.Row12007.hqSplit c)) :=
    measurableSet_keptSet _ (BstLean.Part280.Gen.Row12007.hqSplit c).mgood (measurableSet_bulkIx _ _) _
  have hsub : keptIx (paperDesignP 12007) c (BstLean.Part280.Gen.Row12007.hqSplit c) ⊆ bulkIx (paperDesignP 12007) c :=
    fun _ h => h.1
  have hfirst : A1 c ∈ BstLean.Part153.Eop 12007 := hc.1.1.2 hw.2.1
  have hsecond : c ∈ BstLean.Part164.Eop2 12007 := hc.1.2
  have htab := stored_table_moments c hw hfirst hsecond hK hsub (hX _)
  have hw8 : sharpAw ^ 8 ≤ BstLean.Part280.Gen.Row12007.energyError ^ 8 :=
