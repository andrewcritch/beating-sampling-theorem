  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((336038873 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((274207127 / 50000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5988437 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((548505649 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((336038873 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((53888281 / 8000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5988437 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((673715771 / 1000000000000))) := by
