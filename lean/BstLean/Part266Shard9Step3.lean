    (hw : WINDOW (paperDesignP 12587) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12587) c a v ^ 8
      ∂stdGauss (Fin (12587 - 1)) ∂muI 12587 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12587).prod (stdGauss (Fin (12587 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12587) c (hc.1.1.1.1 hw.2.1)
