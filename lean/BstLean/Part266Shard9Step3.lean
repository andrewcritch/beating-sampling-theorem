theorem removal_of_low_mass {c : Ret 12582}
    (hw : WINDOW (paperDesignP 12582) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12582 - 1))).real
