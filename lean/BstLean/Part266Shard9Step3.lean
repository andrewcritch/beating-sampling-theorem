      ∂stdGauss (Fin (12599 - 1)) ∂muI 12599 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12599).prod (stdGauss (Fin (12599 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
