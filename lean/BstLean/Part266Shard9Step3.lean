theorem removal_of_low_mass {c : Ret 12585}
    (hw : WINDOW (paperDesignP 12585) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12585 - 1))).real
      {v | sgA (paperDesignP 12585) c a v < √(2 / (12585 : ℝ) * mixtureFloor)}
      ∂muI 12585 ≤ lowMassBudget) :
