  have hL2 := pow_le_pow_left₀ hl0 hl1 2
  have hb : 12579 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon) ≤
      12579 * ((11739359 / 500000000) : ℝ) ^ 2 / 2 + ((66200239 / 40000000)) ^ 2 * (1 + (11739359 / 500000000)) := by
    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (12579 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
