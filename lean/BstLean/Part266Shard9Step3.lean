theorem removal_of_low_mass {c : Ret 12578}
    (hw : WINDOW (paperDesignP 12578) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12578 - 1))).real
      {v | sgA (paperDesignP 12578) c a v < √(2 / (12578 : ℝ) * mixtureFloor)}
      ∂muI 12578 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12578 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12578 ≤
        removalBudget := by
