theorem sigma_bounds : ((1476057 / 250000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (5904229 / 1000000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

theorem sigma_pos : 0 < rowSigma := by linarith [sigma_bounds.1]

theorem split_width_bounds {c : Ret 12585} (he : (6 / 10 : ℝ) ≤ eR c) :
    0 < splitLocationWidth c ∧ splitLocationWidth c ≤ (220424153 / 62500000000) ∧
    0 < splitResidualWidth ∧ splitResidualWidth ≤ (1721920833 / 50000000000000) := by
