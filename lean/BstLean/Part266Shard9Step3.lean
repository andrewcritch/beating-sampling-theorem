    ∫ a, ∫ v, sgA (paperDesignP 12591) c a v ^ 8
      ∂stdGauss (Fin (12591 - 1)) ∂muI 12591 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12591).prod (stdGauss (Fin (12591 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12591) c (hc.1.1.1.1 hw.2.1)
