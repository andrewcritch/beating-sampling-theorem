    ∫ a, (∫ v, (sgA (paperDesignP 12311) c a v - gbar (paperDesignP 12311) c a) ^ 2
      ∂stdGauss (Fin (12311 - 1))) ^ 2 ∂muI 12311 ≤ residualVarianceBudget ^ 2 := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
