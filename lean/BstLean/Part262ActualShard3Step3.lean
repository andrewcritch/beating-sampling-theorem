theorem residual_sq_le_energy (c : Ret 12323)
    (p : Ix 12323 × (Fin (12323 - 1) → ℝ)) :
    sgA (paperDesignP 12323) c p.1 p.2 ^ 2 ≤
      (2 / (12323 : ℝ)) * wLatitude c p := by
