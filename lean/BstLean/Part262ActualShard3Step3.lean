      ∫ w, sA (paperDesignP 12308) c a w ∂stdGauss (Fin (12308 - 1))) ^ 2
      ∂stdGauss (Fin (12308 - 1))) ^ 2 ∂muI 12308 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12308) c
