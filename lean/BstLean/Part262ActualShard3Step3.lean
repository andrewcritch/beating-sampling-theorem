theorem residual_sq_le_energy (c : Ret 12301)
    (p : Ix 12301 × (Fin (12301 - 1) → ℝ)) :
    sgA (paperDesignP 12301) c p.1 p.2 ^ 2 ≤
      (2 / (12301 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12301).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12301) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12301 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12301 : ℝ) * _ ≤ 2 / 12301 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12301)
