    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12308) c M H xi)
    (hE : centreEnergy (paperDesignP 12308) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12308 : ℝ))))
    (hprice : massBound 12308 M H xi E u mixtureFloor ≤ 12308 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12308 - 1))).real
