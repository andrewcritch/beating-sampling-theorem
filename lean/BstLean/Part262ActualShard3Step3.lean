theorem full_residual_eighth {c : Ret 12311}
    (hw : WINDOW (paperDesignP 12311) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12311) c a v ^ 8
      ∂stdGauss (Fin (12311 - 1)) ∂muI 12311 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12311).prod (stdGauss (Fin (12311 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12311) c (hc.1.1.1.1 hw.2.1)
