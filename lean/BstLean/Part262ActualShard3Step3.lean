    (hw : WINDOW (paperDesignP 12305) c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12305) c a v - gbar (paperDesignP 12305) c a| ^ (2 * q)
      ∂stdGauss (Fin (12305 - 1)) ∂muI 12305 ≤ residualMomentBudget q ^ (2 * q) := by
