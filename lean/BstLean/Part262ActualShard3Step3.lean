theorem removal_of_low_mass {c : Ret 12324}
    (hw : WINDOW (paperDesignP 12324) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12324 - 1))).real
