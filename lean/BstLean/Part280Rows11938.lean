  have hs : √(2 / (11940 : ℝ)) ≤ (6471170443 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11940 : ℝ) ≤ (27317577 / 250000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11940 : ℝ) + 2 * √11940 ≤ (1519817577 / 125000) := by linarith
