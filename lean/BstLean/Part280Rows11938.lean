    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11938 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11938) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11938).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11938) (FirstMatrix 11938))
    (h2 : c ∈ BstLean.Part164.Eop2 11938) (a : BstLean.Part161.Ix 11938) :
