theorem outputCentre_row {c : Ret 11940}
    (hc : c ∈ outputCentreEvent (paperCentres 11940)) :
    normSq c.2.1.2 ≤ (2 / (11940 : ℝ)) * eR c * 11940 * chi := by
  change normSq c.2.1.2 ≤ 2 / (mA 11940 : ℝ) * normSq (bR c) * chiUp 11940 at hc
