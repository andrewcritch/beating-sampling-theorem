    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11940) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11940).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11940) (FirstMatrix 11940))
    (h2 : c ∈ BstLean.Part164.Eop2 11940) (a : BstLean.Part161.Ix 11940) :
    |VR c a| ≤ varianceMax := by
