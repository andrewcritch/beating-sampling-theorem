    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 12280)]
  exact ⟨by linarith, by linarith [hbulk _ hs.1 hs.2], by nlinarith⟩

theorem node_trace_charge_row {wr : WRet 12280} (hw : windowW wr) :
    (gaussMat (mA 12280) 12280 (2 / (12280 : ℝ))).real {X | ∃ g < Js 12280,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12280 : ℝ)) ∨
