/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12291) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12291) c (rowSplit c wl ws),
    ((12291 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12291 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12291) c (rowSplit c wl ws),
    ((12291 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12291 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12291 - 1)))
    (rowSplit c wl ws).good a ∂muI 12291 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12291) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12291 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12291) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12291 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12291) c (rowSplit c wl ws),
    hellG2 12291 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12291 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 12291}
    (hw : WINDOW (paperDesignP 12291) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
  window := hw
