  have hlam : √(tA 12302 * ((160 : ℝ) ^ 2 / (12302 - 2))) ^ 18 =
      (tA 12302 * ((160 : ℝ) ^ 2 / (12302 - 2))) ^ 9 := by
    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num [tA, mA])]
  have hσ : √((42 / 10 : ℝ) / 12302) ^ 18 = ((42 / 10 : ℝ) / 12302) ^ 9 := by
    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num)]
  simp only [mul_pow, hlam, hσ]
  calc
    _ ≤ (tA 12302 * ((160 : ℝ) ^ 2 / (12302 - 2))) ^ 9 *
        ((42 / 10 : ℝ) / 12302) ^ 9 *
        (2 * 12302 * (212 / 100 : ℝ) + (269 / 10) * 8) ^ 18 * (61 / 100 : ℝ) ^ 18 := by
      gcongr <;> first
