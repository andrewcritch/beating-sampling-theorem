theorem residual_sq_le_energy (c : Ret 12507)
    (p : Ix 12507 × (Fin (12507 - 1) → ℝ)) :
    sgA (paperDesignP 12507) c p.1 p.2 ^ 2 ≤
      (2 / (12507 : ℝ)) * wLatitude c p := by
