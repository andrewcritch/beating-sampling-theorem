      ∂stdGauss (Fin (12518 - 1)) ∂muI 12518 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12518).prod (stdGauss (Fin (12518 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12518) c (hc.1.1.1.1 hw.2.1)
