/-- All twenty-eight fields concern the original retained network and latitude measure. -/
noncomputable def latitudeMoments {c : Ret 12501}
    (hw : WINDOW (paperDesignP 12501) c) (he : 0 < eR c) (hc : c ∈ passEvent)
