theorem residual_sq_le_energy (c : Ret 12520)
    (p : Ix 12520 × (Fin (12520 - 1) → ℝ)) :
    sgA (paperDesignP 12520) c p.1 p.2 ^ 2 ≤
      (2 / (12520 : ℝ)) * wLatitude c p := by
