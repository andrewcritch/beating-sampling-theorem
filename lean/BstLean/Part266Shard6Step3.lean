  have hm := sharp_residual_mass (by norm_num) (paperDesignP 12504) c hw.2.1 hb hb0
    hI hE hu hu1 hd hg
  have hl := latitude_mass_of_MASS (by norm_num) (paperDesignP 12504) c hw.1 hw.2.1
    (by norm_num [mixtureFloor]) hm
