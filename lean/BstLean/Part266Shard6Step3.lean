theorem removal_of_low_mass {c : Ret 12520}
    (hw : WINDOW (paperDesignP 12520) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12520 - 1))).real
      {v | sgA (paperDesignP 12520) c a v < √(2 / (12520 : ℝ) * mixtureFloor)}
      ∂muI 12520 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12520 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12520 ≤
        removalBudget := by
  have hl := locationMomentBudget_pos he (by norm_num : 12 ≤ 12)
  have hs := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
  have h := int_removed (by norm_num) (paperDesignP 12520) c
