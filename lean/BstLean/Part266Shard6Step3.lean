      ∫ w, sA (paperDesignP 12515) c a w ∂stdGauss (Fin (12515 - 1))) ^ 2
      ∂stdGauss (Fin (12515 - 1))) ^ 2 ∂muI 12515 ≤ scaleVarianceBudget ^ 2 :=
