      ∫ w, sA (paperDesignP 12513) c a w ∂stdGauss (Fin (12513 - 1))) ^ 2
      ∂stdGauss (Fin (12513 - 1))) ^ 2 ∂muI 12513 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12513) c
