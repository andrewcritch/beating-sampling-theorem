theorem removal_of_low_mass {c : Ret 12501}
    (hw : WINDOW (paperDesignP 12501) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12501 - 1))).real
      {v | sgA (paperDesignP 12501) c a v < √(2 / (12501 : ℝ) * mixtureFloor)}
      ∂muI 12501 ≤ lowMassBudget) :
