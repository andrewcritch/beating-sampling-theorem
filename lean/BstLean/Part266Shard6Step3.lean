theorem low_mass_of_interfaces {c : Ret 12504}
    (hw : WINDOW (paperDesignP 12504) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12504).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12504) c M H xi)
    (hE : centreEnergy (paperDesignP 12504) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12504 : ℝ))))
    (hprice : massBound 12504 M H xi E u mixtureFloor ≤ 12504 * lowMassBudget) :
