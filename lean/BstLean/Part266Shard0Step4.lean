    (hw : BstLean.Part161.WINDOW (paperDesignP 12363) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12363 - 1))).real
      {v | sgA (paperDesignP 12363) c a v < rowSigma} ∂BstLean.Part161.muI 12363 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
