theorem hq_output_bounds {c : Ret 12367}
    (hw : WINDOW (paperDesignP 12367) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12367)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
