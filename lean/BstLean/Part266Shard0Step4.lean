theorem hq_output_bounds {c : Ret 12360}
    (hw : WINDOW (paperDesignP 12360) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12360)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
