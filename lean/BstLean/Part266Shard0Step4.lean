    (hw : BstLean.Part161.WINDOW (paperDesignP 12367) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12367 - 1))).real
      {v | sgA (paperDesignP 12367) c a v < rowSigma} ∂BstLean.Part161.muI 12367 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
