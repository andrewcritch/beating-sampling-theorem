theorem hq_output_bounds {c : Ret 12359}
    (hw : WINDOW (paperDesignP 12359) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12359)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
