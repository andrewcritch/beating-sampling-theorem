  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((337597903 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((1313331793 / 250000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5959413 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((533003483 / 1000000000000))) := by
        gcongr
