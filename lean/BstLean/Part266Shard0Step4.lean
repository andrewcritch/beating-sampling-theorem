def LowResidualMass (c : Ret 12366) : Prop :=
  ∫ a, (stdGauss (Fin (12366 - 1))).real
    {v | sgA (paperDesignP 12366) c a v < rowSigma} ∂muI 12366 ≤ lowMassBudget

