  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((168839463 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((131237529 / 25000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2978983 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((133186157 / 250000000000))) := by
        gcongr
