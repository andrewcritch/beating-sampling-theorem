  (muI 12360).map (tableNodeIndex wr)

theorem tableNodeMeasure_mass (wr : WRet 12360) : tableNodeMeasure wr univ = 1 := by
  rw [tableNodeMeasure, Measure.map_apply (tableNodeIndex_measurable wr) MeasurableSet.univ]
