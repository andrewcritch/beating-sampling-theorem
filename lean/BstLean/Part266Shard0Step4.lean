    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 12360) (mA 12360) (tA 12360) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
