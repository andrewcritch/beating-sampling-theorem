      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5955317 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((266135357 / 500000000000))) := by
        gcongr
