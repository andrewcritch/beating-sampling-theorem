    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 12363)]
  exact ⟨by linarith, by linarith [hbulk _ hs.1 hs.2], by nlinarith⟩

theorem node_trace_charge_row {wr : WRet 12363} (hw : windowW wr) :
    (gaussMat (mA 12363) 12363 (2 / (12363 : ℝ))).real {X | ∃ g < Js 12363,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12363 : ℝ)) ∨
