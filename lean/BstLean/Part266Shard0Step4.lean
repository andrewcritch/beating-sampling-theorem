  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((168893443 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5244407029 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5956039 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((13309997 / 25000000000))) := by
        gcongr
