def LowResidualMass (c : Ret 12373) : Prop :=
  ∫ a, (stdGauss (Fin (12373 - 1))).real
    {v | sgA (paperDesignP 12373) c a v < rowSigma} ∂muI 12373 ≤ lowMassBudget

