theorem first_matrix_row (c : Ret 12775) (hc : A1 c ∈ Eop 12775) : OpB (A1 c) 163 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12775 : ℝ)) ≤ (6256112471 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12775 : ℝ) ≤ (56513273 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12775 : ℝ) + 2 * √12775 ≤ (3250263273 / 250000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12775) (hc : c ∈ BstLean.Part164.Eop2 12775) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12775 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12775) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12775 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12775) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12775).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12775) (FirstMatrix 12775))
    (h2 : c ∈ BstLean.Part164.Eop2 12775) (a : BstLean.Part161.Ix 12775) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

