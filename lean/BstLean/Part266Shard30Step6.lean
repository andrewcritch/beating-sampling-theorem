    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num [tA, mA])]
  have hσ : √((42 / 10 : ℝ) / 13108) ^ 18 = ((42 / 10 : ℝ) / 13108) ^ 9 := by
    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num)]
  simp only [mul_pow, hlam, hσ]
  calc
    _ ≤ (tA 13108 * ((165 : ℝ) ^ 2 / (13108 - 2))) ^ 9 *
        ((42 / 10 : ℝ) / 13108) ^ 9 *
        (2 * 13108 * (212 / 100 : ℝ) + (269 / 10) * 8) ^ 18 * (61 / 100 : ℝ) ^ 18 := by
      gcongr <;> first
