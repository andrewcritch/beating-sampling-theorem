  have hlam : √(tA 12902 * ((164 : ℝ) ^ 2 / (12902 - 2))) ^ 18 =
      (tA 12902 * ((164 : ℝ) ^ 2 / (12902 - 2))) ^ 9 := by
    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num [tA, mA])]
  have hσ : √((42 / 10 : ℝ) / 12902) ^ 18 = ((42 / 10 : ℝ) / 12902) ^ 9 := by
    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num)]
  simp only [mul_pow, hlam, hσ]
  calc
    _ ≤ (tA 12902 * ((164 : ℝ) ^ 2 / (12902 - 2))) ^ 9 *
