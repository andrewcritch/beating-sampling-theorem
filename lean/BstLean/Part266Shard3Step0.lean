theorem first_matrix_row (c : Ret 12425) (hc : A1 c ∈ Eop 12425) : OpB (A1 c) 161 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12425 : ℝ)) ≤ (6343614797 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12425 : ℝ) ≤ (22293497 / 200000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12425 : ℝ) + 2 * √12425 ≤ (1264793497 / 100000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12425) (hc : c ∈ BstLean.Part164.Eop2 12425) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12425 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12425) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12425 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12425) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12425).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12425) (FirstMatrix 12425))
    (h2 : c ∈ BstLean.Part164.Eop2 12425) (a : BstLean.Part161.Ix 12425) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

