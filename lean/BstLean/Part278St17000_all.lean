  exact BstLean.Part179.N30.N27.N26.N25.N24.N23.N22.J1725.J17.M.classifier_paper_gen22k_st (hodd := hodd) (BstLean.Part185.K.HQG_of hHQ hEn hFn hn) (by omega) t (Sm := SminN n)
