theorem exactTableMoments_of_N {c : Ret 12082} (hw : WINDOW (paperDesignP 12082) c)
    (hθ : BstLean.Part280.m2Guard 12082 c) (hc : c ∈ BstLean.Part280.sharpTableN 12082)
