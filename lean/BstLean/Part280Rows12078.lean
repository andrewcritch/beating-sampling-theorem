      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((746227 / 125000000)) ^ 2 * ((1003 / 1000) * ((18281619 / 500000000000000))) := by
        gcongr
