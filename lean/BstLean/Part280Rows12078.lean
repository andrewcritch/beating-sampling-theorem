      ∂stdGauss (Fin (12082 - 1)) ∂muI 12082 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12082).prod (stdGauss (Fin (12082 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
