  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84268547 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((3336686421 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
