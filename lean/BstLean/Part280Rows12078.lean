  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84268547 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((5433131677 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((746227 / 125000000)) * ((1001 / 1000 + 52 / 1000) * ((6813733 / 12500000000))) := by
        gcongr
