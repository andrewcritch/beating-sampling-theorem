  removal : ∫ a, removed (stdGauss (Fin (12080 - 1)))
    (rowSplit c wl ws).good a ∂muI 12080 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12080) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12080 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12080) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12080 ≤ mixtureRoot ^ 2
