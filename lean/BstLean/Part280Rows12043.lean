theorem first_matrix_row (c : Ret 12045) (hc : A1 c ∈ Eop 12045) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12045 : ℝ)) ≤ (1288580621 / 100000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12045 : ℝ) ≤ (27437429 / 250000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12045 : ℝ) + 2 * √12045 ≤ (1533062429 / 125000) := by linarith
