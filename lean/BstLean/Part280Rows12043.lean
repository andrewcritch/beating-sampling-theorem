  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12043) (hc : A1 c ∈ Eop 12043) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12043 : ℝ)) ≤ (3221719037 / 250000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12043 : ℝ) ≤ (27435151 / 250000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12043 : ℝ) + 2 * √12043 ≤ (1532810151 / 125000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12043) (hc : c ∈ BstLean.Part164.Eop2 12043) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12043 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12043) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12043 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12043) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12043).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12043) (FirstMatrix 12043))
    (h2 : c ∈ BstLean.Part164.Eop2 12043) (a : BstLean.Part161.Ix 12043) :
