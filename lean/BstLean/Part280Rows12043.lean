    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12045) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12045).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12045) (FirstMatrix 12045))
    (h2 : c ∈ BstLean.Part164.Eop2 12045) (a : BstLean.Part161.Ix 12045) :
    |VR c a| ≤ varianceMax := by
