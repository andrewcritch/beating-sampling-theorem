  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((347734987 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4802102993 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2891849 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((125506149 / 250000000000))) := by
