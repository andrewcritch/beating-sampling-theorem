  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((2891849 / 500000000)) ^ 2 * ((1003 / 1000) * ((6202853 / 200000000000000))) := by
        gcongr
