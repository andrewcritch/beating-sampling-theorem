theorem node_trace_charge_row {wr : WRet 13106} (hw : windowW wr) :
    (gaussMat (mA 13106) 13106 (2 / (13106 : ℝ))).real {X | ∃ g < Js 13106,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13106 : ℝ)) ∨
