    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13105) (mA 13105) (tA 13105) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
