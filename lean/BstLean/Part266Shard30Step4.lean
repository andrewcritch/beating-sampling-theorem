def LowResidualMass (c : Ret 13115) : Prop :=
  ∫ a, (stdGauss (Fin (13115 - 1))).real
    {v | sgA (paperDesignP 13115) c a v < rowSigma} ∂muI 13115 ≤ lowMassBudget

