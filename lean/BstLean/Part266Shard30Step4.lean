theorem hq_output_bounds {c : Ret 13119}
    (hw : WINDOW (paperDesignP 13119) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13119)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
