    (hw : BstLean.Part161.WINDOW (paperDesignP 13102) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13102 - 1))).real
      {v | sgA (paperDesignP 13102) c a v < rowSigma} ∂BstLean.Part161.muI 13102 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
