theorem hq_output_bounds {c : Ret 13109}
    (hw : WINDOW (paperDesignP 13109) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13109)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
