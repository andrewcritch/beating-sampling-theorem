    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13113 - 1))).real
      {v | sgA (paperDesignP 13113) c a v < rowSigma} ∂BstLean.Part161.muI 13113 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
