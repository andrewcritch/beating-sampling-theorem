theorem hq_output_bounds {c : Ret 13116}
    (hw : WINDOW (paperDesignP 13116) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13116)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
