  removal : ∫ a, removed (stdGauss (Fin (13123 - 1)))
    (rowSplit c wl ws).good a ∂muI 13123 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13123) c (rowSplit c wl ws),
