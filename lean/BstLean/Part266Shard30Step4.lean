def LowResidualMass (c : Ret 13122) : Prop :=
  ∫ a, (stdGauss (Fin (13122 - 1))).real
    {v | sgA (paperDesignP 13122) c a v < rowSigma} ∂muI 13122 ≤ lowMassBudget

