    (hw : WINDOW (paperDesignP 13116) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13116)) (hm : LowResidualMass c) :
    FLUCT_hyp (paperDesignP 13116) t c (hqSplit c) (24 / 10000) := by
  have he := (centre_energy_range hw ha).1
