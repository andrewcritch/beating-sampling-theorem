theorem exactTableMoments_of_N {c : Ret 12067} (hw : WINDOW (paperDesignP 12067) c)
    (hθ : BstLean.Part280.m2Guard 12067 c) (hc : c ∈ BstLean.Part280.sharpTableN 12067)
