    simpa only [IntegrableOn, Measure.restrict_univ] using hh
  refine (setIntegral_le_integral iV
    (Filter.Eventually.of_forall fun a => sq_nonneg ((n : ℝ) * VR c a))).trans ?_
  have hid : (fun a => ((n : ℝ) * VR c a) ^ 2) =
