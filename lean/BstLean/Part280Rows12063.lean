theorem first_matrix_row (c : Ret 12065) (hc : A1 c ∈ Eop 12065) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12065 : ℝ)) ≤ (643756073 / 50000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12065 : ℝ) ≤ (54920397 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12065 : ℝ) + 2 * √12065 ≤ (3071170397 / 250000) := by linarith
