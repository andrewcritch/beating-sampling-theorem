theorem variance_of_matrix_events (c : Ret 12063) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12063).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12063) (FirstMatrix 12063))
