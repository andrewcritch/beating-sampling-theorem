      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((2986763 / 500000000)) ^ 2 * ((1003 / 1000) * ((36654229 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84216849 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((5443270429 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2986763 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((136444163 / 250000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84216849 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((6685827383 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
