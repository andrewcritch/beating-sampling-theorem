theorem exactTableMoments_of_N {c : Ret 12072} (hw : WINDOW (paperDesignP 12072) c)
    (hθ : BstLean.Part280.m2Guard 12072 c) (hc : c ∈ BstLean.Part280.sharpTableN 12072)
