  have hs : √(2 / (12070 : ℝ)) ≤ (12872454423 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12070 : ℝ) ≤ (1716618 / 15625) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12070 : ℝ) + 2 * √12070 ≤ (192026986 / 15625) := by linarith
