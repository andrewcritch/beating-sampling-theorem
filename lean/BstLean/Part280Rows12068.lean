    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12070) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12070).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12070) (FirstMatrix 12070))
    (h2 : c ∈ BstLean.Part164.Eop2 12070) (a : BstLean.Part161.Ix 12070) :
