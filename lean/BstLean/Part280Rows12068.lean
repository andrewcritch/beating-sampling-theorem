theorem variance_of_matrix_events (c : Ret 12068) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12068).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12068) (FirstMatrix 12068))
    (h2 : c ∈ BstLean.Part164.Eop2 12068) (a : BstLean.Part161.Ix 12068) :
