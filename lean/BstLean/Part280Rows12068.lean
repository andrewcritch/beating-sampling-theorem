  have hs : √(2 / (12068 : ℝ)) ≤ (12873521039 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12068 : ℝ) ≤ (2197089 / 20000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12068 : ℝ) + 2 * √12068 ≤ (122877089 / 10000) := by linarith
