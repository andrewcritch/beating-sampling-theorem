    fun _ h => h.1.2, fun _ h => h.1.1.2, fun _ h => h.2⟩

def baseEvent (T : Set (Ret 12443)) : Set (Ret 12443) := analyticBase ∩ T

theorem baseEvent_measurable {T : Set (Ret 12443)} (hT : MeasurableSet T) :
