  have hτ := paperDesign_tauWorld (n := 12440) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12440) hτ
  have hC := centreSources_ret_charge_row 12440 (paperDesignP 12440) hτ
