  have hτ := paperDesign_tauWorld (n := 12449) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12449) hτ
  have hC := centreSources_ret_charge_row 12449 (paperDesignP 12449) hτ
