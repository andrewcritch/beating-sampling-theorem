      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5919771 / 1000000000)) ^ 2 * ((1003 / 1000) * ((34037961 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169915997 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5149161967 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5919771 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((525933397 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169915997 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((6324543439 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
