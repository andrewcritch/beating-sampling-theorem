open BstLean.Part29 (stdGauss)

/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12523) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12523) c (rowSplit c wl ws),
    ((12523 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12523 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12523) c (rowSplit c wl ws),
    ((12523 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12523 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12523 - 1)))
    (rowSplit c wl ws).good a ∂muI 12523 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12523) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12523 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12523) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12523 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12523) c (rowSplit c wl ws),
    hellG2 12523 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12523 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 12523}
    (hw : WINDOW (paperDesignP 12523) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
  window := hw
  energy_pos := he
  centre := pass_centre_of_events c hc
  moments := pass_moments_of_events c hw he hc _ R.energy_table R.location_table
  removal := R.removal
  mixture := R.mixture
  displacement := R.displacement

/-- This structure value can be passed directly to Part243 once the five remainder bounds hold. -/
noncomputable def rootInputs_of_events {t : ℝ} {c : Ret 12523}
    (hw : WINDOW (paperDesignP 12523) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) :
    BstLean.Part243.RootInputs 12523 t c BstLean.Part266.agent12523.root :=
  rootInputs (rootSource_of_events hw he hc R)

end BstLean.Part266.Row12523

/-! The analytic base has an unconditional payment. The null output-centre
exception adds no payment. This event does not supply the stored-table bounds. -/
namespace BstLean.Part266.Row12523
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part157 BstLean.Part169

def paidBaseEvent : Set (Ret 12523) :=
  analyticBase ∩ positiveOutputEvent (paperCentres 12523)

theorem paidBaseEvent_measurable : MeasurableSet paidBaseEvent :=
  analyticBase_measurable.inter (positiveOutputEvent_measurable _)

theorem paidBaseEvent_charge :
    (retDist (paperCentres 12523)).real paidBaseEventᶜ ≤ analyticCharge := by
  unfold paidBaseEvent
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans
    (add_le_add analyticBase_charge (positiveOutputEvent_charge (by norm_num) _))).trans
      (by simp)

structure PaidBaseCertificate (H : Set (Ret 12523)) : Prop where
  measurable : MeasurableSet paidBaseEvent
  charge : (retDist (paperCentres 12523)).real (H ∩ paidBaseEventᶜ) ≤
    BstLean.Part249.baseChargeAllowance
  analytic : paidBaseEvent ⊆ analyticBase
  positive_output : paidBaseEvent ⊆ positiveOutputEvent (paperCentres 12523)

theorem paidBaseCertificate (H : Set (Ret 12523)) : PaidBaseCertificate H := by
  refine ⟨paidBaseEvent_measurable, ?_, fun _ h => h.1, fun _ h => h.2⟩
  exact ((measureReal_mono inter_subset_right (measure_ne_top _ _)).trans
    paidBaseEvent_charge).trans (by
      norm_num [analyticCharge, BstLean.Part249.baseChargeAllowance,
        BstLean.Part243.proposedRetainedCharge])

