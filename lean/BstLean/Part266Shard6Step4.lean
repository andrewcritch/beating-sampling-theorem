    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 12505)]
  exact ⟨by linarith, by linarith [hbulk _ hs.1 hs.2], by nlinarith⟩

theorem node_trace_charge_row {wr : WRet 12505} (hw : windowW wr) :
    (gaussMat (mA 12505) 12505 (2 / (12505 : ℝ))).real {X | ∃ g < Js 12505,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12505 : ℝ)) ∨
