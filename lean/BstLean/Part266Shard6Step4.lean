  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((21230277 / 62500) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2577978819 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
