    (by norm_num [mA] : (0 : ℝ) ≤ (mA 12825 : ℝ) / 2 + 320)
  have h2 := mul_le_mul hs ht (sqrt_nonneg _) (by norm_num : (0 : ℝ) ≤ 9)
  norm_num only [mA, Nat.cast_pow, Nat.cast_ofNat] at h1 h2 ⊢
  norm_num only [show (12825 : ℝ) ^ 2 / 2 + 320 = 164481265 / 2 by norm_num,
    show (12825 : ℝ) ^ 2 / 2 + 160 = 164480945 / 2 by norm_num] at h1 h2 ⊢
