theorem residual_sq_le_energy (c : Ret 12037)
    (p : Ix 12037 × (Fin (12037 - 1) → ℝ)) :
    sgA (paperDesignP 12037) c p.1 p.2 ^ 2 ≤
      (2 / (12037 : ℝ)) * wLatitude c p := by
