  have hsub : keptIx (paperDesignP 12037) c (BstLean.Part280.Gen.Row12037.hqSplit c) ⊆ bulkIx (paperDesignP 12037) c :=
    fun _ h => h.1
  have hfirst : A1 c ∈ BstLean.Part153.Eop 12037 := hc.1.1.2 hw.2.1
  have hsecond : c ∈ BstLean.Part164.Eop2 12037 := hc.1.2
  have htab := stored_table_moments c hw hfirst hsecond hK hsub (hX _)
