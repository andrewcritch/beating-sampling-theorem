theorem firstMatrix_charge {n : ℕ} (hn : 1 ≤ n) (D : Design n) (hτW : TauWorld D) :
    (retDist D.toCentres).real (agentEv D (FirstMatrix n))ᶜ ≤ exp (-(n : ℝ) / 2) := by
  rw [agentEv_compl]
  apply retDist_agent_charge D hτW (firstMatrix_measurable n) (exp_pos _).le
  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12033) (hc : A1 c ∈ Eop 12033) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12033 : ℝ)) ≤ (6446114921 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12033 : ℝ) ≤ (13711879 / 125000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12033 : ℝ) + 2 * √12033 ≤ (765774379 / 62500) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12033) (hc : c ∈ BstLean.Part164.Eop2 12033) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12033 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12033) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12033 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12033) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12033).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12033) (FirstMatrix 12033))
    (h2 : c ∈ BstLean.Part164.Eop2 12033) (a : BstLean.Part161.Ix 12033) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
