    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12035) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12035).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12035) (FirstMatrix 12035))
    (h2 : c ∈ BstLean.Part164.Eop2 12035) (a : BstLean.Part161.Ix 12035) :
