theorem residual_sq_le_energy (c : Ret 12042)
    (p : Ix 12042 × (Fin (12042 - 1) → ℝ)) :
    sgA (paperDesignP 12042) c p.1 p.2 ^ 2 ≤
      (2 / (12042 : ℝ)) * wLatitude c p := by
