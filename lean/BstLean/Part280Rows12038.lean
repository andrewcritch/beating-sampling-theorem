  removal : ∫ a, removed (stdGauss (Fin (12040 - 1)))
    (rowSplit c wl ws).good a ∂muI 12040 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12040) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12040 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12040) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12040 ≤ mixtureRoot ^ 2
