structure RootRemainder (t : ℝ) (c : Ret 12040) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12040) c (rowSplit c wl ws),
    ((12040 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12040 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12040) c (rowSplit c wl ws),
