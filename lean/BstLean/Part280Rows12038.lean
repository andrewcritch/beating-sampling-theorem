      (pLat (paperDesignP 12041) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12041 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12041) c (rowSplit c wl ws),
    hellG2 12041 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12041 ≤ displacementBudget

