    ∫ a, ∫ v, |lA (paperDesignP 12707) c a v - lbar (paperDesignP 12707) c a| ^ (2 * q)
      ∂stdGauss (Fin (12707 - 1)) ∂muI 12707 ≤ locationMomentBudget c q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
