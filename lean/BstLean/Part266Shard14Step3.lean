theorem variance_budgets_row {c : Ret 12700} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (16537273 / 500000000000000) ∧ residualVarianceBudget ≤ (1562577 / 500000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
  have hce : latitudeC / eR c ≤ 16 / 3 := by
