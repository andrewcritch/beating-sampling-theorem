theorem low_mass_of_interfaces {c : Ret 12701}
    (hw : WINDOW (paperDesignP 12701) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12701).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12701) c M H xi)
    (hE : centreEnergy (paperDesignP 12701) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12701 : ℝ))))
    (hprice : massBound 12701 M H xi E u mixtureFloor ≤ 12701 * lowMassBudget) :
