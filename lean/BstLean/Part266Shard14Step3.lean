      ∫ w, sA (paperDesignP 12701) c a w ∂stdGauss (Fin (12701 - 1))) ^ 2
      ∂stdGauss (Fin (12701 - 1))) ^ 2 ∂muI 12701 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12701) c
