theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (314965671 / 62500000000000) ∧
    residualMomentBudget 6 ≤ (1237954937 / 200000000000000) ∧
    residualMomentBudget 12 ≤ (4246425643 / 500000000000000) := by
  refine ⟨?_, ?_, ?_⟩
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
