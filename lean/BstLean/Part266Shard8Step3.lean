theorem full_residual_eighth {c : Ret 12567}
    (hw : WINDOW (paperDesignP 12567) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12567) c a v ^ 8
      ∂stdGauss (Fin (12567 - 1)) ∂muI 12567 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12567).prod (stdGauss (Fin (12567 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12567) c (hc.1.1.1.1 hw.2.1)
  have h32 := energy_latitude_norm (by norm_num) c hw.1 hw.2.1 hE
  have h8 : LBound μ 8 (fun p => |√(wLatitude c p) - 1|)
      (BstLean.Part222.energyAllowance 12567) :=
    h32.lower (by norm_num) (by norm_num) (by norm_num) (by simp [μ])
  have h1 : LBound μ 8 (fun _ => (1 : ℝ)) 1 :=
    LBound.const (by norm_num : (8 : ℕ) ≠ 0) (by simp [μ]) (by norm_num)
  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (12567 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 12567) c p.1 p.2)
      (√(2 / (12567 : ℝ)) * (1 + BstLean.Part222.energyAllowance 12567)) := by
    apply hn.mono (measurable_sgA _ c)
    apply Filter.Eventually.of_forall
