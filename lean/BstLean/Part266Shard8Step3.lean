theorem sigma_bounds : ((295611 / 50000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (5912221 / 1000000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

