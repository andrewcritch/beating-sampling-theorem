      ∫ w, sA (paperDesignP 12557) c a w ∂stdGauss (Fin (12557 - 1))) ^ 2
      ∂stdGauss (Fin (12557 - 1))) ^ 2 ∂muI 12557 ≤ scaleVarianceBudget ^ 2 :=
