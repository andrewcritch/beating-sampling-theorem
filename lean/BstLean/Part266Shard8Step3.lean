theorem variance_budgets_row {c : Ret 12550} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (33869993 / 1000000000000000) ∧ residualVarianceBudget ≤ (1619283 / 500000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
  have hce : latitudeC / eR c ≤ 16 / 3 := by
    rw [div_le_iff₀ (by linarith : 0 < eR c)]
