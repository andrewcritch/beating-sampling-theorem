      ∂stdGauss (Fin (12568 - 1)) ∂muI 12568 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12568).prod (stdGauss (Fin (12568 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12568) c (hc.1.1.1.1 hw.2.1)
