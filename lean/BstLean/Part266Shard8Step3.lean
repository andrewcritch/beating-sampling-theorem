      ∫ w, sA (paperDesignP 12554) c a w ∂stdGauss (Fin (12554 - 1))) ^ 2
      ∂stdGauss (Fin (12554 - 1))) ^ 2 ∂muI 12554 ≤ scaleVarianceBudget ^ 2 :=
