    LBound.const (by norm_num : (8 : ℕ) ≠ 0) (by simp [μ]) (by norm_num)
  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (12573 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 12573) c p.1 p.2)
      (√(2 / (12573 : ℝ)) * (1 + BstLean.Part222.energyAllowance 12573)) := by
