theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (5130090627 / 1000000000000000) ∧
    residualMomentBudget 6 ≤ (6301116259 / 1000000000000000) ∧
    residualMomentBudget 12 ≤ (8645669533 / 1000000000000000) := by
  refine ⟨?_, ?_, ?_⟩
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
      rotation_four (by norm_num)
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
