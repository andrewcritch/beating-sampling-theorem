theorem residual_sq_le_energy (c : Ret 12572)
    (p : Ix 12572 × (Fin (12572 - 1) → ℝ)) :
    sgA (paperDesignP 12572) c p.1 p.2 ^ 2 ≤
      (2 / (12572 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12572).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12572) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12572 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12572 : ℝ) * _ ≤ 2 / 12572 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12572)
  norm_num [mA]
