      ∂stdGauss (Fin (12562 - 1)) ∂muI 12562 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12562).prod (stdGauss (Fin (12562 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
