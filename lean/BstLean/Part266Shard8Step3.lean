    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12551 : ℝ))))
    (hprice : massBound 12551 M H xi E u mixtureFloor ≤ 12551 * lowMassBudget) :
