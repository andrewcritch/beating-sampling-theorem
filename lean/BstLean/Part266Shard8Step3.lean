      ∫ w, sA (paperDesignP 12572) c a w ∂stdGauss (Fin (12572 - 1))) ^ 2
      ∂stdGauss (Fin (12572 - 1))) ^ 2 ∂muI 12572 ≤ scaleVarianceBudget ^ 2 :=
