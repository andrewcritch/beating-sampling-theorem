  have hτ := paperDesign_tauWorld (n := 12765) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12765) hτ
  have hC := centreSources_ret_charge_row 12765 (paperDesignP 12765) hτ
