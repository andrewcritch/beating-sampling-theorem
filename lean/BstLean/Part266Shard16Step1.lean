  have h1 := ethm_charge (paperCentres 12763)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12763) (paperCentres 12763)
  have he : exp (-(45 / 10000 * (12763 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12763 : ℝ))) ≤ exp (-12) ^ 2 := by
