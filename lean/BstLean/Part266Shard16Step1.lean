    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ 2 * (1 + (11 / 1000 : ℝ)) *
          (1 + 2 * 1.036505 * (81 / 1000 / 12771)) * 12771 := by gcongr <;> linarith
      _ ≤ ((160696303 / 1000000) : ℝ) ^ 2 := by norm_num
  have hroot2 : √(2 * (1 + (11 / 1000 : ℝ)) * BstLean.Part153.wn 12771 * 12771 *
      (1 + BstLean.Part154.deltaChi 12771 12 + 2 / π) / BstLean.Part154.csC) ≤
      (18393643 / 100000) := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ 2 * (1 + (11 / 1000 : ℝ)) * 1.036505 * 12771 *
          (1 + 0.0005669 + 2 / 3.141592) / 1.29521 := by gcongr <;> linarith
      _ ≤ ((18393643 / 100000) : ℝ) ^ 2 := by norm_num
  have hroot3 : √((12771 : ℝ) / BstLean.Part154.csC) ≤ (3971937 / 40000) := by
    apply sqrt_le_iff.mpr
