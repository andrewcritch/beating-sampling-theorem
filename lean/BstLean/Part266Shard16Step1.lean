  unfold worldAngles
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans (add_le_add (h1.trans he)
    (h2.trans exp_neg12_row))).trans (by norm_num)

def analyticBase : Set (Ret 12763) :=
  (passEvent ∩ agentEv (paperDesignP 12763) (DirectionError 12763) ∩
    agentEv (paperDesignP 12763) (CentreSources 12763 12763)) ∩ worldAngles

