  (measurableSet_Ethm _).inter (measurableSet_Ethp _)

theorem worldAngles_charge :
    (retDist (paperCentres 12758)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12758)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12758) (paperCentres 12758)
  have he : exp (-(45 / 10000 * (12758 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12758 : ℝ))) ≤ exp (-12) ^ 2 := by
