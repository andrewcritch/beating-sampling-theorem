  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12754)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12754) (CentreSources 12754 12754)
  direction : analyticBase ⊆ agentEv (paperDesignP 12754) (DirectionError 12754)
  angles : analyticBase ⊆ worldAngles

