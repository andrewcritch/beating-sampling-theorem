  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12757)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12757) (CentreSources 12757 12757)
  direction : analyticBase ⊆ agentEv (paperDesignP 12757) (DirectionError 12757)
  angles : analyticBase ⊆ worldAngles

