  have hb0 := BstLean.Part150.betaJ_nonneg 12771
  have hw := wn_upper
  have hw0 : 0 ≤ BstLean.Part153.wn 12771 := by unfold BstLean.Part153.wn; positivity
  have hc := cs_lower
  have hdc := deltaChi_upper
  have hdc0 : 0 ≤ BstLean.Part154.deltaChi 12771 12 := by
    unfold BstLean.Part154.deltaChi
    positivity
  have hp := pi_gt_d6.le
  have h2pi : (2.506628 : ℝ) ≤ √(2 * π) := le_sqrt_of_sq_le (by linarith)
  have hroot1 : √(2 * (1 + (11 / 1000 : ℝ)) *
      (1 + 2 * BstLean.Part153.wn 12771 * BstLean.Part150.betaJ 12771) * 12771) ≤
      (160696303 / 1000000) := by
