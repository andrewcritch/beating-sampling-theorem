    (retDist (paperCentres 12763)).real analyticBaseᶜ ≤ analyticCharge := by
  have hτ := paperDesign_tauWorld (n := 12763) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12763) hτ
  have hC := centreSources_ret_charge_row 12763 (paperDesignP 12763) hτ
