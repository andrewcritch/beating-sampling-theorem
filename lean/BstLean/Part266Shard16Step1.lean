  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12753)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12753) (CentreSources 12753 12753)
  direction : analyticBase ⊆ agentEv (paperDesignP 12753) (DirectionError 12753)
  angles : analyticBase ⊆ worldAngles

