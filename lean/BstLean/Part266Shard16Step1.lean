theorem energy_upper_coarse :
    energyUpper 12758 (gMinus 12758) (gPlus 12758)
      (finiteEnergy 12758 12758 (11 / 1000)) (54 / 100) ≤ 9 / 10 := by
  have hg := energy_g_bounds
  have hr := energy_ratio_coarse
  have hr0 : 0 ≤ energyRatio 12758 (gMinus 12758) (54 / 100) := by
    unfold energyRatio
