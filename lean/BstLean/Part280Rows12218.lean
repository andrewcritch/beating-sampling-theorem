theorem location_variance_on_event {c : Ret 12222}
    (hw : WINDOW (paperDesignP 12222) c) (he : 0 < eR c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (lA (paperDesignP 12222) c a v - lbar (paperDesignP 12222) c a) ^ 2
      ∂stdGauss (Fin (12222 - 1))) ^ 2 ∂muI 12222 ≤ locationVarianceBudget c ^ 2 := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
