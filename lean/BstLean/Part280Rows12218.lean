    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12222) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12222).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12222) (FirstMatrix 12222))
    (h2 : c ∈ BstLean.Part164.Eop2 12222) (a : BstLean.Part161.Ix 12222) :
