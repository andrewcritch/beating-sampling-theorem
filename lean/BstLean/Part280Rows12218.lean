    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12220) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12220).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12220) (FirstMatrix 12220))
    (h2 : c ∈ BstLean.Part164.Eop2 12220) (a : BstLean.Part161.Ix 12220) :
    |VR c a| ≤ varianceMax := by
