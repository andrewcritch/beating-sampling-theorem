      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2967759 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((107770167 / 200000000000))) := by
