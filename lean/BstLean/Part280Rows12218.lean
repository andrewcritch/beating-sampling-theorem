  have hs : √(2 / (12222 : ℝ)) ≤ (511686371 / 40000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12222 : ℝ) ≤ (22110631 / 200000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12222 : ℝ) + 2 * √12222 ≤ (1244310631 / 100000) := by linarith
