  rw [removal_root, displacement_root]
  have h := stored_bias_root
  norm_num [mixtureRoot, biasRootCap, BstLean.Part280.Gen.agent12220] at *
  linarith

/-- A structure value records all checked scalar guards and the numerical reserve. -/
