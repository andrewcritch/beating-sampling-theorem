    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13163) (mA 13163) (tA 13163) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
