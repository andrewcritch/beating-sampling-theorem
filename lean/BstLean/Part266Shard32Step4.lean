      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1443889 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((250305893 / 500000000000))) := by
        gcongr
