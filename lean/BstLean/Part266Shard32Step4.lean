  removal : ∫ a, removed (stdGauss (Fin (13167 - 1)))
    (rowSplit c wl ws).good a ∂muI 13167 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13167) c (rowSplit c wl ws),
