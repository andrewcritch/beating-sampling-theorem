      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((180397 / 31250000)) ^ 2 * ((1003 / 1000) * ((6155821 / 200000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((34838987 / 100000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((596845693 / 125000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((180397 / 31250000)) * ((1001 / 1000 + 52 / 1000) * ((3125733 / 6250000000))) := by
