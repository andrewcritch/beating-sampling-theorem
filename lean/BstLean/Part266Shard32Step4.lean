      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13167) (mA 13167) (tA 13167) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
