  removal : ∫ a, removed (stdGauss (Fin (13173 - 1)))
    (rowSplit c wl ws).good a ∂muI 13173 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13173) c (rowSplit c wl ws),
