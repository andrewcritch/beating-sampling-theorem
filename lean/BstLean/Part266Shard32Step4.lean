def LowResidualMass (c : Ret 13164) : Prop :=
  ∫ a, (stdGauss (Fin (13164 - 1))).real
    {v | sgA (paperDesignP 13164) c a v < rowSigma} ∂muI 13164 ≤ lowMassBudget

