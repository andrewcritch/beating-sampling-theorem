theorem node_trace_charge_row {wr : WRet 13156} (hw : windowW wr) :
    (gaussMat (mA 13156) 13156 (2 / (13156 : ℝ))).real {X | ∃ g < Js 13156,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13156 : ℝ)) ∨
