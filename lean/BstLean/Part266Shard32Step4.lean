theorem hq_output_bounds {c : Ret 13163}
    (hw : WINDOW (paperDesignP 13163) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13163)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
