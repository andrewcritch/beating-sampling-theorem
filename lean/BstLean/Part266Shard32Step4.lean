    (gaussMat (mA 13157) 13157 (2 / (13157 : ℝ))).real {X | ∃ g < Js 13157,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13157 : ℝ)) ∨
