theorem hq_displacement_root {c : Ret 13169} (he : (6 / 10 : ℝ) ≤ eR c)
    {B : ℝ} (hB0 : 0 ≤ B) (hB : B ≤ removalBudget) :
    √(Dpap 13169 B hqCentreCap (locationVarianceBudget c) scaleVarianceBudget eta rowSigma) ≤
