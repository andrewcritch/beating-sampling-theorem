  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((69696289 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4770959 / 1000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
