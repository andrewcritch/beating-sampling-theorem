theorem removal_of_low_mass {c : Ret 12928}
    (hw : WINDOW (paperDesignP 12928) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12928 - 1))).real
      {v | sgA (paperDesignP 12928) c a v < √(2 / (12928 : ℝ) * mixtureFloor)}
      ∂muI 12928 ≤ lowMassBudget) :
