  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12940 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12940 : ℝ) * _ ≤ 2 / 12940 *
