theorem residual_sq_le_energy (c : Ret 12929)
    (p : Ix 12929 × (Fin (12929 - 1) → ℝ)) :
    sgA (paperDesignP 12929) c p.1 p.2 ^ 2 ≤
      (2 / (12929 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12929).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12929) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12929 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12929 : ℝ) * _ ≤ 2 / 12929 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12929)
