    (gaussMat (mA 12768) 12768 (2 / (12768 : ℝ))).real {X | ∃ g < Js 12768,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12768 : ℝ)) ∨
