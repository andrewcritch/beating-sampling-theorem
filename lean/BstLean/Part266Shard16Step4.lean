theorem node_trace_charge_row {wr : WRet 12767} (hw : windowW wr) :
    (gaussMat (mA 12767) 12767 (2 / (12767 : ℝ))).real {X | ∃ g < Js 12767,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12767 : ℝ)) ∨
