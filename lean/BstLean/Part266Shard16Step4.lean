    (gaussMat (mA 12770) 12770 (2 / (12770 : ℝ))).real {X | ∃ g < Js 12770,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12770 : ℝ)) ∨
