      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5862223 / 1000000000)) ^ 2 * ((1003 / 1000) * ((32733401 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((171564649 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2500205657 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5862223 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((515753907 / 1000000000000))) := by
        gcongr
