def LowResidualMass (c : Ret 12765) : Prop :=
  ∫ a, (stdGauss (Fin (12765 - 1))).real
    {v | sgA (paperDesignP 12765) c a v < rowSigma} ∂muI 12765 ≤ lowMassBudget

