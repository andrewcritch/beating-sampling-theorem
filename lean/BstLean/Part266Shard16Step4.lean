  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((21444753 / 62500) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5000999057 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1465613 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((20631773 / 40000000000))) := by
        gcongr
