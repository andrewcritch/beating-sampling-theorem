structure RootRemainder (t : ℝ) (c : Ret 12759) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12759) c (rowSplit c wl ws),
    ((12759 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12759 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12759) c (rowSplit c wl ws),
