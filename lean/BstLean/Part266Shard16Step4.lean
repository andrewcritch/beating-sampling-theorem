  let ρ := BstLean.Part169.rhoR c
  have hρ2 : ρ ^ 2 = normSq c.1.2 + 12764 * BstLean.Part169.tauR c ^ 2 := by
    change (√(normSq c.1.2 + (12764 : ℝ) * BstLean.Part169.tauR c ^ 2)) ^ 2 = _
