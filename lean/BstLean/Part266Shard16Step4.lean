theorem node_trace_charge_row {wr : WRet 12763} (hw : windowW wr) :
    (gaussMat (mA 12763) 12763 (2 / (12763 : ℝ))).real {X | ∃ g < Js 12763,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12763 : ℝ)) ∨
