    (gaussMat (mA 12755) 12755 (2 / (12755 : ℝ))).real {X | ∃ g < Js 12755,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12755 : ℝ)) ∨
