theorem residual_sq_le_energy (c : Ret 13101)
    (p : Ix 13101 × (Fin (13101 - 1) → ℝ)) :
    sgA (paperDesignP 13101) c p.1 p.2 ^ 2 ≤
      (2 / (13101 : ℝ)) * wLatitude c p := by
