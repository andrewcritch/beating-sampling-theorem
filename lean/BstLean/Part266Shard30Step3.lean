theorem residual_sq_le_energy (c : Ret 13120)
    (p : Ix 13120 × (Fin (13120 - 1) → ℝ)) :
    sgA (paperDesignP 13120) c p.1 p.2 ^ 2 ≤
      (2 / (13120 : ℝ)) * wLatitude c p := by
