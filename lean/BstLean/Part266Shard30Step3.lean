theorem low_mass_of_interfaces {c : Ret 13104}
    (hw : WINDOW (paperDesignP 13104) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 13104).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 13104) c M H xi)
    (hE : centreEnergy (paperDesignP 13104) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (13104 : ℝ))))
    (hprice : massBound 13104 M H xi E u mixtureFloor ≤ 13104 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (13104 - 1))).real
      {v | sgA (paperDesignP 13104) c a v < √(2 / (13104 : ℝ) * mixtureFloor)}
        ∂muI 13104 ≤ lowMassBudget := by
