      ∫ w, sA (paperDesignP 13104) c a w ∂stdGauss (Fin (13104 - 1))) ^ 2
      ∂stdGauss (Fin (13104 - 1))) ^ 2 ∂muI 13104 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 13104) c
