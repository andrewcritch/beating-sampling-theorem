  have ha0 := layerAllowance_nonneg (mA 12625)
  change 0 ≤ agentLayerAllowance 12625 at ha0
  have he : energyWeightAllowance 12625 ≤ (1395 / 1000000 : ℝ) := by
    unfold energyWeightAllowance
