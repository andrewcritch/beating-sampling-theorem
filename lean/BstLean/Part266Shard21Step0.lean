    (add_nonneg (add_nonneg (by norm_num) (sqrt_nonneg _)) (gaussMomConst_nonneg 80))
    (by norm_num)).trans (by norm_num)

theorem jacobian_squared_row : latitudeJacobianSquared160 12875 4 ≤ (81 / 16 : ℝ) := by
  have hs : √(2 / (mA 12875 : ℝ)) ≤ (109841831 / 1000000000000) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  have hinner : planeEnvelopeSquared160 12875 4 +
      2 / (mA 12875 : ℝ) * frobEnvelopeSquared160 12875 ≤ (21 / 10 : ℝ) ^ 2 := by
    have hp := plane_squared_row
    norm_num [frobEnvelopeSquared160, mA] at *
    linarith
  have hr : √(planeEnvelopeSquared160 12875 4 +
      2 / (mA 12875 : ℝ) * frobEnvelopeSquared160 12875) ≤ (21 / 10 : ℝ) :=
    (sqrt_le_iff).mpr ⟨by norm_num, hinner⟩
  have ht : transverseConstant160 * √(2 / (mA 12875 : ℝ)) *
