    (√(tA 13077 * ((165 : ℝ) ^ 2 / (13077 - 2))) * √((42 / 10 : ℝ) / 13077) *
      energyCoefficient18 13077) ^ 18 * (61 / 100 : ℝ) ^ 18 ≤
