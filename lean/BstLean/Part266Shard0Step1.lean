  unfold worldAngles
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans (add_le_add (h1.trans he)
    (h2.trans exp_neg12_row))).trans (by norm_num)

def analyticBase : Set (Ret 12363) :=
  (passEvent ∩ agentEv (paperDesignP 12363) (DirectionError 12363) ∩
    agentEv (paperDesignP 12363) (CentreSources 12363 12363)) ∩ worldAngles

