  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12355)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12355) (CentreSources 12355 12355)
  direction : analyticBase ⊆ agentEv (paperDesignP 12355) (DirectionError 12355)
