  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12354)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12354) (CentreSources 12354 12354)
  direction : analyticBase ⊆ agentEv (paperDesignP 12354) (DirectionError 12354)
  angles : analyticBase ⊆ worldAngles

