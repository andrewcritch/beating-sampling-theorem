  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12363)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12363) (CentreSources 12363 12363)
  direction : analyticBase ⊆ agentEv (paperDesignP 12363) (DirectionError 12363)
  angles : analyticBase ⊆ worldAngles

