  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12358)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12358) (CentreSources 12358 12358)
  direction : analyticBase ⊆ agentEv (paperDesignP 12358) (DirectionError 12358)
  angles : analyticBase ⊆ worldAngles

