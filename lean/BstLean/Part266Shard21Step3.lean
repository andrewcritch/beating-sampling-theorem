theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (4937030791 / 1000000000000000) ∧
    residualMomentBudget 6 ≤ (189498843 / 31250000000000) ∧
    residualMomentBudget 12 ≤ (8320174269 / 1000000000000000) := by
  refine ⟨?_, ?_, ?_⟩
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
