theorem variance_budgets_row {c : Ret 12875} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (32181439 / 1000000000000000) ∧ residualVarianceBudget ≤ (749859 / 250000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
