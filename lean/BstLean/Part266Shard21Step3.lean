  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12893 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12893 : ℝ) * _ ≤ 2 / 12893 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12893)
