noncomputable def lowMassBudget : ℝ := 5 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 12888}
    (hw : WINDOW (paperDesignP 12888) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12888 - 1))).real
      {v | sgA (paperDesignP 12888) c a v < √(2 / (12888 : ℝ) * mixtureFloor)}
      ∂muI 12888 ≤ lowMassBudget) :
