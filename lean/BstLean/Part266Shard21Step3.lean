noncomputable def fullResidualBudget : ℝ := √(2 / (12895 : ℝ)) * locationNorm

theorem residual_sq_le_energy (c : Ret 12895)
    (p : Ix 12895 × (Fin (12895 - 1) → ℝ)) :
    sgA (paperDesignP 12895) c p.1 p.2 ^ 2 ≤
      (2 / (12895 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12895).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12895) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12895 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12895 : ℝ) * _ ≤ 2 / 12895 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12895)
  norm_num [mA]
  linarith

theorem full_residual_eighth {c : Ret 12895}
    (hw : WINDOW (paperDesignP 12895) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12895) c a v ^ 8
      ∂stdGauss (Fin (12895 - 1)) ∂muI 12895 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12895).prod (stdGauss (Fin (12895 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12895) c (hc.1.1.1.1 hw.2.1)
  have h32 := energy_latitude_norm (by norm_num) c hw.1 hw.2.1 hE
  have h8 : LBound μ 8 (fun p => |√(wLatitude c p) - 1|)
      (BstLean.Part222.energyAllowance 12895) :=
    h32.lower (by norm_num) (by norm_num) (by norm_num) (by simp [μ])
  have h1 : LBound μ 8 (fun _ => (1 : ℝ)) 1 :=
    LBound.const (by norm_num : (8 : ℕ) ≠ 0) (by simp [μ]) (by norm_num)
  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (12895 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 12895) c p.1 p.2)
      (√(2 / (12895 : ℝ)) * (1 + BstLean.Part222.energyAllowance 12895)) := by
    apply hn.mono (measurable_sgA _ c)
    apply Filter.Eventually.of_forall
    intro p
    rw [abs_of_nonneg (sgA_nonneg _ _ _ _), abs_of_nonneg (by positivity)]
    have hh := sqrt_le_sqrt (residual_sq_le_energy c p)
    rw [sqrt_sq_eq_abs, abs_of_nonneg (sgA_nonneg _ _ _ _), sqrt_mul (by norm_num)] at hh
    have ht := mul_le_mul_of_nonneg_left (le_abs_self (√(wLatitude c p) - 1))
      (sqrt_nonneg (2 / (12895 : ℝ)))
    nlinarith
  have hs' : LBound μ 8 (fun p => sgA (paperDesignP 12895) c p.1 p.2) fullResidualBudget := by
    refine ⟨hs.measurable, by unfold fullResidualBudget locationNorm; positivity,
      hs.bound.trans (ENNReal.ofReal_le_ofReal ?_)⟩
    apply mul_le_mul_of_nonneg_left _ (sqrt_nonneg _)
    have he := energy_allowance_row
    unfold locationNorm
    linarith
