    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12876 : ℝ))))
    (hprice : massBound 12876 M H xi E u mixtureFloor ≤ 12876 * lowMassBudget) :
