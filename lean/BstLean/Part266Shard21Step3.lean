    sgA (paperDesignP 12879) c p.1 p.2 ^ 2 ≤
      (2 / (12879 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12879).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12879) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12879 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12879 : ℝ) * _ ≤ 2 / 12879 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12879)
