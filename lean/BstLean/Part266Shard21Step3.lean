theorem removal_of_low_mass {c : Ret 12895}
    (hw : WINDOW (paperDesignP 12895) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12895 - 1))).real
      {v | sgA (paperDesignP 12895) c a v < √(2 / (12895 : ℝ) * mixtureFloor)}
      ∂muI 12895 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12895 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12895 ≤
        removalBudget := by
  have hl := locationMomentBudget_pos he (by norm_num : 12 ≤ 12)
  have hs := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
  have h := int_removed (by norm_num) (paperDesignP 12895) c
