/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13208) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13208) c (rowSplit c wl ws),
    ((13208 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13208 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13208) c (rowSplit c wl ws),
    ((13208 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13208 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13208 - 1)))
    (rowSplit c wl ws).good a ∂muI 13208 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13208) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13208 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13208) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13208 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 13208) c (rowSplit c wl ws),
    hellG2 13208 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 13208 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 13208}
    (hw : WINDOW (paperDesignP 13208) c) (he : 0 < eR c)
