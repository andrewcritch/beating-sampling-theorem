  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((17454787 / 50000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((1186382807 / 250000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5760901 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((49807359 / 100000000000))) := by
        gcongr
