    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 13220)]
  exact ⟨by linarith, by linarith [hbulk _ hs.1 hs.2], by nlinarith⟩

theorem node_trace_charge_row {wr : WRet 13220} (hw : windowW wr) :
    (gaussMat (mA 13220) 13220 (2 / (13220 : ℝ))).real {X | ∃ g < Js 13220,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13220 : ℝ)) ∨
