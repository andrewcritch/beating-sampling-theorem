  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((87241287 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((296932653 / 62500000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
