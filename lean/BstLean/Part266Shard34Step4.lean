  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((69829589 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((948675519 / 200000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((576003 / 100000000)) * ((1001 / 1000 + 52 / 1000) * ((49792287 / 100000000000))) := by
        gcongr
