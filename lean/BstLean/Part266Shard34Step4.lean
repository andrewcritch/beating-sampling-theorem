      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5760683 / 1000000000)) ^ 2 * ((1003 / 1000) * ((1907719 / 62500000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((69821761 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4744992667 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5760683 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((249017951 / 500000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
