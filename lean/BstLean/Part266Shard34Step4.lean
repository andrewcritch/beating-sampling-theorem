  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((349043491 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((583137539 / 100000000000000))) := by gcongr
      _ ≤ _ := by norm_num
