theorem node_trace_charge_row {wr : WRet 13206} (hw : windowW wr) :
    (gaussMat (mA 13206) 13206 (2 / (13206 : ℝ))).real {X | ∃ g < Js 13206,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13206 : ℝ)) ∨
