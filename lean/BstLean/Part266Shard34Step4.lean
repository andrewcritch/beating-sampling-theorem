    (gaussMat (mA 13207) 13207 (2 / (13207 : ℝ))).real {X | ∃ g < Js 13207,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13207 : ℝ)) ∨
