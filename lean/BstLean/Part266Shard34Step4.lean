theorem hq_root_price {c : Ret 13206} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 13206) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13206 - 1))).real
      {v | sgA (paperDesignP 13206) c a v < rowSigma} ∂BstLean.Part161.muI 13206 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
