/-! The root constructor after the charged pass events have supplied their fields. -/
namespace BstLean.Part266.Row13201
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part130 BstLean.Part157 BstLean.Part161 BstLean.Part169
open BstLean.Part29 (stdGauss)

/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13201) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13201) c (rowSplit c wl ws),
    ((13201 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13201 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13201) c (rowSplit c wl ws),
    ((13201 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13201 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13201 - 1)))
    (rowSplit c wl ws).good a ∂muI 13201 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13201) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13201 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13201) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13201 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 13201) c (rowSplit c wl ws),
    hellG2 13201 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 13201 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 13201}
    (hw : WINDOW (paperDesignP 13201) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
  window := hw
  energy_pos := he
  centre := pass_centre_of_events c hc
  moments := pass_moments_of_events c hw he hc _ R.energy_table R.location_table
  removal := R.removal
