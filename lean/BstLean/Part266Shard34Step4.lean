theorem node_trace_charge_row {wr : WRet 13216} (hw : windowW wr) :
    (gaussMat (mA 13216) 13216 (2 / (13216 : ℝ))).real {X | ∃ g < Js 13216,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13216 : ℝ)) ∨
