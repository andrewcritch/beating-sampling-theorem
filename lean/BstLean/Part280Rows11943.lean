  have hn : √(11943 : ℝ) ≤ (54642017 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11943 : ℝ) + 2 * √11943 ≤ (3040392017 / 250000) := by linarith
