    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (11947 : ℝ))))
    (hprice : massBound 11947 M H xi E u mixtureFloor ≤ 11947 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (11947 - 1))).real
      {v | sgA (paperDesignP 11947) c a v < √(2 / (11947 : ℝ) * mixtureFloor)}
        ∂muI 11947 ≤ lowMassBudget := by
  have hb : 0 < normSq ((paperDesignP 11947).bA c.1 c.2.1.1) := by
    change 0 < normSq (bR c)
    unfold eR at he
    exact (div_pos_iff.mp he).elim (fun h => h.1) (fun h => by norm_num at h)
  have hm := sharp_residual_mass (by norm_num) (paperDesignP 11947) c hw.2.1 hb hb0
    hI hE hu hu1 hd hg
