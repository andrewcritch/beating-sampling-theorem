theorem variance_of_matrix_events (c : Ret 11943) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11943).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11943) (FirstMatrix 11943))
