  have hn : √(11944 : ℝ) ≤ (109288609 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11944 : ℝ) + 2 * √11944 ≤ (6081288609 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 11944) (hc : c ∈ BstLean.Part164.Eop2 11944) :
    OpB (A2 c) (283 / 100) := by
