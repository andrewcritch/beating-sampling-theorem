  refine hc.trans ?_
  have hs : √(2 / (mA 11944 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11944) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11944 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11944) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11944).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11944) (FirstMatrix 11944))
    (h2 : c ∈ BstLean.Part164.Eop2 11944) (a : BstLean.Part161.Ix 11944) :
