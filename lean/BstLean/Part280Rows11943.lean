      11944 * ((12486373 / 500000000) : ℝ) ^ 2 / 2 + ((857341823 / 500000000)) ^ 2 * (1 + (12486373 / 500000000)) := by
    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (11944 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
      _ ≤ (1001 / 1000 : ℝ) * (11944 * ((12486373 / 500000000)) ^ 2 / 2 + ((857341823 / 500000000)) ^ 2 * (1 + (12486373 / 500000000))) := by
        exact mul_le_mul hk1 hb
