      ∫ w, sA (paperDesignP 12763) c a w ∂stdGauss (Fin (12763 - 1))) ^ 2
      ∂stdGauss (Fin (12763 - 1))) ^ 2 ∂muI 12763 ≤ scaleVarianceBudget ^ 2 :=
