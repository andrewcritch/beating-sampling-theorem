      ∫ w, sA (paperDesignP 12762) c a w ∂stdGauss (Fin (12762 - 1))) ^ 2
      ∂stdGauss (Fin (12762 - 1))) ^ 2 ∂muI 12762 ≤ scaleVarianceBudget ^ 2 :=
