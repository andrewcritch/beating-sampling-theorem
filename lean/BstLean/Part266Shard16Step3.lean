theorem residual_sq_le_energy (c : Ret 12765)
    (p : Ix 12765 × (Fin (12765 - 1) → ℝ)) :
    sgA (paperDesignP 12765) c p.1 p.2 ^ 2 ≤
      (2 / (12765 : ℝ)) * wLatitude c p := by
