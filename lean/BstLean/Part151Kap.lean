lemma Rmix_nonneg {x : ℝ} (h1 : 9 / 10 ≤ x) :
    0 ≤ 21 / 50 * D5 x ^ 2 - 6 * (1 - 21 / 50) * D4 x ^ 2 := by
  obtain ⟨d, rfl⟩ : ∃ d : ℝ, x = 9 / 10 + d := ⟨x - 9 / 10, by ring⟩
  have hd0 : 0 ≤ d := by linarith
  have e : 21 / 50 * D5 (9 / 10 + d) ^ 2 - 6 * (1 - 21 / 50) * D4 (9 / 10 + d) ^ 2 =
      (723785352301701 / 50000000000000 : ℝ) * d ^ 0 + (406960058801367 / 1250000000000 : ℝ) * d ^ 1 + (533323932235893 / 250000000000 : ℝ) * d ^ 2 + (11177375671359 / 2500000000 : ℝ) * d ^ 3 + (5527912836159 / 1000000000 : ℝ) * d ^ 4 + (297670826151 / 62500000 : ℝ) * d ^ 5 + (37650504291 / 12500000 : ℝ) * d ^ 6 + (903548871 / 625000 : ℝ) * d ^ 7 + (53152719 / 100000 : ℝ) * d ^ 8 + (373599 / 2500 : ℝ) * d ^ 9 + (78933 / 2500 : ℝ) * d ^ 10 + (567 / 125 : ℝ) * d ^ 11 + (21 / 50 : ℝ) * d ^ 12 := by
    unfold D5 D4
    ring
  rw [e]
  positivity

/-- **`2Φ̄(a) ≤ (1/3)/a²` for `a > 0`.** (The best constant is `0.33113…`.) -/
theorem two_PhiBar_le_third {a : ℝ} (ha : 0 < a) : 2 * PhiBar a ≤ 1 / 3 / a ^ 2 := by
  rcases le_total a (9 / 10) with h | h
  · have hR : ∀ x, a ≤ x → 0 ≤ (1 : ℝ) * D5 x ^ 2 - 6 * (1 - 1) * D4 x ^ 2 := by
      intro x _
      have : 0 ≤ D5 x ^ 2 := sq_nonneg _
      linarith
    have hP : 0 ≤ Pmix 1 a := by
      rcases le_total a (1 / 4) with h1 | h1
      · exact PmixA_0 ha.le (by linarith)
      rcases le_total a (3 / 4) with h2 | h2
      · exact PmixA_1 h1 (by linarith)
      · exact PmixA_2 h2 (by linarith)
    exact third_of_mix (by norm_num) (by norm_num) ha hR hP
  · have hR : ∀ x, a ≤ x → 0 ≤ (21 / 50 : ℝ) * D5 x ^ 2 - 6 * (1 - 21 / 50) * D4 x ^ 2 :=
      fun x hx => Rmix_nonneg (h.trans hx)
    have hP : 0 ≤ Pmix (21 / 50) a := by
      rcases le_total a (41 / 40) with h1 | h1
      · exact PmixB_0 h (by linarith)
      rcases le_total a (23 / 20) with h2 | h2
      · exact PmixB_1 h1 (by linarith)
      rcases le_total a (97 / 80) with h3 | h3
      · exact PmixB_2 h2 (by linarith)
      · exact PmixB_3 h3
    exact third_of_mix (by norm_num) (by norm_num) ha hR hP

