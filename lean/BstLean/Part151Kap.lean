import BstLean.Part151Moment

/-!
# Part 151: the bound `2Φ̄(a) ≤ (1/3)/a²`

A sharper constant for the Gaussian step in moment form (`Part151Moment` has `2/5`). The
supremum of `2a²Φ̄(a)` is `0.33113…`.

Route. `q_k` is the `k`-th convergent of the continued fraction of the Mills ratio
(`q₄ = N4/D4` is above the ratio, `q₅ = N5/D5` is below). For `λ ∈ [0, 1]` the mixture
`q = λq₄ + (1 − λ)q₅` satisfies `x·q − q′ − 1 = 120(λD5² − 6(1 − λ)D4²)/(D4²D5²)`, so by
`tail_le_of`: `Φ̄(a) ≤ φ(a)·q(a)` whenever `λD5² ≥ 6(1 − λ)D4²` on `[a, ∞)` (`tail_le_mix`).
With `e^{−u} ≤ 1/T7(u)` (`T7` the Taylor polynomial of degree 6) and `√(2π) ≥ 2.50662` the claim
is the polynomial inequality `Pmix λ a ≥ 0`. It is proved with `λ = 1` on `(0, 9/10]` and with
`λ = 21/50` on `[9/10, ∞)`, on seven intervals, by the expansion at the left end of each interval
(the coefficients were generated by a script; Lean checks each identity with `ring`).
Do not use `sorry`, `native_decide` or `axiom`.
-/

namespace BstLean.Part151

open MeasureTheory ProbabilityTheory Set
open BstLean.Part131 (pdf_eq)

noncomputable def N4 (x : ℝ) : ℝ := x ^ 4 + 9 * x ^ 2 + 8
noncomputable def E4 (x : ℝ) : ℝ := x ^ 4 + 10 * x ^ 2 + 15
noncomputable def D4 (x : ℝ) : ℝ := x ^ 5 + 10 * x ^ 3 + 15 * x
noncomputable def N5 (x : ℝ) : ℝ := x ^ 5 + 14 * x ^ 3 + 33 * x
noncomputable def D5 (x : ℝ) : ℝ := x ^ 6 + 15 * x ^ 4 + 45 * x ^ 2 + 15
noncomputable def T7 (u : ℝ) : ℝ :=
  1 + u + u ^ 2 / 2 + u ^ 3 / 6 + u ^ 4 / 24 + u ^ 5 / 120 + u ^ 6 / 720

/-- The polynomial whose sign decides the claim. -/
noncomputable def Pmix (lam a : ℝ) : ℝ :=
  250662 / 100000 * T7 (a ^ 2 / 2) * E4 a * D5 a -
    (6 * a * lam * N4 a * D5 a + 6 * a ^ 2 * (1 - lam) * N5 a * E4 a)

lemma D4_pos {x : ℝ} (hx : 0 < x) : 0 < D4 x := by unfold D4; positivity
lemma D5_pos (x : ℝ) : 0 < D5 x := by unfold D5; positivity
lemma E4_pos (x : ℝ) : 0 < E4 x := by unfold E4; positivity
lemma D4_eq (x : ℝ) : D4 x = x * E4 x := by unfold D4 E4; ring

/-- `Φ̄(a) ≤ φ(a)·(λ·N4/D4 + (1 − λ)·N5/D5)` if `λD5² ≥ 6(1 − λ)D4²` on `[a, ∞)`. -/
theorem tail_le_mix {lam a : ℝ} (hl0 : 0 ≤ lam) (hl1 : lam ≤ 1) (ha : 0 < a)
    (hR : ∀ x, a ≤ x → 0 ≤ lam * D5 x ^ 2 - 6 * (1 - lam) * D4 x ^ 2) :
    (gaussianReal 0 1).real (Ioi a) ≤
      gaussianPDFReal 0 1 a * (lam * (N4 a / D4 a) + (1 - lam) * (N5 a / D5 a)) := by
  refine tail_le_of (a := a) (K := 1 / a)
    (q := fun x => lam * (N4 x / D4 x) + (1 - lam) * (N5 x / D5 x))
    (q' := fun x => lam * (((4 * x ^ 3 + 18 * x) * D4 x - N4 x * (5 * x ^ 4 + 30 * x ^ 2 + 15)) /
        D4 x ^ 2) +
      (1 - lam) * (((5 * x ^ 4 + 42 * x ^ 2 + 33) * D5 x -
        N5 x * (6 * x ^ 5 + 60 * x ^ 3 + 90 * x)) / D5 x ^ 2)) ?_ ?_ ?_
  · intro x hx
    have hx0 : 0 < x := lt_of_lt_of_le ha hx
    have hN4 : HasDerivAt N4 (4 * x ^ 3 + 18 * x) x := by
      have h : HasDerivAt (fun y : ℝ => y ^ 4 + 9 * y ^ 2 + 8) _ x :=
        ((hasDerivAt_pow 4 x).add ((hasDerivAt_pow 2 x).const_mul (9 : ℝ))).add
          (hasDerivAt_const x (8 : ℝ))
      have e : N4 = fun y : ℝ => y ^ 4 + 9 * y ^ 2 + 8 := rfl
      rw [e]
      convert h using 1
      ring
    have hD4 : HasDerivAt D4 (5 * x ^ 4 + 30 * x ^ 2 + 15) x := by
      have h : HasDerivAt (fun y : ℝ => y ^ 5 + 10 * y ^ 3 + 15 * y) _ x :=
        ((hasDerivAt_pow 5 x).add ((hasDerivAt_pow 3 x).const_mul (10 : ℝ))).add
          ((hasDerivAt_id' x).const_mul (15 : ℝ))
      have e : D4 = fun y : ℝ => y ^ 5 + 10 * y ^ 3 + 15 * y := rfl
      rw [e]
      convert h using 1
      ring
    have hN5 : HasDerivAt N5 (5 * x ^ 4 + 42 * x ^ 2 + 33) x := by
      have h : HasDerivAt (fun y : ℝ => y ^ 5 + 14 * y ^ 3 + 33 * y) _ x :=
        ((hasDerivAt_pow 5 x).add ((hasDerivAt_pow 3 x).const_mul (14 : ℝ))).add
          ((hasDerivAt_id' x).const_mul (33 : ℝ))
      have e : N5 = fun y : ℝ => y ^ 5 + 14 * y ^ 3 + 33 * y := rfl
      rw [e]
      convert h using 1
      ring
    have hD5 : HasDerivAt D5 (6 * x ^ 5 + 60 * x ^ 3 + 90 * x) x := by
      have h : HasDerivAt (fun y : ℝ => y ^ 6 + 15 * y ^ 4 + 45 * y ^ 2 + 15) _ x :=
        (((hasDerivAt_pow 6 x).add ((hasDerivAt_pow 4 x).const_mul (15 : ℝ))).add
          ((hasDerivAt_pow 2 x).const_mul (45 : ℝ))).add (hasDerivAt_const x (15 : ℝ))
      have e : D5 = fun y : ℝ => y ^ 6 + 15 * y ^ 4 + 45 * y ^ 2 + 15 := rfl
      rw [e]
      convert h using 1
      ring
    exact ((hN4.div hD4 (D4_pos hx0).ne').const_mul lam).add
      ((hN5.div hD5 (D5_pos x).ne').const_mul (1 - lam))
  · intro x hx
    have hx0 : 0 < x := lt_trans ha hx
    have h4 := D4_pos hx0
    have h5 := D5_pos x
    have i4 : x * (N4 x / D4 x) -
        ((4 * x ^ 3 + 18 * x) * D4 x - N4 x * (5 * x ^ 4 + 30 * x ^ 2 + 15)) / D4 x ^ 2 =
        1 + 120 / D4 x ^ 2 := by
      rw [eq_comm, ← sub_eq_zero]
      have hne := h4.ne'
      field_simp
      unfold N4 D4
      ring
    have i5 : x * (N5 x / D5 x) -
        ((5 * x ^ 4 + 42 * x ^ 2 + 33) * D5 x - N5 x * (6 * x ^ 5 + 60 * x ^ 3 + 90 * x)) /
          D5 x ^ 2 = 1 - 720 / D5 x ^ 2 := by
      rw [eq_comm, ← sub_eq_zero]
      have hne := h5.ne'
      field_simp
      unfold N5 D5
      ring
    have e : x * (lam * (N4 x / D4 x) + (1 - lam) * (N5 x / D5 x)) -
        (lam * (((4 * x ^ 3 + 18 * x) * D4 x - N4 x * (5 * x ^ 4 + 30 * x ^ 2 + 15)) /
            D4 x ^ 2) +
          (1 - lam) * (((5 * x ^ 4 + 42 * x ^ 2 + 33) * D5 x -
            N5 x * (6 * x ^ 5 + 60 * x ^ 3 + 90 * x)) / D5 x ^ 2)) =
        1 + 120 * (lam * D5 x ^ 2 - 6 * (1 - lam) * D4 x ^ 2) / (D4 x ^ 2 * D5 x ^ 2) := by
      have e1 : x * (lam * (N4 x / D4 x) + (1 - lam) * (N5 x / D5 x)) -
          (lam * (((4 * x ^ 3 + 18 * x) * D4 x - N4 x * (5 * x ^ 4 + 30 * x ^ 2 + 15)) /
              D4 x ^ 2) +
            (1 - lam) * (((5 * x ^ 4 + 42 * x ^ 2 + 33) * D5 x -
              N5 x * (6 * x ^ 5 + 60 * x ^ 3 + 90 * x)) / D5 x ^ 2)) =
          lam * (1 + 120 / D4 x ^ 2) + (1 - lam) * (1 - 720 / D5 x ^ 2) := by
        rw [← i4, ← i5]; ring
      rw [e1]
      field_simp
      ring
    rw [e]
    have := hR x hx.le
    have : 0 ≤ 120 * (lam * D5 x ^ 2 - 6 * (1 - lam) * D4 x ^ 2) / (D4 x ^ 2 * D5 x ^ 2) := by
      positivity
    linarith
  · intro x hx
    have hx0 : 0 < x := lt_trans ha hx
    have h4 := D4_pos hx0
    have h5 := D5_pos x
    have a4 : N4 x / D4 x ≤ 1 / x := by
      rw [div_le_div_iff₀ h4 hx0]
      unfold N4 D4
      nlinarith [sq_nonneg x, pow_pos hx0 3]
    have a5 : N5 x / D5 x ≤ 1 / x := by
      rw [div_le_div_iff₀ h5 hx0]
      unfold N5 D5
      nlinarith [sq_nonneg x, pow_pos hx0 4, pow_pos hx0 2]
    have n4 : 0 ≤ N4 x / D4 x := by unfold N4; positivity
    have n5 : 0 ≤ N5 x / D5 x := by unfold N5; positivity
    have hl1' : 0 ≤ 1 - lam := by linarith
    rw [abs_of_nonneg (by positivity)]
    calc lam * (N4 x / D4 x) + (1 - lam) * (N5 x / D5 x)
        ≤ lam * (1 / x) + (1 - lam) * (1 / x) :=
          add_le_add (mul_le_mul_of_nonneg_left a4 hl0) (mul_le_mul_of_nonneg_left a5 hl1')
      _ = 1 / x := by ring
      _ ≤ 1 / a := one_div_le_one_div_of_le ha hx.le

/-- The claim at `a` from the polynomial inequality. -/
theorem third_of_mix {lam a : ℝ} (hl0 : 0 ≤ lam) (hl1 : lam ≤ 1) (ha : 0 < a)
    (hR : ∀ x, a ≤ x → 0 ≤ lam * D5 x ^ 2 - 6 * (1 - lam) * D4 x ^ 2)
    (hP : 0 ≤ Pmix lam a) : 2 * PhiBar a ≤ 1 / 3 / a ^ 2 := by
  have h1 := tail_le_mix hl0 hl1 ha hR
  have h4 := D4_pos ha
  have h5 := D5_pos a
  have hE := E4_pos a
  set q : ℝ := lam * (N4 a / D4 a) + (1 - lam) * (N5 a / D5 a) with hq
  set u : ℝ := a ^ 2 / 2 with hu
  have hu0 : 0 ≤ u := by rw [hu]; positivity
  have hT : T7 u ≤ Real.exp u := by
    have h := Real.sum_le_exp_of_nonneg hu0 7
    unfold T7
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, Nat.factorial] at h
    norm_num at h
    linarith
  have hT0 : 0 < T7 u := by unfold T7; positivity
  have hpi : (250662 / 100000 : ℝ) ≤ √(2 * Real.pi) := by
    rw [Real.le_sqrt' (by norm_num)]
    have := Real.pi_gt_d6
    nlinarith
  set S : ℝ := √(2 * Real.pi) * Real.exp u with hS
  have hS0 : 0 < S := by
    rw [hS]
    exact mul_pos (lt_of_lt_of_le (by norm_num) hpi) (Real.exp_pos _)
  have hSl : 250662 / 100000 * T7 u ≤ S := by
    rw [hS]
    exact mul_le_mul hpi hT hT0.le (Real.sqrt_nonneg _)
  -- `6a²q = M/(E4·D5)`
  have hM : 6 * a ^ 2 * q =
      (6 * a * lam * N4 a * D5 a + 6 * a ^ 2 * (1 - lam) * N5 a * E4 a) / (E4 a * D5 a) := by
    rw [hq, D4_eq]
    field_simp
  have hq6 : 6 * a ^ 2 * q ≤ S := by
    rw [hM, div_le_iff₀ (mul_pos hE h5)]
    have h2 : 250662 / 100000 * T7 u * (E4 a * D5 a) ≤ S * (E4 a * D5 a) :=
      mul_le_mul_of_nonneg_right hSl (mul_pos hE h5).le
    unfold Pmix at hP
    rw [← hu] at hP
    nlinarith
  have hφ : gaussianPDFReal 0 1 a = 1 / S := by
    rw [pdf_eq, hS, ← hu, Real.exp_neg]
    field_simp
  rw [hφ] at h1
  have h3 : 1 / S * q ≤ 1 / (6 * a ^ 2) := by
    rw [one_div_mul_eq_div, div_le_div_iff₀ hS0 (by positivity)]
    linarith
  unfold PhiBar
  have e : (1 : ℝ) / 3 / a ^ 2 = 2 * (1 / (6 * a ^ 2)) := by
    field_simp
    ring
  rw [e]
  linarith

