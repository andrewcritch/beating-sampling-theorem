def LowResidualMass (c : Ret 12890) : Prop :=
  ∫ a, (stdGauss (Fin (12890 - 1))).real
    {v | sgA (paperDesignP 12890) c a v < rowSigma} ∂muI 12890 ≤ lowMassBudget

