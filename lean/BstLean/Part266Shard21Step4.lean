  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((344693421 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4931857413 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1458829 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((63878581 / 125000000000))) := by
        gcongr
