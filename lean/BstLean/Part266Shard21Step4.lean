theorem node_trace_charge_row {wr : WRet 12891} (hw : windowW wr) :
    (gaussMat (mA 12891) 12891 (2 / (12891 : ℝ))).real {X | ∃ g < Js 12891,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12891 : ℝ)) ∨
