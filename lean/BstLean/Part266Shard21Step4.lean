  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((344772807 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((616051689 / 125000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5833957 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((510790693 / 1000000000000))) := by
        gcongr
