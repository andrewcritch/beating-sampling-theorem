      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5833957 / 1000000000)) ^ 2 * ((1003 / 1000) * ((2006661 / 62500000000000))) := by
        gcongr
