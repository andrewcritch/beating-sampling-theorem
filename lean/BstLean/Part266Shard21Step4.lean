      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((1458037 / 250000000)) ^ 2 * ((1003 / 1000) * ((6413351 / 200000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((68975707 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2461913937 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1458037 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((127618441 / 250000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((68975707 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((6047744669 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
