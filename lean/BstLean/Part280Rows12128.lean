theorem firstMatrix_charge {n : ℕ} (hn : 1 ≤ n) (D : Design n) (hτW : TauWorld D) :
    (retDist D.toCentres).real (agentEv D (FirstMatrix n))ᶜ ≤ exp (-(n : ℝ) / 2) := by
  rw [agentEv_compl]
  apply retDist_agent_charge D hτW (firstMatrix_measurable n) (exp_pos _).le
  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12130) (hc : A1 c ∈ Eop 12130) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12130 : ℝ)) ≤ (12840578713 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12130 : ℝ) ≤ (2753407 / 25000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12130 : ℝ) + 2 * √12130 ≤ (154378407 / 12500) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12130) (hc : c ∈ BstLean.Part164.Eop2 12130) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12130 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12130) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12130 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12130) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12130).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12130) (FirstMatrix 12130))
    (h2 : c ∈ BstLean.Part164.Eop2 12130) (a : BstLean.Part161.Ix 12130) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

