theorem residual_sq_le_energy (c : Ret 12132)
    (p : Ix 12132 × (Fin (12132 - 1) → ℝ)) :
    sgA (paperDesignP 12132) c p.1 p.2 ^ 2 ≤
      (2 / (12132 : ℝ)) * wLatitude c p := by
