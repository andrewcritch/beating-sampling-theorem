theorem location_moment_on_event {c : Ret 12131}
    (hw : WINDOW (paperDesignP 12131) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |lA (paperDesignP 12131) c a v - lbar (paperDesignP 12131) c a| ^ (2 * q)
      ∂stdGauss (Fin (12131 - 1)) ∂muI 12131 ≤ locationMomentBudget c q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
