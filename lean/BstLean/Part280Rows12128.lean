    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12129) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12129).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12129) (FirstMatrix 12129))
    (h2 : c ∈ BstLean.Part164.Eop2 12129) (a : BstLean.Part161.Ix 12129) :
