  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12410)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12410) (CentreSources 12410 12410)
  direction : analyticBase ⊆ agentEv (paperDesignP 12410) (DirectionError 12410)
  angles : analyticBase ⊆ worldAngles

