  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12411)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12411) (CentreSources 12411 12411)
  direction : analyticBase ⊆ agentEv (paperDesignP 12411) (DirectionError 12411)
  angles : analyticBase ⊆ worldAngles

