    (show energyRatio 12421 (gMinus 12421) (54 / 100) ∈ Icc (-1 : ℝ) 1 by constructor <;> linarith)
  have hkp := (kappa_mem (by linarith : -1 ≤ energyRatio 12421 (gMinus 12421) (54 / 100))
    (by linarith : energyRatio 12421 (gMinus 12421) (54 / 100) ≤ 1)).1
  have hmul := mul_le_mul hg.2.2 (show kappa (energyRatio 12421 (gMinus 12421) (54 / 100)) ≤
