  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12403)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12403) (CentreSources 12403 12403)
  direction : analyticBase ⊆ agentEv (paperDesignP 12403) (DirectionError 12403)
  angles : analyticBase ⊆ worldAngles

