    exact h.trans ((pow_le_pow_left₀ (exp_pos _).le exp_neg12_row 2).trans (by norm_num))
  unfold worldAngles
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans (add_le_add (h1.trans he)
    (h2.trans exp_neg12_row))).trans (by norm_num)

def analyticBase : Set (Ret 12412) :=
  (passEvent ∩ agentEv (paperDesignP 12412) (DirectionError 12412) ∩
    agentEv (paperDesignP 12412) (CentreSources 12412 12412)) ∩ worldAngles

