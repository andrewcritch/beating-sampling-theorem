  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12405)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12405) (CentreSources 12405 12405)
  direction : analyticBase ⊆ agentEv (paperDesignP 12405) (DirectionError 12405)
  angles : analyticBase ⊆ worldAngles

