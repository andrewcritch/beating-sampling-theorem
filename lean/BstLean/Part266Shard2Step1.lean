  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12412)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12412) (CentreSources 12412 12412)
  direction : analyticBase ⊆ agentEv (paperDesignP 12412) (DirectionError 12412)
  angles : analyticBase ⊆ worldAngles

