  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12408)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12408) (CentreSources 12408 12408)
  direction : analyticBase ⊆ agentEv (paperDesignP 12408) (DirectionError 12408)
  angles : analyticBase ⊆ worldAngles

