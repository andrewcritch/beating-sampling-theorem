def worldAngles : Set (Ret 12409) :=
  Ethm (paperCentres 12409) ∩ Ethp (paperCentres 12409)

theorem worldAngles_measurable : MeasurableSet worldAngles :=
  (measurableSet_Ethm _).inter (measurableSet_Ethp _)

theorem worldAngles_charge :
    (retDist (paperCentres 12409)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12409)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12409) (paperCentres 12409)
  have he : exp (-(45 / 10000 * (12409 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12409 : ℝ))) ≤ exp (-12) ^ 2 := by
