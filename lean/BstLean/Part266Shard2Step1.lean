  have hτ := paperDesign_tauWorld (n := 12403) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12403) hτ
  have hC := centreSources_ret_charge_row 12403 (paperDesignP 12403) hτ
