  have hm := energy_mean_lower_coarse hw
  have hg := energy_g_bounds
  have hr : (57 / 100 : ℝ) ≤ meanLowerRoot 12404 θ ^ 2 / gPlus 12404 := by
    rw [le_div_iff₀ (by linarith [hg.2.1] : 0 < gPlus 12404)]
    nlinarith [hg.2.2]
