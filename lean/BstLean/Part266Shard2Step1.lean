theorem energy_lower_components {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
    0 ≤ kappa (meanLowerRoot 12421 θ ^ 2 / gPlus 12421) - 2 / (12421 : ℝ) ^ 2 ∧
    (804 / 1000 : ℝ) ≤
      √(gMinus 12421 * (kappa (meanLowerRoot 12421 θ ^ 2 / gPlus 12421) -
        2 / (12421 : ℝ) ^ 2)) - 2 * √(12 * gPlus 12421) / 12421 -
