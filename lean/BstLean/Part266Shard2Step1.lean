theorem baseEvent_charge {H T : Set (Ret 12407)}
    (hT : (retDist (paperCentres 12407)).real (H ∩ Tᶜ) ≤ tableChargeAllowance) :
    (retDist (paperCentres 12407)).real (H ∩ (baseEvent T)ᶜ) ≤
      BstLean.Part249.baseChargeAllowance := by
