    (retDist (paperCentres 12415)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12415)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12415) (paperCentres 12415)
  have he : exp (-(45 / 10000 * (12415 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
