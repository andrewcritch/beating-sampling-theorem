    (gaussMat (mA 12530) 12530 (2 / (12530 : ℝ))).real {X | ∃ g < Js 12530,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12530 : ℝ)) ∨
