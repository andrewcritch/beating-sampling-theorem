    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 12534)]
  exact ⟨by linarith, by linarith [hbulk _ hs.1 hs.2], by nlinarith⟩

theorem node_trace_charge_row {wr : WRet 12534} (hw : windowW wr) :
    (gaussMat (mA 12534) 12534 (2 / (12534 : ℝ))).real {X | ∃ g < Js 12534,
