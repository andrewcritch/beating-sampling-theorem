    (energyMoment_on_event (by norm_num) _ c he) hk hke hk32 K).trans ?_
  apply pow_le_pow_left₀ (by linarith [energyAllowance_nonneg 13075])
  have hh := energy_allowance_row
  norm_num [locationNorm] at *
  linarith

