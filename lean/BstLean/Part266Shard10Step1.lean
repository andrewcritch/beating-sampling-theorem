def worldAngles : Set (Ret 12609) :=
  Ethm (paperCentres 12609) ∩ Ethp (paperCentres 12609)

theorem worldAngles_measurable : MeasurableSet worldAngles :=
  (measurableSet_Ethm _).inter (measurableSet_Ethp _)

theorem worldAngles_charge :
    (retDist (paperCentres 12609)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12609)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12609) (paperCentres 12609)
  have he : exp (-(45 / 10000 * (12609 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12609 : ℝ))) ≤ exp (-12) ^ 2 := by
