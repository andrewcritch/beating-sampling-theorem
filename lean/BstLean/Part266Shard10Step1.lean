    linarith
  have ht : √(12 * gPlus 12621) ≤ 7 / 2 :=
    sqrt_le_iff.mpr ⟨by norm_num, by linarith [hg.2.2]⟩
  have hn : (110 : ℝ) ≤ √12621 := le_sqrt_of_sq_le (by norm_num)
