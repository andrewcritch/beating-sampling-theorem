def worldAngles : Set (Ret 12608) :=
  Ethm (paperCentres 12608) ∩ Ethp (paperCentres 12608)

theorem worldAngles_measurable : MeasurableSet worldAngles :=
  (measurableSet_Ethm _).inter (measurableSet_Ethp _)

theorem worldAngles_charge :
    (retDist (paperCentres 12608)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12608)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12608) (paperCentres 12608)
  have he : exp (-(45 / 10000 * (12608 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12608 : ℝ))) ≤ exp (-12) ^ 2 := by
