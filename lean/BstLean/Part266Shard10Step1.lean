  have hτ := paperDesign_tauWorld (n := 12612) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12612) hτ
  have hC := centreSources_ret_charge_row 12612 (paperDesignP 12612) hτ
