  have hmean0 : 0 ≤ meanRoot 12608 (54 / 100) := by unfold meanRoot; positivity
  have hg := energy_g_bounds.1
  unfold energyRatio
  rw [div_le_iff₀ (by linarith : 0 < gMinus 12608)]
  nlinarith

theorem energy_upper_coarse :
    energyUpper 12608 (gMinus 12608) (gPlus 12608)
      (finiteEnergy 12608 12608 (11 / 1000)) (54 / 100) ≤ 9 / 10 := by
  have hg := energy_g_bounds
  have hr := energy_ratio_coarse
  have hr0 : 0 ≤ energyRatio 12608 (gMinus 12608) (54 / 100) := by
    unfold energyRatio
