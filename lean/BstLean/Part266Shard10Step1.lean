theorem baseEvent_charge {H T : Set (Ret 12620)}
    (hT : (retDist (paperCentres 12620)).real (H ∩ Tᶜ) ≤ tableChargeAllowance) :
    (retDist (paperCentres 12620)).real (H ∩ (baseEvent T)ᶜ) ≤
