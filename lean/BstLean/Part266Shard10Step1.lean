  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12611)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12611) (CentreSources 12611 12611)
  direction : analyticBase ⊆ agentEv (paperDesignP 12611) (DirectionError 12611)
