  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12604)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12604) (CentreSources 12604 12604)
  direction : analyticBase ⊆ agentEv (paperDesignP 12604) (DirectionError 12604)
  angles : analyticBase ⊆ worldAngles

