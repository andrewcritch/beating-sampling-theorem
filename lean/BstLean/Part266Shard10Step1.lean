    linarith
  have hs : (805 / 1000 : ℝ) ≤ √(gMinus 12621 *
      (kappa (meanLowerRoot 12621 θ ^ 2 / gPlus 12621) - 2 / (12621 : ℝ) ^ 2)) := by
    apply le_sqrt_of_sq_le
    have hp := mul_le_mul hg.1 hbr (by norm_num : (0 : ℝ) ≤ 65 / 100 - 2 / 12621 ^ 2)
