  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12603)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12603) (CentreSources 12603 12603)
  direction : analyticBase ⊆ agentEv (paperDesignP 12603) (DirectionError 12603)
  angles : analyticBase ⊆ worldAngles

