  have hpm := BstLean.Part280.Gen.Row12207.pass_moments_of_events c hw he hc _ (htab.1.trans hw8) (htab.2.trans hf8)
  have hm : PaperMoments c (keptIx (paperDesignP 12207) c (BstLean.Part280.Gen.Row12207.hqSplit c))
      BstLean.Part280.Gen.Row12207.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12207.locationNorm BstLean.Part280.Gen.Row12207.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
  exact passInputs_of_paperMoments (by norm_num) c BstLean.Part280.Gen.Row12207.eta_pos BstLean.Part280.Gen.Row12207.eta_lt_one
    (sqrt_nonneg _) he BstLean.Part280.Gen.Row12207.bias_floor_ge (by norm_num [BstLean.Part280.Gen.Row12207.epsilon]) BstLean.Part280.Gen.Row12207.bias_threshold_pos
    (by norm_num [sharpAw]) (by norm_num [sharpAf]) (by norm_num [BstLean.Part280.Gen.Row12207.locationNorm])
    (by norm_num [BstLean.Part280.Gen.Row12207.varianceNorm]) BstLean.Part280.Gen.Row12207.row_split_floor.le
    (BstLean.Part280.Gen.Row12207.pass_centre_of_events c hc) hm

