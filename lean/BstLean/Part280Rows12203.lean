  change √(∫ a, Vl a ^ 2 ∂muI n) ≤ (C / eR c) / ((n : ℝ) * ((n : ℝ) - 3)) at hcert
  have hint : ∫ a, Vl a ^ 2 ∂muI n ≤ ((C / eR c) / ((n : ℝ) * ((n : ℝ) - 3))) ^ 2 :=
