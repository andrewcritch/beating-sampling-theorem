theorem full_residual_eighth {c : Ret 12207}
    (hw : WINDOW (paperDesignP 12207) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12207) c a v ^ 8
      ∂stdGauss (Fin (12207 - 1)) ∂muI 12207 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12207).prod (stdGauss (Fin (12207 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
