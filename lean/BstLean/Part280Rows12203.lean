    measurableSet_keptSet _ (BstLean.Part280.Gen.Row12207.hqSplit c).mgood (measurableSet_bulkIx _ _) _
  have hsub : keptIx (paperDesignP 12207) c (BstLean.Part280.Gen.Row12207.hqSplit c) ⊆ bulkIx (paperDesignP 12207) c :=
    fun _ h => h.1
  have hfirst : A1 c ∈ BstLean.Part153.Eop 12207 := hc.1.1.2 hw.2.1
  have hsecond : c ∈ BstLean.Part164.Eop2 12207 := hc.1.2
  have htab := stored_table_moments c hw hfirst hsecond hK hsub (hX _)
  have hw8 : sharpAw ^ 8 ≤ BstLean.Part280.Gen.Row12207.energyError ^ 8 :=
