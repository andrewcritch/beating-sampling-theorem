theorem second_matrix_charge_row :
    (retDist (paperCentres 13200)).real (BstLean.Part164.Eop2 13200)ᶜ ≤
      (373 / 10 ^ 8 : ℝ) := by
  refine (BstLean.Part164.Eop2_charge (by norm_num) (paperCentres 13200)).trans ?_
  have he : (-(25 / 2) : ℝ) = -12 + -(1 / 2) := by norm_num
