theorem first_matrix_row (c : Ret 13200) (hc : A1 c ∈ Eop 13200) : OpB (A1 c) 166 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (13200 : ℝ)) ≤ (6154574549 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(13200 : ℝ) ≤ (114891253 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (13200 : ℝ) + 2 * √13200 ≤ (6714891253 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 13200) (hc : c ∈ BstLean.Part164.Eop2 13200) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 13200 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 13200) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 13200 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 13200) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 13200).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 13200) (FirstMatrix 13200))
    (h2 : c ∈ BstLean.Part164.Eop2 13200) (a : BstLean.Part161.Ix 13200) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

end BstLean.Part266.Row13200

