  unfold energyLower
  simp only [Nat.cast_ofNat]
  nlinarith

theorem computed_energy_eq (c : Ret 12151) (hτ : 0 < (paperDesignP 12151).tau0 c) :
    eR c = (2 / (mA 12151 : ℝ)) *
      normSq (BstLean.Part150.bT 12151 12151 (A1 c) (A2 c) c.1.2
        ((paperDesignP 12151).tau0 c)) /
      (2 / (12151 : ℝ) * BstLean.Part150.rhoC c.1.2 ((paperDesignP 12151).tau0 c) ^ 2) := by
  have hb : bR c = (BstLean.Part150.rhoC c.1.2 ((paperDesignP 12151).tau0 c))⁻¹ •
      BstLean.Part150.bT 12151 12151 (A1 c) (A2 c) c.1.2 ((paperDesignP 12151).tau0 c) := by
    ext j
    change bAp c.1 c.2.1.1 j = _
    simp only [bAp, Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, mul_comm]
    rfl
  calc
    eR c = (2 / (mA 12151 : ℝ)) * normSq (bR c) / (2 / (12151 : ℝ)) := by
      norm_num [eR, mA]
      ring
    _ = _ := by
