  removal : ∫ a, removed (stdGauss (Fin (12150 - 1)))
    (rowSplit c wl ws).good a ∂muI 12150 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12150) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12150 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12150) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12150 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12150) c (rowSplit c wl ws),
    hellG2 12150 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12150 ≤ displacementBudget

