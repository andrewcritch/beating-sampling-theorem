theorem variance_of_matrix_events (c : Ret 12152) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12152).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12152) (FirstMatrix 12152))
