    (hprice : massBound 12151 M H xi E u mixtureFloor ≤ 12151 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12151 - 1))).real
      {v | sgA (paperDesignP 12151) c a v < √(2 / (12151 : ℝ) * mixtureFloor)}
