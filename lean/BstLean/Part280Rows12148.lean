  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12150) c (rowSplit c wl ws),
    ((12150 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12150 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12150) c (rowSplit c wl ws),
