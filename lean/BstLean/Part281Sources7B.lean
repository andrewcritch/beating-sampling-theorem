  have hd : (2 : ℝ) / 109.777046781192 ≤ 2 / √(12051 : ℝ) := by gcongr
  unfold wn
  simp only [Nat.cast_ofNat]
  nlinarith

theorem pilot_rho_bounds : (0.000265691842 : ℝ) ≤ rhoBar 12051 csC ∧
    rhoBar 12051 csC ≤ 0.000265692254 := by
  have hw := pilot_wn_upper
  have hwl := pilot_wn_lower
  have hc := cs_lower
  have hcu := BstLean.Part264.pilot_cs_upper
  have hc0 : 0 < csC := by linarith
  unfold rhoBar
  simp only [Nat.cast_ofNat]
  constructor
  · calc
      _ ≤ 4 * (1.036769412258 : ℝ) / (1.295212 * 12051) := by norm_num
      _ ≤ _ := by gcongr
  · calc
      _ ≤ 4 * (1.036769412259 : ℝ) / (1.29521 * 12051) := by gcongr
      _ ≤ (0.000265692254 : ℝ) := by norm_num

theorem pilot_nu_upper : nuR (rhoBar 12051 csC) ≤ 0.001062839609 := by
  have h := pilot_rho_bounds
  unfold nuR
  nlinarith

theorem pilot_piBar_upper : piBar (rhoBar 12051 csC) ≤ (1 / 10 ^ 40 : ℝ) := by
  exact BstLean.Part281.piBar_upper_of_bounds
    (lt_of_lt_of_le (by norm_num) pilot_rho_bounds.1)
    (pilot_rho_bounds.2.trans (by norm_num))

theorem pilot_cc_bounds : cc0 (rhoBar 12051 csC) (piBar (rhoBar 12051 csC)) ≤ 0.000202938054 ∧
    cc1 (rhoBar 12051 csC) (piBar (rhoBar 12051 csC)) ≤ 0.000129130724 ∧
    cc2 (rhoBar 12051 csC) ≤ 0.000074961246 := by
  have hr := pilot_rho_bounds
  have hrlo := hr.1
  have hrhi := hr.2
  have hr0 : 0 ≤ rhoBar 12051 csC := by linarith
  have hv := pilot_nu_upper
  have hv0 : 0 ≤ nuR (rhoBar 12051 csC) := by unfold nuR; positivity
  have hp := pilot_piBar_upper
  have hp0 : 0 ≤ piBar (rhoBar 12051 csC) := by unfold piBar; positivity
  have hz := BstLean.Part264.pilot_phi_zero_upper
  have ho := BstLean.Part264.pilot_phi_one_upper
  have hz0 := (phiG_pos 0).le
  have ho0 := (phiG_pos 1).le
  have h2 : (1.414213562 : ℝ) ≤ √2 := le_sqrt_of_sq_le (by norm_num)
  have hs1 : √(rhoBar 12051 csC * nuR (rhoBar 12051 csC)) ≤ 0.000531402156 := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ (0.000265692254 : ℝ) * 0.001062839609 := by gcongr
      _ ≤ (0.000531402156 : ℝ) ^ 2 := by norm_num
  have hs2 : √(piBar (rhoBar 12051 csC) * nuR (rhoBar 12051 csC)) ≤ 1 / 10 ^ 20 := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ (1 / 10 ^ 40 : ℝ) * 0.001062839609 := by gcongr
      _ ≤ (1 / 10 ^ 20 : ℝ) ^ 2 := by norm_num
  have hs3 : √(piBar (rhoBar 12051 csC) * rhoBar 12051 csC) ≤ 1 / 10 ^ 20 := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ (1 / 10 ^ 40 : ℝ) * 0.000265692254 := by gcongr
      _ ≤ (1 / 10 ^ 20 : ℝ) ^ 2 := by norm_num
  constructor
  · unfold cc0
    calc
      _ ≤ (0.399 : ℝ) * 0.000265692254 / 2 + 0.399 * 0.001062839609 / (2 * 1.414213562) +
          (3 / 2) * 0.399 * (1 / 10 ^ 20) := by gcongr
      _ ≤ (0.000202938054 : ℝ) := by norm_num
  constructor
  · unfold cc1
    calc
      _ ≤ (0.243 : ℝ) * 0.000531402156 + 2 * (1 / 10 ^ 20) := by gcongr
      _ ≤ (0.000129130724 : ℝ) := by norm_num
  · unfold cc2
