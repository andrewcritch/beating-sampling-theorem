    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11910) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11910).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11910) (FirstMatrix 11910))
    (h2 : c ∈ BstLean.Part164.Eop2 11910) (a : BstLean.Part161.Ix 11910) :
