theorem exactTableMoments_of_N {c : Ret 11912} (hw : WINDOW (paperDesignP 11912) c)
    (hθ : BstLean.Part280.m2Guard 11912 c) (hc : c ∈ BstLean.Part280.sharpTableN 11912)
