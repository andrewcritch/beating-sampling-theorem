theorem full_residual_eighth {c : Ret 11912}
    (hw : WINDOW (paperDesignP 11912) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 11912) c a v ^ 8
      ∂stdGauss (Fin (11912 - 1)) ∂muI 11912 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 11912).prod (stdGauss (Fin (11912 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
