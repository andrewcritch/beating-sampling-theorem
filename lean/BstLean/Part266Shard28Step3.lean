      ∫ w, sA (paperDesignP 13066) c a w ∂stdGauss (Fin (13066 - 1))) ^ 2
      ∂stdGauss (Fin (13066 - 1))) ^ 2 ∂muI 13066 ≤ scaleVarianceBudget ^ 2 :=
