theorem low_mass_of_interfaces {c : Ret 13066}
    (hw : WINDOW (paperDesignP 13066) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 13066).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 13066) c M H xi)
    (hE : centreEnergy (paperDesignP 13066) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (13066 : ℝ))))
    (hprice : massBound 13066 M H xi E u mixtureFloor ≤ 13066 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (13066 - 1))).real
      {v | sgA (paperDesignP 13066) c a v < √(2 / (13066 : ℝ) * mixtureFloor)}
        ∂muI 13066 ≤ lowMassBudget := by
