    (hw : WINDOW (paperDesignP 13070) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 13070) c a v ^ 8
      ∂stdGauss (Fin (13070 - 1)) ∂muI 13070 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 13070).prod (stdGauss (Fin (13070 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 13070) c (hc.1.1.1.1 hw.2.1)
