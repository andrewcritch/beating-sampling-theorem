theorem variance_budgets_row {c : Ret 13050} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (1252961 / 40000000000000) ∧ residualVarianceBudget ≤ (2880371 / 1000000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
  have hce : latitudeC / eR c ≤ 16 / 3 := by
    rw [div_le_iff₀ (by linarith : 0 < eR c)]
    linarith
