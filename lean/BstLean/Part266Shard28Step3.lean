    (hw : WINDOW (paperDesignP 13056) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 13056) c a v ^ 8
      ∂stdGauss (Fin (13056 - 1)) ∂muI 13056 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 13056).prod (stdGauss (Fin (13056 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 13056) c (hc.1.1.1.1 hw.2.1)
