      ∫ w, sA (paperDesignP 13065) c a w ∂stdGauss (Fin (13065 - 1))) ^ 2
      ∂stdGauss (Fin (13065 - 1))) ^ 2 ∂muI 13065 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 13065) c
