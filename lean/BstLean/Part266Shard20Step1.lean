  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12859)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12859) (CentreSources 12859 12859)
  direction : analyticBase ⊆ agentEv (paperDesignP 12859) (DirectionError 12859)
  angles : analyticBase ⊆ worldAngles

