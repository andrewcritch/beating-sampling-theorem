  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12858)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12858) (CentreSources 12858 12858)
  direction : analyticBase ⊆ agentEv (paperDesignP 12858) (DirectionError 12858)
  angles : analyticBase ⊆ worldAngles

