  unfold worldAngles
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans (add_le_add (h1.trans he)
    (h2.trans exp_neg12_row))).trans (by norm_num)

def analyticBase : Set (Ret 12863) :=
  (passEvent ∩ agentEv (paperDesignP 12863) (DirectionError 12863) ∩
    agentEv (paperDesignP 12863) (CentreSources 12863 12863)) ∩ worldAngles

