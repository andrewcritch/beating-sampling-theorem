  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12870)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12870) (CentreSources 12870 12870)
  direction : analyticBase ⊆ agentEv (paperDesignP 12870) (DirectionError 12870)
  angles : analyticBase ⊆ worldAngles

