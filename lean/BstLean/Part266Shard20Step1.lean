  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12860)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12860) (CentreSources 12860 12860)
  direction : analyticBase ⊆ agentEv (paperDesignP 12860) (DirectionError 12860)
  angles : analyticBase ⊆ worldAngles

