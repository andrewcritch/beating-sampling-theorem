def worldAngles : Set (Ret 12862) :=
  Ethm (paperCentres 12862) ∩ Ethp (paperCentres 12862)

theorem worldAngles_measurable : MeasurableSet worldAngles :=
  (measurableSet_Ethm _).inter (measurableSet_Ethp _)

theorem worldAngles_charge :
    (retDist (paperCentres 12862)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12862)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12862) (paperCentres 12862)
  have he : exp (-(45 / 10000 * (12862 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12862 : ℝ))) ≤ exp (-12) ^ 2 := by
