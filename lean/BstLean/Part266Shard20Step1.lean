  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12854)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12854) (CentreSources 12854 12854)
  direction : analyticBase ⊆ agentEv (paperDesignP 12854) (DirectionError 12854)
  angles : analyticBase ⊆ worldAngles

