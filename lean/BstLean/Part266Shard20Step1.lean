  have hb : bR c = (BstLean.Part150.rhoC c.1.2 ((paperDesignP 12865).tau0 c))⁻¹ •
      BstLean.Part150.bT 12865 12865 (A1 c) (A2 c) c.1.2 ((paperDesignP 12865).tau0 c) := by
    ext j
    change bAp c.1 c.2.1.1 j = _
    simp only [bAp, Pi.smul_apply, smul_eq_mul, div_eq_mul_inv, mul_comm]
    rfl
  calc
    eR c = (2 / (mA 12865 : ℝ)) * normSq (bR c) / (2 / (12865 : ℝ)) := by
      norm_num [eR, mA]
      ring
    _ = _ := by
      rw [hb]
      exact computed_hidden_normalization (by norm_num) (A1 c) (A2 c) c.1.2 hτ

theorem centre_energy_range {c : Ret 12865}
    (hw : BstLean.Part161.WINDOW (paperDesignP 12865) c) (hc : c ∈ analyticBase) :
