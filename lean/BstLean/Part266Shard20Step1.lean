    (show energyRatio 12853 (gMinus 12853) (54 / 100) ∈ Icc (-1 : ℝ) 1 by constructor <;> linarith)
  have hkp := (kappa_mem (by linarith : -1 ≤ energyRatio 12853 (gMinus 12853) (54 / 100))
    (by linarith : energyRatio 12853 (gMinus 12853) (54 / 100) ≤ 1)).1
