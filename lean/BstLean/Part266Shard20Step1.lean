  have ht0 := sqrt_nonneg (12 : ℝ)
  unfold meanLowerRoot
  simp only [Nat.cast_ofNat]
  constructor <;> linarith

theorem energy_lower_components {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
    0 ≤ kappa (meanLowerRoot 12853 θ ^ 2 / gPlus 12853) - 2 / (12853 : ℝ) ^ 2 ∧
    (804 / 1000 : ℝ) ≤
      √(gMinus 12853 * (kappa (meanLowerRoot 12853 θ ^ 2 / gPlus 12853) -
        2 / (12853 : ℝ) ^ 2)) - 2 * √(12 * gPlus 12853) / 12853 -
        finiteEnergy 12853 12853 (11 / 1000) / √12853 := by
  have hm := energy_mean_lower_coarse hw
  have hg := energy_g_bounds
  have hr : (57 / 100 : ℝ) ≤ meanLowerRoot 12853 θ ^ 2 / gPlus 12853 := by
    rw [le_div_iff₀ (by linarith [hg.2.1] : 0 < gPlus 12853)]
    nlinarith [hg.2.2]
  have hr1 : meanLowerRoot 12853 θ ^ 2 / gPlus 12853 ≤ 1 := by
    rw [div_le_iff₀ (by linarith [hg.2.1] : 0 < gPlus 12853)]
    nlinarith [hg.2.1]
  have hk : (65 / 100 : ℝ) ≤ kappa (57 / 100) := by
    apply kernel_lower_rational (s := 821 / 1000) <;> norm_num
  have hκ := kappa_monotoneOn (by norm_num : (57 / 100 : ℝ) ∈ Icc (-1) 1)
    (show meanLowerRoot 12853 θ ^ 2 / gPlus 12853 ∈ Icc (-1 : ℝ) 1 by
      exact ⟨by linarith, hr1⟩) hr
  have hbr : (65 / 100 : ℝ) - 2 / 12853 ^ 2 ≤
      kappa (meanLowerRoot 12853 θ ^ 2 / gPlus 12853) - 2 / (12853 : ℝ) ^ 2 := by
    linarith
  have hs : (805 / 1000 : ℝ) ≤ √(gMinus 12853 *
      (kappa (meanLowerRoot 12853 θ ^ 2 / gPlus 12853) - 2 / (12853 : ℝ) ^ 2)) := by
    apply le_sqrt_of_sq_le
    have hp := mul_le_mul hg.1 hbr (by norm_num : (0 : ℝ) ≤ 65 / 100 - 2 / 12853 ^ 2)
      (by linarith [hg.1] : 0 ≤ gMinus 12853)
    linarith
