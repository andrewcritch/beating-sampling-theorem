      norm_num [eR, mA]
      ring
    _ = _ := by
      rw [hb]
      exact computed_hidden_normalization (by norm_num) (A1 c) (A2 c) c.1.2 hτ

theorem centre_energy_range {c : Ret 12852}
    (hw : BstLean.Part161.WINDOW (paperDesignP 12852) c) (hc : c ∈ analyticBase) :
