  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12862)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12862) (CentreSources 12862 12862)
  direction : analyticBase ⊆ agentEv (paperDesignP 12862) (DirectionError 12862)
  angles : analyticBase ⊆ worldAngles

