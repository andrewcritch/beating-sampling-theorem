  have hτ := paperDesign_tauWorld (n := 12861) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12861) hτ
  have hC := centreSources_ret_charge_row 12861 (paperDesignP 12861) hτ
