    eR c = (2 / (mA 12852 : ℝ)) *
      normSq (BstLean.Part150.bT 12852 12852 (A1 c) (A2 c) c.1.2
        ((paperDesignP 12852).tau0 c)) /
      (2 / (12852 : ℝ) * BstLean.Part150.rhoC c.1.2 ((paperDesignP 12852).tau0 c) ^ 2) := by
  have hb : bR c = (BstLean.Part150.rhoC c.1.2 ((paperDesignP 12852).tau0 c))⁻¹ •
      BstLean.Part150.bT 12852 12852 (A1 c) (A2 c) c.1.2 ((paperDesignP 12852).tau0 c) := by
    ext j
