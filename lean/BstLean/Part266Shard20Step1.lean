  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12857)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12857) (CentreSources 12857 12857)
  direction : analyticBase ⊆ agentEv (paperDesignP 12857) (DirectionError 12857)
  angles : analyticBase ⊆ worldAngles

