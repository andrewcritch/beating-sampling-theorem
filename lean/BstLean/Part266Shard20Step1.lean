  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12861)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12861) (CentreSources 12861 12861)
  direction : analyticBase ⊆ agentEv (paperDesignP 12861) (DirectionError 12861)
  angles : analyticBase ⊆ worldAngles

