  have hτ := paperDesign_tauWorld (n := 12863) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12863) hτ
  have hC := centreSources_ret_charge_row 12863 (paperDesignP 12863) hτ
