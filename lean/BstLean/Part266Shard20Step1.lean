  have hτ := paperDesign_tauWorld (n := 12870) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12870) hτ
  have hC := centreSources_ret_charge_row 12870 (paperDesignP 12870) hτ
