  have hs : (805 / 1000 : ℝ) ≤ √(gMinus 12925 *
      (kappa (meanLowerRoot 12925 θ ^ 2 / gPlus 12925) - 2 / (12925 : ℝ) ^ 2)) := by
    apply le_sqrt_of_sq_le
    have hp := mul_le_mul hg.1 hbr (by norm_num : (0 : ℝ) ≤ 65 / 100 - 2 / 12925 ^ 2)
      (by linarith [hg.1] : 0 ≤ gMinus 12925)
    linarith
  have ht : √(12 * gPlus 12925) ≤ 7 / 2 :=
    sqrt_le_iff.mpr ⟨by norm_num, by linarith [hg.2.2]⟩
