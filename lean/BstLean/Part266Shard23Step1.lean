theorem centreSources_charge_row (J : ℕ) (c : Fin 12942 → ℝ) {τ : ℝ} (hτ : 0 < τ) :
    (nuA 12942).real (BstLean.Part211.CentreSource 12942 J c τ 2)ᶜ ≤
      (103 / 10 ^ 6 : ℝ) := by
