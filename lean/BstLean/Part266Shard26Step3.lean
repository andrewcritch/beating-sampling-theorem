theorem removal_of_low_mass {c : Ret 13003}
    (hw : WINDOW (paperDesignP 13003) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (13003 - 1))).real
      {v | sgA (paperDesignP 13003) c a v < √(2 / (13003 : ℝ) * mixtureFloor)}
      ∂muI 13003 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (13003 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 13003 ≤
