theorem sigma_bounds : ((5808553 / 1000000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (2904277 / 500000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
