      ∫ w, sA (paperDesignP 13007) c a w ∂stdGauss (Fin (13007 - 1))) ^ 2
      ∂stdGauss (Fin (13007 - 1))) ^ 2 ∂muI 13007 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 13007) c
