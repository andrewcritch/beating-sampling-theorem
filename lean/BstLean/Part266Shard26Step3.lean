      ∫ w, sA (paperDesignP 13022) c a w ∂stdGauss (Fin (13022 - 1))) ^ 2
      ∂stdGauss (Fin (13022 - 1))) ^ 2 ∂muI 13022 ≤ scaleVarianceBudget ^ 2 :=
