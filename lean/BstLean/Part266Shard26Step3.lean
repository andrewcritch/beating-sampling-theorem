      ∂stdGauss (Fin (13008 - 1)) ∂muI 13008 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 13008).prod (stdGauss (Fin (13008 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 13008) c (hc.1.1.1.1 hw.2.1)
