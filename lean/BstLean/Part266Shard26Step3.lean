theorem low_mass_of_interfaces {c : Ret 13001}
    (hw : WINDOW (paperDesignP 13001) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 13001).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 13001) c M H xi)
    (hE : centreEnergy (paperDesignP 13001) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (13001 : ℝ))))
    (hprice : massBound 13001 M H xi E u mixtureFloor ≤ 13001 * lowMassBudget) :
