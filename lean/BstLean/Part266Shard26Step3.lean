theorem low_mass_of_interfaces {c : Ret 13007}
    (hw : WINDOW (paperDesignP 13007) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 13007).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 13007) c M H xi)
    (hE : centreEnergy (paperDesignP 13007) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (13007 : ℝ))))
    (hprice : massBound 13007 M H xi E u mixtureFloor ≤ 13007 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (13007 - 1))).real
      {v | sgA (paperDesignP 13007) c a v < √(2 / (13007 : ℝ) * mixtureFloor)}
        ∂muI 13007 ≤ lowMassBudget := by
