theorem residual_sq_le_energy (c : Ret 13024)
    (p : Ix 13024 × (Fin (13024 - 1) → ℝ)) :
    sgA (paperDesignP 13024) c p.1 p.2 ^ 2 ≤
      (2 / (13024 : ℝ)) * wLatitude c p := by
