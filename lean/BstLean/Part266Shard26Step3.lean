  calc
    _ ≤ (1385 / 1000 : ℝ) * (2 * ((106608293 / 31250000000))) / ((580699 / 100000000)) := by
      apply div_le_div₀ (by positivity) _ (by norm_num) sigma_bounds.1
      exact mul_le_mul hs (by linarith [hw.2.1]) (by linarith [hw.1]) (by norm_num)
