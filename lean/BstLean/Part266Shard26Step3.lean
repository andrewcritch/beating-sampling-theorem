theorem low_mass_of_interfaces {c : Ret 13010}
    (hw : WINDOW (paperDesignP 13010) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 13010).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 13010) c M H xi)
    (hE : centreEnergy (paperDesignP 13010) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (13010 : ℝ))))
    (hprice : massBound 13010 M H xi E u mixtureFloor ≤ 13010 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (13010 - 1))).real
      {v | sgA (paperDesignP 13010) c a v < √(2 / (13010 : ℝ) * mixtureFloor)}
        ∂muI 13010 ≤ lowMassBudget := by
