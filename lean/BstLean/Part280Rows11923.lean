theorem first_matrix_row (c : Ret 11923) (hc : A1 c ∈ Eop 11923) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11923 : ℝ)) ≤ (1618945537 / 125000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11923 : ℝ) ≤ (109192491 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11923 : ℝ) + 2 * √11923 ≤ (6070692491 / 500000) := by linarith
