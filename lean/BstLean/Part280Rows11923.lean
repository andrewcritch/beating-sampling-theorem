    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11925) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11925).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11925) (FirstMatrix 11925))
    (h2 : c ∈ BstLean.Part164.Eop2 11925) (a : BstLean.Part161.Ix 11925) :
