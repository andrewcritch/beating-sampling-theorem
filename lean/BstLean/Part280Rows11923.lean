  have hn : √(11925 : ℝ) ≤ (109201649 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11925 : ℝ) + 2 * √11925 ≤ (6071701649 / 500000) := by linarith
