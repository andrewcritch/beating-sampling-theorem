theorem variance_of_matrix_events (c : Ret 11923) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11923).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11923) (FirstMatrix 11923))
    (h2 : c ∈ BstLean.Part164.Eop2 11923) (a : BstLean.Part161.Ix 11923) :
