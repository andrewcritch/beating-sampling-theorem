      ∫ w, sA (paperDesignP 12626) c a w ∂stdGauss (Fin (12626 - 1))) ^ 2
      ∂stdGauss (Fin (12626 - 1))) ^ 2 ∂muI 12626 ≤ scaleVarianceBudget ^ 2 :=
