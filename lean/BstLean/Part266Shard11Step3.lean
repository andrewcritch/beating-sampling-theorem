    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12626 : ℝ))))
    (hprice : massBound 12626 M H xi E u mixtureFloor ≤ 12626 * lowMassBudget) :
