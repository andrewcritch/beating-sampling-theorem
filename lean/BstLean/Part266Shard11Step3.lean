theorem scale_variance_on_event {c : Ret 12648}
    (hw : WINDOW (paperDesignP 12648) c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (sA (paperDesignP 12648) c a v -
      ∫ w, sA (paperDesignP 12648) c a w ∂stdGauss (Fin (12648 - 1))) ^ 2
