theorem residual_sq_le_energy (c : Ret 12637)
    (p : Ix 12637 × (Fin (12637 - 1) → ℝ)) :
    sgA (paperDesignP 12637) c p.1 p.2 ^ 2 ≤
      (2 / (12637 : ℝ)) * wLatitude c p := by
