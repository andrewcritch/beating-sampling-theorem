theorem row_node_geometry {wr : WRet 13178} (hw : windowW wr)
    (θ : AHid 13178) {g : ℕ} (hg : g < Js 13178) :
    0 ≤ nodeS (mkR wr θ) g ∧
      (3969 / 10000 : ℝ) ≤ 1 - nodeS (mkR wr θ) g ^ 2 ∧
