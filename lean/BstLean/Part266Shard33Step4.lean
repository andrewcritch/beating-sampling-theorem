theorem row_node_geometry {wr : WRet 13189} (hw : windowW wr)
    (θ : AHid 13189) {g : ℕ} (hg : g < Js 13189) :
    0 ≤ nodeS (mkR wr θ) g ∧
      (3969 / 10000 : ℝ) ≤ 1 - nodeS (mkR wr θ) g ^ 2 ∧
      1 - nodeS (mkR wr θ) g ^ 2 ≤ 61 / 100 := by
