    (gaussMat (mA 13193) 13193 (2 / (13193 : ℝ))).real {X | ∃ g < Js 13193,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13193 : ℝ)) ∨
