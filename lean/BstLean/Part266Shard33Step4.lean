    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13188) (mA 13188) (tA 13188) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
