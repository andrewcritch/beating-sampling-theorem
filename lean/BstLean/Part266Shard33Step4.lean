/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13185) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13185) c (rowSplit c wl ws),
    ((13185 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13185 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13185) c (rowSplit c wl ws),
