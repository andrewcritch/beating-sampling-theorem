    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13196) (mA 13196) (tA 13196) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
