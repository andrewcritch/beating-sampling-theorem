theorem hq_output_bounds {c : Ret 13190}
    (hw : WINDOW (paperDesignP 13190) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13190)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
