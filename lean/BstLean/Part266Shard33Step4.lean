def LowResidualMass (c : Ret 13197) : Prop :=
  ∫ a, (stdGauss (Fin (13197 - 1))).real
    {v | sgA (paperDesignP 13197) c a v < rowSigma} ∂muI 13197 ≤ lowMassBudget

