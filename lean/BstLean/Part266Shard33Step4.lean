  removal : ∫ a, removed (stdGauss (Fin (13185 - 1)))
    (rowSplit c wl ws).good a ∂muI 13185 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13185) c (rowSplit c wl ws),
