    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((1153621 / 200000000)) ^ 2 * ((1003 / 1000) * ((15340567 / 500000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((69732913 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4763361067 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1153621 / 200000000)) * ((1001 / 1000 + 52 / 1000) * ((249660261 / 500000000000))) := by
