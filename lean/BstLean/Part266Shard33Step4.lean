theorem hq_output_bounds {c : Ret 13196}
    (hw : WINDOW (paperDesignP 13196) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13196)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
