theorem hq_output_bounds {c : Ret 13189}
    (hw : WINDOW (paperDesignP 13189) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13189)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
