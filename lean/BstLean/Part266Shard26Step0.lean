      (operatorEnvelope_pos160 (by norm_num)).le (by norm_num)
    exact h2.trans (by norm_num)
  unfold latitudeJacobianSquared160 jacobianConstantSquared160
  have hh : √(planeEnvelopeSquared160 13000 4 +
      2 / (mA 13000 : ℝ) * frobEnvelopeSquared160 13000) +
      transverseConstant160 * √(2 / (mA 13000 : ℝ)) * operatorEnvelope160 13000 ≤ 9 / 4 := by
    linarith
  have hh0 : 0 ≤ √(planeEnvelopeSquared160 13000 4 +
      2 / (mA 13000 : ℝ) * frobEnvelopeSquared160 13000) +
      transverseConstant160 * √(2 / (mA 13000 : ℝ)) * operatorEnvelope160 13000 :=
    add_nonneg (sqrt_nonneg _) (mul_nonneg
      (mul_nonneg (gaussMomConst_nonneg 80) (sqrt_nonneg _))
      (operatorEnvelope_pos160 (by norm_num)).le)
  exact (pow_le_pow_left₀ hh0 hh 2).trans (by norm_num)

theorem latitude_constant_sharp_row : freshLatitudeConstant160 13000 4 (55 / 100) ≤ (16 / 5 : ℝ) := by
  have hr : (20000 : ℝ) ^ (1 / 80 : ℝ) ≤ 1132 / 1000 := by
