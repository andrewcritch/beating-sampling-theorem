/-! The pointwise variance budget follows from ordinary matrix operator bounds. -/
namespace BstLean.Part266.Row13000
open BstLean.Part252
open MeasureTheory Real
open BstLean.Part130 BstLean.Part157 BstLean.Part161 BstLean.Part169
open BstLean.Part162 (psiA)
open BstLean.Part53 (unitF53)
open BstLean.Part29 (stdGauss)

theorem variance_pointwise_row (c : Ret 13000) (hb : normSq (bR c) ≠ 0)
    (h1 : OpB (A1 c) 165) (h2 : OpB (A2 c) (283 / 100)) (a : Ix 13000) :
    |VR c a| ≤ varianceMax := by
  have h := variance_pointwise (by norm_num) c hb h1 h2 (by norm_num) (by norm_num) a
  rw [abs_of_nonneg h.1]
  refine h.2.trans ?_
  norm_num only [Nat.cast_ofNat]
  rw [div_pow, sq_sqrt (by norm_num : (0 : ℝ) ≤ 13000)]
  norm_num [varianceMax]

end BstLean.Part266.Row13000

/-! The ordinary operator events supply the pointwise variance guard. -/
namespace BstLean.Part266.Row13000
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part130 BstLean.Part153 BstLean.Part157 BstLean.Part160 BstLean.Part169

theorem first_matrix_row (c : Ret 13000) (hc : A1 c ∈ Eop 13000) : OpB (A1 c) 165 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (13000 : ℝ)) ≤ (12403473459 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(13000 : ℝ) ≤ (114017543 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (13000 : ℝ) + 2 * √13000 ≤ (6614017543 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 13000) (hc : c ∈ BstLean.Part164.Eop2 13000) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 13000 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 13000) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 13000 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 13000) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 13000).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 13000) (FirstMatrix 13000))
    (h2 : c ∈ BstLean.Part164.Eop2 13000) (a : BstLean.Part161.Ix 13000) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

end BstLean.Part266.Row13000

