  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((5333716 / 15625) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5079604017 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5893 / 1000000)) * ((1001 / 1000 + 52 / 1000) * ((521185691 / 1000000000000))) := by
        gcongr
