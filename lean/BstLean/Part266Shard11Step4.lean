  all_goals clear * - hV0 hV1 hE0 hE1 hi80 hi81 hi120 hi121 hc20 hc21 hc30 hc31 hVl hVs hVl0 hVs0 hl4 hl6 hs4 hs6 hl40 hl60 hs40 hs60 hinv hinv0 hσ0 hσ hca0 hroot0 hroot
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((23306846471 / 200000) : ℝ) * ((1003 / 1000) * ((396799 / 125000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5892767 / 1000000000)) ^ 2 * ((1003 / 1000) * ((33421053 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((68274233 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2539500399 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5892767 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((521144423 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((68274233 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((3119178867 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
