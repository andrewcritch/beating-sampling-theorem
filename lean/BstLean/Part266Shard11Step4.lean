/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12637) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12637) c (rowSplit c wl ws),
    ((12637 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12637 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12637) c (rowSplit c wl ws),
    ((12637 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12637 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12637 - 1)))
    (rowSplit c wl ws).good a ∂muI 12637 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12637) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12637 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12637) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12637 ≤ mixtureRoot ^ 2
