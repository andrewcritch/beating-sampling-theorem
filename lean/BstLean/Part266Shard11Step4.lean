  (muI 12634).map (tableNodeIndex wr)

theorem tableNodeMeasure_mass (wr : WRet 12634) : tableNodeMeasure wr univ = 1 := by
  rw [tableNodeMeasure, Measure.map_apply (tableNodeIndex_measurable wr) MeasurableSet.univ]
