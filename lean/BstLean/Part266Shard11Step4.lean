def LowResidualMass (c : Ret 12628) : Prop :=
  ∫ a, (stdGauss (Fin (12628 - 1))).real
    {v | sgA (paperDesignP 12628) c a v < rowSigma} ∂muI 12628 ≤ lowMassBudget

