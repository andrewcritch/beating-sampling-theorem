theorem hq_output_bounds {c : Ret 12633}
    (hw : WINDOW (paperDesignP 12633) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12633)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
