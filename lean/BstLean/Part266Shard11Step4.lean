  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((85376173 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5072975171 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1472609 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((520732109 / 1000000000000))) := by
        gcongr
