theorem hsAffineBand {n : ℕ} (hn : 8000 ≤ n) {θ : ℝ}
    (hw : θ ∈ Icc (0.46 : ℝ) 0.54) :
    hsProfile n θ 0.006 * (θ * √θ) ≤ 0.004172 + 0.34 * θ := by
  obtain ⟨j, hj⟩ := unit_interval_cover 159
    (x := (θ - 46 / 100) * 2000) (by constructor <;> norm_num <;> linarith [hw.1, hw.2])
  have he := hsAffineNoise (j := j) (θ := θ) (by constructor <;> linarith [hj.1, hj.2])
  have hm := BstLean.Part277.hsProfile_leP (n0 := 8000) (by norm_num) hn
    (by linarith [hw.1] : 0 < θ) (by linarith [hw.2] : θ ≤ 1)
  have hθ : 0 ≤ θ := by linarith [hw.1]
  exact (mul_le_mul_of_nonneg_right hm (by positivity : 0 ≤ θ * √θ)).trans he

theorem hsAffinePrefix {n : ℕ} (hn : 8000 ≤ n) {θ Θ : ℝ}
    (hw : θ ∈ Icc (0.46 : ℝ) Θ) (hΘ : Θ ≤ 0.54) :
    hsProfile n θ 0.006 * (θ * √θ) ≤ 0.004172 + 0.34 * Θ := by
  have h := hsAffineBand hn ⟨hw.1, hw.2.trans hΘ⟩
  linarith [hw.2]

