open Real Set

structure ScalarRow (n : ℕ) where
  M : ℝ
  H : ℝ
  xi : ℝ
  top : ℝ
  targetFrame : ℝ
  table : Fin 60 → CellData
  grid : Grid
  grid_top : grid.top = top
  grid_lower : grid.worldLower = BstLean.Part227.noiseLower (202225 / 100000)
  grid_upper : grid.worldUpper = BstLean.Part227.noiseUpper n (202831 / 100000)
  certificate : ∀ i, CellCertificate n M H xi (table i)
  energy_allowance : BstLean.Part222.energyAllowance n ≤ H
  frame : ∀ i, 10 ≤ i.val ∧ i.val ≤ 52 → (table i).frame ≤ targetFrame
  containment : ∀ i, (table i).lower ≤ noiseNode top i.val ∧
    noiseNode top (i.val+1) ≤ (table i).upper

