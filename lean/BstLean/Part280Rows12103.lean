theorem removal_of_low_mass {c : Ret 12107}
    (hw : WINDOW (paperDesignP 12107) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12107 - 1))).real
