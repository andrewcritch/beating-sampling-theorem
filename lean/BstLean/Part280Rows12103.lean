theorem row_split_floor :
    (2 / (12104 : ℝ)) * biasFloor =
      (1 - eta) * (√(2 / (12104 : ℝ) * mixtureFloor)) ^ 2 := by
  rw [Real.sq_sqrt (by norm_num [mixtureFloor])]
  unfold biasFloor
  ring

/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 12104) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 12104) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (12104 : ℝ)) * eR c * 12104 * chi
  moments : PaperMoments c (keptIx (paperDesignP 12104) c (rowSplit c wl ws))
    varianceMax energyError locationError locationNorm varianceNorm
  removal : ∫ a, removed (stdGauss (Fin (12104 - 1)))
    (rowSplit c wl ws).good a ∂muI 12104 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12104) c (rowSplit c wl ws),
