    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12104) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12104).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12104) (FirstMatrix 12104))
    (h2 : c ∈ BstLean.Part164.Eop2 12104) (a : BstLean.Part161.Ix 12104) :
