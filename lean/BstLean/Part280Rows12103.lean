theorem first_matrix_row (c : Ret 12105) (hc : A1 c ∈ Eop 12105) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12105 : ℝ)) ≤ (2570766291 / 200000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12105 : ℝ) ≤ (4400909 / 40000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12105 : ℝ) + 2 * √12105 ≤ (246500909 / 20000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12105) (hc : c ∈ BstLean.Part164.Eop2 12105) :
    OpB (A2 c) (283 / 100) := by
