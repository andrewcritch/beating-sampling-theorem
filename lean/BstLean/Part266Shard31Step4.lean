theorem hq_output_bounds {c : Ret 13134}
    (hw : WINDOW (paperDesignP 13134) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13134)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
