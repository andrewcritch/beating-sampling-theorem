theorem hq_output_bounds {c : Ret 13146}
    (hw : WINDOW (paperDesignP 13146) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13146)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
