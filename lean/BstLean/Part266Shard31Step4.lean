    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13146 - 1))).real
      {v | sgA (paperDesignP 13146) c a v < rowSigma} ∂BstLean.Part161.muI 13146 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
