    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13134 - 1))).real
      {v | sgA (paperDesignP 13134) c a v < rowSigma} ∂BstLean.Part161.muI 13134 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
