theorem hq_displacement_root {c : Ret 13126} (he : (6 / 10 : ℝ) ≤ eR c)
    {B : ℝ} (hB0 : 0 ≤ B) (hB : B ≤ removalBudget) :
    √(Dpap 13126 B hqCentreCap (locationVarianceBudget c) scaleVarianceBudget eta rowSigma) ≤
