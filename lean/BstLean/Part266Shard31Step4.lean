/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13137) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13137) c (rowSplit c wl ws),
    ((13137 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13137 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13137) c (rowSplit c wl ws),
    ((13137 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13137 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13137 - 1)))
    (rowSplit c wl ws).good a ∂muI 13137 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13137) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13137 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13137) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13137 ≤ mixtureRoot ^ 2
