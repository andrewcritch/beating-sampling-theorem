    exact (div_pos_iff.mp he0).elim (fun h => h.1) (fun h => by norm_num at h)
  refine ⟨hp hb, ?_⟩
  norm_num [chi, hqCentreCap] at hcap ⊢
  linarith [he.2]

theorem hq_fluctuation {c : Ret 13146} (t : ℝ)
    (hw : WINDOW (paperDesignP 13146) c) (ha : c ∈ analyticBase)
