theorem hq_root_price {c : Ret 13126} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 13126) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13126 - 1))).real
      {v | sgA (paperDesignP 13126) c a v < rowSigma} ∂BstLean.Part161.muI 13126 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
