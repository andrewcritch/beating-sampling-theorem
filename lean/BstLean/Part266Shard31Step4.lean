theorem hq_fluctuation {c : Ret 13134} (t : ℝ)
    (hw : WINDOW (paperDesignP 13134) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13134)) (hm : LowResidualMass c) :
    FLUCT_hyp (paperDesignP 13134) t c (hqSplit c) (24 / 10000) := by
  have he := (centre_energy_range hw ha).1
  have he0 : 0 < eR c := by linarith
  have hc := analyticBaseCertificate.pass_fields ha
  have ho := hq_output_bounds hw ha hp
