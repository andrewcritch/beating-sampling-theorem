    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13130) (mA 13130) (tA 13130) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
