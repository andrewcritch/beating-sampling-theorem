/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13139) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13139) c (rowSplit c wl ws),
    ((13139 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13139 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13139) c (rowSplit c wl ws),
    ((13139 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13139 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13139 - 1)))
    (rowSplit c wl ws).good a ∂muI 13139 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13139) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13139 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13139) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13139 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 13139) c (rowSplit c wl ws),
    hellG2 13139 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 13139 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 13139}
    (hw : WINDOW (paperDesignP 13139) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
  window := hw
  energy_pos := he
  centre := pass_centre_of_events c hc
  moments := pass_moments_of_events c hw he hc _ R.energy_table R.location_table
  removal := R.removal
  mixture := R.mixture
  displacement := R.displacement

/-- This structure value can be passed directly to Part243 once the five remainder bounds hold. -/
noncomputable def rootInputs_of_events {t : ℝ} {c : Ret 13139}
    (hw : WINDOW (paperDesignP 13139) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) :
    BstLean.Part243.RootInputs 13139 t c BstLean.Part266.agent13139.root :=
  rootInputs (rootSource_of_events hw he hc R)

