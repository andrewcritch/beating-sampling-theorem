  let ρ := BstLean.Part169.rhoR c
  have hρ2 : ρ ^ 2 = normSq c.1.2 + 13139 * BstLean.Part169.tauR c ^ 2 := by
    change (√(normSq c.1.2 + (13139 : ℝ) * BstLean.Part169.tauR c ^ 2)) ^ 2 = _
