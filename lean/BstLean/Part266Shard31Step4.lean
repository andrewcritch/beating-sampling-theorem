    (gaussMat (mA 13136) 13136 (2 / (13136 : ℝ))).real {X | ∃ g < Js 13136,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13136 : ℝ)) ∨
