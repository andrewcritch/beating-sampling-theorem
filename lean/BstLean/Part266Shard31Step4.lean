    (gaussMat (mA 13141) 13141 (2 / (13141 : ℝ))).real {X | ∃ g < Js 13141,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13141 : ℝ)) ∨
