    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 12380) (mA 12380) (tA 12380) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
