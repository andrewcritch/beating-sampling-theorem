      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((1487387 / 250000000)) ^ 2 * ((1003 / 1000) * ((34728089 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169075531 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5227275017 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1487387 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((531239639 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169075531 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((6420497449 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
