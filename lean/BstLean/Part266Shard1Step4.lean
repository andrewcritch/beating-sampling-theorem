def LowResidualMass (c : Ret 12387) : Prop :=
  ∫ a, (stdGauss (Fin (12387 - 1))).real
    {v | sgA (paperDesignP 12387) c a v < rowSigma} ∂muI 12387 ≤ lowMassBudget

