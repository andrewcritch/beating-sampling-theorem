theorem hq_root_price {c : Ret 12398} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 12398) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12398 - 1))).real
      {v | sgA (paperDesignP 12398) c a v < rowSigma} ∂BstLean.Part161.muI 12398 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
