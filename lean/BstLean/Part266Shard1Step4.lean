    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((595219 / 100000000)) ^ 2 * ((1003 / 1000) * ((34789823 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((338002737 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((104684869 / 20000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((595219 / 100000000)) * ((1001 / 1000 + 52 / 1000) * ((531711719 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((338002737 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((160726437 / 25000000000000))) := by gcongr
      _ ≤ _ := by norm_num
