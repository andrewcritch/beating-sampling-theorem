theorem hq_output_bounds {c : Ret 12383}
    (hw : WINDOW (paperDesignP 12383) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12383)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
