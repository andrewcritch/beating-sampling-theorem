    (gaussMat (mA 12391) 12391 (2 / (12391 : ℝ))).real {X | ∃ g < Js 12391,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12391 : ℝ)) ∨
