def LowResidualMass (c : Ret 12398) : Prop :=
  ∫ a, (stdGauss (Fin (12398 - 1))).real
    {v | sgA (paperDesignP 12398) c a v < rowSigma} ∂muI 12398 ≤ lowMassBudget

