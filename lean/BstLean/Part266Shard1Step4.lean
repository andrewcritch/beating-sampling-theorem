    (hw : BstLean.Part161.WINDOW (paperDesignP 12377) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12377 - 1))).real
      {v | sgA (paperDesignP 12377) c a v < rowSigma} ∂BstLean.Part161.muI 12377 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
