def LowResidualMass (c : Ret 12394) : Prop :=
  ∫ a, (stdGauss (Fin (12394 - 1))).real
    {v | sgA (paperDesignP 12394) c a v < rowSigma} ∂muI 12394 ≤ lowMassBudget

