open BstLean.Part81 (JJ WIdx pf kap eD)
open BstLean.Part84

/-! ## §1 Sphere moments -/

/-- **Sphere moments**: `E (n p₄(x))^j ≤ B^j` for `j ≤ J`. -/
def MomB (n J : ℕ) (B : ℝ) : Prop :=
  ∀ j : ℕ, j ≤ J → ∫ x : Fin n → ℝ, ((n : ℝ) * p4 x) ^ j ∂uniformSphere n ≤ B ^ j

/-- The bound for `k · t`, `t = |lam² κ(x,x) − e_d| √n / (e_d (1 − w/n))`, as a polynomial with
nonnegative coefficients in `y = n p₄(x)`. -/
noncomputable def tauF (n d k : ℕ) (w y : ℝ) : ℝ :=
  k * (w + (1 + w / n) * (1 / eD d) *
      (2719 / 2000 * y * (1 + 1 / Real.sqrt n + y / (4 * Real.sqrt n)) *
        (1 + (d : ℝ) / (2 * n) * y))) /
    (Real.sqrt n * (1 - w / n))

/-- **The scale defect, pointwise**: for `|lam² − 1| ≤ w/n` and `x` on the sphere. -/
def PtIface88 (n d k : ℕ) (w : ℝ) : Prop :=
  ∀ lam : ℝ, |lam ^ 2 - 1| ≤ w / (n : ℝ) → ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
    eD d * (1 - w / n) ≤ lam ^ 2 * kap d x x ∧
    k * (|lam ^ 2 * kap d x x - eD d| * Real.sqrt n / (eD d * (1 - w / n))) ≤
      tauF n d k w (n * p4 x)

/-- **The four sphere averages** of functions of `τ(x) = tauF (n p₄(x))`. -/
def MomFacts88 (n d k : ℕ) (w B : ℝ) : Prop :=
  ∫ x : Fin n → ℝ, tauF n d k w (n * p4 x) ∂uniformSphere n ≤ tauF n d k w B ∧
  ∫ x : Fin n → ℝ, (1 + tauF n d k w (n * p4 x)) ^ (2 * k) ∂uniformSphere n ≤
    (1 + tauF n d k w B) ^ (2 * k) ∧
  ∫ x : Fin n → ℝ, (tauF n d k w (n * p4 x) / k) ^ 2 * (1 + tauF n d k w (n * p4 x)) ^ k
    ∂uniformSphere n ≤ (tauF n d k w B / k) ^ 2 * (1 + tauF n d k w B) ^ k ∧
  ∫ x : Fin n → ℝ, ((1 + tauF n d k w (n * p4 x)) ^ (2 * k) +
      (tauF n d k w (n * p4 x) / k) ^ 2 * (1 + tauF n d k w (n * p4 x)) ^ k) ^ 2
    ∂uniformSphere n ≤
    ((1 + tauF n d k w B) ^ (2 * k) + (tauF n d k w B / k) ^ 2 * (1 + tauF n d k w B) ^ k) ^ 2

/-! ## §2 The Gaussian model on a scale window -/

/-- The constants of the Gaussian model, as functions of `τ = tauF n d k w B`. -/
noncomputable def cEG (k : ℕ) (τ : ℝ) : ℝ := (1 + τ) ^ (2 * k)

noncomputable def c1G (n d k : ℕ) (CF τ : ℝ) : ℝ :=
  n * ((τ / k) ^ 2 * (1 + τ) ^ k) + CF * (1 + τ) ^ (2 * k) / eD d

noncomputable def cVG (n d k : ℕ) (CF K4 τ : ℝ) : ℝ :=
  K4 * (2 * CF * ((1 + τ) ^ (2 * k) + (τ / k) ^ 2 * (1 + τ) ^ k) ^ 2 / eD d +
    2 * c1G n d k CF τ ^ 2 / n)

noncomputable def eflG (n d k : ℕ) (CF τ : ℝ) : ℝ := 2 * k * τ + c1G n d k CF τ / n

/-- **The Gaussian model given the constant column, on the scale window `|lam² − 1| ≤ w/n`.**
One level `L ≥ 0` for every scale; a centre `Vb lam ≥ (1 − efl) L`; `E errW² ≤ (c1/n) L`;
`E (VW − Vb lam)² ≤ (cV/n) L²`; and the drift of the centre between two scales of the window. -/
def GM88 (n d k : ℕ) (w c1 cV efl cE : ℝ) : Prop :=
  ∀ (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ k → ∃ (L : ℝ) (Vb : ℝ → ℝ), 0 ≤ L ∧
    (∀ lam : ℝ, |lam ^ 2 - 1| ≤ w / (n : ℝ) →
      (1 - efl) * L ≤ Vb lam ∧
      Integrable (fun W : WIdx n d → ℝ => errW P lam W ^ 2) (stdGauss (WIdx n d)) ∧
      Integrable (fun W : WIdx n d → ℝ => (VW P lam W - Vb lam) ^ 2) (stdGauss (WIdx n d)) ∧
      ∫ W : WIdx n d → ℝ, errW P lam W ^ 2 ∂stdGauss (WIdx n d) ≤ c1 / (n : ℝ) * L ∧
      ∫ W : WIdx n d → ℝ, (VW P lam W - Vb lam) ^ 2 ∂stdGauss (WIdx n d) ≤ cV / (n : ℝ) * L ^ 2) ∧
    (∀ lam lam' : ℝ, |lam ^ 2 - 1| ≤ w / (n : ℝ) → |lam' ^ 2 - 1| ≤ w / (n : ℝ) →
      |Vb lam' - Vb lam| ≤
        (((1 + k * (|lam' ^ 2 - lam ^ 2| * Real.sqrt n / min (lam ^ 2) (lam' ^ 2))) ^ (2 * k) - 1) *
          cE + 2 * c1 / n) * L)

/-! ## §3 The Christoffel bound (Chebyshev polynomials of the second kind) -/

/-- `Σ_{j ≤ D, j odd} (j+1)²`. -/
noncomputable def Sodd (D : ℕ) : ℝ :=
  ∑ j ∈ Finset.range (D + 1), if j % 2 = 1 then ((j : ℝ) + 1) ^ 2 else 0

/-- The Christoffel constant near the centre of the semicircle distribution. -/
noncomputable def SS (D : ℕ) (ξ : ℝ) : ℝ := ((D / 2 : ℕ) : ℝ) + 1 + 5 / 4 * ξ ^ 2 * Sodd D

/-- **Christoffel bound**: for a polynomial `p` of degree `≤ D`, a centre `c`, a half-width `β`
and a point `x0` with `|x0| ≤ 1/2`:
`p(c(1+β x0))² (1 − x0²) ≤ SS D x0 · (2/π) ∫_0^π p(c(1+β cos θ))² sin²θ dθ`. -/
def ChrisIface (D : ℕ) : Prop :=
  ∀ (p : Polynomial ℝ), p.natDegree ≤ D → ∀ (c β x0 : ℝ), |x0| ≤ 1 / 2 →
    (p.eval (c * (1 + β * x0))) ^ 2 * (1 - x0 ^ 2) ≤
      SS D x0 * (2 / Real.pi * ∫ θ in (0 : ℝ)..Real.pi,
        (p.eval (c * (1 + β * Real.cos θ))) ^ 2 * Real.sin θ ^ 2)

/-! ## §4 The sphere step -/

/-- The scale ratio bound inside the semicircle window. -/
noncomputable def tB (n : ℕ) (β : ℝ) : ℝ := ((1 + β) ^ 2 - 1) * Real.sqrt n / (1 - β) ^ 2

/-- The drift of the centre inside the semicircle window (relative to `L`). -/
noncomputable def DrF (n k : ℕ) (c1 cE β : ℝ) : ℝ :=
  ((1 + k * tB n β) ^ (2 * k) - 1) * cE + 2 * c1 / n

/-- The variance constant with the drift. -/
noncomputable def cVe (n k : ℕ) (c1 cV cE β θ : ℝ) : ℝ :=
  (1 + θ) * cV + (1 + 1 / θ) * (n * DrF n k c1 cE β ^ 2)

/-- The bound for the probability that the radius ratio is not good. -/
noncomputable def nuB (n d : ℕ) (β ξ : ℝ) : ℝ := 2 / (DW n d * (19 / 10 * ξ * β) ^ 2)

/-- The bound of the sphere step. -/
noncomputable def pS (n d k : ℕ) (c1 cV efl cE β ξ θ ε κ : ℝ) : ℝ :=
  (SS k ξ * c1 / (n * (ε ^ 2 * κ)) +
    SS (2 * k) ξ * cVe n k c1 cV cE β θ / (n * (1 - efl - κ) ^ 2)) /
    ((1 - ξ ^ 2) * (1 - nuB n d β ξ))

/-- **The sphere step** (semicircle average over the scale, Christoffel bound, then Markov and
Chebyshev): for a fixed polynomial and a fixed scale `lam` with `|lam² − 1| ≤ 1/n`, the failure
probability over the direction of `W`. The parameters: `β` is the relative half-width of the scale
average, `ξ` bounds the off-centre position, `θ` is the weight of the drift. -/
def SemiStep (n d k : ℕ) (w c1 cV efl cE : ℝ) : Prop :=
  ∀ (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ k → ∀ lam : ℝ, |lam ^ 2 - 1| ≤ 1 / (n : ℝ) →
    ∀ ε κ β ξ θ : ℝ, 0 < ε → 0 < κ → efl + κ < 1 → 0 < β → β < 1 → 0 < ξ → ξ ≤ 1 / 2 →
      ξ * β ≤ 1 / 100 → 0 < θ → nuB n d β ξ < 1 →
      (1 + 1 / (n : ℝ)) * (1 + β) ^ 2 ≤ 1 + w / n →
      1 - w / n ≤ (1 - 1 / (n : ℝ)) * (1 - β) ^ 2 →
      stdGauss (WIdx n d) {W | ε ^ 2 * VW P lam (Real.sqrt (DW n d) • unitF53 W) <
          errW P lam (Real.sqrt (DW n d) • unitF53 W) ^ 2} ≤
        ENNReal.ofReal (pS n d k c1 cV efl cE β ξ θ ε κ)

end BstLean.Part88
