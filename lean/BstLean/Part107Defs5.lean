import BstLean.Part107Defs

/-!
# Part 107, frozen definitions for item 5: the program for the linear part and Lemma E

Paper source: `delegations/answers/oaW7-opus-prover.md` §2 (Lemma E, Lemma A), `oaW7c-cx.md` §3.
Definitions and `Prop`-valued interface statements only. Do not edit this file.

The program `g` for the linear part: the mean of `ℓ·A(y_i)` over `k` samples `y_i` of the stand-in
`ν_W` (`nuW W τ`, `τ = tauOf dW σ = √(dW − 1)·σ`). A sample of the stand-in is a function of the
independent primitives `(u_i, g_i)`, `u_i` uniform on the unit sphere of `ℝ^N`, `g_i ∼ N(0, I_n)`:
`y_i = (W_0 + W_1 u_i + τ g_i)/|W_0 + W_1 u_i + τ g_i|`. The stand-in reads the coefficients of
degree `0` and `1` of `W` only.
-/

namespace BstLean.Part107

open MeasureTheory ProbabilityTheory
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part105

/-- The primitives of one sample of the stand-in: `(u, g)`. -/
abbrev Prim (N n : ℕ) := (Fin N → ℝ) × (Fin n → ℝ)

/-- The distribution of the primitives of one sample. -/
noncomputable abbrev primM (N n : ℕ) : Measure (Prim N n) :=
  (uniformSphere N).prod (stdGauss (Fin n))

/-- One sample of the stand-in `ν_W` as a function of its primitives. `nuW W τ` is the image of
`primM N n` under `standIn W τ` (by definition). -/
noncomputable def standIn {N n dW : ℕ} (W : CoefIdx N n dW → ℝ) (τ : ℝ) (s : Prim N n) :
    Fin n → ℝ :=
  sphProj (bwEval (mixW W 0) s.1 + τ • s.2)

/-- The program `g` for the linear part: the mean of `ℓ·A(y_i)` over `k` samples of the
stand-in. -/
noncomputable def gProg {N n dW dA k : ℕ} (τ : ℝ) (W : CoefIdx N n dW → ℝ)
    (A : CoefIdx n n dA → ℝ) (ℓ : Fin n → ℝ) (s : Fin k → Prim N n) : ℝ :=
  (1 / (k : ℝ)) * ∑ i, qLin A ℓ (standIn W τ (s i))

/-- `B = E_{μ_W} ℓ·A(x)`: the average behavior of the linear part. -/
noncomputable def Bmean {N n dW dA : ℕ} (W : CoefIdx N n dW → ℝ) (A : CoefIdx n n dA → ℝ)
    (ℓ : Fin n → ℝ) : ℝ :=
  ∫ x, qLin A ℓ x ∂muW W

/-- The distribution of `((W, (A₁, ℓ)), (u_i, g_i)_{i < k})`: all independent. -/
noncomputable abbrev Full (N n dW dA k : ℕ) (σ : ℝ) :
    Measure (((CoefIdx N n dW → ℝ) × ((CoefIdx n n dA → ℝ) × (Fin n → ℝ))) ×
      (Fin k → Prim N n)) :=
  (PP N n dW dA σ).prod (Measure.pi fun _ : Fin k => primM N n)

/-- The error `g − B` on the full space. -/
noncomputable def gErr {N n dW dA k : ℕ} (σ : ℝ)
    (ω : ((CoefIdx N n dW → ℝ) × ((CoefIdx n n dA → ℝ) × (Fin n → ℝ))) × (Fin k → Prim N n)) : ℝ :=
  gProg (tauOf dW σ) ω.1.1 ω.1.2.1 ω.1.2.2 ω.2 - Bmean ω.1.1 ω.1.2.1 ω.1.2.2

/-- **Lemma E for the linear part** (Gaussian versions):
`(1 − λ_0) · E(g − B)² ≤ (λ_0 + 1/k) · E X₁`. -/
def LemmaE107 : Prop :=
  ∀ (N n dW dA k : ℕ) (σ : ℝ), 1 ≤ N → 2 ≤ dW → 1 ≤ k →
    Integrable (fun ω => gErr (N := N) (n := n) (dW := dW) (dA := dA) (k := k) σ ω ^ 2)
      (Full N n dW dA k σ) ∧
    (1 - lam0 N dW) * ∫ ω, gErr (N := N) (n := n) (dW := dW) (dA := dA) (k := k) σ ω ^ 2
        ∂Full N n dW dA k σ ≤
      (lam0 N dW + 1 / (k : ℝ)) * ∫ ω, X1 ω.1 ω.2.1 ω.2.2 ∂PP N n dW dA σ

/-- `λ_0 ≤ (1/(14n))(1 + 2/n)` at `d_W = 8`, `N = 2n`, `n ≥ 10`. -/
def Lam8_107 : Prop :=
  ∀ n : ℕ, 10 ≤ n → lam0 (2 * n) 8 ≤ 1 / (14 * (n : ℝ)) * (1 + 2 / (n : ℝ))

end BstLean.Part107
