import BstLean.Part106All
import BstLean.Part107All

/-!
# Part 108, frozen definitions: Theorem W8-S (sphere versions of `W`, `A`, `F`; realized spread)

Role: `delegations/statements/p108-spec.md`. Paper sources: `oaW7-opus-prover.md` §4,
`oaW7c-cx.md` §5, §7, `oaW8-opus-prover.md`, `oaW8c-cx.md`.
This file holds definitions and `Prop`-valued interface statements only.
Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

* `Bu W φ`, `Vu W φ`: the mean and the variance of `φ(W(u)/|W(u)|)` over `u` (they are
  `∫ φ ∂μ_W` and `Var_{μ_W} φ` for measurable `φ`).
* `Err W τ φ ω = g − B`, `Succ W τ φ ω : |g − B| ≤ (1/2)·sd_μ`.
* `nrm b = b/‖b‖` (Bombieri–Weyl norm).
* `linF F`: the coefficients of degree 1 of `F`; `Htail F y`: the terms of degree `≥ 2` of `F(y)`;
  `psi ρ A₁ F x = ρ · Htail F (A₁(x)/ρ)`: the perturbation, so that
  `ρ · F(A₁(x)/ρ) = ρ·F_0 + ℓ·A₁(x) + psi ρ A₁ F x`.
-/

namespace BstLean.Part108

open MeasureTheory ProbabilityTheory
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part105

/-- The `k` blocks of random inputs of the program. -/
abbrev Draws (N n k : ℕ) := Fin k → (Fin N → ℝ) × (Fin n → ℝ)

/-- The distribution of the `k` blocks: `u_i` uniform on the unit sphere of `ℝ^N`, `g_i` standard
Gaussian in `ℝⁿ`, all independent. -/
noncomputable abbrev drawM (N n k : ℕ) : Measure (Draws N n k) :=
  Measure.pi fun _ : Fin k => (uniformSphere N).prod (stdGauss (Fin n))

/-- `B`: the mean of `φ(W(u)/|W(u)|)` over `u`. -/
noncomputable def Bu {N n d : ℕ} (W : CoefIdx N n d → ℝ) (φ : (Fin n → ℝ) → ℝ) : ℝ :=
  ∫ u, φ (sphProj (bwEval W u)) ∂uniformSphere N

/-- `sd_μ²`: the variance of `φ(W(u)/|W(u)|)` over `u`. -/
noncomputable def Vu {N n d : ℕ} (W : CoefIdx N n d → ℝ) (φ : (Fin n → ℝ) → ℝ) : ℝ :=
  ∫ u, (φ (sphProj (bwEval W u)) - Bu W φ) ^ 2 ∂uniformSphere N

/-- `g − B`. -/
noncomputable def Err {N n d k : ℕ} (W : CoefIdx N n d → ℝ) (τ : ℝ) (φ : (Fin n → ℝ) → ℝ)
    (ω : Draws N n k) : ℝ :=
  BstLean.Part106.gVal W τ φ ω - Bu W φ

/-- Success: `|g − B| ≤ (1/2)·sd_μ`. -/
def Succ {N n d k : ℕ} (W : CoefIdx N n d → ℝ) (τ : ℝ) (φ : (Fin n → ℝ) → ℝ)
    (ω : Draws N n k) : Prop :=
  |Err W τ φ ω| ≤ 1 / 2 * Real.sqrt (Vu W φ)

/-- `b/‖b‖` in the Bombieri–Weyl norm (and `0` at `b = 0`). -/
noncomputable def nrm {k q d : ℕ} (b : CoefIdx k q d → ℝ) : CoefIdx k q d → ℝ :=
  (1 / Real.sqrt (bwNormSq b)) • b

/-- The coefficients of degree 1 of `F`. -/
def linF {n dF : ℕ} (hd : 1 ≤ dF) (F : CoefIdx n 1 dF → ℝ) : Fin n → ℝ :=
  fun i => F (0, mono1 n dF hd i)

/-- The terms of degree at least 2 of `F(y)`. -/
noncomputable def Htail {n dF : ℕ} (hd : 1 ≤ dF) (F : CoefIdx n 1 dF → ℝ) (y : Fin n → ℝ) : ℝ :=
  bwEval F y 0 - F (0, mono0 n dF) - ∑ i, F (0, mono1 n dF hd i) * y i

/-- The perturbation: `ρ · (terms of degree ≥ 2 of F)(A₁(x)/ρ)`. -/
noncomputable def psi {n dA dF : ℕ} (hd : 1 ≤ dF) (ρ : ℝ) (A1 : CoefIdx n n dA → ℝ)
    (F : CoefIdx n 1 dF → ℝ) (x : Fin n → ℝ) : ℝ :=
  ρ * Htail hd F (ρ⁻¹ • bwEval A1 x)

/-- `E |g|^{2j}`, `g` standard Gaussian in `ℝⁿ`. -/
noncomputable def gmom (n j : ℕ) : ℝ := ∫ z, (∑ i, z i ^ 2) ^ j ∂stdGauss (Fin n)

/-- Scale the Gaussian part of every block by `s`. -/
def scaleDraws {N n k : ℕ} (s : ℝ) (ω : Draws N n k) : Draws N n k :=
  fun i => ((ω i).1, s • (ω i).2)

/-! ## Interface statements -/

/-- The coefficients of degree 1 of the Gaussian version of `F` are a standard Gaussian vector. -/
def LinLaw108 : Prop :=
  ∀ (n dF : ℕ) (hd : 1 ≤ dF), (bwGauss n 1 dF 1).map (linF hd) = stdGauss (Fin n)

/-- The second moment over `F` of the terms of degree at least 2: `Σ_{j=2}^{d_F} |y|^{2j}`. -/
def HtailMom108 : Prop :=
  ∀ (n dF : ℕ) (hd : 1 ≤ dF) (y : Fin n → ℝ),
    ∫⁻ F, ENNReal.ofReal (Htail hd F y ^ 2) ∂bwGauss n 1 dF 1 =
      ENNReal.ofReal (∑ j ∈ Finset.Icc 2 dF, dot y y ^ j)

/-- The moments of `|A₁(x)|²` for the Gaussian version of `A`: `κ(|x|²)^j · E|g|^{2j}`. -/
def EvalMom108 : Prop :=
  ∀ (n dA : ℕ) (x : Fin n → ℝ) (j : ℕ),
    ∫⁻ A, ENNReal.ofReal ((∑ a, bwEval A x a ^ 2) ^ j) ∂bwGauss n n dA 1 =
      ENNReal.ofReal (BstLean.Part107.kap dA (dot x x) ^ j * gmom n j)

/-- Values and bounds of `E|g|^{2j}`. -/
def GMom108 : Prop :=
  ∀ n : ℕ, 1 ≤ n →
    (∀ j, 0 ≤ gmom n j) ∧ gmom n 2 = (n : ℝ) * ((n : ℝ) + 2) ∧
      gmom n 3 ≤ 15 * (n : ℝ) ^ 3 ∧ gmom n 4 ≤ 105 * (n : ℝ) ^ 4

/-- **The perturbation bound.** For fixed `W`, `τ`, blocks `ω`: the mean over the Gaussian
versions `(A₁, F)` of `(|g − B| + sd_μ/2)²` for the test function `psi ρ_A A₁ F`, on the event
`ρ_A² ≥ 1/c₂`, is at most `(17/2) Σ_{j=2}^{d_F} c₂^{j−1} K^j E|g|^{2j}`. -/
def PertBound108 : Prop :=
  ∀ (N n dW dA dF k : ℕ) (hd : 1 ≤ dF), 1 ≤ N → 1 ≤ k →
    ∀ (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ω : Draws N n k) (c2 : ℝ), 0 ≤ c2 →
      ∫⁻ q : (CoefIdx n n dA → ℝ) × (CoefIdx n 1 dF → ℝ),
          (if 1 ≤ c2 * bwNormSq q.1 then
            ENNReal.ofReal
              ((|Err W τ (psi hd (Real.sqrt (bwNormSq q.1)) q.1 q.2) ω| +
                1 / 2 * Real.sqrt (Vu W (psi hd (Real.sqrt (bwNormSq q.1)) q.1 q.2))) ^ 2)
          else 0) ∂((bwGauss n n dA 1).prod (bwGauss n 1 dF 1)) ≤
        ENNReal.ofReal (17 / 2 * ∑ j ∈ Finset.Icc 2 dF,
          c2 ^ (j - 1) * ((dA : ℝ) + 1) ^ j * gmom n j)

/-- **Total variation for a change of the noise scale.** For a measurable set of blocks and
`0 < s`, `s² < 2`: scaling the Gaussian part of every block by `s` changes the probability by at
most `√((s²(2 − s²))^{−kn/2} − 1)`. -/
def DrawsTV108 : Prop :=
  ∀ (N n k : ℕ), 1 ≤ N → ∀ (Bad : Set (Draws N n k)), MeasurableSet Bad →
    ∀ s : ℝ, 0 < s → s ^ 2 < 2 →
      (drawM N n k).real {ω | scaleDraws s ω ∈ Bad} ≤
        (drawM N n k).real Bad +
          Real.sqrt ((Real.sqrt (s ^ 2 * (2 - s ^ 2)))⁻¹ ^ (k * n) - 1)

/-- **The deterministic step** (`g − B` is linear in the test function, `sd_μ` is a seminorm,
the success event does not change if the test function is multiplied by a positive number or a
constant is added). -/
def SuccParts108 : Prop :=
  ∀ (N n dW dA dF k : ℕ) (hd : 1 ≤ dF), 1 ≤ N → 1 ≤ k →
    ∀ (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ω : Draws N n k) (A1 : CoefIdx n n dA → ℝ)
      (F : CoefIdx n 1 dF → ℝ) (ρ a b : ℝ), 0 < ρ →
      |Err W τ (fun x => BstLean.Part107.qLin A1 (linF hd F) x) ω| ≤ a →
      |Err W τ (psi hd ρ A1 F) ω| + 1 / 2 * Real.sqrt (Vu W (psi hd ρ A1 F)) ≤ b →
      a + b ≤ 1 / 2 * Real.sqrt (Vu W (fun x => BstLean.Part107.qLin A1 (linF hd F) x)) →
      ∀ c : ℝ, 0 ≤ c → Succ W τ (BstLean.Part106.phiAF (ρ⁻¹ • A1) (c • F)) ω

/-- **Measurability, general form**: for a measurable family of test functions and measurable
`W`, `τ`. -/
def MeasGen108 : Prop :=
  ∀ (N n d k : ℕ) (Θ : Type) [MeasurableSpace Θ] (w : Θ → CoefIdx N n d → ℝ) (τ : Θ → ℝ)
    (Φ : Θ → (Fin n → ℝ) → ℝ), Measurable w → Measurable τ →
    Measurable (fun p : Θ × (Fin n → ℝ) => Φ p.1 p.2) →
    Measurable (fun p : Θ × Draws N n k => BstLean.Part106.gVal (w p.1) (τ p.1) (Φ p.1) p.2) ∧
    Measurable (fun θ : Θ => Bu (w θ) (Φ θ)) ∧
    Measurable (fun θ : Θ => Vu (w θ) (Φ θ))

/-- Joint measurability of `F(A(x))` in `(A, F, x)`. -/
def MeasPhi108 : Prop :=
  ∀ (n dA dF : ℕ),
    Measurable (fun p : ((CoefIdx n n dA → ℝ) × (CoefIdx n 1 dF → ℝ)) × (Fin n → ℝ) =>
      BstLean.Part106.phiAF p.1.1 p.1.2 p.2)

/-- Joint measurability of the perturbation in `(ρ, A₁, F, x)`. -/
def MeasPsi108 : Prop :=
  ∀ (n dA dF : ℕ) (hd : 1 ≤ dF),
    Measurable (fun p : (ℝ × (CoefIdx n n dA → ℝ) × (CoefIdx n 1 dF → ℝ)) × (Fin n → ℝ) =>
      psi hd p.1.1 p.1.2.1 p.1.2.2 p.2)

/-- **The nested form by the Markov inequality** (abstract). -/
def Nested108 : Prop :=
  ∀ (α β : Type) [MeasurableSpace α] [MeasurableSpace β] (μ : Measure α) (ν : Measure β)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν] (E : Set (α × β)) (δ : ℝ),
    MeasurableSet E → 0 ≤ δ → 1 - δ ≤ (μ.prod ν).real E →
    1 - Real.sqrt δ ≤ μ.real {a | 1 - Real.sqrt δ ≤ ν.real {b | (a, b) ∈ E}}

/-- Rearrangement of a product of four probability measures:
`((w, (a, f)), ω) ↦ ((w, f), (a, ω))`. -/
def Rearr108 : Prop :=
  ∀ (α β γ δ : Type) [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
    [MeasurableSpace δ] (μ₁ : Measure α) (μ₂ : Measure β) (μ₃ : Measure γ) (μ₄ : Measure δ)
    [IsProbabilityMeasure μ₁] [IsProbabilityMeasure μ₂] [IsProbabilityMeasure μ₃]
    [IsProbabilityMeasure μ₄],
    ((μ₁.prod (μ₂.prod μ₃)).prod μ₄).map
        (fun p : (α × (β × γ)) × δ => ((p.1.1, p.1.2.2), (p.1.2.1, p.2))) =
      (μ₁.prod μ₃).prod (μ₂.prod μ₄)

end BstLean.Part108
