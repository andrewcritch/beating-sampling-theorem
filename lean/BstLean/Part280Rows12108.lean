theorem outputCentre_row {c : Ret 12112}
    (hc : c ∈ outputCentreEvent (paperCentres 12112)) :
    normSq c.2.1.2 ≤ (2 / (12112 : ℝ)) * eR c * 12112 * chi := by
  change normSq c.2.1.2 ≤ 2 / (mA 12112 : ℝ) * normSq (bR c) * chiUp 12112 at hc
  have hn := normSq_nonneg (bR c)
