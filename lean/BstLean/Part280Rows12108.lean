    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12112) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12112).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12112) (FirstMatrix 12112))
    (h2 : c ∈ BstLean.Part164.Eop2 12112) (a : BstLean.Part161.Ix 12112) :
