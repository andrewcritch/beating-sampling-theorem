theorem first_matrix_row (c : Ret 12109) (hc : A1 c ∈ Eop 12109) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12109 : ℝ)) ≤ (12851708259 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12109 : ℝ) ≤ (55020451 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12109 : ℝ) + 2 * √12109 ≤ (3082270451 / 250000) := by linarith
