  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12110) (hc : A1 c ∈ Eop 12110) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12110 : ℝ)) ≤ (1606397203 / 125000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12110 : ℝ) ≤ (55022723 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12110 : ℝ) + 2 * √12110 ≤ (3082522723 / 250000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12110) (hc : c ∈ BstLean.Part164.Eop2 12110) :
    OpB (A2 c) (283 / 100) := by
