    (paperDesign_agentCentre _ _ _ _) c fresh_latitude_constant_pos_row he hL hq hq12

theorem residual_moment_on_event {c : Ret 12111}
    (hw : WINDOW (paperDesignP 12111) c) (hc : c ∈ passEvent)
