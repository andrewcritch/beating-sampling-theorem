    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11975) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11975).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11975) (FirstMatrix 11975))
    (h2 : c ∈ BstLean.Part164.Eop2 11975) (a : BstLean.Part161.Ix 11975) :
