theorem variance_of_matrix_events (c : Ret 11973) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11973).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11973) (FirstMatrix 11973))
