noncomputable def splitLocationWidth (c : Ret 11973) : ℝ := 4 * locationMomentBudget c 12
noncomputable def splitResidualWidth : ℝ := 4 * residualMomentBudget 12
noncomputable def lowMassBudget : ℝ := 4 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 11973}
    (hw : WINDOW (paperDesignP 11973) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (11973 - 1))).real
      {v | sgA (paperDesignP 11973) c a v < √(2 / (11973 : ℝ) * mixtureFloor)}
