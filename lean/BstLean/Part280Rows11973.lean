  have hn : √(11975 : ℝ) ≤ (13678793 / 125000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11975 : ℝ) + 2 * √11975 ≤ (762116293 / 62500) := by linarith
