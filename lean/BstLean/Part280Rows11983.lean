/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 11983) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 11983) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (11983 : ℝ)) * eR c * 11983 * chi
