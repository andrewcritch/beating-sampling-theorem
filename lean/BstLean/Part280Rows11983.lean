      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((749179 / 125000000)) * ((1001 / 1000 + 52 / 1000) * ((54942139 / 100000000000))) := by
