    ∫ a, ∫ v, |lA (paperDesignP 11985) c a v - lbar (paperDesignP 11985) c a| ^ (2 * q)
      ∂stdGauss (Fin (11985 - 1)) ∂muI 11985 ≤ locationMomentBudget c q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
  exact fresh_LG_lambda (by norm_num) (paperDesignP 11985)
    (paperDesign_agentCentre _ _ _ _) c fresh_latitude_constant_pos_row he hL hq hq12

theorem residual_moment_on_event {c : Ret 11985}
