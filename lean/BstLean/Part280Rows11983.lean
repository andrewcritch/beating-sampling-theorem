theorem row_split_floor :
    (2 / (11983 : ℝ)) * biasFloor =
      (1 - eta) * (√(2 / (11983 : ℝ) * mixtureFloor)) ^ 2 := by
  rw [Real.sq_sqrt (by norm_num [mixtureFloor])]
  unfold biasFloor
