theorem removal_of_low_mass {c : Ret 11983}
    (hw : WINDOW (paperDesignP 11983) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (11983 - 1))).real
