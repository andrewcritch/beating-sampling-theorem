theorem hq_root_price {c : Ret 11984} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 11984) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (11984 - 1))).real
      {v | sgA (paperDesignP 11984) c a v < rowSigma} ∂BstLean.Part161.muI 11984 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
