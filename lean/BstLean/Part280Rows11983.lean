noncomputable def residualVarianceBudget : ℝ :=
  (2 * latitudeC / 11985) / ((11985 : ℝ) * (11985 - 3))

theorem location_variance_on_event {c : Ret 11985}
    (hw : WINDOW (paperDesignP 11985) c) (he : 0 < eR c) (hc : c ∈ passEvent) :
