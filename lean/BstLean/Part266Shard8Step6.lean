    (√(tA 12552 * ((162 : ℝ) ^ 2 / (12552 - 2))) * √((42 / 10 : ℝ) / 12552) *
      energyCoefficient18 12552) ^ 18 * (61 / 100 : ℝ) ^ 18 ≤
