      (operatorEnvelope_pos160 (by norm_num)).le (by norm_num)
    exact h2.trans (by norm_num)
  unfold latitudeJacobianSquared160 jacobianConstantSquared160
  have hh : √(planeEnvelopeSquared160 12575 4 +
      2 / (mA 12575 : ℝ) * frobEnvelopeSquared160 12575) +
      transverseConstant160 * √(2 / (mA 12575 : ℝ)) * operatorEnvelope160 12575 ≤ 9 / 4 := by
    linarith
  have hh0 : 0 ≤ √(planeEnvelopeSquared160 12575 4 +
      2 / (mA 12575 : ℝ) * frobEnvelopeSquared160 12575) +
      transverseConstant160 * √(2 / (mA 12575 : ℝ)) * operatorEnvelope160 12575 :=
    add_nonneg (sqrt_nonneg _) (mul_nonneg
      (mul_nonneg (gaussMomConst_nonneg 80) (sqrt_nonneg _))
