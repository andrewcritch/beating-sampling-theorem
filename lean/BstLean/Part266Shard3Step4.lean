    (gaussMat (mA 12441) 12441 (2 / (12441 : ℝ))).real {X | ∃ g < Js 12441,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12441 : ℝ)) ∨
