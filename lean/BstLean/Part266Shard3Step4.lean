    (gaussMat (mA 12445) 12445 (2 / (12445 : ℝ))).real {X | ∃ g < Js 12445,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12445 : ℝ)) ∨
