  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((338689841 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((520206513 / 100000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
