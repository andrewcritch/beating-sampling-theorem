    (gaussMat (mA 12432) 12432 (2 / (12432 : ℝ))).real {X | ∃ g < Js 12432,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12432 : ℝ)) ∨
