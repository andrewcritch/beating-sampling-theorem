    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12438 - 1))).real
      {v | sgA (paperDesignP 12438) c a v < rowSigma} ∂BstLean.Part161.muI 12438 ≤ lowMassBudget) :
