/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12437) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12437) c (rowSplit c wl ws),
    ((12437 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12437 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12437) c (rowSplit c wl ws),
    ((12437 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12437 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12437 - 1)))
    (rowSplit c wl ws).good a ∂muI 12437 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12437) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12437 - 1))) (rowSplit c wl ws).good
