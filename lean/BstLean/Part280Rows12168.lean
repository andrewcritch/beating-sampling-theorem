      BstLean.Part280.Gen.Row12172.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12172.locationNorm BstLean.Part280.Gen.Row12172.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
