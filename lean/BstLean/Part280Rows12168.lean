noncomputable def locationVarianceBudget (c : Ret 12170) : ℝ :=
  (latitudeC / eR c) / ((12170 : ℝ) * (12170 - 3))

noncomputable def residualVarianceBudget : ℝ :=
  (2 * latitudeC / 12170) / ((12170 : ℝ) * (12170 - 3))

