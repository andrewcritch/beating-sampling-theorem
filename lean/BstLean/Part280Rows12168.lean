    (sqrt_nonneg _) he BstLean.Part280.Gen.Row12172.bias_floor_ge (by norm_num [BstLean.Part280.Gen.Row12172.epsilon]) BstLean.Part280.Gen.Row12172.bias_threshold_pos
    (by norm_num [sharpAw]) (by norm_num [sharpAf]) (by norm_num [BstLean.Part280.Gen.Row12172.locationNorm])
