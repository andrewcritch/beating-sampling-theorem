theorem residual_sq_le_energy (c : Ret 12172)
    (p : Ix 12172 × (Fin (12172 - 1) → ℝ)) :
    sgA (paperDesignP 12172) c p.1 p.2 ^ 2 ≤
      (2 / (12172 : ℝ)) * wLatitude c p := by
