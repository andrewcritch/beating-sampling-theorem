theorem row_split_floor :
    (2 / (12172 : ℝ)) * biasFloor =
      (1 - eta) * (√(2 / (12172 : ℝ) * mixtureFloor)) ^ 2 := by
  rw [Real.sq_sqrt (by norm_num [mixtureFloor])]
  unfold biasFloor
  ring

/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 12172) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 12172) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (12172 : ℝ)) * eR c * 12172 * chi
  moments : PaperMoments c (keptIx (paperDesignP 12172) c (rowSplit c wl ws))
    varianceMax energyError locationError locationNorm varianceNorm
  removal : ∫ a, removed (stdGauss (Fin (12172 - 1)))
    (rowSplit c wl ws).good a ∂muI 12172 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12172) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12172 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12172) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12172 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12172) c (rowSplit c wl ws),
    hellG2 12172 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12172 ≤ displacementBudget

/-- All pass guards and integrability proofs are supplied, including the variable bias floor. -/
theorem row_pass_inputs {t : ℝ} {c : Ret 12172} (R : RootSource t c) :
    BstLean.Part241.PassInputs c (rowSplit c R.wl R.ws) chi biasFloor epsilon
      varianceMax energyError locationError locationNorm varianceNorm := by
  exact passInputs_of_paperMoments (by norm_num) c eta_pos eta_lt_one
    (Real.sqrt_nonneg _) R.energy_pos bias_floor_ge (by norm_num [epsilon])
    bias_threshold_pos (by norm_num [energyError]) (by norm_num [locationError])
    (by norm_num [locationNorm]) (by norm_num [varianceNorm]) row_split_floor.le
    R.centre R.moments

/-- The constructor supplies the requested Lean structure after the source integrals are bounded. -/
noncomputable def rootInputs {t : ℝ} {c : Ret 12172} (R : RootSource t c) :
    BstLean.Part243.RootInputs 12172 t c BstLean.Part280.Gen.agent12172.root where
  split := rowSplit c R.wl R.ws
  chi := chi
  biasFloor := biasFloor
  epsilon := epsilon
  vmax := varianceMax
  aw := energyError
  af := locationError
  Hf := locationNorm
  Cv := varianceNorm
  B := removalBudget
  mix := mixtureRoot
  displacement := displacementBudget
  window := R.window
  passes := row_pass_inputs R
  fluctuation := by
    refine ⟨removalBudget, mixtureRoot ^ 2, displacementBudget,
      R.removal, R.mixture, R.displacement, ?_⟩
    rw [Real.sqrt_sq (by norm_num [mixtureRoot])]
