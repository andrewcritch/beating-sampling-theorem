      (pLat (paperDesignP 12171) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12171 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12171) c (rowSplit c wl ws),
    hellG2 12171 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12171 ≤ displacementBudget

