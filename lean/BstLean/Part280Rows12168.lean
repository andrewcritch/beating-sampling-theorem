      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((5947211 / 1000000000)) ^ 2 * ((1003 / 1000) * ((2881 / 80000000000))) := by
        gcongr
