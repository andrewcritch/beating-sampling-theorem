noncomputable def locationVarianceBudget (c : Ret 12115) : ℝ :=
  (latitudeC / eR c) / ((12115 : ℝ) * (12115 - 3))

noncomputable def residualVarianceBudget : ℝ :=
  (2 * latitudeC / 12115) / ((12115 : ℝ) * (12115 - 3))

