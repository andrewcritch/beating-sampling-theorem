theorem row_split_floor :
    (2 / (12114 : ℝ)) * biasFloor =
      (1 - eta) * (√(2 / (12114 : ℝ) * mixtureFloor)) ^ 2 := by
  rw [Real.sq_sqrt (by norm_num [mixtureFloor])]
  unfold biasFloor
  ring

/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 12114) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 12114) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (12114 : ℝ)) * eR c * 12114 * chi
