  refine hc.trans ?_
  have hs : √(2 / (mA 12114 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12114) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12114 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12114) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12114).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12114) (FirstMatrix 12114))
    (h2 : c ∈ BstLean.Part164.Eop2 12114) (a : BstLean.Part161.Ix 12114) :
