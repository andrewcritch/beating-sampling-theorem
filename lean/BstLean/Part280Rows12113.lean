theorem residual_sq_le_energy (c : Ret 12117)
    (p : Ix 12117 × (Fin (12117 - 1) → ℝ)) :
    sgA (paperDesignP 12117) c p.1 p.2 ^ 2 ≤
      (2 / (12117 : ℝ)) * wLatitude c p := by
