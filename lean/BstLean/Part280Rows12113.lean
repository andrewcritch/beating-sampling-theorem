  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12114) (hc : A1 c ∈ Eop 12114) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12114 : ℝ)) ≤ (6424527871 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12114 : ℝ) ≤ (55031809 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12114 : ℝ) + 2 * √12114 ≤ (3083531809 / 250000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

