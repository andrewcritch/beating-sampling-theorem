      (pLat (paperDesignP 12114) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12114 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12114) c (rowSplit c wl ws),
    hellG2 12114 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12114 ≤ displacementBudget

