theorem exactTableMoments_of_N {c : Ret 12117} (hw : WINDOW (paperDesignP 12117) c)
    (hθ : BstLean.Part280.m2Guard 12117 c) (hc : c ∈ BstLean.Part280.sharpTableN 12117)
