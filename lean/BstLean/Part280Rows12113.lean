  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((42194527 / 125000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((3322231073 / 500000000000000))) := by gcongr
