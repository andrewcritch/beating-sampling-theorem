import BstLean.Part89Defs
import BstLean.Part80Defs6

/-!
# Part 89, frozen definitions for `d_f = 2`: the variance bound averaged over the anchors

Role: `delegations/statements/p89-spec.md`. Definitions and `Prop`-valued interface statements
only. Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

At `d_f = 2` the polynomial given the anchors is `f(Σ_j b_j(x) A_j + lam·sc·Wψ(x))` with
`f = qfun f0 ℓ H` (`QuadRep`). In each slice the variance bound of Part 80 (`varBoundA3`) is used in
place of the slice reverse Hölder inequality. The price is a term with
`Dq = 16 |I| Σ_j ‖H A_j‖²`, which is of order `‖H‖_F²` for most anchors only.
-/

namespace BstLean.Part89

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss)
open BstLean.Part78 (nsq frobH qfun zv)
open BstLean.Part86

section model

variable {n : ℕ} {I J S G : Type} [Fintype I] [Fintype J] [MeasurableSpace S] [MeasurableSpace G]

/-- `Ȳ_p = E_W Y_p`: the mean over `W` of the variance in slice `p`. -/
noncomputable def Yb (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ) (p : S) : ℝ :=
  ∫ W, Ysl M P lam W p ∂stdGauss (J × Fin n)

/-- **Slice feature operator bound with an explicit level function** `tau`. -/
def SliceOpF (M : Mod n I J S G) (Lam : ℝ) (tau : S → ℝ) : Prop :=
  Measurable tau ∧ ∀ p : S, 0 ≤ tau p ∧
    (∀ᵐ g ∂M.ga, tau p ≤ kapm M (M.X (p, g)) (M.X (p, g))) ∧
    ∀ c : J → ℝ, ∫ g, (∑ q, c q * M.ps (M.X (p, g)) q) ^ 2 ∂M.ga ≤ Lam * tau p * ∑ q, c q ^ 2

/-- `P` is the quadratic `f = qfun f0 ℓ H` at `Σ_j b_j(x) A_j + lam · sc · W ψ(x)`. -/
def QuadRep (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (f0 : ℝ) (ℓ : Fin n → ℝ)
    (H : Matrix (Fin n) (Fin n) ℝ) (A : I → Fin n → ℝ) (sc : ℝ) : Prop :=
  ∀ (lam : ℝ) (W : J × Fin n → ℝ) (x : Fin n → ℝ),
    Fm M P lam W x =
      qfun f0 ℓ H (fun i => ∑ j, M.b x j * A j i + lam * sc * zv W (M.ps x) i)

/-- `Dq = 16 |I| Σ_j ‖H A_j‖²`: a bound of `sup_{x,y} ‖a(x) − a(y)‖²`, `a(x) = ℓ + 2 H mu(x)`. -/
noncomputable def Dq (H : Matrix (Fin n) (Fin n) ℝ) (A : I → Fin n → ℝ) : ℝ :=
  16 * (Fintype.card I : ℝ) * ∑ j, nsq (fun i => ∑ l, H i l * A j l)

/-- The constant of `Part80.VarBoundA3`. -/
noncomputable def c0q (η : ℝ) : ℝ := (1 + 1 / η) * ((4184 / 1000) * (8 * (1733 / 1000))) + 8

/-- **The variance bound in one slice** (for almost every slice): a floor for `Ȳ_p` and
`Var_W Y_p ≤ α Ȳ_p² + 2 Λ t_p E₀ Ȳ_p`, `t_p = lam² sc² τ_p`. -/
def QuadSlice (M : Mod n I J S G) (Lam : ℝ) (tau : S → ℝ) (kmax : ℝ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ) (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ)
    (A : I → Fin n → ℝ) (sc : ℝ), H.IsSymm → QuadRep M P f0 ℓ H A sc →
    ∀ lam η η' : ℝ, 0 < η → 0 < η' → ∀ᵐ p ∂M.pi,
      2 * (1 - Lam) * frobH H * (lam ^ 2 * sc ^ 2 * tau p) ^ 2 ≤ Yb M P lam p ∧
      ∫ W, (Ysl M P lam W p - Yb M P lam p) ^ 2 ∂stdGauss (J × Fin n) ≤
        2 * Lam * (2 + η) * (1 + η') / (1 - Lam) * Yb M P lam p ^ 2 +
        2 * Lam * (lam ^ 2 * sc ^ 2 * tau p) *
          ((2 + η) * (1 + 1 / η') * Dq H A + c0q η * (lam ^ 2 * sc ^ 2 * kmax / 2) * frobH H) *
          Yb M P lam p

/-- The constant of the variance bound: `X = (1+ω)(2+η)(1+η') +
(1+1/ω)((2+η)(1+1/η') Yn + c₀(η) κmax/2)/(2 τmin)`. -/
noncomputable def XQ (η η' ω Yn kmax tmin : ℝ) : ℝ :=
  (1 + ω) * (2 + η) * (1 + η') +
    (1 + 1 / ω) * ((2 + η) * (1 + 1 / η') * Yn + c0q η * kmax / 2) / (2 * tmin)

/-- **The variance bound for the within-slice variance** `Vdn = E_p Y_p`, for a quadratic `P` with
`Dq ≤ Yn · lam² sc² ‖H‖_F²`:
`E_W (Vdn − E_p Ȳ_p)² ≤ (2Λ/(1−Λ)) X (E_p Ȳ_p)²`. -/
def QuadVar (M : Mod n I J S G) (Lam kmax tmin : ℝ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ) (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ)
    (A : I → Fin n → ℝ) (sc : ℝ), H.IsSymm → QuadRep M P f0 ℓ H A sc →
    ∀ lam η η' ω Yn : ℝ, 0 < η → 0 < η' → 0 < ω → 0 ≤ Yn →
      Dq H A ≤ Yn * (lam ^ 2 * sc ^ 2 * frobH H) →
      ∫ W, (Vdn M P lam W - ∫ p, Yb M P lam p ∂M.pi) ^ 2 ∂stdGauss (J × Fin n) ≤
        2 * Lam / (1 - Lam) * XQ η η' ω Yn kmax tmin * (∫ p, Yb M P lam p ∂M.pi) ^ 2

end model

end BstLean.Part89
