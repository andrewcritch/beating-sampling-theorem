      _ ≤ ((114610488421 / 1000000) : ℝ) * ((1003 / 1000) * ((834729 / 250000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((29713 / 5000000)) ^ 2 * ((1003 / 1000) * ((17283061 / 500000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169270883 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5208977617 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((29713 / 5000000)) * ((1001 / 1000 + 52 / 1000) * ((21199963 / 40000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169270883 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((3199010457 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
