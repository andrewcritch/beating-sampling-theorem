  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((67686809 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((200131507 / 31250000000000))) := by gcongr
