  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((67686809 / 200000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2607007251 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2972257 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((6629259 / 12500000000))) := by
        gcongr
