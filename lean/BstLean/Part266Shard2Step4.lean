    (gaussMat (mA 12420) 12420 (2 / (12420 : ℝ))).real {X | ∃ g < Js 12420,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12420 : ℝ)) ∨
