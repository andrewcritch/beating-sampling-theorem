theorem hq_output_bounds {c : Ret 12419}
    (hw : WINDOW (paperDesignP 12419) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12419)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
