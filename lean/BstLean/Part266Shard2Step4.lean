def LowResidualMass (c : Ret 12416) : Prop :=
  ∫ a, (stdGauss (Fin (12416 - 1))).real
    {v | sgA (paperDesignP 12416) c a v < rowSigma} ∂muI 12416 ≤ lowMassBudget

noncomputable def hqSplit (c : Ret 12416) : SplitData 12416 :=
  rowSplit c (splitLocationWidth c) splitResidualWidth

theorem hq_output_bounds {c : Ret 12416}
    (hw : WINDOW (paperDesignP 12416) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12416)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
  have he := centre_energy_range hw ha
  have hpass := analyticBaseCertificate.pass_fields ha
  have hcap := pass_centre_of_events c hpass
  have hb : 0 < normSq ((paperCentres 12416).bA c.1 c.2.1.1) := by
    change 0 < normSq (bR c)
