      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((237771 / 40000000)) ^ 2 * ((1003 / 1000) * ((34605113 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((84611873 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5213384447 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((237771 / 40000000)) * ((1001 / 1000 + 52 / 1000) * ((53029799 / 100000000000))) := by
        gcongr
