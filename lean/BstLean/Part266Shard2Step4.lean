      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((2972257 / 500000000)) ^ 2 * ((1003 / 1000) * ((34610689 / 1000000000000000))) := by
        gcongr
