      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((371577 / 62500000)) ^ 2 * ((1003 / 1000) * ((1082107 / 31250000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169196827 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5215905427 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((371577 / 62500000)) * ((1001 / 1000 + 52 / 1000) * ((530468951 / 1000000000000))) := by
        gcongr
