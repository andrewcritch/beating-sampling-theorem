  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((169163141 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((6410405513 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((594643 / 100000000)) * ((1001 / 1000 + 52 / 1000) * ((130364177 / 200000000000))) := by
