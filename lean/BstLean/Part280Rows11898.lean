theorem outputCentre_row {c : Ret 11900}
    (hc : c ∈ outputCentreEvent (paperCentres 11900)) :
    normSq c.2.1.2 ≤ (2 / (11900 : ℝ)) * eR c * 11900 * chi := by
  change normSq c.2.1.2 ≤ 2 / (mA 11900 : ℝ) * normSq (bR c) * chiUp 11900 at hc
  have hn := normSq_nonneg (bR c)
