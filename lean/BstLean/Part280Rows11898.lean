theorem second_matrix_row (c : Ret 11898) (hc : c ∈ BstLean.Part164.Eop2 11898) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 11898 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11898) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11898 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11898) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11898).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11898) (FirstMatrix 11898))
    (h2 : c ∈ BstLean.Part164.Eop2 11898) (a : BstLean.Part161.Ix 11898) :
