theorem first_matrix_row (c : Ret 11900) (hc : A1 c ∈ Eop 11900) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11900 : ℝ)) ≤ (1620509309 / 125000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11900 : ℝ) ≤ (54543561 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11900 : ℝ) + 2 * √11900 ≤ (3029543561 / 250000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 11900) (hc : c ∈ BstLean.Part164.Eop2 11900) :
    OpB (A2 c) (283 / 100) := by
