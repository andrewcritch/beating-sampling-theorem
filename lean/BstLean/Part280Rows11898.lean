theorem hq_root_price {c : Ret 11899} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 11899) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (11899 - 1))).real
      {v | sgA (paperDesignP 11899) c a v < rowSigma} ∂BstLean.Part161.muI 11899 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
