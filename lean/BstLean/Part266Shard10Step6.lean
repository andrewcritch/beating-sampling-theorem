    (√(tA 12602 * ((162 : ℝ) ^ 2 / (12602 - 2))) * √((42 / 10 : ℝ) / 12602) *
      energyCoefficient18 12602) ^ 18 * (61 / 100 : ℝ) ^ 18 ≤
