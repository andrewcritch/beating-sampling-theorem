    ∀ᵐ X ∂gaussMat (mA 12601) 12601 (2 / (12601 : ℝ)), X ∈ tableFirstEvent wr →
      (gaussMat (mA 12601) (mA 12601) (tA 12601))
        {M | (X, M) ∈ tableBadPair wr} ≤ ENNReal.ofReal (742 / 10 ^ 6 : ℝ) := by
  have hc := BstLean.Part172.sg_wr_ne (by norm_num) hw
  have hs (g : Fin (Js 12601)) : nodeS (mkR wr (0, 0)) g.val ^ 2 ≤ 1 := by
    have h := row_node_geometry hw (0, 0) g.isLt
