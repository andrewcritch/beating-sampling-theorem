theorem variance_pointwise_row (c : Ret 12725) (hb : normSq (bR c) ≠ 0)
    (h1 : OpB (A1 c) 163) (h2 : OpB (A2 c) (283 / 100)) (a : Ix 12725) :
    |VR c a| ≤ varianceMax := by
