        4 * (1 / 2.506628) * 1.036505 * (12389929 / 125000) *
          (81 / 1000 / 12725 + (1792 / 10000 / 12725) ^ 2) := by gcongr <;> linarith
    _ ≤ (0.008646 : ℝ) := by norm_num

