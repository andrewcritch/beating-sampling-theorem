theorem energy_lower_components {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
    0 ≤ kappa (meanLowerRoot 12725 θ ^ 2 / gPlus 12725) - 2 / (12725 : ℝ) ^ 2 ∧
    (804 / 1000 : ℝ) ≤
      √(gMinus 12725 * (kappa (meanLowerRoot 12725 θ ^ 2 / gPlus 12725) -
        2 / (12725 : ℝ) ^ 2)) - 2 * √(12 * gPlus 12725) / 12725 -
