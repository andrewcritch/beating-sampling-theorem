  have hr : (57 / 100 : ℝ) ≤ meanLowerRoot 12746 θ ^ 2 / gPlus 12746 := by
    rw [le_div_iff₀ (by linarith [hg.2.1] : 0 < gPlus 12746)]
    nlinarith [hg.2.2]
  have hr1 : meanLowerRoot 12746 θ ^ 2 / gPlus 12746 ≤ 1 := by
    rw [div_le_iff₀ (by linarith [hg.2.1] : 0 < gPlus 12746)]
    nlinarith [hg.2.1]
  have hk : (65 / 100 : ℝ) ≤ kappa (57 / 100) := by
    apply kernel_lower_rational (s := 821 / 1000) <;> norm_num
  have hκ := kappa_monotoneOn (by norm_num : (57 / 100 : ℝ) ∈ Icc (-1) 1)
    (show meanLowerRoot 12746 θ ^ 2 / gPlus 12746 ∈ Icc (-1 : ℝ) 1 by
      exact ⟨by linarith, hr1⟩) hr
  have hbr : (65 / 100 : ℝ) - 2 / 12746 ^ 2 ≤
      kappa (meanLowerRoot 12746 θ ^ 2 / gPlus 12746) - 2 / (12746 : ℝ) ^ 2 := by
    linarith
  have hs : (805 / 1000 : ℝ) ≤ √(gMinus 12746 *
      (kappa (meanLowerRoot 12746 θ ^ 2 / gPlus 12746) - 2 / (12746 : ℝ) ^ 2)) := by
    apply le_sqrt_of_sq_le
    have hp := mul_le_mul hg.1 hbr (by norm_num : (0 : ℝ) ≤ 65 / 100 - 2 / 12746 ^ 2)
      (by linarith [hg.1] : 0 ≤ gMinus 12746)
    linarith
  have ht : √(12 * gPlus 12746) ≤ 7 / 2 :=
    sqrt_le_iff.mpr ⟨by norm_num, by linarith [hg.2.2]⟩
  have hn : (110 : ℝ) ≤ √12746 := le_sqrt_of_sq_le (by norm_num)
  have hf := finite_centre_upper
  have hfd : finiteEnergy 12746 12746 (11 / 1000) / √12746 ≤ 1 / 10000 := by
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < √12746)]
    linarith
  constructor <;> linarith

theorem energy_lower_coarse {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
