theorem energy_lower_components {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
    0 ≤ kappa (meanLowerRoot 12746 θ ^ 2 / gPlus 12746) - 2 / (12746 : ℝ) ^ 2 ∧
    (804 / 1000 : ℝ) ≤
      √(gMinus 12746 * (kappa (meanLowerRoot 12746 θ ^ 2 / gPlus 12746) -
        2 / (12746 : ℝ) ^ 2)) - 2 * √(12 * gPlus 12746) / 12746 -
