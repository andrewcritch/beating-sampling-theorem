    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12984 - 1))).real
      {v | sgA (paperDesignP 12984) c a v < rowSigma} ∂BstLean.Part161.muI 12984 ≤ lowMassBudget) :
