variable {n : ℕ}

theorem row_node_geometry {wr : WRet 12989} (hw : windowW wr)
    (θ : AHid 12989) {g : ℕ} (hg : g < Js 12989) :
    0 ≤ nodeS (mkR wr θ) g ∧
      (3969 / 10000 : ℝ) ≤ 1 - nodeS (mkR wr θ) g ^ 2 ∧
      1 - nodeS (mkR wr θ) g ^ 2 ≤ 61 / 100 := by
  let c := mkR wr θ
  obtain ⟨hLH, hbulk, -⟩ := BstLean.Part169.bulk_of_window (by norm_num) c
