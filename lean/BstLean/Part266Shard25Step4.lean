theorem hq_output_bounds {c : Ret 12978}
    (hw : WINDOW (paperDesignP 12978) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12978)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
