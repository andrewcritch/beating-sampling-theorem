/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12984) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12984) c (rowSplit c wl ws),
    ((12984 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12984 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12984) c (rowSplit c wl ws),
    ((12984 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12984 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12984 - 1)))
    (rowSplit c wl ws).good a ∂muI 12984 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12984) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12984 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12984) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12984 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12984) c (rowSplit c wl ws),
    hellG2 12984 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12984 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 12984}
    (hw : WINDOW (paperDesignP 12984) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
