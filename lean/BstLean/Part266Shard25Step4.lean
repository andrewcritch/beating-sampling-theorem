  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((86552751 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4866540341 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2904723 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((31656631 / 62500000000))) := by
        gcongr
