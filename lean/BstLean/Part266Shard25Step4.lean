  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((1081086 / 3125) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((195111837 / 40000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
