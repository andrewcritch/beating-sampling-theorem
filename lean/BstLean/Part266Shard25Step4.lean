noncomputable def hqRootInputs {c : Ret 12978} (t : ℝ)
    (hw : WINDOW (paperDesignP 12978) c) (ha : c ∈ analyticBase)
    (ht : c ∈ tableEvent) (hp : c ∈ positiveOutputEvent (paperCentres 12978))
