  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((345987061 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2994561149 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5813249 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((622935901 / 1000000000000))) := by
