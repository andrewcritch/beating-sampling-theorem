  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((34609243 / 100000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4871599991 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5811459 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((253428573 / 500000000000))) := by
        gcongr
