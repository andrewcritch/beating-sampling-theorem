theorem hq_output_bounds {c : Ret 12984}
    (hw : WINDOW (paperDesignP 12984) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12984)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
