        12981 * (188 / 10 ^ 16) / (8 * (1 - eta) ^ 2 * ((5813473 / 1000000000)) ^ 4)) := by
      gcongr <;> norm_num
    _ ≤ _ := by norm_num [eta]

theorem hq_root_price {c : Ret 12981} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 12981) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12981 - 1))).real
      {v | sgA (paperDesignP 12981) c a v < rowSigma} ∂BstLean.Part161.muI 12981 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
