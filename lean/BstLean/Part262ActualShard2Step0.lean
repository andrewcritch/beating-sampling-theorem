/-! The ordinary operator events supply the pointwise variance guard. -/
namespace BstLean.Part262.Row12275
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part130 BstLean.Part153 BstLean.Part157 BstLean.Part160 BstLean.Part169

theorem first_matrix_row (c : Ret 12275) (hc : A1 c ∈ Eop 12275) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12275 : ℝ)) ≤ (6382256463 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12275 : ℝ) ≤ (553963 / 5000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12275 : ℝ) + 2 * √12275 ≤ (31241463 / 2500) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12275) (hc : c ∈ BstLean.Part164.Eop2 12275) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12275 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12275) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12275 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12275) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12275).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12275) (FirstMatrix 12275))
    (h2 : c ∈ BstLean.Part164.Eop2 12275) (a : BstLean.Part161.Ix 12275) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

end BstLean.Part262.Row12275

