  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((171205569 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((6181009137 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
