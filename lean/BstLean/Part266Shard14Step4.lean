  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((34245113 / 100000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2515266817 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5873967 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((258911667 / 500000000000))) := by
        gcongr
