  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((171278803 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5025788593 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((146803 / 25000000)) * ((1001 / 1000 + 52 / 1000) * ((517497621 / 1000000000000))) := by
        gcongr
