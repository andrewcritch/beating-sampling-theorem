def LowResidualMass (c : Ret 12710) : Prop :=
  ∫ a, (stdGauss (Fin (12710 - 1))).real
    {v | sgA (paperDesignP 12710) c a v < rowSigma} ∂muI 12710 ≤ lowMassBudget

