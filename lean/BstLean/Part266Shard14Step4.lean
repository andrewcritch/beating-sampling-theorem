      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5873967 / 1000000000)) ^ 2 * ((1003 / 1000) * ((16498273 / 500000000000000))) := by
        gcongr
