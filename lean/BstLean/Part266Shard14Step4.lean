      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5873737 / 1000000000)) ^ 2 * ((1003 / 1000) * ((8247839 / 250000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((5351006 / 15625) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((39296407 / 7812500000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5873737 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((517782597 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
