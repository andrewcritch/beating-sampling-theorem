import BstLean.Part105All

/-!
# Part 107, frozen definitions: the spread of the linear part

Role: `delegations/statements/p107-spec.md`. Paper sources: `delegations/answers/oaW7-opus-prover.md`
(§2 to §4), `oaW7c-cx.md`, `oaW8-opus-prover.md`, `oaW8c-cx.md`.
This file holds definitions and `Prop`-valued interface statements only. Each interface statement
is proved in another `Part107*.lean` file. Do not edit this file. Do not use `sorry`,
`native_decide` or `axiom`.

Notation of the sources: `κ(τ) = Σ_{j ≤ d_A} τ^j` (`kap`), `r(t) = (Σ_{j ≤ d_W} t^j)/(d_W + 1)`
(`rW`), `a = x·x′` with `x = g/|g|`, `x′ = g′/|g′|` (`cosA`), the Gaussian pair
`g′ = r g + √(1−r²) h` (`aR r (g, h)`).
-/

namespace BstLean.Part107

open MeasureTheory ProbabilityTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part105

/-! ## §1 Definitions -/

/-- `κ(τ) = Σ_{j=0}^{d_A} τ^j`: the kernel of the Gaussian version of `A` (unit coefficient
variance), `E A_i(x) A_j(x′) = δ_ij κ(x·x′)`. -/
noncomputable def kap (dA : ℕ) (τ : ℝ) : ℝ := ∑ j ∈ Finset.range (dA + 1), τ ^ j

/-- `κ′(τ) = Σ_{j=0}^{d_A − 1} (j+1) τ^j`. -/
noncomputable def kap' (dA : ℕ) (τ : ℝ) : ℝ := ∑ j ∈ Finset.range dA, ((j : ℝ) + 1) * τ ^ j

/-- `r(t) = (Σ_{j=0}^{d} t^j)/(d+1)`: the correlation of `(W(u), W(u′))` for a Gaussian `W` of
degree `d`, `t = u·u′`. -/
noncomputable def rW (d : ℕ) (t : ℝ) : ℝ := (∑ j ∈ Finset.range (d + 1), t ^ j) / ((d : ℝ) + 1)

/-- `a = x·x′`, `x = g/|g|`, `x′ = g′/|g′|` (with `y/|y| = 0` at `y = 0`). -/
noncomputable def cosA {n : ℕ} (g g' : Fin n → ℝ) : ℝ := dot (sphProj g) (sphProj g')

/-- The distribution of a pair `(g, h)` of independent standard Gaussian vectors of `ℝⁿ`. -/
noncomputable abbrev gg (n : ℕ) : Measure ((Fin n → ℝ) × (Fin n → ℝ)) :=
  (stdGauss (Fin n)).prod (stdGauss (Fin n))

/-- `a` for the Gaussian pair `g`, `g′ = r g + √(1−r²) h` at `p = (g, h)`. -/
noncomputable def aR {n : ℕ} (r : ℝ) (p : (Fin n → ℝ) × (Fin n → ℝ)) : ℝ :=
  cosA p.1 (r • p.1 + sC r • p.2)

/-- `ℓ·A(x)`: the linear part `F_1(A(x))`, `F_1(z) = ℓ·z`. -/
noncomputable def qLin {n dA : ℕ} (A : CoefIdx n n dA → ℝ) (ℓ : Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  dot ℓ (bwEval A x)

/-- `X₁ = Var_{μ_W}(ℓ·A(x))`: the realized spread of the linear part. -/
noncomputable def X1 {N n dW dA : ℕ} (W : CoefIdx N n dW → ℝ) (A : CoefIdx n n dA → ℝ)
    (ℓ : Fin n → ℝ) : ℝ :=
  Var[fun x => qLin A ℓ x; muW W]

/-- The distribution of `(A₁, ℓ)`: `A₁` the Gaussian version of `A` with unit coefficient
variance, `ℓ ∼ N(0, I_n)`, independent. -/
noncomputable abbrev AL (n dA : ℕ) : Measure ((CoefIdx n n dA → ℝ) × (Fin n → ℝ)) :=
  (bwGauss n n dA 1).prod (stdGauss (Fin n))

/-- The distribution of `(W, (A₁, ℓ))`, all independent; `W` the Gaussian version with
coefficient variance `σ²`, with `N` inputs and degree `dW`. -/
noncomputable abbrev PP (N n dW dA : ℕ) (σ : ℝ) :
    Measure ((CoefIdx N n dW → ℝ) × ((CoefIdx n n dA → ℝ) × (Fin n → ℝ))) :=
  (bwGauss N n dW σ).prod (AL n dA)

/-- A two-point statistic of the realized input distribution, averaged over `W`:
`E_W E_{u,u′} ψ(x·x′)`, `x = W(u)/|W(u)|`, `x′ = W(u′)/|W(u′)|`. -/
noncomputable def twoPt (N n dW : ℕ) (σ : ℝ) (ψ : ℝ → ℝ) : ℝ :=
  ∫ W, ∫ u, ∫ u', ψ (cosA (bwEval W u) (bwEval W u')) ∂uniformSphere N ∂uniformSphere N
    ∂bwGauss N n dW σ

/-! ### The explicit constants (`K = d_A + 1`, `m = 2 d_A + 1`, `N = 2n`, `d_W = 2 d_A`) -/

/-- `S`: the sum of the even coefficients of `(Σ_{j ≤ d_W} t^j)²` from `t⁴` on. -/
noncomputable def Sof (dA : ℕ) : ℝ := if dA = 3 then 21 else 37

/-- `c_κ`: an upper bound of `κ′(a)²(1 − a²)` on `[−1, 1]`. -/
noncomputable def cKap (dA : ℕ) : ℝ := if dA = 3 then 7697 / 1000 else 15532 / 1000

/-- `r₊ = r(1/10)`. -/
noncomputable def rPlus (dA : ℕ) : ℝ := rW (2 * dA) (1 / 10)

/-- `max |κ′|` on `[−1, 1]`: `d_A (d_A + 1)/2`. -/
noncomputable def LipK (dA : ℕ) : ℝ := (dA : ℝ) * ((dA : ℝ) + 1) / 2

/-- `δ_r` as a function of the number `N` of inputs of `W`:
`[3/N + 3S/(N(N+2))]/m²`. -/
noncomputable def delN (dA N : ℕ) : ℝ :=
  (3 / (N : ℝ) + 3 * Sof dA / ((N : ℝ) * ((N : ℝ) + 2))) / (2 * (dA : ℝ) + 1) ^ 2

/-- `L²` of (P4): `4 (max|κ′|)² (n/(n−2)) / (1 − r₊²)`. -/
noncomputable def Lsq (dA n : ℕ) : ℝ :=
  4 * LipK dA ^ 2 * ((n : ℝ) / ((n : ℝ) - 2)) / (1 - rPlus dA ^ 2)

/-- The bound of `Pr(|t| > 1/10)` used here: `10¹⁶ · E t¹⁶` (Markov). The sources use
`2 e^{−n/100}`. -/
noncomputable def p0 (n : ℕ) : ℝ := 10 ^ 16 * sphMom (2 * n) 16

/-- `J_*` (P5), with `p0` in place of `2 e^{−n/100}`. -/
noncomputable def Jstar (dA n : ℕ) : ℝ :=
  cKap dA * (2 + 2 * rPlus dA) * ((n : ℝ) / ((n : ℝ) - 2)) + Lsq dA n * (n : ℝ) * delN dA (2 * n) +
    ((dA : ℝ) + 1) ^ 2 * (n : ℝ) * p0 n

/-- The bound of `E a²`: `1/m² + δ_r + 3/n`. -/
noncomputable def Ea2 (dA n : ℕ) : ℝ := 1 / (2 * (dA : ℝ) + 1) ^ 2 + delN dA (2 * n) + 3 / (n : ℝ)

/-- `v̄ = 1 + √(E a²) + (d_A − 1) E a²` (P2). -/
noncomputable def vbar (dA n : ℕ) : ℝ :=
  1 + Real.sqrt (Ea2 dA n) + ((dA : ℝ) - 1) * Ea2 dA n

/-- `a_L = 2 + 3 J_* (1 + 2/n)/(K − v̄)²` (Corollary S). -/
noncomputable def aL (dA n : ℕ) : ℝ :=
  2 + 3 * Jstar dA n * (1 + 2 / (n : ℝ)) / ((dA : ℝ) + 1 - vbar dA n) ^ 2

/-- The centre `c = E[κ(a) | r = 1/m]`. -/
noncomputable def cStar (n dA : ℕ) : ℝ := ∫ p, kap dA (aR (1 / (2 * (dA : ℝ) + 1)) p) ∂gg n

/-! ## §2 Interface statements -/

/-- **The Gaussian Poincaré inequality** (constant 1) for a function that is continuously
differentiable on an open set `U`, where almost every rotation path
`θ ↦ cos θ · x + sin θ · z` stays in `U`, and with an integrable majorant `Γ` of `|∇f|²` on `U`. -/
def Poincare107 : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (f : (ι → ℝ) → ℝ) (U : Set (ι → ℝ)) (Γ : (ι → ℝ) → ℝ),
    IsOpen U → ContDiffOn ℝ 1 f U → Measurable f → MemLp f 2 (stdGauss ι) →
    Integrable Γ (stdGauss ι) →
    (∀ x ∈ U, ∑ i, (fderiv ℝ f x (Pi.single i 1)) ^ 2 ≤ Γ x) →
    (∀ᵐ p ∂(stdGauss ι).prod (stdGauss ι), ∀ θ : ℝ, Real.cos θ • p.1 + Real.sin θ • p.2 ∈ U) →
    ∫ x, (f x - ∫ y, f y ∂stdGauss ι) ^ 2 ∂stdGauss ι ≤ ∫ x, Γ x ∂stdGauss ι

/-- `E |g|^{−2} ≤ 1/(n−2)` for a standard Gaussian vector of `ℝⁿ`, `n ≥ 3`. -/
def InvMom107 : Prop :=
  ∀ n : ℕ, 3 ≤ n →
    Integrable (fun g : Fin n → ℝ => 1 / ∑ i, g i ^ 2) (stdGauss (Fin n)) ∧
    ∫ g, 1 / ∑ i, g i ^ 2 ∂stdGauss (Fin n) ≤ 1 / ((n : ℝ) - 2)

/-- A standard Gaussian vector of `ℝⁿ`, `n ≥ 1`, is not zero, almost surely. -/
def NonZero107 : Prop :=
  ∀ n : ℕ, 1 ≤ n → ∀ᵐ g ∂stdGauss (Fin n), g ≠ 0

/-- Two independent standard Gaussian vectors of `ℝⁿ`, `n ≥ 2`, are not parallel, almost surely:
no rotation path through them meets the origin. -/
def NullPar107 : Prop :=
  ∀ n : ℕ, 2 ≤ n → ∀ᵐ p ∂gg n, ∀ θ : ℝ, Real.cos θ • p.1 + Real.sin θ • p.2 ≠ 0

/-- **(P1)** `E[a² | r] ≤ r² + 3/n`. -/
def P1_107 : Prop :=
  ∀ (n : ℕ) (r : ℝ), 1 ≤ n → |r| ≤ 1 → ∫ p, aR r p ^ 2 ∂gg n ≤ r ^ 2 + 3 / (n : ℝ)

/-- **(P3)** `Var(ψ(a) | r) ≤ c (2 + 2|r|)/(n − 2)` when `ψ′(a)²(1 − a²) ≤ c` on `[−1, 1]`. -/
def P3_107 : Prop :=
  ∀ (n : ℕ) (r cκ : ℝ) (ψ ψ' : ℝ → ℝ), 3 ≤ n → |r| ≤ 1 →
    (∀ a, HasDerivAt ψ (ψ' a) a) → Continuous ψ' →
    (∀ a : ℝ, |a| ≤ 1 → ψ' a ^ 2 * (1 - a ^ 2) ≤ cκ) →
    ∫ p, (ψ (aR r p) - ∫ q, ψ (aR r q) ∂gg n) ^ 2 ∂gg n ≤ cκ * (2 + 2 * |r|) / ((n : ℝ) - 2)

/-- **(P4)** the Lipschitz bound of `r ↦ E[ψ(a) | r]` on `[0, r₊]`:
`(m(r₁) − m(r₂))² ≤ 4 Lip² (n/(n−2)) (r₁ − r₂)²/(1 − r₊²)`. -/
def P4_107 : Prop :=
  ∀ (n : ℕ) (r₁ r₂ rp Lip : ℝ) (ψ : ℝ → ℝ), 3 ≤ n → 0 ≤ r₁ → r₁ ≤ rp → 0 ≤ r₂ → r₂ ≤ rp →
    rp < 1 → 0 ≤ Lip → Measurable ψ →
    (∀ a b : ℝ, |a| ≤ 1 → |b| ≤ 1 → |ψ a - ψ b| ≤ Lip * |a - b|) →
    (∫ p, ψ (aR r₁ p) ∂gg n - ∫ p, ψ (aR r₂ p) ∂gg n) ^ 2 ≤
      4 * Lip ^ 2 * ((n : ℝ) / ((n : ℝ) - 2)) / (1 - rp ^ 2) * (r₁ - r₂) ^ 2

/-- **The statistics of `t = u·u′`** for independent uniform `u, u′` on the unit sphere of `ℝ^N`,
at the degrees `d_W = 6` (`d_A = 3`) and `d_W = 8` (`d_A = 4`):
`E r² ≤ 1/m² + δ_r`, `E (r − 1/m)² ≤ δ_r`, `Pr(|t| > 1/10) ≤ 10¹⁶ E t¹⁶`. -/
def SphStat107 : Prop :=
  ∀ (N dA : ℕ), 1 ≤ N → (dA = 3 ∨ dA = 4) →
    (∫ u, ∫ u', rW (2 * dA) (dot u u') ^ 2 ∂uniformSphere N ∂uniformSphere N ≤
      1 / (2 * (dA : ℝ) + 1) ^ 2 + delN dA N) ∧
    (∫ u, ∫ u', (rW (2 * dA) (dot u u') - 1 / (2 * (dA : ℝ) + 1)) ^ 2
      ∂uniformSphere N ∂uniformSphere N ≤ delN dA N) ∧
    (∫ u, ∫ u', (if 1 / 10 < |dot u u'| then (1 : ℝ) else 0) ∂uniformSphere N ∂uniformSphere N ≤
      10 ^ 16 * sphMom N 16)

/-- **The pair distribution of a Gaussian `W`**: for unit `u, u′` and `σ ≠ 0`, the statistic
`ψ(x·x′)` of `(W(u), W(u′))` has the same mean as `ψ(a)` for the Gaussian pair with correlation
`r(u·u′)`. -/
def TwoPoint107 : Prop :=
  ∀ (N n d : ℕ) (σ : ℝ) (u u' : Fin N → ℝ) (ψ : ℝ → ℝ), σ ≠ 0 → dot u u = 1 → dot u' u' = 1 →
    Measurable ψ →
    ∫ c, ψ (cosA (bwEval c u) (bwEval c u')) ∂bwGauss N n d σ =
      ∫ p, ψ (aR (rW d (dot u u')) p) ∂gg n

/-- For a unit `u` and `σ ≠ 0`, `W(u) ≠ 0` almost surely. -/
def OnePoint107 : Prop :=
  ∀ (N n d : ℕ) (σ : ℝ) (u : Fin N → ℝ), 1 ≤ n → σ ≠ 0 → dot u u = 1 →
    ∀ᵐ c ∂bwGauss N n d σ, bwEval c u ≠ 0

/-- **The two-point and four-point moments of `ℓ·A₁(x)`** over `(A₁, ℓ)`:
`E q(x₁)q(x₂) = n κ₁₂`, `E q(x₁)q(x₂)q(x₃)q(x₄) = n(n+2)(κ₁₂κ₃₄ + κ₁₃κ₂₄ + κ₁₄κ₂₃)`,
`κ_ij = κ(x_i·x_j)`. -/
def Wick107 : Prop :=
  ∀ (n dA : ℕ) (x₁ x₂ x₃ x₄ : Fin n → ℝ),
    (∫ ω, qLin ω.1 ω.2 x₁ * qLin ω.1 ω.2 x₂ ∂AL n dA = (n : ℝ) * kap dA (dot x₁ x₂)) ∧
    (∫ ω, qLin ω.1 ω.2 x₁ * qLin ω.1 ω.2 x₂ * qLin ω.1 ω.2 x₃ * qLin ω.1 ω.2 x₄ ∂AL n dA =
      (n : ℝ) * ((n : ℝ) + 2) *
        (kap dA (dot x₁ x₂) * kap dA (dot x₃ x₄) + kap dA (dot x₁ x₃) * kap dA (dot x₂ x₄) +
          kap dA (dot x₁ x₄) * kap dA (dot x₂ x₃)))

/-- A dominating function of `ℓ·A₁(x)` over the cube `|x_i| ≤ 1`, with a finite fourth moment. -/
def QDom107 : Prop :=
  ∀ (n dA : ℕ), ∃ Q : (CoefIdx n n dA → ℝ) × (Fin n → ℝ) → ℝ,
    Measurable Q ∧ (∀ ω, 0 ≤ Q ω) ∧ Integrable (fun ω => Q ω ^ 4) (AL n dA) ∧
    ∀ ω (x : Fin n → ℝ), (∀ i, |x i| ≤ 1) → |qLin ω.1 ω.2 x| ≤ Q ω

/-- **Lemma S and Corollary S** in the form that takes the two-point bounds as hypotheses:
`E X₁ ≥ n(K − v)` and `n · Var X₁ ≤ (2 + 3J(1 + 2/n)/(K − v)²)(E X₁)²`, when
`E κ(x·x′) ≤ v < K` and `n · E(κ(x·x′) − c)² ≤ J`. -/
def CorS107 : Prop :=
  ∀ (N n dW dA : ℕ) (σ v J c : ℝ), 1 ≤ N → 1 ≤ n → σ ≠ 0 → v < (dA : ℝ) + 1 →
    twoPt N n dW σ (kap dA) ≤ v →
    (n : ℝ) * twoPt N n dW σ (fun a => (kap dA a - c) ^ 2) ≤ J →
    MemLp (fun ω => X1 ω.1 ω.2.1 ω.2.2) 2 (PP N n dW dA σ) ∧
    (n : ℝ) * ((dA : ℝ) + 1 - v) ≤ ∫ ω, X1 ω.1 ω.2.1 ω.2.2 ∂PP N n dW dA σ ∧
    (n : ℝ) * Var[fun ω => X1 ω.1 ω.2.1 ω.2.2; PP N n dW dA σ] ≤
      (2 + 3 * J * (1 + 2 / (n : ℝ)) / ((dA : ℝ) + 1 - v) ^ 2) *
        (∫ ω, X1 ω.1 ω.2.1 ω.2.2 ∂PP N n dW dA σ) ^ 2

/-- **Facts about `κ`** for `d_A ∈ {3, 4}` on `[−1, 1]`. -/
def KapFacts107 : Prop :=
  ∀ dA : ℕ, (dA = 3 ∨ dA = 4) →
    (∀ a : ℝ, HasDerivAt (kap dA) (kap' dA a) a) ∧
    (∀ a : ℝ, |a| ≤ 1 → 0 ≤ kap dA a ∧ kap dA a ≤ (dA : ℝ) + 1) ∧
    (∀ a : ℝ, |a| ≤ 1 → kap dA a ≤ 1 + a + ((dA : ℝ) - 1) * a ^ 2) ∧
    (∀ a b : ℝ, |a| ≤ 1 → |b| ≤ 1 → |kap dA a - kap dA b| ≤ LipK dA * |a - b|) ∧
    (∀ a : ℝ, |a| ≤ 1 → kap' dA a ^ 2 * (1 - a ^ 2) ≤ cKap dA)

/-- **(P2) and (P5)** for the Gaussian version of `W` at `r = 2` (`N = 2n`, `d_W = 2 d_A`):
`E κ(x·x′) ≤ v̄` and `n · E(κ(x·x′) − c)² ≤ J_*`. -/
def P5_107 : Prop :=
  ∀ (n dA : ℕ) (σ : ℝ), 3 ≤ n → (dA = 3 ∨ dA = 4) → σ ≠ 0 →
    twoPt (2 * n) n (2 * dA) σ (kap dA) ≤ vbar dA n ∧
    (n : ℝ) * twoPt (2 * n) n (2 * dA) σ (fun a => (kap dA a - cStar n dA) ^ 2) ≤ Jstar dA n

/-- **The numeric bounds** for every `n ≥ 4 096`: `v̄ < K`, `J_* ≥ 0`, `a_L ≤ 10.5` (`d_A = 3`),
`a_L ≤ 10.7` (`d_A = 4`). -/
def Numeric107 : Prop :=
  ∀ n : ℕ, 4096 ≤ n →
    (vbar 3 n < 4 ∧ 0 ≤ Jstar 3 n ∧ aL 3 n ≤ 105 / 10) ∧
    (vbar 4 n < 5 ∧ 0 ≤ Jstar 4 n ∧ aL 4 n ≤ 107 / 10)

end BstLean.Part107
