import BstLean.Part253FallbackRetuned

/-! The checked covariance caps fit a weaker retuned frame budget. -/
namespace BstLean.Part253

structure SuppliedFrameCertificate (i : Fin 60) : Prop where
  cap_nonneg : 0 ≤ BstLean.Part254.capTable i
  frame_upper : certifiedRetunedFrameExpression i ≤ 1.505

