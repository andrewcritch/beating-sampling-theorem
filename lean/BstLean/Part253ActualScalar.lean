theorem suppliedFrameNeeded (j : Fin 43) :
    SuppliedFrameCertificate ⟨j.val + 10, by omega⟩ := by
  match j with
  | ⟨0, _⟩ => exact suppliedFrame10
  | ⟨1, _⟩ => exact suppliedFrame11
  | ⟨2, _⟩ => exact suppliedFrame12
  | ⟨3, _⟩ => exact suppliedFrame13
  | ⟨4, _⟩ => exact suppliedFrame14
  | ⟨5, _⟩ => exact suppliedFrame15
  | ⟨6, _⟩ => exact suppliedFrame16
  | ⟨7, _⟩ => exact suppliedFrame17
  | ⟨8, _⟩ => exact suppliedFrame18
  | ⟨9, _⟩ => exact suppliedFrame19
  | ⟨10, _⟩ => exact suppliedFrame20
  | ⟨11, _⟩ => exact suppliedFrame21
  | ⟨12, _⟩ => exact suppliedFrame22
  | ⟨13, _⟩ => exact suppliedFrame23
  | ⟨14, _⟩ => exact suppliedFrame24
  | ⟨15, _⟩ => exact suppliedFrame25
  | ⟨16, _⟩ => exact suppliedFrame26
  | ⟨17, _⟩ => exact suppliedFrame27
  | ⟨18, _⟩ => exact suppliedFrame28
  | ⟨19, _⟩ => exact suppliedFrame29
  | ⟨20, _⟩ => exact suppliedFrame30
  | ⟨21, _⟩ => exact suppliedFrame31
  | ⟨22, _⟩ => exact suppliedFrame32
  | ⟨23, _⟩ => exact suppliedFrame33
  | ⟨24, _⟩ => exact suppliedFrame34
  | ⟨25, _⟩ => exact suppliedFrame35
  | ⟨26, _⟩ => exact suppliedFrame36
  | ⟨27, _⟩ => exact suppliedFrame37
  | ⟨28, _⟩ => exact suppliedFrame38
  | ⟨29, _⟩ => exact suppliedFrame39
  | ⟨30, _⟩ => exact suppliedFrame40
  | ⟨31, _⟩ => exact suppliedFrame41
  | ⟨32, _⟩ => exact suppliedFrame42
  | ⟨33, _⟩ => exact suppliedFrame43
  | ⟨34, _⟩ => exact suppliedFrame44
  | ⟨35, _⟩ => exact suppliedFrame45
  | ⟨36, _⟩ => exact suppliedFrame46
  | ⟨37, _⟩ => exact suppliedFrame47
  | ⟨38, _⟩ => exact suppliedFrame48
  | ⟨39, _⟩ => exact suppliedFrame49
  | ⟨40, _⟩ => exact suppliedFrame50
  | ⟨41, _⟩ => exact suppliedFrame51
  | ⟨42, _⟩ => exact suppliedFrame52
  | ⟨k + 43, h⟩ => omega

theorem supplied_frame_on_needed {i : Fin 60} (hi : needed i) : SuppliedFrameCertificate i := by
  let j : Fin 43 := ⟨i.val - 10, by have := hi.2; omega⟩
  have he : (⟨j.val + 10, by omega⟩ : Fin 60) = i := by
    apply Fin.ext
    dsimp [j]
    have := hi.1
    omega
  rw [← he]
  exact suppliedFrameNeeded j

end BstLean.Part253
