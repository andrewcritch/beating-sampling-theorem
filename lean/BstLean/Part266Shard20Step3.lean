    ∫ a, ∫ v, |lA (paperDesignP 12870) c a v - lbar (paperDesignP 12870) c a| ^ (2 * q)
      ∂stdGauss (Fin (12870 - 1)) ∂muI 12870 ≤ locationMomentBudget c q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
  exact fresh_LG_lambda (by norm_num) (paperDesignP 12870)
    (paperDesign_agentCentre _ _ _ _) c fresh_latitude_constant_pos_row he hL hq hq12

theorem residual_moment_on_event {c : Ret 12870}
    (hw : WINDOW (paperDesignP 12870) c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12870) c a v - gbar (paperDesignP 12870) c a| ^ (2 * q)
      ∂stdGauss (Fin (12870 - 1)) ∂muI 12870 ≤ residualMomentBudget q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
