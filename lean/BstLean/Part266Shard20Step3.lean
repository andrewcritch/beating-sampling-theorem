theorem removal_of_low_mass {c : Ret 12856}
    (hw : WINDOW (paperDesignP 12856) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12856 - 1))).real
      {v | sgA (paperDesignP 12856) c a v < √(2 / (12856 : ℝ) * mixtureFloor)}
      ∂muI 12856 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12856 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12856 ≤
        removalBudget := by
