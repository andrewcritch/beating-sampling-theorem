theorem removal_of_low_mass {c : Ret 12857}
    (hw : WINDOW (paperDesignP 12857) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12857 - 1))).real
      {v | sgA (paperDesignP 12857) c a v < √(2 / (12857 : ℝ) * mixtureFloor)}
      ∂muI 12857 ≤ lowMassBudget) :
