theorem sigma_bounds : ((1459679 / 250000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (5838717 / 1000000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
