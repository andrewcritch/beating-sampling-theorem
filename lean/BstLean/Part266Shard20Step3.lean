theorem low_mass_of_interfaces {c : Ret 12854}
    (hw : WINDOW (paperDesignP 12854) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12854).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12854) c M H xi)
    (hE : centreEnergy (paperDesignP 12854) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12854 : ℝ))))
    (hprice : massBound 12854 M H xi E u mixtureFloor ≤ 12854 * lowMassBudget) :
