      ∂stdGauss (Fin (12872 - 1)) ∂muI 12872 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12872).prod (stdGauss (Fin (12872 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
