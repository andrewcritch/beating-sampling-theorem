theorem removal_of_low_mass {c : Ret 12852}
    (hw : WINDOW (paperDesignP 12852) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12852 - 1))).real
