      ∫ w, sA (paperDesignP 12863) c a w ∂stdGauss (Fin (12863 - 1))) ^ 2
      ∂stdGauss (Fin (12863 - 1))) ^ 2 ∂muI 12863 ≤ scaleVarianceBudget ^ 2 :=
