theorem sigma_bounds : ((36509 / 6250000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (5841441 / 1000000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

theorem sigma_pos : 0 < rowSigma := by linarith [sigma_bounds.1]

theorem split_width_bounds {c : Ret 12857} (he : (6 / 10 : ℝ) ≤ eR c) :
    0 < splitLocationWidth c ∧ splitLocationWidth c ≤ (215756363 / 62500000000) ∧
    0 < splitResidualWidth ∧ splitResidualWidth ≤ (4168832149 / 125000000000000) := by
