  have hL2 := pow_le_pow_left₀ hl0 hl1 2
  have hb : 12863 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon) ≤
      12863 * ((2869611 / 125000000) : ℝ) ^ 2 / 2 + ((1636597821 / 1000000000)) ^ 2 * (1 + (2869611 / 125000000)) := by
    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (12863 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
      _ ≤ (1001 / 1000 : ℝ) * (12863 * ((2869611 / 125000000)) ^ 2 / 2 + ((1636597821 / 1000000000)) ^ 2 * (1 + (2869611 / 125000000))) := by
        exact mul_le_mul hk1 hb
