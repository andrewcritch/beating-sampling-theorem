theorem variance_of_matrix_events (c : Ret 11935) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11935).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11935) (FirstMatrix 11935))
