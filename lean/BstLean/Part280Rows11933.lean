  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((41883717 / 125000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((6795409827 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
