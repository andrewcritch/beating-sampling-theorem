      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((3002987 / 500000000)) ^ 2 * ((1003 / 1000) * ((37457247 / 1000000000000000))) := by
        gcongr
