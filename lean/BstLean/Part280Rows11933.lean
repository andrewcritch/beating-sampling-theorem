  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((41883717 / 125000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((5532477033 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((3002987 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((22068967 / 40000000000))) := by
        gcongr
