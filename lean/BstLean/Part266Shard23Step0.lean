theorem first_matrix_row (c : Ret 12925) (hc : A1 c ∈ Eop 12925) : OpB (A1 c) 164 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12925 : ℝ)) ≤ (777463017 / 62500000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12925 : ℝ) ≤ (113688171 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12925 : ℝ) + 2 * √12925 ≤ (6576188171 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12925) (hc : c ∈ BstLean.Part164.Eop2 12925) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12925 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12925) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12925 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12925) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12925).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12925) (FirstMatrix 12925))
    (h2 : c ∈ BstLean.Part164.Eop2 12925) (a : BstLean.Part161.Ix 12925) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

