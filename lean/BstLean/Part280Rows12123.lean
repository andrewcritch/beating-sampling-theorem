theorem row_split_floor :
    (2 / (12124 : ℝ)) * biasFloor =
      (1 - eta) * (√(2 / (12124 : ℝ) * mixtureFloor)) ^ 2 := by
  rw [Real.sq_sqrt (by norm_num [mixtureFloor])]
  unfold biasFloor
  ring

/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 12124) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 12124) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (12124 : ℝ)) * eR c * 12124 * chi
  moments : PaperMoments c (keptIx (paperDesignP 12124) c (rowSplit c wl ws))
    varianceMax energyError locationError locationNorm varianceNorm
  removal : ∫ a, removed (stdGauss (Fin (12124 - 1)))
    (rowSplit c wl ws).good a ∂muI 12124 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12124) c (rowSplit c wl ws),
