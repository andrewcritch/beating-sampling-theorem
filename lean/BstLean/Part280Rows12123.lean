  have hn : √(12124 : ℝ) ≤ (110109037 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12124 : ℝ) + 2 * √12124 ≤ (6172109037 / 500000) := by linarith
