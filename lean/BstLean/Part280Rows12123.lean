noncomputable def splitLocationWidth (c : Ret 12127) : ℝ := 4 * locationMomentBudget c 12
noncomputable def splitResidualWidth : ℝ := 4 * residualMomentBudget 12
noncomputable def lowMassBudget : ℝ := 4 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 12127}
    (hw : WINDOW (paperDesignP 12127) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12127 - 1))).real
      {v | sgA (paperDesignP 12127) c a v < √(2 / (12127 : ℝ) * mixtureFloor)}
      ∂muI 12127 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12127 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12127 ≤
        removalBudget := by
