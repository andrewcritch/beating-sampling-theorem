    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12127) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12127).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12127) (FirstMatrix 12127))
    (h2 : c ∈ BstLean.Part164.Eop2 12127) (a : BstLean.Part161.Ix 12127) :
