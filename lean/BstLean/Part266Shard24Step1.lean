    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ 2 * (1 + (11 / 1000 : ℝ)) *
          (1 + 2 * 1.036505 * (81 / 1000 / 12966)) * 12966 := by gcongr <;> linarith
      _ ≤ ((20239809 / 125000) : ℝ) ^ 2 := by norm_num
  have hroot2 : √(2 * (1 + (11 / 1000 : ℝ)) * BstLean.Part153.wn 12966 * 12966 *
      (1 + BstLean.Part154.deltaChi 12966 12 + 2 / π) / BstLean.Part154.csC) ≤
      (18533537 / 100000) := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ 2 * (1 + (11 / 1000 : ℝ)) * 1.036505 * 12966 *
          (1 + 0.0005669 + 2 / 3.141592) / 1.29521 := by gcongr <;> linarith
      _ ≤ ((18533537 / 100000) : ℝ) ^ 2 := by norm_num
  have hroot3 : √((12966 : ℝ) / BstLean.Part154.csC) ≤ (20010729 / 200000) := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
