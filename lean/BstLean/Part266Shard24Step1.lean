theorem energy_lower_components {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
    0 ≤ kappa (meanLowerRoot 12971 θ ^ 2 / gPlus 12971) - 2 / (12971 : ℝ) ^ 2 ∧
    (804 / 1000 : ℝ) ≤
      √(gMinus 12971 * (kappa (meanLowerRoot 12971 θ ^ 2 / gPlus 12971) -
