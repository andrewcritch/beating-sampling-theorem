  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12957)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12957) (CentreSources 12957 12957)
  direction : analyticBase ⊆ agentEv (paperDesignP 12957) (DirectionError 12957)
  angles : analyticBase ⊆ worldAngles

