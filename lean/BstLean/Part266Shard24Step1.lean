  have hkp := (kappa_mem (by linarith : -1 ≤ energyRatio 12971 (gMinus 12971) (54 / 100))
    (by linarith : energyRatio 12971 (gMinus 12971) (54 / 100) ≤ 1)).1
  have hmul := mul_le_mul hg.2.2 (show kappa (energyRatio 12971 (gMinus 12971) (54 / 100)) ≤
