  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12959)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12959) (CentreSources 12959 12959)
  direction : analyticBase ⊆ agentEv (paperDesignP 12959) (DirectionError 12959)
  angles : analyticBase ⊆ worldAngles

