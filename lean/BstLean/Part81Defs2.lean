import BstLean.Part81Defs

/-!
# Part 81, frozen definitions (2): moment form of the sphere constants, for bounds that are
uniform in the map degree `d`

`δ(x) = κ(x,x) − e_d`. `SphM` records bounds for the first three moments of `δ` in place of a
pointwise upper bound for `κ(x,x)` (which grows with `d`). `muS n j = E Σ_k x_k^{2j}` on the sphere.
Do not edit this file.
-/

namespace BstLean.Part81

open MeasureTheory
open BstLean.Part29 (stdGauss uniformSphere)

/-- `μ_j = E Σ_k x_k^{2j} = n (2j−1)!!/(n(n+2)⋯(n+2j−2))`: `μ_0 = n`, `μ_{j+1} = μ_j (2j+1)/(n+2j)`. -/
noncomputable def muS (n : ℕ) : ℕ → ℝ
  | 0 => (n : ℝ)
  | (j + 1) => muS n j * (2 * (j : ℝ) + 1) / ((n : ℝ) + 2 * (j : ℝ))

/-- `G_m(q) = Σ_{i=0}^{m} q^i`. -/
def Gq (m : ℕ) (q : ℝ) : ℝ := ∑ i ∈ Finset.range (m + 1), q ^ i

/-- **Sphere constants, moment form.** -/
def SphM (n d : ℕ) (M1 S2 B1 B2 B3 : ℝ) : Prop :=
  tG n d - eD d ≤ B1 / (n : ℝ) ∧
  ∫ x, (kap d x x - eD d) ^ 2 ∂uniformSphere n ≤ B2 / (n : ℝ) ^ 2 ∧
  ∫ x, (kap d x x - eD d) ^ 3 ∂uniformSphere n ≤ B3 / (n : ℝ) ^ 3 ∧
  0 ≤ mm1 n d ∧ mm1 n d ≤ M1 / (n : ℝ) ∧
  0 ≤ ss2 n d ∧ ss2 n d ≤ S2 / (n : ℝ) ∧
  ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
    eD d ≤ kap d x x ∧
    0 ≤ ∫ y, kap d x y ∂uniformSphere n ∧ ∫ y, kap d x y ∂uniformSphere n ≤ kap d x x

end BstLean.Part81
