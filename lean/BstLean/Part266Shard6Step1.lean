theorem baseEvent_charge {H T : Set (Ret 12518)}
    (hT : (retDist (paperCentres 12518)).real (H ∩ Tᶜ) ≤ tableChargeAllowance) :
    (retDist (paperCentres 12518)).real (H ∩ (baseEvent T)ᶜ) ≤
