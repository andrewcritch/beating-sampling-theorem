  have hτ := paperDesign_tauWorld (n := 12514) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12514) hτ
  have hC := centreSources_ret_charge_row 12514 (paperDesignP 12514) hτ
