  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12503)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12503) (CentreSources 12503 12503)
  direction : analyticBase ⊆ agentEv (paperDesignP 12503) (DirectionError 12503)
  angles : analyticBase ⊆ worldAngles

