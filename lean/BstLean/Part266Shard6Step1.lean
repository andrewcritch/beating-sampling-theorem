  have hτ := paperDesign_tauWorld (n := 12523) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12523) hτ
  have hC := centreSources_ret_charge_row 12523 (paperDesignP 12523) hτ
