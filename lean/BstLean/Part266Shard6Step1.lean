theorem computed_energy_eq (c : Ret 12515) (hτ : 0 < (paperDesignP 12515).tau0 c) :
    eR c = (2 / (mA 12515 : ℝ)) *
      normSq (BstLean.Part150.bT 12515 12515 (A1 c) (A2 c) c.1.2
        ((paperDesignP 12515).tau0 c)) /
