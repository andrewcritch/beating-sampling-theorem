  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12510)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12510) (CentreSources 12510 12510)
  direction : analyticBase ⊆ agentEv (paperDesignP 12510) (DirectionError 12510)
  angles : analyticBase ⊆ worldAngles

