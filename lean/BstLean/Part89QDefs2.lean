import BstLean.Part89QDefs
import BstLean.Part89SDefs
import BstLean.Part86ArithS

/-!
# Part 89, frozen definitions for the assembly at `d_f = 2` (anchor-averaged variance bound)

Definitions only. Do not edit this file. `n = m + 1`, `L = CLs d / m` (the slice operator constant
over `m`), `y` stands for `Ỹ(U) = Σ_j ‖H U_j‖²/‖H‖_F²`.
-/

namespace BstLean.Part89

open BstLean.Part86

/-- `Yn = kapQ · Ỹ(U)`: `16 (d+1) (101/100)/(1 − β)`. -/
noncomputable def kapQ (d : ℕ) (β : ℝ) : ℝ := 16 * ((d : ℝ) + 1) * (101 / 100) / (1 - β)

/-- The variance constant at one scale: `(2L/(1−L)) X(Yn)`, `κmax = d`, `τmin = 49/100`. -/
noncomputable def cV0Q (d : ℕ) (L η η' ω β y : ℝ) : ℝ :=
  2 * L / (1 - L) * XQ η η' ω (kapQ d β * y) d (49 / 100)

/-- The bound of the sphere step at `d_f = 2`, as a function of `y = Ỹ(U)`. -/
noncomputable def gQ (m d : ℕ) (η η' ω ϑ a b β ξ y : ℝ) : ℝ :=
  semiBound89 (m + 1) 2 (DWr (m + 1) (JR (m + 1) d))
    (((m + 1 : ℕ) : ℝ) * (CLs d / (m : ℝ)) + 2)
    (((m + 1 : ℕ) : ℝ) * cVW 2 (tS (m + 1) β) (CLs d / (m : ℝ))
      (cV0Q d (CLs d / (m : ℝ)) η η' ω β y) ϑ)
    (CLs d / (m : ℝ)) a b β ξ

/-- The numeric conditions of the assembly at `d_f = 2`. -/
structure NumQ (m d : ℕ) (η η' ω ϑ a b β ξ : ℝ) : Prop where
  h100 : 100 ≤ m + 1
  h5000 : 5000 ≤ m
  hdn : d ≤ m + 1
  hL10 : CLs d / (m : ℝ) ≤ 1 / 10
  hη : 0 < η
  hη' : 0 < η'
  hω : 0 < ω
  hϑ : 0 < ϑ
  ha : 0 < a
  hb0 : 0 ≤ b
  hb1 : b < 1
  hab : 9 / 4 * a + 1 / 400 ≤ b * (1 - CLs d / (m : ℝ)) / 4
  hβ : 0 < β
  hβ4 : β ≤ 1 / 4
  hξ : 0 < ξ
  hξ2 : ξ ≤ 1 / 2
  hξβ : ξ * β ≤ 1 / 100
  hν : 2 / (DWr (m + 1) (JR (m + 1) d) * (99 / 100 * ξ * β) ^ 2) < 1

/-- The threshold at `d_f = 2`: `110000 (d+1)² (d+1)!`. -/
def NQ (d : ℕ) : ℕ := 110000 * (d + 1) ^ 2 * (d + 1).factorial

/-- The threshold of the second pass for every degree pair: `110 (k+2) (d+1)! 9^{dk}`. -/
def N89s (d k : ℕ) : ℕ := 110 * (k + 2) * (d + 1).factorial * 9 ^ (d * k)

end BstLean.Part89
