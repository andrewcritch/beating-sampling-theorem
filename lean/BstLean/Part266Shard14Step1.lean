  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12712)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12712) (CentreSources 12712 12712)
  direction : analyticBase ⊆ agentEv (paperDesignP 12712) (DirectionError 12712)
  angles : analyticBase ⊆ worldAngles

