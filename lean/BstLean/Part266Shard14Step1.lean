  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12711)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12711) (CentreSources 12711 12711)
  direction : analyticBase ⊆ agentEv (paperDesignP 12711) (DirectionError 12711)
  angles : analyticBase ⊆ worldAngles

