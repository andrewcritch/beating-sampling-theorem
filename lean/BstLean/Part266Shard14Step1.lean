  have h0 : 0 ≤ √(gPlus 12721 * kappa (energyRatio 12721 (gMinus 12721) (54 / 100))) +
      2 * √(12 * gPlus 12721) / 12721 + finiteEnergy 12721 12721 (11 / 1000) / √12721 := by
    positivity
