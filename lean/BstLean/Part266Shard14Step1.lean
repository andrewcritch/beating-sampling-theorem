theorem energy_upper_coarse :
    energyUpper 12708 (gMinus 12708) (gPlus 12708)
      (finiteEnergy 12708 12708 (11 / 1000)) (54 / 100) ≤ 9 / 10 := by
  have hg := energy_g_bounds
  have hr := energy_ratio_coarse
  have hr0 : 0 ≤ energyRatio 12708 (gMinus 12708) (54 / 100) := by
    unfold energyRatio
