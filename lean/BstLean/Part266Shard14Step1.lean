  have hr : (57 / 100 : ℝ) ≤ meanLowerRoot 12721 θ ^ 2 / gPlus 12721 := by
    rw [le_div_iff₀ (by linarith [hg.2.1] : 0 < gPlus 12721)]
    nlinarith [hg.2.2]
