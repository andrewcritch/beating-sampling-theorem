    rw [div_le_iff₀ (by linarith [hg.2.1] : 0 < gPlus 12703)]
    nlinarith [hg.2.1]
  have hk : (65 / 100 : ℝ) ≤ kappa (57 / 100) := by
    apply kernel_lower_rational (s := 821 / 1000) <;> norm_num
  have hκ := kappa_monotoneOn (by norm_num : (57 / 100 : ℝ) ∈ Icc (-1) 1)
    (show meanLowerRoot 12703 θ ^ 2 / gPlus 12703 ∈ Icc (-1 : ℝ) 1 by
      exact ⟨by linarith, hr1⟩) hr
  have hbr : (65 / 100 : ℝ) - 2 / 12703 ^ 2 ≤
      kappa (meanLowerRoot 12703 θ ^ 2 / gPlus 12703) - 2 / (12703 : ℝ) ^ 2 := by
    linarith
  have hs : (805 / 1000 : ℝ) ≤ √(gMinus 12703 *
      (kappa (meanLowerRoot 12703 θ ^ 2 / gPlus 12703) - 2 / (12703 : ℝ) ^ 2)) := by
    apply le_sqrt_of_sq_le
    have hp := mul_le_mul hg.1 hbr (by norm_num : (0 : ℝ) ≤ 65 / 100 - 2 / 12703 ^ 2)
