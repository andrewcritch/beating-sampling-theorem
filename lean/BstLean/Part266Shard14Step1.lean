    (retDist (paperCentres 12715)).real analyticBaseᶜ ≤ analyticCharge := by
  have hτ := paperDesign_tauWorld (n := 12715) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12715) hτ
  have hC := centreSources_ret_charge_row 12715 (paperDesignP 12715) hτ
