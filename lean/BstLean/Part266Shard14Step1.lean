    simp only [Nat.cast_ofNat]
    linarith
  have hmean0 : 0 ≤ meanRoot 12721 (54 / 100) := by unfold meanRoot; positivity
  have hg := energy_g_bounds.1
  unfold energyRatio
  rw [div_le_iff₀ (by linarith : 0 < gMinus 12721)]
  nlinarith

theorem energy_upper_coarse :
    energyUpper 12721 (gMinus 12721) (gPlus 12721)
      (finiteEnergy 12721 12721 (11 / 1000)) (54 / 100) ≤ 9 / 10 := by
  have hg := energy_g_bounds
  have hr := energy_ratio_coarse
  have hr0 : 0 ≤ energyRatio 12721 (gMinus 12721) (54 / 100) := by
