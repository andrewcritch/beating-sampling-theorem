  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12710)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12710) (CentreSources 12710 12710)
  direction : analyticBase ⊆ agentEv (paperDesignP 12710) (DirectionError 12710)
  angles : analyticBase ⊆ worldAngles

