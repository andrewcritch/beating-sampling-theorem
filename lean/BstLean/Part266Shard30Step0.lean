    (add_nonneg (add_nonneg (by norm_num) (sqrt_nonneg _)) (gaussMomConst_nonneg 80))
    (by norm_num)).trans (by norm_num)

theorem jacobian_squared_row : latitudeJacobianSquared160 13100 4 ≤ (81 / 16 : ℝ) := by
  have hs : √(2 / (mA 13100 : ℝ)) ≤ (53977617 / 500000000000) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  have hinner : planeEnvelopeSquared160 13100 4 +
      2 / (mA 13100 : ℝ) * frobEnvelopeSquared160 13100 ≤ (21 / 10 : ℝ) ^ 2 := by
    have hp := plane_squared_row
