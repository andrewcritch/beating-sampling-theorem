def LowResidualMass (c : Ret 12698) : Prop :=
  ∫ a, (stdGauss (Fin (12698 - 1))).real
    {v | sgA (paperDesignP 12698) c a v < rowSigma} ∂muI 12698 ≤ lowMassBudget

