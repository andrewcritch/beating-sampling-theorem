    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12688 - 1))).real
      {v | sgA (paperDesignP 12688) c a v < rowSigma} ∂BstLean.Part161.muI 12688 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
