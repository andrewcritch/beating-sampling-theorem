/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12683) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12683) c (rowSplit c wl ws),
    ((12683 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12683 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12683) c (rowSplit c wl ws),
    ((12683 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12683 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12683 - 1)))
    (rowSplit c wl ws).good a ∂muI 12683 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12683) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12683 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12683) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12683 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12683) c (rowSplit c wl ws),
    hellG2 12683 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12683 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 12683}
    (hw : WINDOW (paperDesignP 12683) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
