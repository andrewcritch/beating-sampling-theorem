    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12677 - 1))).real
      {v | sgA (paperDesignP 12677) c a v < rowSigma} ∂BstLean.Part161.muI 12677 ≤ lowMassBudget) :
