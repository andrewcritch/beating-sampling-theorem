  rw [hid, integral_const_mul]
  refine (mul_le_mul_of_nonneg_left hint (sq_nonneg _)).trans_eq ?_
  field_simp
  <;> ring

theorem variance_moment_row (c : Ret 11963) (he : 0 < eR c) {C : ℝ}
    (hC : 0 < C) (hC6 : C ≤ 16 / 5)
