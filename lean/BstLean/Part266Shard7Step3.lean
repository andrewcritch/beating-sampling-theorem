      12525 * ((4716127 / 200000000) : ℝ) ^ 2 / 2 + ((829288471 / 500000000)) ^ 2 * (1 + (4716127 / 200000000)) := by
    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (12525 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
