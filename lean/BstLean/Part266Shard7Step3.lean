    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (12528 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
      _ ≤ (1001 / 1000 : ℝ) * (12528 * ((23574951 / 1000000000)) ^ 2 / 2 + ((414594511 / 250000000)) ^ 2 * (1 + (23574951 / 1000000000))) := by
        exact mul_le_mul hk1 hb
