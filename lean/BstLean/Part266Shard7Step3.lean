theorem removal_of_low_mass {c : Ret 12532}
    (hw : WINDOW (paperDesignP 12532) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12532 - 1))).real
      {v | sgA (paperDesignP 12532) c a v < √(2 / (12532 : ℝ) * mixtureFloor)}
      ∂muI 12532 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12532 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12532 ≤
        removalBudget := by
