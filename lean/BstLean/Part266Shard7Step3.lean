    ∫ a, ∫ v, sgA (paperDesignP 12543) c a v ^ 8
      ∂stdGauss (Fin (12543 - 1)) ∂muI 12543 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12543).prod (stdGauss (Fin (12543 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12543) c (hc.1.1.1.1 hw.2.1)
