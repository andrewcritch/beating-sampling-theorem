theorem low_mass_of_interfaces {c : Ret 12538}
    (hw : WINDOW (paperDesignP 12538) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12538).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12538) c M H xi)
    (hE : centreEnergy (paperDesignP 12538) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12538 : ℝ))))
    (hprice : massBound 12538 M H xi E u mixtureFloor ≤ 12538 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12538 - 1))).real
      {v | sgA (paperDesignP 12538) c a v < √(2 / (12538 : ℝ) * mixtureFloor)}
        ∂muI 12538 ≤ lowMassBudget := by
