theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (5145461527 / 1000000000000000) ∧
    residualMomentBudget 6 ≤ (6319997827 / 1000000000000000) ∧
    residualMomentBudget 12 ≤ (4335792479 / 500000000000000) := by
  refine ⟨?_, ?_, ?_⟩
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
