theorem variance_budgets_row {c : Ret 12525} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (17002677 / 500000000000000) ∧ residualVarianceBudget ≤ (1628999 / 500000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
