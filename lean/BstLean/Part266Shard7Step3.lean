theorem removal_of_low_mass {c : Ret 12526}
    (hw : WINDOW (paperDesignP 12526) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12526 - 1))).real
