theorem sigma_bounds : ((184919 / 31250000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (5917409 / 1000000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

