theorem removal_of_low_mass {c : Ret 12548}
    (hw : WINDOW (paperDesignP 12548) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12548 - 1))).real
      {v | sgA (paperDesignP 12548) c a v < √(2 / (12548 : ℝ) * mixtureFloor)}
      ∂muI 12548 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12548 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12548 ≤
        removalBudget := by
