    mul_pos (by norm_num) hs0, by linarith⟩

theorem residual_width_bounds : 0 < splitResidualWidth ∧ splitResidualWidth ≤ (4327492099 / 125000000000000) := by
  have hs := residual_budgets_row.2.2
