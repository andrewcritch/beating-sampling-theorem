    unfold radialProduct
    calc
      (∏ i ∈ Finset.range 80, (((12017 - 1 - 1 : ℕ) : ℝ) + 2 * (i : ℝ)))
          ≤ ∏ i ∈ Finset.range 80, (12173 : ℝ) := by
