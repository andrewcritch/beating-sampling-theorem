theorem exact_radius_sq_row : exactRadius (12017 - 1 - 1) 80 ^ 2 ≤ (102 / 100 : ℝ) := by
  have hp := exactRadius_pow (d := 12017 - 1 - 1) (j := 80) (by norm_num) (by norm_num)
