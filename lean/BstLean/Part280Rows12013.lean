      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((2992723 / 500000000)) ^ 2 * ((1003 / 1000) * ((18473847 / 500000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((168102367 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((68449091 / 12500000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2992723 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((547957669 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((168102367 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((1345188681 / 200000000000000))) := by gcongr
      _ ≤ _ := by norm_num
