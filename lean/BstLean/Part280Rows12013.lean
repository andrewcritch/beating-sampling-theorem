theorem first_matrix_row (c : Ret 12017) (hc : A1 c ∈ Eop 12017) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12017 : ℝ)) ≤ (806300603 / 62500000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12017 : ℝ) ≤ (109622079 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12017 : ℝ) + 2 * √12017 ≤ (6118122079 / 500000) := by linarith
