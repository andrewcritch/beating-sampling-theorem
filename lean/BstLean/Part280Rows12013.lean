    ∫ a, ∫ v, |lA (paperDesignP 12017) c a v - lbar (paperDesignP 12017) c a| ^ (2 * q)
      ∂stdGauss (Fin (12017 - 1)) ∂muI 12017 ≤ locationMomentBudget c q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
