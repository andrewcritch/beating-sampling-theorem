    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12017) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12017).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12017) (FirstMatrix 12017))
    (h2 : c ∈ BstLean.Part164.Eop2 12017) (a : BstLean.Part161.Ix 12017) :
