theorem hq_root_price {c : Ret 11954} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 11954) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (11954 - 1))).real
      {v | sgA (paperDesignP 11954) c a v < rowSigma} ∂BstLean.Part161.muI 11954 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
