theorem firstMatrix_charge {n : ℕ} (hn : 1 ≤ n) (D : Design n) (hτW : TauWorld D) :
    (retDist D.toCentres).real (agentEv D (FirstMatrix n))ᶜ ≤ exp (-(n : ℝ) / 2) := by
  rw [agentEv_compl]
  apply retDist_agent_charge D hτW (firstMatrix_measurable n) (exp_pos _).le
  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 11953) (hc : A1 c ∈ Eop 11953) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (11953 : ℝ)) ≤ (3233825243 / 250000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11953 : ℝ) ≤ (109329777 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11953 : ℝ) + 2 * √11953 ≤ (6085829777 / 500000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 11953) (hc : c ∈ BstLean.Part164.Eop2 11953) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 11953 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 11953) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 11953 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 11953) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11953).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11953) (FirstMatrix 11953))
    (h2 : c ∈ BstLean.Part164.Eop2 11953) (a : BstLean.Part161.Ix 11953) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
