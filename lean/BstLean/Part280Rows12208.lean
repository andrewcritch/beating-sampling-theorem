theorem exactTableMoments_of_N {c : Ret 12212} (hw : WINDOW (paperDesignP 12212) c)
    (hθ : BstLean.Part280.m2Guard 12212 c) (hc : c ∈ BstLean.Part280.sharpTableN 12212)
