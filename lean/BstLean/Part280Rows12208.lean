noncomputable def eta : ℝ := 2147 / 10 ^ 6
noncomputable def mixtureFloor : ℝ := 215240 / 10 ^ 6
noncomputable def biasFloor : ℝ := (1 - eta) * mixtureFloor
noncomputable def chi : ℝ := (213 / 200)
