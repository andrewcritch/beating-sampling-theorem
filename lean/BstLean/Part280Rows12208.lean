theorem full_residual_eighth {c : Ret 12212}
    (hw : WINDOW (paperDesignP 12212) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12212) c a v ^ 8
      ∂stdGauss (Fin (12212 - 1)) ∂muI 12212 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12212).prod (stdGauss (Fin (12212 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
