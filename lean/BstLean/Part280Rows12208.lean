theorem variance_of_matrix_events (c : Ret 12210) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12210).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12210) (FirstMatrix 12210))
