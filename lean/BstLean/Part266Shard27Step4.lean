theorem hq_root_price {c : Ret 13044} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 13044) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13044 - 1))).real
      {v | sgA (paperDesignP 13044) c a v < rowSigma} ∂BstLean.Part161.muI 13044 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
