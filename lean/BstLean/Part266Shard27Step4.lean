theorem hq_root_price {c : Ret 13046} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 13046) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13046 - 1))).real
      {v | sgA (paperDesignP 13046) c a v < rowSigma} ∂BstLean.Part161.muI 13046 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
