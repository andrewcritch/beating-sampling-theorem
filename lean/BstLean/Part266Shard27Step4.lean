  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((4639 / 800000)) ^ 2 * ((1003 / 1000) * ((31338433 / 1000000000000000))) := by
        gcongr
