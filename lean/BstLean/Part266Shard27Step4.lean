def LowResidualMass (c : Ret 13033) : Prop :=
  ∫ a, (stdGauss (Fin (13033 - 1))).real
    {v | sgA (paperDesignP 13033) c a v < rowSigma} ∂muI 13033 ≤ lowMassBudget

