  have hq : 3969 / 10000 ≤ BstLean.Part169.qB 13039 := by
    have hr := row_bulk_radius
    have hr2 := Real.sq_sqrt row_bulk_positive.le
    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 13039)]
