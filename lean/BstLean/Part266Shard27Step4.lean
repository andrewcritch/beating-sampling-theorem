    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13027 - 1))).real
      {v | sgA (paperDesignP 13027) c a v < rowSigma} ∂BstLean.Part161.muI 13027 ≤ lowMassBudget) :
