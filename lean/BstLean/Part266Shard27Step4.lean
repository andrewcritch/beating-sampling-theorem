/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13037) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13037) c (rowSplit c wl ws),
    ((13037 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13037 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13037) c (rowSplit c wl ws),
    ((13037 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13037 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13037 - 1)))
    (rowSplit c wl ws).good a ∂muI 13037 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13037) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13037 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13037) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13037 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 13037) c (rowSplit c wl ws),
