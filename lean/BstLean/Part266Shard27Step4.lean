    nlinarith [Real.sqrt_nonneg (BstLean.Part169.qB 13045)]
  exact ⟨by linarith, by linarith [hbulk _ hs.1 hs.2], by nlinarith⟩

theorem node_trace_charge_row {wr : WRet 13045} (hw : windowW wr) :
    (gaussMat (mA 13045) 13045 (2 / (13045 : ℝ))).real {X | ∃ g < Js 13045,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13045 : ℝ)) ∨
