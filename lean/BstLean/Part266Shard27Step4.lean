/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13046) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13046) c (rowSplit c wl ws),
    ((13046 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13046 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13046) c (rowSplit c wl ws),
    ((13046 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13046 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13046 - 1)))
    (rowSplit c wl ws).good a ∂muI 13046 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13046) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13046 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13046) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13046 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 13046) c (rowSplit c wl ws),
    hellG2 13046 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 13046 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 13046}
    (hw : WINDOW (paperDesignP 13046) c) (he : 0 < eR c)
