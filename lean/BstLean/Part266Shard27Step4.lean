  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((173355473 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4845273611 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((2900487 / 500000000)) * ((1001 / 1000 + 52 / 1000) * ((31564327 / 62500000000))) := by
        gcongr
