theorem hq_output_bounds {c : Ret 13046}
    (hw : WINDOW (paperDesignP 13046) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13046)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
