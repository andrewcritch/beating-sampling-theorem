      ∫ w, sA (paperDesignP 12261) c a w ∂stdGauss (Fin (12261 - 1))) ^ 2
      ∂stdGauss (Fin (12261 - 1))) ^ 2 ∂muI 12261 ≤ scaleVarianceBudget ^ 2 :=
