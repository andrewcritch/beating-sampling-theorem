theorem removal_of_low_mass {c : Ret 12254}
    (hw : WINDOW (paperDesignP 12254) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12254 - 1))).real
      {v | sgA (paperDesignP 12254) c a v < √(2 / (12254 : ℝ) * mixtureFloor)}
      ∂muI 12254 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12254 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12254 ≤
        removalBudget := by
  have hl := locationMomentBudget_pos he (by norm_num : 12 ≤ 12)
  have hs := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
