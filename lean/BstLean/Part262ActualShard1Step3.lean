theorem sigma_bounds : (593 / 10 ^ 5 : ℝ) ≤ rowSigma ∧ rowSigma ≤ 5962 / 10 ^ 6 := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

