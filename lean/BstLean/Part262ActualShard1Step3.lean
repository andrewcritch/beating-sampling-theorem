theorem residual_moment_on_event {c : Ret 12251}
    (hw : WINDOW (paperDesignP 12251) c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12251) c a v - gbar (paperDesignP 12251) c a| ^ (2 * q)
      ∂stdGauss (Fin (12251 - 1)) ∂muI 12251 ≤ residualMomentBudget q ^ (2 * q) := by
