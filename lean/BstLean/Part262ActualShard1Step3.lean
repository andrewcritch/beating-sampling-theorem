    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12258) c M H xi)
    (hE : centreEnergy (paperDesignP 12258) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12258 : ℝ))))
    (hprice : massBound 12258 M H xi E u mixtureFloor ≤ 12258 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12258 - 1))).real
