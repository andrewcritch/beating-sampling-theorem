theorem full_residual_eighth {c : Ret 12265}
    (hw : WINDOW (paperDesignP 12265) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12265) c a v ^ 8
      ∂stdGauss (Fin (12265 - 1)) ∂muI 12265 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12265).prod (stdGauss (Fin (12265 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
