    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12145 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12145) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12145).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12145) (FirstMatrix 12145))
    (h2 : c ∈ BstLean.Part164.Eop2 12145) (a : BstLean.Part161.Ix 12145) :
    |VR c a| ≤ varianceMax := by
