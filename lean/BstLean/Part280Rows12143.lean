theorem hq_output_bounds {c : Ret 12146}
    (hw : WINDOW (paperDesignP 12146) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12146)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
