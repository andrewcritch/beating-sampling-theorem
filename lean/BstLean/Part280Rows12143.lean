theorem first_matrix_row (c : Ret 12145) (hc : A1 c ∈ Eop 12145) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12145 : ℝ)) ≤ (3208161679 / 250000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12145 : ℝ) ≤ (27551089 / 250000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12145 : ℝ) + 2 * √12145 ≤ (1545676089 / 125000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12145) (hc : c ∈ BstLean.Part164.Eop2 12145) :
