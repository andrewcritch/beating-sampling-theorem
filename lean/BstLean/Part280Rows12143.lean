    change √(2 / (mA n : ℝ)) * √(normSq (res (D.bA c.1 c.2.1.1)
      (hStand D c ξ))) < _ ↔ _
    rw [← Real.sqrt_mul (by positivity)]
    exact Real.sqrt_lt_sqrt_iff (mul_nonneg (by positivity) (normSq_nonneg _))
  rw [hs, le_div_iff₀ hnR, mul_comm]
