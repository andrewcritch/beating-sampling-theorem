  have hsum : (12800 : ℝ) + √12800 + gaussMomConst 80 ≤ 12923 := by
    linarith [gaussian80_le]
  exact (mul_le_mul hs hsum
    (add_nonneg (add_nonneg (by norm_num) (sqrt_nonneg _)) (gaussMomConst_nonneg 80))
    (by norm_num)).trans (by norm_num)

theorem jacobian_squared_row : latitudeJacobianSquared160 12800 4 ≤ (81 / 16 : ℝ) := by
  have hs : √(2 / (mA 12800 : ℝ)) ≤ (22097087 / 200000000000) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  have hinner : planeEnvelopeSquared160 12800 4 +
      2 / (mA 12800 : ℝ) * frobEnvelopeSquared160 12800 ≤ (21 / 10 : ℝ) ^ 2 := by
    have hp := plane_squared_row
