    linarith
  have hr : √(planeEnvelopeSquared160 12800 4 +
      2 / (mA 12800 : ℝ) * frobEnvelopeSquared160 12800) ≤ (21 / 10 : ℝ) :=
    (sqrt_le_iff).mpr ⟨by norm_num, hinner⟩
  have ht : transverseConstant160 * √(2 / (mA 12800 : ℝ)) *
