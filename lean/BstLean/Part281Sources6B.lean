noncomputable def pilot_groupMomentCertificate {g : Fin 10} (hg : BstLean.Part281.Groups.NeededGroup g) :
    MomentCertificate 12030 0.011 1.22 1.12 0.46 (BstLean.Part281.Groups.groupTheta g) (BstLean.Part281.Groups.groupProfile g)
      (fun _ => 0.006) := by
  have G := BstLean.Part281.Groups.group_scalar hg
  exact {
    delta_nonneg := by norm_num
    delta_lt := by norm_num
    k_gt := by norm_num
    k3_gt := by norm_num
    theta_lower := by norm_num
    v_pos := by intro θ hθ; norm_num
    supremum := fun θ hθ => by
      have hθ0 : 0 < θ := lt_of_lt_of_le (by norm_num) hθ.1
      have hθ1 : θ ≤ 1 := hθ.2.trans (G.window.2.trans (by norm_num))
      exact (mul_le_mul_of_nonneg_right (BstLean.Part281.Groups.hsProfile_le (by norm_num) hθ0 hθ1)
        (by positivity : 0 ≤ θ * √θ)).trans (BstLean.Part281.Groups.profile_on_group hg hθ)
    ratio := by have := pilot_rho_bounds.2; linarith
    ratio_gamma := by have := (pilot_gamma_bounds G.window).2; linarith
    gap := lt_of_lt_of_le (by norm_num) pilot_first_gap_lower
    gap_gamma := lt_of_lt_of_le (by norm_num) (pilot_second_gap_lower G.window) }

theorem pilot_group_moment_bounds {g : Fin 10} (hg : BstLean.Part281.Groups.NeededGroup g) :
    0 ≤ momentAllowance 12030 csC 0.011 1.22 1.12 (BstLean.Part281.Groups.groupTheta g) (BstLean.Part281.Groups.groupProfile g) ∧
    momentAllowance 12030 csC 0.011 1.22 1.12 (BstLean.Part281.Groups.groupTheta g) (BstLean.Part281.Groups.groupProfile g) ≤ 0.053939406573 ∧
    0 ≤ bN 12030 csC (BstLean.Part281.Groups.groupTheta g) ∧ bN 12030 csC (BstLean.Part281.Groups.groupTheta g) ≤ 0.001460057463 := by
  have G := BstLean.Part281.Groups.group_scalar hg
  have hΘ : 0 ≤ BstLean.Part281.Groups.groupTheta g := le_trans (by norm_num) G.window.1
  have hm := pilot_moment_upper G.window G.profile_nonneg
  have hb := pilot_bn_upper hΘ
  exact ⟨pilot_centre_moment_nonneg hΘ G.profile_nonneg,
    by have := G.profile_le; have := G.window.2; linarith,
    pilot_centre_bn_nonneg hΘ, by have := G.window.2; linarith⟩

theorem pilot_group_parallel {g : Fin 10} (hg : BstLean.Part281.Groups.NeededGroup g) :
    parallelFormula 12030 12030 0.011
      (momentAllowance 12030 csC 0.011 1.22 1.12 (BstLean.Part281.Groups.groupTheta g) (BstLean.Part281.Groups.groupProfile g))
      (bN 12030 csC (BstLean.Part281.Groups.groupTheta g))
      (√(momentAllowance 12030 csC 0.011 1.22 1.12 (BstLean.Part281.Groups.groupTheta g) (BstLean.Part281.Groups.groupProfile g)) +
        sharpDeviation 12030 csC 0.011 0.46 (BstLean.Part281.Groups.groupTheta g)) (BstLean.Part281.Groups.groupTheta g) 1.25 ≤ pilotParallelCap := by
  have G := BstLean.Part281.Groups.group_scalar hg
  obtain ⟨hxi0,hxi1,hbn0,hbn1⟩ := pilot_group_moment_bounds hg
  have hΘ : 0 ≤ BstLean.Part281.Groups.groupTheta g := le_trans (by norm_num) G.window.1
  have hd0 : 0 ≤ sharpDeviation 12030 csC 0.011 0.46 (BstLean.Part281.Groups.groupTheta g) := by
    unfold sharpDeviation
    positivity
  have hxs : √(momentAllowance 12030 csC 0.011 1.22 1.12
      (BstLean.Part281.Groups.groupTheta g) (BstLean.Part281.Groups.groupProfile g)) ≤ 0.232248587882 :=
    sqrt_le_iff.mpr ⟨by norm_num, by linarith⟩
  have hd := pilot_deviation_upper hΘ G.window.2
  exact pilot_parallel_formula_bound hxi0 hxi1 hbn0 hbn1 (by positivity) (by linarith)
    hΘ G.window.2

theorem pilot_group_relative_gap {g : Fin 10} (hg : BstLean.Part281.Groups.NeededGroup g) :
    eMP 12030 0.011
      (momentAllowance 12030 csC 0.011 1.22 1.12 (BstLean.Part281.Groups.groupTheta g) (BstLean.Part281.Groups.groupProfile g))
      (bN 12030 csC (BstLean.Part281.Groups.groupTheta g)) ≤ 1 / 10 := by
  obtain ⟨hxi0,hxi1,hbn0,hbn1⟩ := pilot_group_moment_bounds hg
  exact (pilot_emp_upper hxi0 hxi1 hbn0 hbn1).trans (by norm_num)

end BstLean.Part281.N12030
