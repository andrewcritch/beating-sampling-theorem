    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12607) c a v - gbar (paperDesignP 12607) c a| ^ (2 * q)
      ∂stdGauss (Fin (12607 - 1)) ∂muI 12607 ≤ residualMomentBudget q ^ (2 * q) := by
