      ∂stdGauss (Fin (12624 - 1)) ∂muI 12624 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12624).prod (stdGauss (Fin (12624 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
