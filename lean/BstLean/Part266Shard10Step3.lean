theorem removal_of_low_mass {c : Ret 12608}
    (hw : WINDOW (paperDesignP 12608) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12608 - 1))).real
