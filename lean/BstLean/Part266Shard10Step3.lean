/-- All twenty-eight fields concern the original retained network and latitude measure. -/
noncomputable def latitudeMoments {c : Ret 12600}
    (hw : WINDOW (paperDesignP 12600) c) (he : 0 < eR c) (hc : c ∈ passEvent)
