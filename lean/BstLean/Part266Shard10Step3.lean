/-- All twenty-eight fields concern the original retained network and latitude measure. -/
noncomputable def latitudeMoments {c : Ret 12607}
    (hw : WINDOW (paperDesignP 12607) c) (he : 0 < eR c) (hc : c ∈ passEvent)
