      ∫ w, sA (paperDesignP 12609) c a w ∂stdGauss (Fin (12609 - 1))) ^ 2
      ∂stdGauss (Fin (12609 - 1))) ^ 2 ∂muI 12609 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12609) c
