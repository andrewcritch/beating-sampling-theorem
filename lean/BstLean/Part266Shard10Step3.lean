    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12604) c a v - gbar (paperDesignP 12604) c a| ^ (2 * q)
      ∂stdGauss (Fin (12604 - 1)) ∂muI 12604 ≤ residualMomentBudget q ^ (2 * q) := by
