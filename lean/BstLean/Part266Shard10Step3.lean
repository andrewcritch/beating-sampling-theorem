theorem sigma_bounds : ((2949537 / 500000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (235963 / 40000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

theorem sigma_pos : 0 < rowSigma := by linarith [sigma_bounds.1]

theorem split_width_bounds {c : Ret 12607} (he : (6 / 10 : ℝ) ≤ eR c) :
    0 < splitLocationWidth c ∧ splitLocationWidth c ≤ (220039117 / 62500000000) ∧
    0 < splitResidualWidth ∧ splitResidualWidth ≤ (2146765661 / 62500000000000) := by
  have hl := (location_budgets_row he).2.2
  have hs := residual_budgets_row.2.2
