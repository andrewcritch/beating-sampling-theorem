theorem uniformS0 {n : ℕ} (hn : 12227 ≤ n) {c : ℝ}
    (hc : B (69/200) (7/20) c) :
    0 < s3am n 46 ∧ 0 ≤ s3dm n 46 c ∧
    s3dm n 46 c ^ 2 ≤ 2 * s3ap n 46 ^ 2 ∧ s3c1 n 46 c < 1 ∧
    0 ≤ s3Cpa n c - s3r1 n 46 ∧
    s3e0 n 46 ≤ (s3Cpa n c - s3r1 n 46) / s3ap n 46 ∧
    s3nks n 46 (√23/n) c ≤ n * (97391/500000) :=
  s_from_normalized hn (normalizedS0 (invN_bounds hn) hc)

