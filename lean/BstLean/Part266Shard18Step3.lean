theorem residual_sq_le_energy (c : Ret 12823)
    (p : Ix 12823 × (Fin (12823 - 1) → ℝ)) :
    sgA (paperDesignP 12823) c p.1 p.2 ^ 2 ≤
      (2 / (12823 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12823).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12823) c p.1)
