    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12822) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12822 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12822 : ℝ) * _ ≤ 2 / 12822 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12822)
