theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (498049637 / 100000000000000) ∧
    residualMomentBudget 6 ≤ (1223471127 / 200000000000000) ∧
    residualMomentBudget 12 ≤ (1049181957 / 125000000000000) := by
  refine ⟨?_, ?_, ?_⟩
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
