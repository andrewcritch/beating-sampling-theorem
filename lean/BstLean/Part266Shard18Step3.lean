theorem removal_of_low_mass {c : Ret 12806}
    (hw : WINDOW (paperDesignP 12806) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12806 - 1))).real
      {v | sgA (paperDesignP 12806) c a v < √(2 / (12806 : ℝ) * mixtureFloor)}
      ∂muI 12806 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12806 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12806 ≤
        removalBudget := by
  have hl := locationMomentBudget_pos he (by norm_num : 12 ≤ 12)
  have hs := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
