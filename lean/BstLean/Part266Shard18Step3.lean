theorem low_mass_of_interfaces {c : Ret 12816}
    (hw : WINDOW (paperDesignP 12816) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12816).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12816) c M H xi)
    (hE : centreEnergy (paperDesignP 12816) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12816 : ℝ))))
    (hprice : massBound 12816 M H xi E u mixtureFloor ≤ 12816 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12816 - 1))).real
      {v | sgA (paperDesignP 12816) c a v < √(2 / (12816 : ℝ) * mixtureFloor)}
        ∂muI 12816 ≤ lowMassBudget := by
