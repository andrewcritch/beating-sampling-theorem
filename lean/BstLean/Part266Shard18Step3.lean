theorem residual_sq_le_energy (c : Ret 12822)
    (p : Ix 12822 × (Fin (12822 - 1) → ℝ)) :
    sgA (paperDesignP 12822) c p.1 p.2 ^ 2 ≤
      (2 / (12822 : ℝ)) * wLatitude c p := by
