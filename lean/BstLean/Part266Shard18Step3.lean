noncomputable def fullResidualBudget : ℝ := √(2 / (12802 : ℝ)) * locationNorm

theorem residual_sq_le_energy (c : Ret 12802)
    (p : Ix 12802 × (Fin (12802 - 1) → ℝ)) :
