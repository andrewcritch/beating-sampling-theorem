theorem residual_sq_le_energy (c : Ret 12824)
    (p : Ix 12824 × (Fin (12824 - 1) → ℝ)) :
    sgA (paperDesignP 12824) c p.1 p.2 ^ 2 ≤
      (2 / (12824 : ℝ)) * wLatitude c p := by
