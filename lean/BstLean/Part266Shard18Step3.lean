    (hw : WINDOW (paperDesignP 12810) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12810) c a v ^ 8
      ∂stdGauss (Fin (12810 - 1)) ∂muI 12810 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12810).prod (stdGauss (Fin (12810 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
