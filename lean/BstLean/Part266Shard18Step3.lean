noncomputable def lowMassBudget : ℝ := 5 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 12801}
    (hw : WINDOW (paperDesignP 12801) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12801 - 1))).real
      {v | sgA (paperDesignP 12801) c a v < √(2 / (12801 : ℝ) * mixtureFloor)}
      ∂muI 12801 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12801 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12801 ≤
        removalBudget := by
  have hl := locationMomentBudget_pos he (by norm_num : 12 ≤ 12)
  have hs := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
