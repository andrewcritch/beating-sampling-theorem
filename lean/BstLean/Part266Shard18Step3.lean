noncomputable def fullResidualBudget : ℝ := √(2 / (12808 : ℝ)) * locationNorm

theorem residual_sq_le_energy (c : Ret 12808)
    (p : Ix 12808 × (Fin (12808 - 1) → ℝ)) :
    sgA (paperDesignP 12808) c p.1 p.2 ^ 2 ≤
      (2 / (12808 : ℝ)) * wLatitude c p := by
