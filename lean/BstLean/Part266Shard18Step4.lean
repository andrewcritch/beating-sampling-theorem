  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((343832749 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4969424933 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5850091 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((25681039 / 50000000000))) := by
        gcongr
