    (ht : c ∈ tableEvent) (hp : c ∈ positiveOutputEvent (paperCentres 12816))
    (hm : LowResidualMass c) :
    BstLean.Part243.RootInputs 12816 t c BstLean.Part266.agent12816.root where
  split := hqSplit c
  chi := chi
  biasFloor := biasFloor
  epsilon := epsilon
  vmax := varianceMax
  aw := energyError
  af := locationError
  Hf := locationNorm
  Cv := varianceNorm
  B := 0
  mix := 24 / 10000
  displacement := 0
  window := hw
  passes := hq_passes hw ha ht
  fluctuation := by simpa using hq_fluctuation t hw ha hp hm
  scalar := by
    have h := stored_bias_root
    norm_num [biasRootCap, BstLean.Part266.agent12816] at h ⊢
    linarith

