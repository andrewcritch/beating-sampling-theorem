      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5849179 / 1000000000)) ^ 2 * ((1003 / 1000) * ((6488601 / 200000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((85971437 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((496709933 / 100000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5849179 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((102692101 / 200000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((85971437 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((1525224711 / 250000000000000))) := by gcongr
      _ ≤ _ := by norm_num
