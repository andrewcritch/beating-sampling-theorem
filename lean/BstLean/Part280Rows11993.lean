theorem location_variance_on_event {c : Ret 11997}
    (hw : WINDOW (paperDesignP 11997) c) (he : 0 < eR c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (lA (paperDesignP 11997) c a v - lbar (paperDesignP 11997) c a) ^ 2
      ∂stdGauss (Fin (11997 - 1))) ^ 2 ∂muI 11997 ≤ locationVarianceBudget c ^ 2 := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
