theorem hq_location_bounds {c : Ret 11996} (he : (6 / 10 : ℝ) ≤ eR c) :
    0 ≤ hqLocation c ∧ hqLocation c ≤ (26733679 / 15625000) := by
  have hw := split_width_bounds he
