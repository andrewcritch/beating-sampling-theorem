theorem variance_of_matrix_events (c : Ret 12183) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12183).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12183) (FirstMatrix 12183))
