noncomputable def splitLocationWidth (c : Ret 12185) : ℝ := 4 * locationMomentBudget c 12
noncomputable def splitResidualWidth : ℝ := 4 * residualMomentBudget 12
noncomputable def lowMassBudget : ℝ := 4 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 12185}
    (hw : WINDOW (paperDesignP 12185) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12185 - 1))).real
      {v | sgA (paperDesignP 12185) c a v < √(2 / (12185 : ℝ) * mixtureFloor)}
      ∂muI 12185 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12185 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12185 ≤
        removalBudget := by
