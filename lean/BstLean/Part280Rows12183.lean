theorem variance_of_matrix_events (c : Ret 12185) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12185).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12185) (FirstMatrix 12185))
