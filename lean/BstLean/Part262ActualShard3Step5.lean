    0 ≤ d.w0 12300 160 ∧ 0 ≤ d.w1 12300 160 ∧ 0 ≤ d.w2 12300 160
  dsimp only [RAData.f0, RAData.f1, RAData.f2, RAData.w0, RAData.w1, RAData.w2]
  unfold AF0 AF1 AF2 AW0 AW1 AW2
  exact ⟨by positivity, by positivity, by positivity,
