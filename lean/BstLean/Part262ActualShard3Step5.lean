      6 * (180 / 10 ^ 11) * (42 / 10 ^ 11) * (126 / 100) + 8 * (42 / 10 ^ 11) ^ 2 := by
    unfold collectedSecond
    gcongr <;> first | exact F.f0 | exact F.f1 | exact F.f2 | exact hπ | assumption
  have hcol0 : 0 ≤ collectedSecond (d.f0 12300 160) (d.f1 12300 160) d.f2 := by
    unfold collectedSecond
    positivity
  have hrF0 : 0 ≤ locationR16 12300 := by unfold locationR16; positivity
  have hrW0 : 0 ≤ energyR16 12300 := by unfold energyR16; positivity
  have htF0 := radiusPolynomialRoot16_nonneg (d.f0 12300 160) (d.f1 12300 160) d.f2
  have htW0 := radiusPolynomialRoot16_nonneg (d.w0 12300 160) (d.w1 12300 160) (d.w2 12300 160)
  have hwexpr0 : 0 ≤ d.w0 12300 160 + d.w1 12300 160 * √(π / 2) +
      2 * d.w2 12300 160 + energyR16 12300 *
