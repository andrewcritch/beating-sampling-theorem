def LowResidualMass (c : Ret 12337) : Prop :=
  ∫ a, (stdGauss (Fin (12337 - 1))).real
    {v | sgA (paperDesignP 12337) c a v < rowSigma} ∂muI 12337 ≤ lowMassBudget

