theorem hq_root_price {c : Ret 12338} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 12338) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12338 - 1))).real
      {v | sgA (paperDesignP 12338) c a v < rowSigma} ∂BstLean.Part161.muI 12338 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
