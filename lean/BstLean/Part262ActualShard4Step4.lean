theorem node_trace_charge_row {wr : WRet 12334} (hw : windowW wr) :
    (gaussMat (mA 12334) 12334 (2 / (12334 : ℝ))).real {X | ∃ g < Js 12334,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12334 : ℝ)) ∨
