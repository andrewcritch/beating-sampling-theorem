import BstLean.Part108All

/-!
# Part 112, frozen definitions: the trace vector of the quadratic term of `W` (Claim U1)

Role: `delegations/statements/p112-spec.md`. Paper sources: `delegations/answers/oaW13-opus-prover.md`
and its challenge `delegations/answers/oaW13c-cx.md` (§2 the quadratic split, §3 the signed Mehler
statement). This file holds definitions and `Prop`-valued interface statements only.
Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

## The quadratic split

`W : ℝ^N → ℝ^n` of degree at most `d ≥ 2`, monomial coefficients `W (a, α)`.
* `sqMono N d hd i` is the monomial `u_i²` (its Bombieri–Weyl weight is `1`).
* `t2 hd W a = (1/N) Σ_i W (a, u_i²)`: the trace vector `t₂(W) = E_u W_2(u, u)` (`E u_i² = 1/N`,
  `E u_i u_j = 0` for `i ≠ j`). It is a linear function of the `n·N` diagonal quadratic coefficients.
* `trPart hd W`: the coefficient vector of the polynomial map `u ↦ t₂(W)·|u|²` (the trace projection
  of the quadratic term).
* `mixT hd b0 c`: the coefficients of degree `0` and `1` and the trace projection of the quadratic
  term from `b0` (the read part); the centred quadratic term and the degrees `3` to `d` from `c`
  (the unread part).
* `addT hd W`: `W` with `t₂(W)` added to its constant term; `nuT hd W τ = nuW (addT hd W) τ` is the
  distribution of `y/|y|`, `y = (W_0 + t₂) + W_1 u + τ γ` (the stand-in with the trace vector).
* `reflT hd W`: the reflection `t₂ ↦ −t₂` (the trace projection of the quadratic term reversed).
* `tauT N d σ = √(d − 1 − 1/N)·σ`, `rhoT N d t = (Σ_{j=2}^{d} t^j − 1/N)/(d − 1 − 1/N)`.
* `SsumT N d = Σ_{m=2}^{d/2} E t^{2m}`, `lamS N d = S/(d − 1 − 1/N)` (the factor `λ′` of the paper),
  `lamT N d = (S + E t⁴/80 + 21·E t⁶)/(d − 1 − 1/N)` (the factor that Lean proves).
-/

namespace BstLean.Part112

open MeasureTheory ProbabilityTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part105

variable {N n d : ℕ}

/-! ## §1 Definitions -/

/-- The monomial `u_i²`. -/
def sqMono (N d : ℕ) (hd : 2 ≤ d) (i : Fin N) : MonoIdx N d :=
  ⟨⟨2, by omega⟩, ⟨(i ::ₘ {i} : Multiset (Fin N)), by simp⟩⟩

/-- The trace vector `t₂(W)_a = (1/N) Σ_i W (a, u_i²)`. -/
noncomputable def t2 (hd : 2 ≤ d) (W : CoefIdx N n d → ℝ) (a : Fin n) : ℝ :=
  (∑ i : Fin N, W (a, sqMono N d hd i)) / (N : ℝ)

open Classical in
/-- The trace projection of the quadratic term: the coefficients of `u ↦ t₂(W)·|u|²`. -/
noncomputable def trPart (hd : 2 ≤ d) (W : CoefIdx N n d → ℝ) : CoefIdx N n d → ℝ :=
  fun p => if ∃ i, p.2 = sqMono N d hd i then t2 hd W p.1 else 0

/-- Read part (degrees `0`, `1` and the trace projection of degree `2`) from `b0`; unread part (the
centred quadratic term and the degrees `3` to `d`) from `c`. -/
noncomputable def mixT (hd : 2 ≤ d) (b0 c : CoefIdx N n d → ℝ) : CoefIdx N n d → ℝ :=
  mixW b0 (c - trPart hd c + trPart hd b0)

/-- The reflection `t₂ ↦ −t₂`. -/
noncomputable def reflT (hd : 2 ≤ d) (W : CoefIdx N n d → ℝ) : CoefIdx N n d → ℝ :=
  W - (2 : ℝ) • trPart hd W

open Classical in
/-- `W` with the trace vector added to its constant term. -/
noncomputable def addT (hd : 2 ≤ d) (W : CoefIdx N n d → ℝ) : CoefIdx N n d → ℝ :=
  fun p => if p.2 = mono0 N d then W p + t2 hd W p.1 else W p

/-- The stand-in with the trace vector: the distribution of `y/|y|`,
`y = (W_0 + t₂) + W_1 u + τ γ`. -/
noncomputable def nuT (hd : 2 ≤ d) (b0 : CoefIdx N n d → ℝ) (τ : ℝ) : Measure (Fin n → ℝ) :=
  nuW (addT hd b0) τ

/-- `τ′ = √(d − 1 − 1/N)·σ`. -/
noncomputable def tauT (N d : ℕ) (σ : ℝ) : ℝ := Real.sqrt ((d : ℝ) - 1 - 1 / (N : ℝ)) * σ

/-- `ρ′(t) = (Σ_{j=2}^{d} t^j − 1/N)/(d − 1 − 1/N)`. -/
noncomputable def rhoT (N d : ℕ) (t : ℝ) : ℝ :=
  ((∑ j ∈ Finset.Icc 2 d, t ^ j) - 1 / (N : ℝ)) / ((d : ℝ) - 1 - 1 / (N : ℝ))

/-- `S = Σ_{m=2}^{d/2} E t^{2m}`. -/
noncomputable def SsumT (N d : ℕ) : ℝ := ∑ m ∈ Finset.Icc 2 (d / 2), sphMom N (2 * m)

/-- The factor `λ′ = S/(d − 1 − 1/N)` of the paper. -/
noncomputable def lamS (N d : ℕ) : ℝ := SsumT N d / ((d : ℝ) - 1 - 1 / (N : ℝ))

/-- The factor that Lean proves: `(S + E t⁴/80 + 21·E t⁶)/(d − 1 − 1/N)`. -/
noncomputable def lamT (N d : ℕ) : ℝ :=
  (SsumT N d + sphMom N 4 / 80 + 21 * sphMom N 6) / ((d : ℝ) - 1 - 1 / (N : ℝ))

/-! ## §2 Interface statements: the second-order Gebelein (signed Mehler) inequality -/

/-- **Second-order Gebelein inequality.** For a Gaussian pair with correlation `ρ ∈ [−1, 1]` and
bounded measurable `f`, `g`:
`|Cov(f(X), g(Y)) − ρ·c_f·c_g| ≤ 2ρ²·a₂(f)·a₂(g)`, with `c_f = E[f(X) X]` (the first chaos) and
`a₂(f)² = Var f − |c_f|²`. -/
def Mehler2 : Prop :=
  ∀ (ι : Type) [Fintype ι] (ρ : ℝ) (f g : (ι → ℝ) → ℝ), |ρ| ≤ 1 → BM f → BM g →
    |∫ w, f w.1 * g (ρ • w.1 + sC ρ • w.2) ∂((stdGauss ι).prod (stdGauss ι)) -
        (∫ x, f x ∂stdGauss ι) * (∫ x, g x ∂stdGauss ι) -
        ρ * ∑ i, (∫ x, f x * x i ∂stdGauss ι) * (∫ x, g x * x i ∂stdGauss ι)| ≤
      2 * ρ ^ 2 *
        Real.sqrt (∫ x, (f x - ∫ y, f y ∂stdGauss ι) ^ 2 ∂stdGauss ι -
          ∑ i, (∫ x, f x * x i ∂stdGauss ι) ^ 2) *
        Real.sqrt (∫ x, (g x - ∫ y, g y ∂stdGauss ι) ^ 2 ∂stdGauss ι -
          ∑ i, (∫ x, g x * x i ∂stdGauss ι) ^ 2)

/-- **Bessel for the first chaos**: `|c_f|² ≤ Var f`. -/
def Chaos1Bessel : Prop :=
  ∀ (ι : Type) [Fintype ι] (f : (ι → ℝ) → ℝ), BM f →
    ∑ i, (∫ x, f x * x i ∂stdGauss ι) ^ 2 ≤ ∫ x, (f x - ∫ y, f y ∂stdGauss ι) ^ 2 ∂stdGauss ι

/-- **The first chaos is all of the part of order `c²`**: for bounded measurable `h` there is `K`
with `E(T_c h)² − (E h)² − c²·|c_h|² ≤ K c⁴` for `0 ≤ c ≤ 1/2`. -/
def ChaosLimit : Prop :=
  ∀ (ι : Type) [Fintype ι] (h : (ι → ℝ) → ℝ), BM h →
    ∃ K : ℝ, ∀ c : ℝ, 0 ≤ c → c ≤ 1 / 2 →
      Nou c h - (∫ x, h x ∂stdGauss ι) ^ 2 - c ^ 2 * ∑ i, (∫ x, h x * x i ∂stdGauss ι) ^ 2 ≤
        K * c ^ 4

/-! ## §3 Interface statements: the quadratic split -/

/-- On the unit sphere, `W = mixT b0 c` is the read centre plus the unread field. -/
def EvalT : Prop :=
  ∀ (N n d : ℕ) (hd : 2 ≤ d) (b0 c : CoefIdx N n d → ℝ) (u : Fin N → ℝ), dot u u = 1 →
    bwEval (mixT hd b0 c) u =
      bwEval (mixW (addT hd b0) 0) u + bwEval (mixW 0 (c - trPart hd c)) u

/-- `|ρ′(t)| ≤ 1` on `[−1, 1]`. -/
def RhoTBounds : Prop :=
  ∀ (N d : ℕ) (t : ℝ), 2 ≤ N → 2 ≤ d → |t| ≤ 1 → |rhoT N d t| ≤ 1

/-- **The pair distribution of the unread field** `R′(u) = Q(u) + Σ_{j ≥ 3} W_j(u)`: for unit
vectors `u, u′`, the pair `(R′(u), R′(u′))` is `(τ′ X, τ′(ρ′ X + √(1−ρ′²) Z))` in distribution,
`ρ′ = rhoT N d (u·u′)`. -/
def PairLawT : Prop :=
  ∀ (N n d : ℕ) (hd : 2 ≤ d) (σ : ℝ) (u u' : Fin N → ℝ), 2 ≤ N → dot u u = 1 → dot u' u' = 1 →
    (bwGauss N n d σ).map
        (fun c => (bwEval (mixW 0 (c - trPart hd c)) u, bwEval (mixW 0 (c - trPart hd c)) u')) =
      ((stdGauss (Fin n)).prod (stdGauss (Fin n))).map
        (fun p => (tauT N d σ • p.1,
          tauT N d σ • (rhoT N d (dot u u') • p.1 + sC (rhoT N d (dot u u')) • p.2)))

/-- **The read part and the unread part are independent Gaussian parts**: if `b0` and `c` are
independent with the Gaussian version, then `mixT hd b0 c` has the Gaussian version. -/
def MixLawT : Prop :=
  ∀ (N n d : ℕ) (hd : 2 ≤ d) (σ : ℝ), 1 ≤ N →
    ((bwGauss N n d σ).prod (bwGauss N n d σ)).map (fun p => mixT hd p.1 p.2) = bwGauss N n d σ

/-- Measurability of the maps of the split. -/
def MeasT : Prop :=
  ∀ (N n d : ℕ) (hd : 2 ≤ d),
    Measurable (fun W : CoefIdx N n d → ℝ => t2 hd W) ∧
    Measurable (fun W : CoefIdx N n d → ℝ => trPart hd W) ∧
    Measurable (fun W : CoefIdx N n d → ℝ => addT hd W) ∧
    Measurable (fun W : CoefIdx N n d → ℝ => reflT hd W) ∧
    Measurable (fun p : (CoefIdx N n d → ℝ) × (CoefIdx N n d → ℝ) => mixT hd p.1 p.2)

/-- **The reflection** `t₂ ↦ −t₂` is an involution, it keeps the Bombieri–Weyl norm, the Gaussian
version and the sphere version, it keeps every coefficient outside the diagonal quadratic ones,
it reverses the trace vector, and it moves `W(u)` by `−2 t₂` on the unit sphere. -/
def ReflT : Prop :=
  ∀ (N n d : ℕ) (hd : 2 ≤ d), 1 ≤ N →
    (∀ W : CoefIdx N n d → ℝ, reflT hd (reflT hd W) = W) ∧
    (∀ W : CoefIdx N n d → ℝ, bwNormSq (reflT hd W) = bwNormSq W) ∧
    (∀ σ : ℝ, (bwGauss N n d σ).map (reflT hd) = bwGauss N n d σ) ∧
    (bwSphere N n d).map (reflT hd) = bwSphere N n d ∧
    (∀ (W : CoefIdx N n d → ℝ) (p : CoefIdx N n d), (¬ ∃ i, p.2 = sqMono N d hd i) →
      reflT hd W p = W p) ∧
    (∀ (W : CoefIdx N n d → ℝ), t2 hd (reflT hd W) = -t2 hd W) ∧
    (∀ (W : CoefIdx N n d → ℝ) (u : Fin N → ℝ), dot u u = 1 →
      bwEval (reflT hd W) u = bwEval W u - (2 : ℝ) • t2 hd W)

/-! ## §4 Interface statements: the zonal kernel on the sphere -/

/-- The centred quadratic kernel `t² − 1/N` has the largest eigenvalue `2/(N(N+2))`. -/
def K2Zero : Prop :=
  ∀ (N : ℕ), 2 ≤ N → ∀ c : (Fin N → ℝ) → ℝ, BM c →
    ∫ u, ∫ u', (dot u u' ^ 2 - 1 / (N : ℝ)) * (c u * c u') ∂uniformSphere N ∂uniformSphere N ≤
      2 / ((N : ℝ) * ((N : ℝ) + 2)) * ∫ u, c u ^ 2 ∂uniformSphere N

/-- The cubic kernel `t³`: quadratic form at most `2/(N(N+2)) + 1/N²`. -/
def K3Bound : Prop :=
  ∀ (N : ℕ), 2 ≤ N → ∀ c : (Fin N → ℝ) → ℝ, BM c →
    ∫ u, ∫ u', dot u u' ^ 3 * (c u * c u') ∂uniformSphere N ∂uniformSphere N ≤
      (2 / ((N : ℝ) * ((N : ℝ) + 2)) + 1 / (N : ℝ) ^ 2) * ∫ u, c u ^ 2 ∂uniformSphere N

/-- The quartic kernel `t⁴` on functions of mean zero: quadratic form at most `1/(N(N+2))`. -/
def K4Mean : Prop :=
  ∀ (N : ℕ), 8192 ≤ N → ∀ c : (Fin N → ℝ) → ℝ, BM c → ∫ u, c u ∂uniformSphere N = 0 →
    ∫ u, ∫ u', dot u u' ^ 4 * (c u * c u') ∂uniformSphere N ∂uniformSphere N ≤
      1 / ((N : ℝ) * ((N : ℝ) + 2)) * ∫ u, c u ^ 2 ∂uniformSphere N

/-- **The first-chaos operator**: the zonal kernel `ρ′(u·u′)` on `L²` of the sphere has its
quadratic form at most `lamT`. -/
def KernelT : Prop :=
  ∀ (N d : ℕ), (d = 6 ∨ d = 8) → 8192 ≤ N → ∀ c : (Fin N → ℝ) → ℝ, BM c →
    ∫ u, ∫ u', rhoT N d (dot u u') * (c u * c u') ∂uniformSphere N ∂uniformSphere N ≤
      lamT N d * ∫ u, c u ^ 2 ∂uniformSphere N

/-- **The higher chaos**: `2·E_{u′} ρ′(u·u′)² ≤ lamT` for every unit `u`. -/
def Rho2T : Prop :=
  ∀ (N d : ℕ), (d = 6 ∨ d = 8) → 8192 ≤ N → ∀ u : Fin N → ℝ, dot u u = 1 →
    2 * ∫ u', rhoT N d (dot u u') ^ 2 ∂uniformSphere N ≤ lamT N d

/-- **Numeric bounds** of `λ′` (paper) and of the Lean factor, `N = 2n`, `n ≥ 4096`. -/
def LamNum : Prop :=
  ∀ n : ℕ, 4096 ≤ n →
    (0 ≤ lamS (2 * n) 6 ∧ lamS (2 * n) 6 ≤ lamT (2 * n) 6 ∧
      lamS (2 * n) 6 ≤ (1501 / 10000) / (n : ℝ) ^ 2 ∧ lamT (2 * n) 6 ≤ (154 / 1000) / (n : ℝ) ^ 2) ∧
    (0 ≤ lamS (2 * n) 8 ∧ lamS (2 * n) 8 ≤ lamT (2 * n) 8 ∧
      lamS (2 * n) 8 ≤ (1073 / 10000) / (n : ℝ) ^ 2 ∧
      lamT (2 * n) 8 ≤ (1101 / 10000) / (n : ℝ) ^ 2)

end BstLean.Part112
