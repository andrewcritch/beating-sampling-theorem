theorem exactTableMoments_of_N {c : Ret 12012} (hw : WINDOW (paperDesignP 12012) c)
    (hθ : BstLean.Part280.m2Guard 12012 c) (hc : c ∈ BstLean.Part280.sharpTableN 12012)
    (K : Set (Ix 12012)) : ExactTableMoments c K := by
  have h := hc (BstLean.Part280.tightG_of_window (by norm_num) c hw hθ)
  obtain ⟨MF, bF⟩ := bdd_exF (by norm_num) c
  obtain ⟨MW, bW⟩ := bdd_exW (by norm_num) c
  have hF := intOn_of_bdd ((measurable_exF c).pow_const 8) (bdd_pow bF 8) Set.univ
  have hE := intOn_of_bdd ((measurable_exW c).pow_const 8) (bdd_pow bW 8) Set.univ
  rw [integrableOn_univ] at hF hE
  refine ⟨?_, ?_⟩
  · exact (setIntegral_le_integral hF
      (Filter.Eventually.of_forall fun a => by positivity)).trans h.1
  · exact (setIntegral_le_integral hE
      (Filter.Eventually.of_forall fun a => by positivity)).trans h.2

theorem sharp_hq_passes {c : Ret 12012} (hw : WINDOW (paperDesignP 12012) c)
    (ha : c ∈ BstLean.Part280.Gen.Row12012.analyticBase) (hX : ∀ K, ExactTableMoments c K) :
    BstLean.Part241.PassInputs c (BstLean.Part280.Gen.Row12012.hqSplit c) BstLean.Part280.Gen.Row12012.chi BstLean.Part280.Gen.Row12012.biasFloor BstLean.Part280.Gen.Row12012.epsilon
      BstLean.Part280.Gen.Row12012.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12012.locationNorm BstLean.Part280.Gen.Row12012.varianceNorm := by
  have he : 0 < eR c := by linarith [(BstLean.Part280.Gen.Row12012.centre_energy_range hw ha).1]
  have hc := BstLean.Part280.Gen.Row12012.analyticBaseCertificate.pass_fields ha
  have hK : MeasurableSet (keptIx (paperDesignP 12012) c (BstLean.Part280.Gen.Row12012.hqSplit c)) :=
    measurableSet_keptSet _ (BstLean.Part280.Gen.Row12012.hqSplit c).mgood (measurableSet_bulkIx _ _) _
  have hsub : keptIx (paperDesignP 12012) c (BstLean.Part280.Gen.Row12012.hqSplit c) ⊆ bulkIx (paperDesignP 12012) c :=
    fun _ h => h.1
  have hfirst : A1 c ∈ BstLean.Part153.Eop 12012 := hc.1.1.2 hw.2.1
  have hsecond : c ∈ BstLean.Part164.Eop2 12012 := hc.1.2
  have htab := stored_table_moments c hw hfirst hsecond hK hsub (hX _)
  have hw8 : sharpAw ^ 8 ≤ BstLean.Part280.Gen.Row12012.energyError ^ 8 :=
    pow_le_pow_left₀ (by norm_num [sharpAw]) (by norm_num [sharpAw, BstLean.Part280.Gen.Row12012.energyError]) 8
  have hf8 : sharpAf ^ 8 ≤ BstLean.Part280.Gen.Row12012.locationError ^ 8 :=
    pow_le_pow_left₀ (by norm_num [sharpAf]) (by norm_num [sharpAf, BstLean.Part280.Gen.Row12012.locationError]) 8
  have hpm := BstLean.Part280.Gen.Row12012.pass_moments_of_events c hw he hc _ (htab.1.trans hw8) (htab.2.trans hf8)
  have hm : PaperMoments c (keptIx (paperDesignP 12012) c (BstLean.Part280.Gen.Row12012.hqSplit c))
      BstLean.Part280.Gen.Row12012.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12012.locationNorm BstLean.Part280.Gen.Row12012.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
  exact passInputs_of_paperMoments (by norm_num) c BstLean.Part280.Gen.Row12012.eta_pos BstLean.Part280.Gen.Row12012.eta_lt_one
    (sqrt_nonneg _) he BstLean.Part280.Gen.Row12012.bias_floor_ge (by norm_num [BstLean.Part280.Gen.Row12012.epsilon]) BstLean.Part280.Gen.Row12012.bias_threshold_pos
    (by norm_num [sharpAw]) (by norm_num [sharpAf]) (by norm_num [BstLean.Part280.Gen.Row12012.locationNorm])
    (by norm_num [BstLean.Part280.Gen.Row12012.varianceNorm]) BstLean.Part280.Gen.Row12012.row_split_floor.le
    (BstLean.Part280.Gen.Row12012.pass_centre_of_events c hc) hm

noncomputable def sharpRootInputs {c : Ret 12012} (t : ℝ) (hw : WINDOW (paperDesignP 12012) c)
    (ha : c ∈ BstLean.Part280.Gen.Row12012.analyticBase) (hX : ∀ K, ExactTableMoments c K)
    (hp : c ∈ BstLean.Part252.positiveOutputEvent (paperCentres 12012))
    (hm : BstLean.Part280.Gen.Row12012.LowResidualMass c) : BstLean.Part243.RootInputs 12012 t c rootTarget where
