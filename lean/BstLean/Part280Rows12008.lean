    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12012) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12012).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12012) (FirstMatrix 12012))
    (h2 : c ∈ BstLean.Part164.Eop2 12012) (a : BstLean.Part161.Ix 12012) :
    |VR c a| ≤ varianceMax := by
