  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12012) c (rowSplit c wl ws),
    ((12012 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12012 ≤ energyError ^ 8
