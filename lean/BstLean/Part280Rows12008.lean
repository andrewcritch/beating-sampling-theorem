  have hs : √(2 / (12012 : ℝ)) ≤ (12903494353 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12012 : ℝ) ≤ (109599271 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12012 : ℝ) + 2 * √12012 ≤ (6115599271 / 500000) := by linarith
