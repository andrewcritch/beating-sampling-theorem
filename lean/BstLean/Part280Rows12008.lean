  removal : ∫ a, removed (stdGauss (Fin (12012 - 1)))
    (rowSplit c wl ws).good a ∂muI 12012 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12012) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12012 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12012) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
