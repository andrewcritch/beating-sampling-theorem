  intro c τ _
  change (nuA n).real {a | a.1 ∈ (Eop n)ᶜ} ≤ _
  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12010) (hc : A1 c ∈ Eop 12010) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12010 : ℝ)) ≤ (100816943 / 7812500000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12010 : ℝ) ≤ (54795073 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12010 : ℝ) + 2 * √12010 ≤ (3057295073 / 250000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12010) (hc : c ∈ BstLean.Part164.Eop2 12010) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12010 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12010) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12010 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12010) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12010).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12010) (FirstMatrix 12010))
    (h2 : c ∈ BstLean.Part164.Eop2 12010) (a : BstLean.Part161.Ix 12010) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
