theorem variance_of_matrix_events (c : Ret 11890) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11890).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11890) (FirstMatrix 11890))
