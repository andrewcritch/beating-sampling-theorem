  have hs : √(2 / (11888 : ℝ)) ≤ (12970615927 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(11888 : ℝ) ≤ (54516053 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (11888 : ℝ) + 2 * √11888 ≤ (3026516053 / 250000) := by linarith
