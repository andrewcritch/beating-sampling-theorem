    (hw : WINDOW (paperDesignP 11892) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 11892).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 11892) c M H xi)
    (hE : centreEnergy (paperDesignP 11892) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (11892 : ℝ))))
    (hprice : massBound 11892 M H xi E u mixtureFloor ≤ 11892 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (11892 - 1))).real
      {v | sgA (paperDesignP 11892) c a v < √(2 / (11892 : ℝ) * mixtureFloor)}
        ∂muI 11892 ≤ lowMassBudget := by
  have hb : 0 < normSq ((paperDesignP 11892).bA c.1 c.2.1.1) := by
    change 0 < normSq (bR c)
    unfold eR at he
    exact (div_pos_iff.mp he).elim (fun h => h.1) (fun h => by norm_num at h)
  have hm := sharp_residual_mass (by norm_num) (paperDesignP 11892) c hw.2.1 hb hb0
