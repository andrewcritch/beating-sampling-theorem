theorem variance_of_matrix_events (c : Ret 11888) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11888).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11888) (FirstMatrix 11888))
    (h2 : c ∈ BstLean.Part164.Eop2 11888) (a : BstLean.Part161.Ix 11888) :
