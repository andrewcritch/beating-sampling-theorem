import BstLean.Part266Parameters
import BstLean.Part266Shard6Step6

/-! Actual root coverage for one prescribed 25-row shard. -/
namespace BstLean.Part266
open Set
theorem root_coverage_shard6 : ∀ n ∈ Icc (12500 : ℕ) 12524,
    ∃ a : BstLean.Part192.AgentParameters,
      Nonempty (BstLean.Part262.ActualRootCertificate n a.root) := by
  intro n hn
  obtain ⟨hlo,hhi⟩ := hn
  interval_cases n
  · exact ⟨agent12500, ⟨actualCertificate12500⟩⟩
  · exact ⟨agent12501, ⟨actualCertificate12501⟩⟩
  · exact ⟨agent12502, ⟨actualCertificate12502⟩⟩
  · exact ⟨agent12503, ⟨actualCertificate12503⟩⟩
