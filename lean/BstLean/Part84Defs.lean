import BstLean.Part81Main
import BstLean.Part71Final
import BstLean.Part62Kappa5

/-!
# Part 84, frozen definitions: Theorem 4 for uniform `D` at every degree pair, by conditioning on
the constant column, with a threshold of single-exponential size

Role: `delegations/statements/p84-spec.md`. This file holds definitions and `Prop`-valued interface
statements only. Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

Conventions. `n` is the input dimension and the width, `d = d_M` is the map degree, `k = d_f` is
the degree of `f`. `JJ n d`, `WIdx n d`, `pf`, `kap`, `eD` are Part 81's objects: the non-constant
monomials, the index of the non-constant part `W` of the coefficient matrix, the features
`p_q(x)`, the kernel `κ(x,y) = Σ_q p_q(x) p_q(y)`, and `e_d = Σ_{j=1}^d 1/j!`.

**The Gaussian model given the constant column.** `P` is a polynomial on `ℝⁿ` (it plays
`z ↦ f(u + σ z)`), `lam` is a scale near `1`, `W` is standard Gaussian on `WIdx n d`:
`FW P lam W x = P(lam · W p(x))`, `BW = E_x FW`, `VW = Var_x FW`, `g0P d P = E P(√e_d · g)`
(`g` standard Gaussian on `ℝⁿ`), `errW = BW − g0P`.

**Tensor side.** For a symmetric family `A` (`fvA K A = P`): `hmean K s A = (P_s A)_0 = E P(√s g)`,
`en K s A = Σ_{c=1}^K c! s^c ‖(P_s A)_c‖² = Var P(√s g)`.
-/

namespace BstLean.Part84

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part36 (CoefIdxD DD unitOfD mapMD)
open BstLean.Part41 (Mono phiM colM varU frob IsSymmT Tens)
open BstLean.Part53 (heatA tinner fvA p4 unitF53 radF53)
open BstLean.Part59 (polyEval TopNZ g0Q BP varP shiftedPoly59x)
open BstLean.Part78 (zv)
open BstLean.Part81 (JJ WIdx pf kap eD FeatOp)

variable {n d : ℕ}

/-! ## §1 The Gaussian model given the constant column -/

/-- `F_x(W) = P(lam · W p(x))`. -/
noncomputable def FW (P : MvPolynomial (Fin n) ℝ) (lam : ℝ) (W : WIdx n d → ℝ)
    (x : Fin n → ℝ) : ℝ :=
  MvPolynomial.eval (fun i => lam * zv W (pf x) i) P

/-- `B(W) = E_x F_x(W)`. -/
noncomputable def BW (P : MvPolynomial (Fin n) ℝ) (lam : ℝ) (W : WIdx n d → ℝ) : ℝ :=
  ∫ x, FW P lam W x ∂uniformSphere n

/-- `V(W) = Var_x F_x(W)`. -/
noncomputable def VW (P : MvPolynomial (Fin n) ℝ) (lam : ℝ) (W : WIdx n d → ℝ) : ℝ :=
  varU (uniformSphere n) (FW P lam W)

/-- The value of `g₀`: `E P(√e_d · g)`, `g` standard Gaussian on `ℝⁿ`. -/
noncomputable def g0P (d : ℕ) (P : MvPolynomial (Fin n) ℝ) : ℝ :=
  ∫ g, MvPolynomial.eval (fun i => Real.sqrt (eD d) * g i) P ∂stdGauss (Fin n)

/-- The error `B − g₀` in the Gaussian model. -/
noncomputable def errW (P : MvPolynomial (Fin n) ℝ) (lam : ℝ) (W : WIdx n d → ℝ) : ℝ :=
  BW P lam W - g0P d P

/-! ## §2 Tensor side -/

/-- `(P_s A)_0`, a number. -/
noncomputable def hmean (K : ℕ) (s : ℝ) (A : Tens n) : ℝ := heatA K s A 0 (fun i => i.elim0)

/-- `Σ_{c=1}^K c! s^c ‖(P_s A)_c‖²`. -/
noncomputable def en (K : ℕ) (s : ℝ) (A : Tens n) : ℝ :=
  ∑ c ∈ Finset.Icc 1 K, (c.factorial : ℝ) * s ^ c * frob (heatA K s A c)

/-- The symmetric family `A` represents `P` in the Gaussian model: the value of `g₀`, the mean of
`F_x`, and the two-point identity (Lemma W on the non-constant columns). -/
def Rep84 (n d K : ℕ) (P : MvPolynomial (Fin n) ℝ) (A : Tens n) : Prop :=
  (∀ j, IsSymmT (A j)) ∧
  g0P d P = hmean K (eD d) A ∧
  (∀ (lam : ℝ) (x : Fin n → ℝ),
    Integrable (fun W : WIdx n d → ℝ => FW P lam W x) (stdGauss (WIdx n d)) ∧
    ∫ W : WIdx n d → ℝ, FW P lam W x ∂stdGauss (WIdx n d) = hmean K (lam ^ 2 * kap d x x) A) ∧
  (∀ (lam : ℝ) (x y : Fin n → ℝ),
    Integrable (fun W : WIdx n d → ℝ => FW P lam W x * FW P lam W y) (stdGauss (WIdx n d)) ∧
    ∫ W : WIdx n d → ℝ, FW P lam W x * FW P lam W y ∂stdGauss (WIdx n d) =
      ∑ c ∈ Finset.range (K + 1), (c.factorial : ℝ) * lam ^ (2 * c) *
        tinner (heatA K (lam ^ 2 * kap d x x) A c) (heatA K (lam ^ 2 * kap d y y) A c) *
        kap d x y ^ c)

/-- **Representation**: every polynomial of degree `≤ K` has a representing symmetric family. -/
def RepIface (n d : ℕ) : Prop :=
  ∀ (K : ℕ) (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ K → ∃ A : Tens n, Rep84 n d K P A

/-- **Scale comparison** (tensor form). With `t = |s' − s| √n / s₀`, `s, s' ≥ s₀ > 0`:
`(m(s') − m(s))² ≤ t² (1 + K t)^K en(s)` and `en(s') ≤ (1 + K t)^{2K} en(s)`. -/
def ScaleIface (n K : ℕ) : Prop :=
  ∀ (A : Tens n), (∀ j, IsSymmT (A j)) → ∀ s s' s0 : ℝ, 0 < s0 → s0 ≤ s → s0 ≤ s' →
    (hmean K s' A - hmean K s A) ^ 2 ≤
      (|s' - s| * Real.sqrt n / s0) ^ 2 *
        (1 + K * (|s' - s| * Real.sqrt n / s0)) ^ K * en K s A ∧
    en K s' A ≤ (1 + K * (|s' - s| * Real.sqrt n / s0)) ^ (2 * K) * en K s A

/-! ## §3 Interfaces of the Gaussian model -/

/-- **Fubini facts.** -/
def FubIface (n d : ℕ) : Prop :=
  ∀ (P : MvPolynomial (Fin n) ℝ) (lam : ℝ),
    (∀ W : WIdx n d → ℝ, Integrable (FW P lam W) (uniformSphere n)) ∧
    Integrable (fun W : WIdx n d → ℝ => BW P lam W) (stdGauss (WIdx n d)) ∧
    ∫ W : WIdx n d → ℝ, BW P lam W ∂stdGauss (WIdx n d) =
      ∫ x, (∫ W : WIdx n d → ℝ, FW P lam W x ∂stdGauss (WIdx n d)) ∂uniformSphere n

/-- **Decorrelation**: `Var_W (E_x F_x) ≤ (CF / (e_d n)) E_x Var_W F_x`, for every polynomial. -/
def DecorIface (n d : ℕ) (CF : ℝ) : Prop :=
  ∀ (K : ℕ) (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ K → ∀ lam : ℝ,
    Integrable (fun W : WIdx n d → ℝ =>
      (BW P lam W - ∫ W' : WIdx n d → ℝ, BW P lam W' ∂stdGauss (WIdx n d)) ^ 2)
      (stdGauss (WIdx n d)) ∧
    ∫ W : WIdx n d → ℝ,
        (BW P lam W - ∫ W' : WIdx n d → ℝ, BW P lam W' ∂stdGauss (WIdx n d)) ^ 2
        ∂stdGauss (WIdx n d) ≤
      CF / (eD d * n) *
        ∫ x, (∫ W : WIdx n d → ℝ,
          (FW P lam W x - ∫ W' : WIdx n d → ℝ, FW P lam W' x ∂stdGauss (WIdx n d)) ^ 2
          ∂stdGauss (WIdx n d)) ∂uniformSphere n

/-- **Sphere moments** of `y = a n p₄(x)`, `p₄ = Σ x_i⁴`. -/
def MomIface (n : ℕ) : Prop :=
  ∀ (a : ℝ), 0 ≤ a → ∀ j m : ℕ,
    Integrable (fun x : Fin n → ℝ => (a * n * p4 x) ^ j * (1 + a * n * p4 x) ^ m)
      (uniformSphere n) ∧
    (4 * ((m : ℝ) + 1) ^ 2 * a ≤ 1 / 2 →
      ∫ x : Fin n → ℝ, (1 + a * n * p4 x) ^ m ∂uniformSphere n ≤ 1 + 8 * ((m : ℝ) + 1) ^ 2 * a) ∧
    (16 * a * m * ((j : ℝ) + 1) * ((j : ℝ) + m + 1) ≤ 1 / 2 →
      ∫ x : Fin n → ℝ, (a * n * p4 x) ^ j * (1 + a * n * p4 x) ^ m ∂uniformSphere n ≤
        2 * a ^ j * ((4 * j - 1).doubleFactorial : ℝ))

/-- **The scale defect**: for `|lam² − 1| ≤ 1/n` and `x` on the sphere,
`lam² κ(x,x) ≥ 9/10` and `|lam² κ(x,x) − e_d| ≤ (2d + 2) p₄(x)`. -/
def DeltaIface (n d : ℕ) : Prop :=
  ∀ lam : ℝ, |lam ^ 2 - 1| ≤ 1 / (n : ℝ) → ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 →
    9 / 10 ≤ lam ^ 2 * kap d x x ∧ |lam ^ 2 * kap d x x - eD d| ≤ (2 * (d : ℝ) + 2) * p4 x

/-- **Fourth-moment constant** at degree `h`: `E P⁴ ≤ C (E P²)²`. -/
def Fourth84 (h : ℕ) (C : ℝ) : Prop :=
  ∀ (ι : Type) [Fintype ι] (P : MvPolynomial ι ℝ), P.totalDegree ≤ h →
    ∫ z, (MvPolynomial.eval z P) ^ 4 ∂stdGauss ι ≤
      C * (∫ z, (MvPolynomial.eval z P) ^ 2 ∂stdGauss ι) ^ 2

/-- **`F_x` and `B` are polynomials in `W`** of degree `≤ K`. -/
def PolyRep (n d : ℕ) : Prop :=
  ∀ (K : ℕ) (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ K → ∀ lam : ℝ,
    (∀ x : Fin n → ℝ, ∃ Q : MvPolynomial (WIdx n d) ℝ, Q.totalDegree ≤ K ∧
      ∀ W : WIdx n d → ℝ, MvPolynomial.eval W Q = FW P lam W x) ∧
    (∃ Q : MvPolynomial (WIdx n d) ℝ, Q.totalDegree ≤ K ∧
      ∀ W : WIdx n d → ℝ, MvPolynomial.eval W Q = BW P lam W)

/-- **`B` and `V` are polynomials in the scale** `lam`, of degrees `≤ K` and `≤ 2K`. -/
def RadPoly (n d : ℕ) : Prop :=
  ∀ (K : ℕ) (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ K → ∀ W : WIdx n d → ℝ,
    (∃ q : Polynomial ℝ, q.natDegree ≤ K ∧ ∀ lam : ℝ, q.eval lam = BW P lam W) ∧
    (∃ q : Polynomial ℝ, q.natDegree ≤ 2 * K ∧ ∀ lam : ℝ, q.eval lam = VW P lam W)

/-- **The Gaussian model given the constant column**: a level `L ≥ 0` and a centre `Vb` with
`Vb ≥ (1 − efl) L`, `E errW² ≤ (c1/n) L`, `E (VW − Vb)² ≤ (cV/n) L²`. -/
def GaussModel (n d k : ℕ) (c1 cV efl : ℝ) : Prop :=
  ∀ (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ k → ∀ lam : ℝ, |lam ^ 2 - 1| ≤ 1 / (n : ℝ) →
    ∃ L Vb : ℝ, 0 ≤ L ∧ (1 - efl) * L ≤ Vb ∧
      Integrable (fun W : WIdx n d → ℝ => errW P lam W ^ 2) (stdGauss (WIdx n d)) ∧
      Integrable (fun W : WIdx n d → ℝ => (VW P lam W - Vb) ^ 2) (stdGauss (WIdx n d)) ∧
      ∫ W : WIdx n d → ℝ, errW P lam W ^ 2 ∂stdGauss (WIdx n d) ≤ c1 / (n : ℝ) * L ∧
      ∫ W : WIdx n d → ℝ, (VW P lam W - Vb) ^ 2 ∂stdGauss (WIdx n d) ≤ cV / (n : ℝ) * L ^ 2

/-- `a = (10/9) k (2d+2) / √n`: the moment parameter of the Gaussian model. -/
noncomputable def aK (n d k : ℕ) : ℝ := 10 / 9 * k * (2 * (d : ℝ) + 2) / Real.sqrt n

/-- The error constant `c₁ = 260 (2d+2)² + 2 CF`. -/
noncomputable def c1F (d : ℕ) (CF : ℝ) : ℝ := 260 * (2 * (d : ℝ) + 2) ^ 2 + 2 * CF

/-! ## §4 The transfer to the coefficient sphere -/

/-- The dimension of the non-constant part, as a real number. -/
noncomputable def DW (n d : ℕ) : ℝ := (Fintype.card (WIdx n d) : ℝ)

/-- **The sphere step** (Remez on the radius of `W`, then Markov and Chebyshev): for a fixed
polynomial and a fixed scale, the failure probability over the direction of `W`. -/
def RemezStep (n d k : ℕ) (c1 cV efl : ℝ) : Prop :=
  ∀ (P : MvPolynomial (Fin n) ℝ), P.totalDegree ≤ k → ∀ lam : ℝ, |lam ^ 2 - 1| ≤ 1 / (n : ℝ) →
    ∀ ε κ : ℝ, 0 < ε → 0 < κ → efl + κ < 1 →
      stdGauss (WIdx n d) {W | ε ^ 2 * VW P lam (Real.sqrt (DW n d) • unitF53 W) <
          errW P lam (Real.sqrt (DW n d) • unitF53 W) ^ 2} ≤
        ENNReal.ofReal (5 / 2 * ((k : ℝ) + 1) ^ 2 * c1 / (n * (ε ^ 2 * κ)) +
          5 / 2 * (2 * (k : ℝ) + 1) ^ 2 * cV / (n * (1 - efl - κ) ^ 2))

/-- The polynomial `z ↦ f(u/r + z/√𝒟)`, `r² = ‖u‖² + ρ²`. -/
noncomputable def Pu (n d k : ℕ) (c : Mono n k → ℝ) (u : Fin n → ℝ) (ρ : ℝ) :
    MvPolynomial (Fin n) ℝ :=
  shiftedPoly59x c (fun i => u i / Real.sqrt (∑ j, u j ^ 2 + ρ ^ 2)) (1 / Real.sqrt (DD n d))

/-- The scale `λ₀ = √𝒟 ρ / (r √D_W)`, `r² = ‖u‖² + ρ²`. -/
noncomputable def lam0 (n d : ℕ) (u : Fin n → ℝ) (ρ : ℝ) : ℝ :=
  Real.sqrt (DD n d) * ρ / (Real.sqrt (∑ j, u j ^ 2 + ρ ^ 2) * Real.sqrt (DW n d))

/-- The failure set over the direction of `W`, for a constant column `u` and a radius `ρ`. -/
def badSet (n d k : ℕ) (ε : ℝ) (c : Mono n k → ℝ) (u : Fin n → ℝ) (ρ : ℝ) :
    Set (WIdx n d → ℝ) :=
  {W | ε ^ 2 * VW (Pu n d k c u ρ) (lam0 n d u ρ) (Real.sqrt (DW n d) • unitF53 W) <
    errW (Pu n d k c u ρ) (lam0 n d u ρ) (Real.sqrt (DW n d) • unitF53 W) ^ 2}

/-- The failure set of Theorem 4 on the coefficient sphere. -/
def SphereFail (n d k : ℕ) (ε : ℝ) (c : Mono n k → ℝ) : Set (CoefIdxD n d → ℝ) :=
  {Z | Z ≠ 0 ∧ ε ^ 2 * varP (uniformSphere n) k c (unitOfD Z) <
    (BP (uniformSphere n) k c (unitOfD Z) - g0Q n d k c (unitOfD Z)) ^ 2}

/-- **Polar reduction**: the failure probability is at most the average, over the constant column
`u` and an independent radius `ρ = ‖W'‖`, of the failure probability over the direction of `W`. -/
def PolarRed (n d k : ℕ) : Prop :=
  ∀ (ε : ℝ) (c : Mono n k → ℝ),
    stdGauss (CoefIdxD n d) (SphereFail n d k ε c) ≤
      ∫⁻ u : Fin n → ℝ, ∫⁻ W' : WIdx n d → ℝ,
        stdGauss (WIdx n d) (badSet n d k ε c u (radF53 W')) ∂stdGauss (WIdx n d)
        ∂stdGauss (Fin n)

/-- **Scale tail**: `P(|λ₀² − 1| > 1/n) ≤ C/n`, in iterated-integral form. -/
def TailIface (n d : ℕ) (C : ℝ) : Prop :=
  ∫⁻ u : Fin n → ℝ, ∫⁻ W' : WIdx n d → ℝ,
      Set.indicator {p : (Fin n → ℝ) × (WIdx n d → ℝ) |
        1 / (n : ℝ) < |lam0 n d p.1 (radF53 p.2) ^ 2 - 1|} (fun _ => (1 : ℝ≥0∞)) (u, W')
      ∂stdGauss (WIdx n d) ∂stdGauss (Fin n) ≤ ENNReal.ofReal (C / n)

end BstLean.Part84
