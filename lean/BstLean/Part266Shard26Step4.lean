theorem table_second_layer_charge (c : Ret 13011) (P : Fin 4 → ℝ)
    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13011) (mA 13011) (tA 13011) ∂tableNodeMeasure c.1 ≤
