  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((86582371 / 250000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2430744721 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1451859 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((506155533 / 1000000000000))) := by
        gcongr
