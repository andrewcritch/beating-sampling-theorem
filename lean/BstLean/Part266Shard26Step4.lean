    (hw : BstLean.Part161.WINDOW (paperDesignP 13009) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13009 - 1))).real
      {v | sgA (paperDesignP 13009) c a v < rowSigma} ∂BstLean.Part161.muI 13009 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
