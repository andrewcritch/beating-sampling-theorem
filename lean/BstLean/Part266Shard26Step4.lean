    (hw : BstLean.Part161.WINDOW (paperDesignP 13002) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13002 - 1))).real
      {v | sgA (paperDesignP 13002) c a v < rowSigma} ∂BstLean.Part161.muI 13002 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
