def LowResidualMass (c : Ret 13016) : Prop :=
  ∫ a, (stdGauss (Fin (13016 - 1))).real
    {v | sgA (paperDesignP 13016) c a v < rowSigma} ∂muI 13016 ≤ lowMassBudget

