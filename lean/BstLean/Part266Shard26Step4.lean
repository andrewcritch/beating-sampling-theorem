def LowResidualMass (c : Ret 13003) : Prop :=
  ∫ a, (stdGauss (Fin (13003 - 1))).real
    {v | sgA (paperDesignP 13003) c a v < rowSigma} ∂muI 13003 ≤ lowMassBudget

