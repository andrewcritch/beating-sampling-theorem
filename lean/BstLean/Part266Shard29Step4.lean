    (gaussMat (mA 13082) 13082 (2 / (13082 : ℝ))).real {X | ∃ g < Js 13082,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13082 : ℝ)) ∨
