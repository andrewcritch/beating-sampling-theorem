  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((173683891 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((4817526121 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5789881 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((503099061 / 1000000000000))) := by
        gcongr
