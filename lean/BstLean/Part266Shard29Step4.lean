    (gaussMat (mA 13093) 13093 (2 / (13093 : ℝ))).real {X | ∃ g < Js 13093,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13093 : ℝ)) ∨
