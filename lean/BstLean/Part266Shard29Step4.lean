/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13078) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13078) c (rowSplit c wl ws),
    ((13078 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13078 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13078) c (rowSplit c wl ws),
    ((13078 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13078 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13078 - 1)))
    (rowSplit c wl ws).good a ∂muI 13078 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13078) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13078 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13078) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13078 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 13078) c (rowSplit c wl ws),
    hellG2 13078 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 13078 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 13078}
    (hw : WINDOW (paperDesignP 13078) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
