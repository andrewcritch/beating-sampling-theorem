theorem hq_root_price {c : Ret 13087} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 13087) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13087 - 1))).real
      {v | sgA (paperDesignP 13087) c a v < rowSigma} ∂BstLean.Part161.muI 13087 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
