    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (13084 - 1))).real
      {v | sgA (paperDesignP 13084) c a v < rowSigma} ∂BstLean.Part161.muI 13084 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
