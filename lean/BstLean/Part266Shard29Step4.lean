theorem hq_output_bounds {c : Ret 13087}
    (hw : WINDOW (paperDesignP 13087) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13087)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
