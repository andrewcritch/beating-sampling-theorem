  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((347472701 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2406555549 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5788113 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((251395801 / 500000000000))) := by
        gcongr
