def LowResidualMass (c : Ret 13097) : Prop :=
  ∫ a, (stdGauss (Fin (13097 - 1))).real
    {v | sgA (paperDesignP 13097) c a v < rowSigma} ∂muI 13097 ≤ lowMassBudget

