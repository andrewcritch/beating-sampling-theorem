      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5788997 / 1000000000)) ^ 2 * ((1003 / 1000) * ((31128101 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((347420233 / 1000000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2407658883 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5788997 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((125736321 / 250000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
