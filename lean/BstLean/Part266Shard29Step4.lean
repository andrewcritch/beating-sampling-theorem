    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 13080) (mA 13080) (tA 13080) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
