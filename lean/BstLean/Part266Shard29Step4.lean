theorem hq_output_bounds {c : Ret 13096}
    (hw : WINDOW (paperDesignP 13096) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 13096)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
