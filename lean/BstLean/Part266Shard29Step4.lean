/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 13092) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 13092) c (rowSplit c wl ws),
    ((13092 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 13092 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 13092) c (rowSplit c wl ws),
    ((13092 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 13092 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (13092 - 1)))
    (rowSplit c wl ws).good a ∂muI 13092 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 13092) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (13092 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 13092) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 13092 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 13092) c (rowSplit c wl ws),
    hellG2 13092 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 13092 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 13092}
    (hw : WINDOW (paperDesignP 13092) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
