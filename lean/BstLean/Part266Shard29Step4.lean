theorem node_trace_charge_row {wr : WRet 13092} (hw : windowW wr) :
    (gaussMat (mA 13092) 13092 (2 / (13092 : ℝ))).real {X | ∃ g < Js 13092,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (13092 : ℝ)) ∨
