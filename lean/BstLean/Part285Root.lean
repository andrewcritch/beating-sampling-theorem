open BstLean.Part241

theorem squaredPrice_band {n a : ℕ} {χ d ε vmax aw af H Cv AW AF : ℝ}
    (ha : 0 < a) (han : a ≤ n) (hχ : 0 ≤ χ) (hd : 0 < d) (hε : ε < 1)
    (he : 0 < ε - vmax / d) (hH : 0 ≤ H) (hCv : 0 ≤ Cv) (haw0 : 0 ≤ aw) (haw : aw ≤ AW)
    (haf0 : 0 ≤ af) (haf : af ≤ AF) :
    squaredPrice n χ d ε vmax aw af H Cv ≤ squaredPrice a χ d ε vmax AW AF H Cv := by
  have hx : (0 : ℝ) < a := by exact_mod_cast ha
  have hxn : (a : ℝ) ≤ n := by exact_mod_cast han
  have hn0 : (0 : ℝ) < n := lt_of_lt_of_le hx hxn
  have hAF0 : 0 ≤ AF := haf0.trans haf
  have hAW0 : 0 ≤ AW := haw0.trans haw
  have hsq : af ^ 2 ≤ AF ^ 2 := pow_le_pow_left₀ haf0 haf 2
  have hq : af ^ 2 / n ≤ AF ^ 2 / a := div_le_div₀ (sq_nonneg _) hsq hx hxn
  have h2H : 0 ≤ 2 * H := by linarith
  have h2 : 2 * H * af ≤ 2 * H * AF := mul_le_mul_of_nonneg_left haf h2H
  have h2' : 0 ≤ 2 * H * af := mul_nonneg h2H haf0
  have hqn : 0 ≤ af ^ 2 / n := div_nonneg (sq_nonneg _) hn0.le
  have hs0 : 0 ≤ scaleBound n d aw af H Cv := by
    unfold scaleBound
    exact div_nonneg (by linarith) hd.le
  have hs : scaleBound n d aw af H Cv ≤ scaleBound a d AW AF H Cv := by
    unfold scaleBound
    exact div_le_div_of_nonneg_right (by linarith) hd.le
  have hk1 : 0 ≤ χ / (2 * (2 - ε) * d) := div_nonneg hχ
    (mul_pos (mul_pos two_pos (by linarith)) hd).le
  have hk2 : 0 < 8 * (1 - ε) := by linarith
  have hreg : regularPrice n χ d ε aw af H Cv ≤ regularPrice a χ d ε AW AF H Cv := by
    unfold regularPrice
    apply div_le_div₀ _ _ hx hxn
    · exact add_nonneg (mul_nonneg hk1 (sq_nonneg _)) (div_nonneg (sq_nonneg _) hk2.le)
    · exact add_le_add (mul_le_mul_of_nonneg_left hsq hk1)
        (div_le_div_of_nonneg_right (pow_le_pow_left₀ hs0 hs 2) hk2.le)
  have hc1 : (0 : ℝ) < 99 / 100 * d := mul_pos (by norm_num) hd
  have hc2 : (0 : ℝ) < 1 / 100 * d := mul_pos (by norm_num) hd
  have hd1 : 0 < 99 / 100 * d * (a : ℝ) * (ε - vmax / d) := mul_pos (mul_pos hc1 hx) he
  have hd1' : 99 / 100 * d * (a : ℝ) * (ε - vmax / d) ≤ 99 / 100 * d * (n : ℝ) * (ε - vmax / d) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hxn hc1.le) he.le
  have hd2 : 0 < 1 / 100 * d * (a : ℝ) ^ 2 * (ε - vmax / d) :=
    mul_pos (mul_pos hc2 (pow_pos hx 2)) he
  have hd2' : 1 / 100 * d * (a : ℝ) ^ 2 * (ε - vmax / d) ≤
      1 / 100 * d * (n : ℝ) ^ 2 * (ε - vmax / d) :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hx.le hxn 2)
      hc2.le) he.le
  have hexc : exceptionalMass n d ε vmax aw af H ≤ exceptionalMass a d ε vmax AW AF H := by
    unfold exceptionalMass
    apply add_le_add
    · apply pow_le_pow_left₀ (div_nonneg (by linarith) (hd1.trans_le hd1').le)
      exact div_le_div₀ (by linarith) (by linarith) hd1 hd1'
    · apply pow_le_pow_left₀ (div_nonneg (sq_nonneg _) (hd2.trans_le hd2').le)
      exact div_le_div₀ (sq_nonneg _) hsq hd2 hd2'
  unfold squaredPrice
  linarith

