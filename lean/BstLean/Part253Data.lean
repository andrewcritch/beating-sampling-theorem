noncomputable def directionCap : ℝ := 0.0900455692642977
noncomputable def parallelCap : ℝ := 0.0347397722670536
noncomputable def energyCap : ℝ := 0.001718175627
noncomputable def massTable (_ : Fin 60) : ℝ := 0.011
noncomputable def radiusCutoff : ℝ := 0.00286

structure ScalarCertificate (i : Fin 60) : Prop where
  covariance_nonneg : 0 ≤ capTable i
  cutoff_pos : 0 < cutoffTable i
  cutoff_lt : cutoffTable i < (1 - radiusCutoff) ^ 2
  gap_pos : 0 < √((1 - radiusCutoff) ^ 2 - cutoffTable i) -
    (√(energyTable i) + √(parallelCap / 12225))
  mass_scalar : BstLean.Part222.massBoundOrder 12225 12 directionCap energyCap parallelCap
    (energyTable i) radiusCutoff (cutoffTable i) ≤ massTable i
  frame_scalar : (capTable i + centreTable (centreGroup i)) / cutoffTable i + massTable i ≤
    BstLean.Part249.optionBAgentFrame

end BstLean.Part253
