theorem local_le_fixed (j : Fin 43) : localCap j ≤ capTable (sourceIndex j) := by
  match j with
  | ⟨0,_⟩ => exact tableLe0
  | ⟨1,_⟩ => exact tableLe1
  | ⟨2,_⟩ => exact tableLe2
  | ⟨3,_⟩ => exact tableLe3
  | ⟨4,_⟩ => exact tableLe4
  | ⟨5,_⟩ => exact tableLe5
  | ⟨6,_⟩ => exact tableLe6
  | ⟨7,_⟩ => exact tableLe7
  | ⟨8,_⟩ => exact tableLe8
  | ⟨9,_⟩ => exact tableLe9
  | ⟨10,_⟩ => exact tableLe10
  | ⟨11,_⟩ => exact tableLe11
  | ⟨12,_⟩ => exact tableLe12
  | ⟨13,_⟩ => exact tableLe13
  | ⟨14,_⟩ => exact tableLe14
  | ⟨15,_⟩ => exact tableLe15
  | ⟨16,_⟩ => exact tableLe16
  | ⟨17,_⟩ => exact tableLe17
  | ⟨18,_⟩ => exact tableLe18
  | ⟨19,_⟩ => exact tableLe19
  | ⟨20,_⟩ => exact tableLe20
  | ⟨21,_⟩ => exact tableLe21
  | ⟨22,_⟩ => exact tableLe22
  | ⟨23,_⟩ => exact tableLe23
  | ⟨24,_⟩ => exact tableLe24
  | ⟨25,_⟩ => exact tableLe25
  | ⟨26,_⟩ => exact tableLe26
  | ⟨27,_⟩ => exact tableLe27
  | ⟨28,_⟩ => exact tableLe28
  | ⟨29,_⟩ => exact tableLe29
  | ⟨30,_⟩ => exact tableLe30
  | ⟨31,_⟩ => exact tableLe31
  | ⟨32,_⟩ => exact tableLe32
  | ⟨33,_⟩ => exact tableLe33
  | ⟨34,_⟩ => exact tableLe34
  | ⟨35,_⟩ => exact tableLe35
  | ⟨36,_⟩ => exact tableLe36
  | ⟨37,_⟩ => exact tableLe37
  | ⟨38,_⟩ => exact tableLe38
  | ⟨39,_⟩ => exact tableLe39
  | ⟨40,_⟩ => exact tableLe40
  | ⟨41,_⟩ => exact tableLe41
  | ⟨42,_⟩ => exact tableLe42
  | ⟨j+43,h⟩ => exact False.elim (by omega)

theorem needed_has_index (i : Fin 60) (hi : Needed i) :
    ∃ j : Fin 43, sourceIndex j = i := by
  refine ⟨⟨i.val-10,by unfold Needed at hi; omega⟩,?_⟩
  apply Fin.ext
  dsimp only [sourceIndex]
  have := hi.1
  omega

theorem localCapTable_le_capTable (i : Fin 60) (hi : Needed i) : localCapTable i ≤ capTable i := by
  obtain ⟨j,rfl⟩ := needed_has_index i hi
  rw [localCapTable_source]
  exact local_le_fixed j

theorem capTable_nonneg (i : Fin 60) (hi : Needed i) : 0 ≤ capTable i := by
  obtain ⟨j,rfl⟩ := needed_has_index i hi
  exact (grid j).2.2.trans (local_le_fixed j)

theorem selected_fallback_contract : LocalCovarianceOn (selected parameters payment) cell capTable := by
  intro i θ hn hi k he hτ hC hX v
  refine (localCov i θ hn hi k he hτ hC hX v).trans ?_
  apply mul_le_mul_of_nonneg_right _ (normSq_nonneg v)
  apply div_le_div_of_nonneg_right _ (by norm_num : (0 : ℝ) ≤ 12225)
  exact mul_le_mul_of_nonneg_right (localCapTable_le_capTable i hn) (by norm_num)

theorem local_envelope_on_cell (j : Fin 43) {θ : ℝ}
    (hi : θ ∈ BstLean.Part254.cell (sourceIndex j)) : envelope (parameters j) θ ≤ localCap j := by
  have hp := parameters_valid j
  have h0 : 0 ≤ θ := by linarith [(BstLean.Part254.cell_window hi).1]
  have hu : cellUpper (sourceIndex j) ≤ (528/1000 : ℝ) :=
    (min_le_right _ _).trans (by norm_num [worldUpper])
  exact (envelope_mono _ hp h0 hi.2 hu hp.wRadius_lt hp.cRadius_lt).trans (grid j).1

theorem least_grid_local_cell_cap (j : Fin 43) (q : ℕ)
    (hq : ∀ θ ∈ BstLean.Part254.cell (sourceIndex j), envelope (parameters j) θ ≤ (q : ℝ)/10^9) :
    localCap j ≤ (q : ℝ)/10^9 := by
  have hn : Needed (sourceIndex j) := by
    have := j.isLt
    constructor <;> dsimp [sourceIndex] <;> omega
  exact least_grid_envelope_cap j q
    (hq _ ⟨BstLean.Part254.cell_nonempty _ hn,le_rfl⟩)

theorem fixed_envelope_on_cell (i : Fin 60) {θ : ℝ} (hi : θ ∈ cell i) :
    BstLean.Part254.gaussianEnvelope θ - 92092/10^9 ≤ capTable i := by
  rw [capTable, if_pos (BstLean.Part254.cell_needed hi)]
  exact sub_le_sub_right (BstLean.Part254.envelope_on_cell i hi) _

theorem fixed_cap_grid (i : Fin 60) (hi : Needed i) : ∃ q : ℕ, capTable i = (q : ℝ)/10^9 := by
  obtain ⟨p,hp⟩ := BstLean.Part254.capTable_grid i hi
  have h0 := capTable_nonneg i hi
  rw [capTable,if_pos hi,hp] at h0
  have hpR : (92092 : ℝ) ≤ p := by linarith
  have hpN : 92092 ≤ p := by exact_mod_cast hpR
  refine ⟨p-92092,?_⟩
  rw [capTable,if_pos hi,hp,Nat.cast_sub hpN]
  norm_num
  ring

theorem least_grid_fixed_cell_cap (i : Fin 60) (hi : Needed i) (q : ℕ)
    (hq : ∀ θ ∈ cell i, BstLean.Part254.gaussianEnvelope θ-92092/10^9 ≤ (q : ℝ)/10^9) :
    capTable i ≤ (q : ℝ)/10^9 := by
  have hq' : ∀ θ ∈ BstLean.Part254.cell i,
      BstLean.Part254.gaussianEnvelope θ ≤ ((q+92092 : ℕ) : ℝ)/10^9 := by
    intro θ hθ
    have h := hq θ hθ
    push_cast
    linarith
  have h := BstLean.Part254.least_grid_cell_cap i hi (q+92092) hq'
  rw [capTable,if_pos hi]
  push_cast at h
  linarith

