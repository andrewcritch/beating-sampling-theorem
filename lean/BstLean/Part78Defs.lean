import BstLean.Part59Defs

/-!
# Part 78, wave 0: frozen definitions — Theorem 4 at `(d_M, d_f) = (2,2)`, uniform `D`, by
conditioning on the constant column

Source: `delegations/answers/omVL-opus-prover.md`, `delegations/answers/omVL-cx-disprover.md`.
Role: `delegations/statements/p78-spec.md`.

This file holds definitions and `Prop`-valued interface statements only. A wave-1 file proves one
interface, and may take others as hypotheses. Do not edit this file. Do not use `sorry`,
`native_decide` or `axiom`.

Conventions.
* `n` is the input dimension and the width. `d_M = d_f = 2`. `x` is uniform on the sphere
  (`uniformSphere n`). The features are the raw monomials `phiM x q`, `q : Mono n 2`;
  `default : Mono n 2` is the constant monomial.
* `JJ n` is the type of the non-constant monomials. `pf x q = phiM x q.1` (`q : JJ n`).
  `kap x y = Σ_q pf x q * pf y q` is the kernel of the non-constant raw features.
* The Gaussian coefficient matrix is split into the constant column `u : Fin n → ℝ` and the rest
  `W : WIdx n → ℝ` (`WIdx n = JJ n × Fin n`, feature first, output index second).
  `zv W p i = Σ_q W (q, i) * p q`, so `m(x) = u + zv W (pf x)`.
* `f(y) = f₀ + ℓ·y + yᵀHy` (`qfun f0 ℓ H`), `H` symmetric. `a = ℓ + 2Hu` (`aU ℓ H u`).
  `Phi a H W p = a·z + zᵀHz` with `z = zv W p`. `FG a H W x = Phi a H W (pf x)`, so
  `f(m(x)) = f(u) + FG (aU ℓ H u) H W x`.
* `VG a H W = Var_x FG a H W x` and `errG a H W = E_x FG a H W x − (3/2) tr H`
  (`= B − g₀` in the Gaussian model, given `u`).
* Sphere constants: `tG n = E κ(x,x)`, `mm1 n = E κ(x,y)`, `kk2 n = E κ(x,x)²`, `ss2 n = E κ(x,y)²`.
-/

namespace BstLean.Part78

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part36 (CoefIdxD DD unitOfD mapMD)
open BstLean.Part41 (Mono phiM colM varU)
open BstLean.Part53 (aH)
open BstLean.Part59 (polyEval TopNZ g0Q)

variable {n : ℕ}

/-! ## §1 Features -/

/-- The non-constant raw monomials of degree `≤ 2`. -/
abbrev JJ (n : ℕ) := {q : Mono n 2 // q ≠ default}

/-- The index of the non-constant part of the coefficient matrix: feature, output index. -/
abbrev WIdx (n : ℕ) := JJ n × Fin n

/-- The non-constant raw features. -/
noncomputable def pf (x : Fin n → ℝ) (q : JJ n) : ℝ := phiM x q.1

/-- The kernel `κ(x,y) = Σ_q p_q(x) p_q(y)`. -/
noncomputable def kap (x y : Fin n → ℝ) : ℝ := ∑ q : JJ n, pf x q * pf y q

/-- `tG = E κ(x,x) = tr G`. -/
noncomputable def tG (n : ℕ) : ℝ := ∫ x, kap x x ∂uniformSphere n

/-- `mm1 = E_{x,y} κ(x,y) = ‖E p‖²`. -/
noncomputable def mm1 (n : ℕ) : ℝ := ∫ x, ∫ y, kap x y ∂uniformSphere n ∂uniformSphere n

/-- `kk2 = E κ(x,x)²`. -/
noncomputable def kk2 (n : ℕ) : ℝ := ∫ x, kap x x ^ 2 ∂uniformSphere n

/-- `ss2 = E_{x,y} κ(x,y)² = tr G²`. -/
noncomputable def ss2 (n : ℕ) : ℝ := ∫ x, ∫ y, kap x y ^ 2 ∂uniformSphere n ∂uniformSphere n

/-! ## §2 The quadratic `f` and the Gaussian model given the constant column -/

/-- `‖a‖²`. -/
def nsq (a : Fin n → ℝ) : ℝ := ∑ i, a i ^ 2

/-- `‖H‖_F²`. -/
def frobH (H : Matrix (Fin n) (Fin n) ℝ) : ℝ := ∑ i, ∑ j, H i j ^ 2

/-- `tr H`. -/
def trH (H : Matrix (Fin n) (Fin n) ℝ) : ℝ := ∑ i, H i i

/-- `f(y) = f₀ + ℓ·y + yᵀHy`. -/
def qfun (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (y : Fin n → ℝ) : ℝ :=
  f0 + ∑ i, ℓ i * y i + ∑ i, ∑ j, H i j * y i * y j

/-- `a_u = ℓ + 2Hu`. -/
def aU (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (u : Fin n → ℝ) : Fin n → ℝ :=
  fun i => ℓ i + 2 * ∑ j, H i j * u j

/-- `z_i = Σ_q W(q,i) p_q`, for any feature index type `J`. -/
def zv {J : Type*} [Fintype J] (W : J × Fin n → ℝ) (p : J → ℝ) (i : Fin n) : ℝ :=
  ∑ q, W (q, i) * p q

/-- `Φ = a·z + zᵀHz`, `z = zv W p`. -/
def Phi {J : Type*} [Fintype J] (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ)
    (W : J × Fin n → ℝ) (p : J → ℝ) : ℝ :=
  ∑ i, a i * zv W p i + ∑ i, ∑ j, H i j * zv W p i * zv W p j

/-- `F_x = a·z(x) + z(x)ᵀHz(x)`, `z(x) = W p(x)`. -/
noncomputable def FG (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (W : WIdx n → ℝ)
    (x : Fin n → ℝ) : ℝ := Phi a H W (pf x)

/-- `V = Var_x F_x`. -/
noncomputable def VG (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (W : WIdx n → ℝ) : ℝ :=
  varU (uniformSphere n) (FG a H W)

/-- `B − g₀ = E_x F_x − (3/2) tr H` (Gaussian model, given `u`). -/
noncomputable def errG (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (W : WIdx n → ℝ) : ℝ :=
  ∫ x, FG a H W x ∂uniformSphere n - 3 / 2 * trH H

/-! ## §3 Interface statements -/

/-- **Gaussian Poincaré inequality for polynomials**: `Var P ≤ Σ_α E (∂_α P)²`. -/
def PoincareMv : Prop :=
  ∀ (ι : Type) [Fintype ι] (P : MvPolynomial ι ℝ),
    ∫ z, (MvPolynomial.eval z P - ∫ w, MvPolynomial.eval w P ∂stdGauss ι) ^ 2 ∂stdGauss ι ≤
      ∑ α, ∫ z, (MvPolynomial.eval z (MvPolynomial.pderiv α P)) ^ 2 ∂stdGauss ι

/-- **Two-point (Wick) identity** for `Φ`, any feature index type `J`, any vectors `p`, `p'`. -/
def WickTwoPoint : Prop :=
  ∀ (J : Type) [Fintype J] (n : ℕ) (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∀ p p' : J → ℝ,
      (∫ W, Phi a H W p ∂stdGauss (J × Fin n) = trH H * ∑ q, p q ^ 2) ∧
      (∫ W, Phi a H W p * Phi a H W p' ∂stdGauss (J × Fin n) =
        nsq a * (∑ q, p q * p' q) + trH H ^ 2 * ((∑ q, p q ^ 2) * (∑ q, p' q ^ 2)) +
          2 * frobH H * (∑ q, p q * p' q) ^ 2)

/-- **Second moment of a linear form.** -/
def GaussLin : Prop :=
  ∀ (ι : Type) [Fintype ι] (b c : ι → ℝ),
    Integrable (fun u : ι → ℝ => (∑ j, b j * u j) * (∑ j, c j * u j)) (stdGauss ι) ∧
    ∫ u, (∑ j, b j * u j) * (∑ j, c j * u j) ∂stdGauss ι = ∑ j, b j * c j

/-- **Fourth moment of an affine function of a Gaussian vector**: `E T⁴ ≤ K₁ (E T²)²`. -/
def AffFourth (K1 : ℝ) : Prop :=
  ∀ (ι : Type) [Fintype ι] (c0 : ℝ) (b : ι → ℝ),
    ∫ u, (c0 + ∑ j, b j * u j) ^ 4 ∂stdGauss ι ≤
      K1 * (∫ u, (c0 + ∑ j, b j * u j) ^ 2 ∂stdGauss ι) ^ 2

/-- **Regularity**: `V` and the error are continuous in `(a, W)`. -/
def RegIface (n : ℕ) : Prop :=
  ∀ H : Matrix (Fin n) (Fin n) ℝ,
    Continuous (fun p : (Fin n → ℝ) × (WIdx n → ℝ) => VG p.1 H p.2) ∧
    Continuous (fun p : (Fin n → ℝ) × (WIdx n → ℝ) => errG p.1 H p.2)

/-- **The exact conditional identities** (given the constant column, that is, for every `a`):
`E_W V = (tG − mm1)‖a‖² + (tr H)²(kk2 − tG²) + 2‖H‖²(kk2 − ss2)` and
`E_W (B − g₀)² = ‖a‖² mm1 + 2‖H‖² ss2 + (tr H)²(tG − 3/2)²`. -/
def MeanIds (n : ℕ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    Integrable (VG a H) (stdGauss (WIdx n)) ∧
    Integrable (fun W => VG a H W ^ 2) (stdGauss (WIdx n)) ∧
    Integrable (fun W => errG a H W ^ 2) (stdGauss (WIdx n)) ∧
    ∫ W, VG a H W ∂stdGauss (WIdx n) =
      (tG n - mm1 n) * nsq a + trH H ^ 2 * (kk2 n - tG n ^ 2) + 2 * frobH H * (kk2 n - ss2 n) ∧
    ∫ W, errG a H W ^ 2 ∂stdGauss (WIdx n) =
      nsq a * mm1 n + 2 * frobH H * ss2 n + trH H ^ 2 * (tG n - 3 / 2) ^ 2

/-- **Sphere constants.** `S2` is a bound for `n · tr G²`. -/
def SphereConsts (n : ℕ) (S2 : ℝ) : Prop :=
  tG n = 3 / 2 + 3 / (2 * ((n : ℝ) + 2)) ∧ mm1 n = 1 / (n : ℝ) ∧
  tG n ^ 2 ≤ kk2 n ∧ kk2 n ≤ tG n ^ 2 + 3 / (4 * ((n : ℝ) + 2)) ∧
  0 ≤ ss2 n ∧ ss2 n ≤ S2 / (n : ℝ) ∧
  ∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 → kap x x ≤ 2

/-- **Feature operator bound**: `E (c·p(x))² ≤ (CF/n)‖c‖²`. -/
def FeatOp (n : ℕ) (CF : ℝ) : Prop :=
  ∀ c : JJ n → ℝ,
    ∫ x, (∑ q, c q * pf x q) ^ 2 ∂uniformSphere n ≤ CF / (n : ℝ) * ∑ q, c q ^ 2

/-- **Conditional variance bound** (Poincaré route):
`Var_W V ≤ (cP/n)(‖a‖² + 8‖H‖²) E_W V`. -/
def VarBound (n : ℕ) (cP : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∫ W, (VG a H W - ∫ W', VG a H W' ∂stdGauss (WIdx n)) ^ 2 ∂stdGauss (WIdx n) ≤
      cP / (n : ℝ) * (nsq a + 8 * frobH H) * ∫ W, VG a H W ∂stdGauss (WIdx n)

/-- **Coefficient form = `(f₀, ℓ, H)` form**, and the value of `g₀` at `(2,2)`. -/
def CoefBridge (n : ℕ) : Prop :=
  ∀ c : Mono n 2 → ℝ, ∃ (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm ∧
    (∀ y : Fin n → ℝ, polyEval 2 c y = qfun (c default) ℓ H y) ∧
    (TopNZ 2 c → 0 < frobH H) ∧
    (∀ M : CoefIdxD n 2 → ℝ,
      g0Q n 2 2 c M = qfun (c default) ℓ H (colM M default) + aH n 2 * trH H)

/-- The values of `𝒟` and `a` at `d = 2`. -/
def DDval (n : ℕ) : Prop :=
  DD n 2 = (n : ℝ) * ((n : ℝ) + 1) * ((n : ℝ) + 2) / 2 ∧ aH n 2 = 3 / 2 / DD n 2

/-- **The split** of the Gaussian coefficient vector into the constant column `u` and the rest `W`. -/
def SplitIface (n : ℕ) : Prop :=
  ∃ comb : (Fin n → ℝ) × (WIdx n → ℝ) → (CoefIdxD n 2 → ℝ), Measurable comb ∧
    Measure.map comb ((stdGauss (Fin n)).prod (stdGauss (WIdx n))) = stdGauss (CoefIdxD n 2) ∧
    ∀ (u : Fin n → ℝ) (W : WIdx n → ℝ),
      colM (comb (u, W)) default = u ∧
      (∀ (x : Fin n → ℝ) (i : Fin n), mapMD (comb (u, W)) x i = u i + zv W (pf x) i) ∧
      ∑ α, comb (u, W) α ^ 2 = ∑ i, u i ^ 2 + ∑ β, W β ^ 2

end BstLean.Part78
