def worldAngles : Set (Ret 12588) :=
  Ethm (paperCentres 12588) ∩ Ethp (paperCentres 12588)

theorem worldAngles_measurable : MeasurableSet worldAngles :=
  (measurableSet_Ethm _).inter (measurableSet_Ethp _)

theorem worldAngles_charge :
    (retDist (paperCentres 12588)).real worldAnglesᶜ ≤ (6145 / 10 ^ 9 : ℝ) := by
  have h1 := ethm_charge (paperCentres 12588)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12588) (paperCentres 12588)
  have he : exp (-(45 / 10000 * (12588 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12588 : ℝ))) ≤ exp (-12) ^ 2 := by
