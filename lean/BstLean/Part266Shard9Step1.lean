  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12587)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12587) (CentreSources 12587 12587)
  direction : analyticBase ⊆ agentEv (paperDesignP 12587) (DirectionError 12587)
  angles : analyticBase ⊆ worldAngles

