    (retDist (paperCentres 12589)).real analyticBaseᶜ ≤ analyticCharge := by
  have hτ := paperDesign_tauWorld (n := 12589) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12589) hτ
  have hC := centreSources_ret_charge_row 12589 (paperDesignP 12589) hτ
