  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12588)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12588) (CentreSources 12588 12588)
  direction : analyticBase ⊆ agentEv (paperDesignP 12588) (DirectionError 12588)
  angles : analyticBase ⊆ worldAngles

