  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12584)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12584) (CentreSources 12584 12584)
  direction : analyticBase ⊆ agentEv (paperDesignP 12584) (DirectionError 12584)
  angles : analyticBase ⊆ worldAngles

