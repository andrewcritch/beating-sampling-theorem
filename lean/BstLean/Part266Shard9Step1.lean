  have hb : bR c = (BstLean.Part150.rhoC c.1.2 ((paperDesignP 12590).tau0 c))⁻¹ •
      BstLean.Part150.bT 12590 12590 (A1 c) (A2 c) c.1.2 ((paperDesignP 12590).tau0 c) := by
    ext j
