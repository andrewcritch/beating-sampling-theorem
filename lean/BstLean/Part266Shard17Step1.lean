  have hτ := paperDesign_tauWorld (n := 12786) passF passW measurable_passF measurable_passW
  have hD := directionError_ret_charge (by norm_num) (paperDesignP 12786) hτ
  have hC := centreSources_ret_charge_row 12786 (paperDesignP 12786) hτ
