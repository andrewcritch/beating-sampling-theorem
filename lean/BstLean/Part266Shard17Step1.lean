  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12778)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12778) (CentreSources 12778 12778)
  direction : analyticBase ⊆ agentEv (paperDesignP 12778) (DirectionError 12778)
  angles : analyticBase ⊆ worldAngles

