    exact h.trans ((pow_le_pow_left₀ (exp_pos _).le exp_neg12_row 2).trans (by norm_num))
  unfold worldAngles
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans (add_le_add (h1.trans he)
    (h2.trans exp_neg12_row))).trans (by norm_num)

def analyticBase : Set (Ret 12790) :=
  (passEvent ∩ agentEv (paperDesignP 12790) (DirectionError 12790) ∩
    agentEv (paperDesignP 12790) (CentreSources 12790 12790)) ∩ worldAngles

