  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12785)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12785) (CentreSources 12785 12785)
  direction : analyticBase ⊆ agentEv (paperDesignP 12785) (DirectionError 12785)
  angles : analyticBase ⊆ worldAngles

