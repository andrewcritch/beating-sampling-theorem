theorem energy_lower_components {θ : ℝ} (hw : θ ∈ Icc (46 / 100 : ℝ) (54 / 100)) :
    0 ≤ kappa (meanLowerRoot 12796 θ ^ 2 / gPlus 12796) - 2 / (12796 : ℝ) ^ 2 ∧
    (804 / 1000 : ℝ) ≤
      √(gMinus 12796 * (kappa (meanLowerRoot 12796 θ ^ 2 / gPlus 12796) -
        2 / (12796 : ℝ) ^ 2)) - 2 * √(12 * gPlus 12796) / 12796 -
