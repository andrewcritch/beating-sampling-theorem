  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12779)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12779) (CentreSources 12779 12779)
  direction : analyticBase ⊆ agentEv (paperDesignP 12779) (DirectionError 12779)
  angles : analyticBase ⊆ worldAngles

