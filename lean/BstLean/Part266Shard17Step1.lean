  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12786)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12786) (CentreSources 12786 12786)
  direction : analyticBase ⊆ agentEv (paperDesignP 12786) (DirectionError 12786)
  angles : analyticBase ⊆ worldAngles

