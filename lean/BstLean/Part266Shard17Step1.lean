  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12790)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12790) (CentreSources 12790 12790)
  direction : analyticBase ⊆ agentEv (paperDesignP 12790) (DirectionError 12790)
