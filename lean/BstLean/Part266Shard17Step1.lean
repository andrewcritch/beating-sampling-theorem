theorem centreSources_charge_row (J : ℕ) (c : Fin 12797 → ℝ) {τ : ℝ} (hτ : 0 < τ) :
    (nuA 12797).real (BstLean.Part211.CentreSource 12797 J c τ 2)ᶜ ≤
      (103 / 10 ^ 6 : ℝ) := by
  have hh := BstLean.Part211.centre_source_charge (n := 12797) (J := J) (P := 160)
    (η := 6 / 1000) (by norm_num) (by norm_num) (by norm_num) c hτ
    (by norm_num : (0 : ℝ) < 2) (by norm_num) (rhoBar_lt (by norm_num))
  have hj0 := jS_nonneg 12797 160 (6 / 1000)
  have hj := jS_160_le (n := 12797) (by norm_num)
  have hj2 := pow_le_pow_left₀ hj0 hj 2
  have hbase : jS 12797 160 (6 / 1000) ^ 2 * 12797 /
      (((12797 : ℝ) - 1 - 2 * 160) * 2) ≤ (3 / 5 : ℝ) := by
    norm_num at *
    linarith
  have hp := pow_le_pow_left₀ (by positivity) hbase 160
  have hp' : (jS 12797 160 (6 / 1000) ^ 2 * 12797 /
      (((12797 : ℝ) - 1 - 2 * 160) * 2)) ^ 160 ≤ (1 / 10 ^ 12 : ℝ) :=
    hp.trans (by norm_num)
  have he : exp (-(12797 : ℝ) / 2) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(12797 : ℝ) / 2) ≤ exp (-12) ^ 2 := by
