    (show energyRatio 12796 (gMinus 12796) (54 / 100) ∈ Icc (-1 : ℝ) 1 by constructor <;> linarith)
  have hkp := (kappa_mem (by linarith : -1 ≤ energyRatio 12796 (gMinus 12796) (54 / 100))
    (by linarith : energyRatio 12796 (gMinus 12796) (54 / 100) ≤ 1)).1
  have hmul := mul_le_mul hg.2.2 (show kappa (energyRatio 12796 (gMinus 12796) (54 / 100)) ≤
