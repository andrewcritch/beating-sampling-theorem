    linarith
  have hmean0 : 0 ≤ meanRoot 12796 (54 / 100) := by unfold meanRoot; positivity
  have hg := energy_g_bounds.1
  unfold energyRatio
  rw [div_le_iff₀ (by linarith : 0 < gMinus 12796)]
  nlinarith

theorem energy_upper_coarse :
