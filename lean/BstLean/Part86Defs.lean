/-! ## §1 The abstract model -/

/-- The data of the model. -/
structure Mod (n : ℕ) (I J S G : Type) [MeasurableSpace S] [MeasurableSpace G] where
  /-- the anchor features, as polynomials in `x` -/
  bP : I → MvPolynomial (Fin n) ℝ
  /-- the residual features, as polynomials in `x` -/
  psP : J → MvPolynomial (Fin n) ℝ
  /-- the distribution of the slice parameter -/
  pi : Measure S
  /-- the distribution inside a slice -/
  ga : Measure G
  /-- the point `x` of slice `p` at position `g` -/
  X : S × G → Fin n → ℝ

section model

variable {n : ℕ} {I J S G : Type} [Fintype I] [Fintype J] [MeasurableSpace S] [MeasurableSpace G]

/-- `b_j(x)`. -/
noncomputable def Mod.b (M : Mod n I J S G) (x : Fin n → ℝ) (j : I) : ℝ :=
  MvPolynomial.eval x (M.bP j)

/-- `ψ_q(x)`. -/
noncomputable def Mod.ps (M : Mod n I J S G) (x : Fin n → ℝ) (q : J) : ℝ :=
  MvPolynomial.eval x (M.psP q)

/-- The residual kernel `κ(x, y) = Σ_q ψ_q(x) ψ_q(y)`. -/
noncomputable def kapm (M : Mod n I J S G) (x y : Fin n → ℝ) : ℝ := ∑ q, M.ps x q * M.ps y q

/-- Regularity: probability measures, `X` measurable with values in the unit ball, features of
degree `≤ d`. -/
def Reg (M : Mod n I J S G) (d : ℕ) : Prop :=
  IsProbabilityMeasure M.pi ∧ IsProbabilityMeasure M.ga ∧ Measurable M.X ∧
    (∀ pg, ∑ i, M.X pg i ^ 2 ≤ 1) ∧
    (∀ j, (M.bP j).totalDegree ≤ d) ∧ (∀ q, (M.psP q).totalDegree ≤ d)

/-- `F_x(W) = 𝒫(b(x), lam · W ψ(x))`. -/
noncomputable def Fm (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  MvPolynomial.eval (Sum.elim (M.b x) (fun i => lam * zv W (M.ps x) i)) P

/-- `F` at the point of slice `p` at position `g`. -/
noncomputable def Fs (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) (p : S) (g : G) : ℝ := Fm M P lam W (M.X (p, g))

/-- The slice mean `m_p(W) = E_g F`. -/
noncomputable def msl (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) (p : S) : ℝ := ∫ g, Fs M P lam W p g ∂M.ga

/-- The slice variance `Y_p(W) = Var_g F`. -/
noncomputable def Ysl (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) (p : S) : ℝ := ∫ g, (Fs M P lam W p g - msl M P lam W p) ^ 2 ∂M.ga

/-- `Φ_lam(x) = E_W F_x(W)`. -/
noncomputable def Phi (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (x : Fin n → ℝ) : ℝ := ∫ W, Fm M P lam W x ∂stdGauss (J × Fin n)

/-- `g_p = E_g Φ₁`. -/
noncomputable def gsl (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (p : S) : ℝ :=
  ∫ g, Phi M P 1 (M.X (p, g)) ∂M.ga

/-- `B(W) = E_x F_x(W) = E_p m_p(W)`. -/
noncomputable def Bm (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) : ℝ := ∫ p, msl M P lam W p ∂M.pi

/-- `V(W) = Var_x F_x(W)`. -/
noncomputable def Vm (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) : ℝ := ∫ p, ∫ g, (Fs M P lam W p g - Bm M P lam W) ^ 2 ∂M.ga ∂M.pi

/-- The within-slice variance `E_p Y_p(W)`. -/
noncomputable def Vdn (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) : ℝ := ∫ p, Ysl M P lam W p ∂M.pi

/-- The slice error energy `E_p (m_p(W) − g_p)²`. -/
noncomputable def Esl (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ)
    (W : J × Fin n → ℝ) : ℝ := ∫ p, (msl M P lam W p - gsl M P p) ^ 2 ∂M.pi

/-- `g_D = E_x Φ₁(x)`: the conditional mean of `B` at `lam = 1`. -/
noncomputable def gD (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) : ℝ :=
  ∫ p, gsl M P p ∂M.pi

/-- `T = Var_p g_p`. -/
noncomputable def Tm (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) : ℝ :=
  ∫ p, (gsl M P p - gD M P) ^ 2 ∂M.pi

/-- `R₁ = E_p Var_g Φ₁`. -/
noncomputable def R1 (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) : ℝ :=
  ∫ p, ∫ g, (Phi M P 1 (M.X (p, g)) - gsl M P p) ^ 2 ∂M.ga ∂M.pi

/-! ## §2 Hypotheses on the model -/

/-- **Two-point identity** (Lemma W of Part 53 on the index `J`): for symmetric families `A, A'`,
feature vectors `p, p'` and a scale `lam`. -/
def TwoPt (n : ℕ) (J : Type) [Fintype J] : Prop :=
  ∀ (K : ℕ) (A A' : Tens n), (∀ j, IsSymmT (A j)) → (∀ j, IsSymmT (A' j)) →
    ∀ (lam : ℝ) (p p' : J → ℝ),
      Integrable (fun W : J × Fin n → ℝ =>
        fvA K A (fun i => lam * zv W p i) * fvA K A' (fun i => lam * zv W p' i))
        (stdGauss (J × Fin n)) ∧
      ∫ W : J × Fin n → ℝ, fvA K A (fun i => lam * zv W p i) * fvA K A' (fun i => lam * zv W p' i)
          ∂stdGauss (J × Fin n) =
        ∑ c ∈ Finset.range (K + 1), (c.factorial : ℝ) * lam ^ (2 * c) *
          tinner (heatA K (lam ^ 2 * ∑ q, p q ^ 2) A c) (heatA K (lam ^ 2 * ∑ q, p' q ^ 2) A' c) *
          (∑ q, p q * p' q) ^ c

/-- **Slice feature operator bound**: in every slice there is a level `τ ≥ 0` below the kernel
diagonal (almost surely), and the second-moment operator of the residual features is at most
`Λ τ`. -/
def SliceOp (M : Mod n I J S G) (Lam : ℝ) : Prop :=
  ∀ p : S, ∃ τ : ℝ, 0 ≤ τ ∧ (∀ᵐ g ∂M.ga, τ ≤ kapm M (M.X (p, g)) (M.X (p, g))) ∧
    ∀ c : J → ℝ, ∫ g, (∑ q, c q * M.ps (M.X (p, g)) q) ^ 2 ∂M.ga ≤ Lam * τ * ∑ q, c q ^ 2

/-- **Slice reverse Hölder inequality** for polynomials in `x` of degree `≤ D`. -/
def SliceRH (M : Mod n I J S G) (D : ℕ) (C : ℝ) : Prop :=
  ∀ (p : S) (Q : MvPolynomial (Fin n) ℝ), Q.totalDegree ≤ D →
    ∫ g, (MvPolynomial.eval (M.X (p, g)) Q) ^ 4 ∂M.ga ≤
      C * (∫ g, (MvPolynomial.eval (M.X (p, g)) Q) ^ 2 ∂M.ga) ^ 2

/-- **Slice decorrelation**: `Var_W(E_g F) ≤ Λ E_g Var_W F` in every slice, for every polynomial
and every scale. -/
def Decor86 (M : Mod n I J S G) (Lam : ℝ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ) (p : S),
    ∫ W : J × Fin n → ℝ,
        (msl M P lam W p - ∫ W' : J × Fin n → ℝ, msl M P lam W' p ∂stdGauss (J × Fin n)) ^ 2
        ∂stdGauss (J × Fin n) ≤
      Lam * ∫ g, (∫ W : J × Fin n → ℝ,
          (Fs M P lam W p g - Phi M P lam (M.X (p, g))) ^ 2 ∂stdGauss (J × Fin n)) ∂M.ga

/-- **Scale comparison, pointwise**: `(Φ_lam(x) − Φ₁(x))² ≤ (2/n) Var_W F_x` for
`|lam² − 1| ≤ 1/n`, polynomials of degree `≤ k`, every `x`. -/
def Scale86 (M : Mod n I J S G) (k : ℕ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ), P.totalDegree ≤ k → ∀ lam : ℝ,
    |lam ^ 2 - 1| ≤ 1 / (n : ℝ) → ∀ x : Fin n → ℝ,
      (Phi M P lam x - Phi M P 1 x) ^ 2 ≤
        2 / (n : ℝ) * ∫ W : J × Fin n → ℝ, (Fm M P lam W x - Phi M P lam x) ^ 2
          ∂stdGauss (J × Fin n)

/-- **Polynomial structure and regularity** of the model functions. For every polynomial `P` of
degree `≤ K` and every scale:
1. `x ↦ F_x(W)` is a polynomial of degree `≤ d K`;
2. `W ↦ F_x(W)` is a polynomial of degree `≤ K`; `W ↦ m_p(W)` is a polynomial of degree `≤ K`;
3. `lam ↦ m_p(W)`, `lam ↦ B(W)` are polynomials of degree `≤ K`; `lam ↦ Vdn(W)`, `lam ↦ V(W)` are
   polynomials of degree `≤ 2K`;
4. `(W, p, g) ↦ F` is jointly measurable. -/
def PolyFacts (M : Mod n I J S G) (d : ℕ) : Prop :=
  ∀ (K : ℕ) (P : MvPolynomial (I ⊕ Fin n) ℝ), P.totalDegree ≤ K →
    (∀ (lam : ℝ) (W : J × Fin n → ℝ), ∃ Q : MvPolynomial (Fin n) ℝ, Q.totalDegree ≤ d * K ∧
      ∀ x, MvPolynomial.eval x Q = Fm M P lam W x) ∧
    (∀ (lam : ℝ) (x : Fin n → ℝ), ∃ Q : MvPolynomial (J × Fin n) ℝ, Q.totalDegree ≤ K ∧
      ∀ W, MvPolynomial.eval W Q = Fm M P lam W x) ∧
    (∀ (lam : ℝ) (p : S), ∃ Q : MvPolynomial (J × Fin n) ℝ, Q.totalDegree ≤ K ∧
      ∀ W, MvPolynomial.eval W Q = msl M P lam W p) ∧
    (∀ (W : J × Fin n → ℝ) (p : S), ∃ q : Polynomial ℝ, q.natDegree ≤ K ∧
      ∀ lam, q.eval lam = msl M P lam W p) ∧
    (∀ W : J × Fin n → ℝ, ∃ q : Polynomial ℝ, q.natDegree ≤ K ∧
      ∀ lam, q.eval lam = Bm M P lam W) ∧
    (∀ W : J × Fin n → ℝ, ∃ q : Polynomial ℝ, q.natDegree ≤ 2 * K ∧
      ∀ lam, q.eval lam = Vdn M P lam W) ∧
    (∀ W : J × Fin n → ℝ, ∃ q : Polynomial ℝ, q.natDegree ≤ 2 * K ∧
      ∀ lam, q.eval lam = Vm M P lam W) ∧
    (∀ lam : ℝ, Measurable (fun a : (J × Fin n → ℝ) × (S × G) => Fs M P lam a.1 a.2.1 a.2.2))

/-- **The Gaussian model given the anchors**: a level `Lv ≥ 0` and a centre `Vb` with
`Vb ≥ (1 − efl) Lv`, `E_W Esl ≤ (c1/n) Lv`, `E_W (Vdn − Vb)² ≤ (cV/n) Lv²`, `R₁ ≤ 2 Lv`. -/
def GaussModel86 (M : Mod n I J S G) (k : ℕ) (c1 cV efl : ℝ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ), P.totalDegree ≤ k → ∀ lam : ℝ,
    |lam ^ 2 - 1| ≤ 1 / (n : ℝ) →
    ∃ Lv Vb : ℝ, 0 ≤ Lv ∧ (1 - efl) * Lv ≤ Vb ∧
      Integrable (fun W : J × Fin n → ℝ => Esl M P lam W) (stdGauss (J × Fin n)) ∧
      Integrable (fun W : J × Fin n → ℝ => (Vdn M P lam W - Vb) ^ 2) (stdGauss (J × Fin n)) ∧
      ∫ W : J × Fin n → ℝ, Esl M P lam W ∂stdGauss (J × Fin n) ≤ c1 / (n : ℝ) * Lv ∧
      ∫ W : J × Fin n → ℝ, (Vdn M P lam W - Vb) ^ 2 ∂stdGauss (J × Fin n) ≤
        cV / (n : ℝ) * Lv ^ 2 ∧
      R1 M P ≤ 2 * Lv

/-- **The surrogate hypothesis** on the program value `gq`:
`(gq − g_D)² ≤ η² (R₁ + T) = η² Var_x Φ₁`. -/
def SurrHyp (M : Mod n I J S G) (η : ℝ) (gq : MvPolynomial (I ⊕ Fin n) ℝ → ℝ) : Prop :=
  ∀ P : MvPolynomial (I ⊕ Fin n) ℝ, (gq P - gD M P) ^ 2 ≤ η ^ 2 * (R1 M P + Tm M P)

/-- The dimension of `W`, as a real number. -/
noncomputable def DWr (n : ℕ) (J : Type) [Fintype J] : ℝ := (Fintype.card (J × Fin n) : ℝ)

/-- The failure set over the direction of `W`, at `ε = 1/2`, for a fixed polynomial and scale. -/
def badSet86 (M : Mod n I J S G) (gq : MvPolynomial (I ⊕ Fin n) ℝ → ℝ)
    (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam : ℝ) : Set (J × Fin n → ℝ) :=
  {W | (1 / 2 : ℝ) ^ 2 * Vm M P lam (Real.sqrt (DWr n J) • unitF53 W) <
    (Bm M P lam (Real.sqrt (DWr n J) • unitF53 W) - gq P) ^ 2}

/-- **The sphere step** (Remez on the radius of `W`, Markov, Chebyshev, and the deterministic
step): the failure probability over the direction of `W`. -/
def RemezStep86 (M : Mod n I J S G) (k : ℕ) (gq : MvPolynomial (I ⊕ Fin n) ℝ → ℝ)
    (bound : ℝ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ), P.totalDegree ≤ k → ∀ lam : ℝ,
    |lam ^ 2 - 1| ≤ 1 / (n : ℝ) →
      stdGauss (J × Fin n) (badSet86 M gq P lam) ≤ ENNReal.ofReal bound

/-- The bound of the sphere step. -/
noncomputable def remezBound (n k : ℕ) (c1 cV : ℝ) : ℝ :=
  5 / 2 * ((k : ℝ) + 1) ^ 2 * 25 * c1 / n + 5 / 2 * (2 * (k : ℝ) + 1) ^ 2 * 5 * cV / n

end model

/-! ## §3 The polynomial of `f`, and the polynomial given the anchors -/

section poly

variable {n : ℕ} {I : Type} [Fintype I]

/-- `f` as a polynomial: `f₀ + Σ_{j=1}^k Σ_w T_j(w) Π_t y_{w_t}`. Its value at `y` is
`fval k f0 T y`. -/
noncomputable def fPoly (k : ℕ) (f0 : ℝ) (T : Tens n) : MvPolynomial (Fin n) ℝ :=
  MvPolynomial.C f0 + ∑ j ∈ Finset.Icc 1 k, ∑ w : Fin j → Fin n,
    MvPolynomial.C (T j w) * ∏ t, MvPolynomial.X (w t)

/-- The polynomial `(b, z) ↦ f(Σ_j b_j U_j / r + sc · z)`. -/
noncomputable def PU (k : ℕ) (f0 : ℝ) (T : Tens n) (U : I × Fin n → ℝ) (r sc : ℝ) :
    MvPolynomial (I ⊕ Fin n) ℝ :=
  MvPolynomial.bind₁
    (fun i : Fin n => ∑ j : I, MvPolynomial.C (U (j, i) / r) * MvPolynomial.X (Sum.inl j) +
      MvPolynomial.C sc * MvPolynomial.X (Sum.inr i)) (fPoly k f0 T)

/-- The scale `λ₀ = √𝒟 ρ / (r √D_W)`, `r² = ‖U‖² + ρ²`. -/
noncomputable def lam0 (DDr DWv : ℝ) (U : I × Fin n → ℝ) (ρ : ℝ) : ℝ :=
  Real.sqrt DDr * ρ / (Real.sqrt (∑ a, U a ^ 2 + ρ ^ 2) * Real.sqrt DWv)

end poly

/-! ## §4 The instance for the rank-one distributions `D_{t,v}` -/

section inst

variable {n d : ℕ}

/-- The residual index: `|Mono n d| − (d + 1)` elements. -/
abbrev JR (n d : ℕ) := Fin (Fintype.card (Mono n d) - (d + 1))

/-- `E` is an orthonormal family in `ℝ^{Mono n d}` that completes the normalized anchor
features `φ_j(v)/‖φ_j(v)‖`, `j ≤ d`, to an orthonormal basis. -/
def RotE (v : Fin n → ℝ) (E : JR n d → Mono n d → ℝ) : Prop :=
  (∀ q q', ∑ p, E q p * E q' p = if q = q' then 1 else 0) ∧
  (∀ q, ∀ j ∈ Finset.range (d + 1), ∑ p, E q p * phiB d j v p = 0) ∧
  (∀ p p' : Mono n d, ∑ q, E q p * E q p' +
      ∑ j ∈ Finset.range (d + 1), phiB d j v p * phiB d j v p' / kJ d j v v =
    if p = p' then 1 else 0)

/-- The monomial `x^β` of `p` as a polynomial; its value at `x` is `phiM x p`. -/
noncomputable def monoP (p : Mono n d) : MvPolynomial (Fin n) ℝ :=
  ((p.2 : Multiset (Fin n)).map MvPolynomial.X).prod

/-- The residual feature polynomials `ψ_q = Σ_p E_{q,p} x^p`. -/
noncomputable def psPE (E : JR n d → Mono n d → ℝ) (q : JR n d) : MvPolynomial (Fin n) ℝ :=
  ∑ p : Mono n d, MvPolynomial.C (E q p) * monoP p

/-- The anchor feature polynomials `b_j = k_j(x, v)/√k_j(v, v)`. -/
noncomputable def bPE (d : ℕ) (v : Fin n → ℝ) (j : Fin (d + 1)) : MvPolynomial (Fin n) ℝ :=
  ∑ p : Mono n d, MvPolynomial.C (phiB d j v p / Real.sqrt (kJ d j v v)) * monoP p

/-- The anchor coordinates `U_{j,i} = (Z φ_j(v))_i / √k_j(v,v)`. -/
noncomputable def Uof (v : Fin n → ℝ) (Z : CoefIdxD n d → ℝ) : Fin (d + 1) × Fin n → ℝ :=
  fun a => ancRK Z v a.1 a.2 / Real.sqrt (kJ d a.1 v v)

/-- The residual coordinates `W_{q,i} = Σ_p E_{q,p} Z_{p,i}`. -/
noncomputable def Wof (E : JR n d → Mono n d → ℝ) (Z : CoefIdxD n d → ℝ) : JR n d × Fin n → ℝ :=
  fun a => ∑ p : Mono n d, E a.1 p * colM Z p a.2

/-- The model of `D_{t,v}` in dimension `m + 1`: slices are the axial states, the position in a
slice is a Gaussian vector `g` (its direction perpendicular to `v` is what matters). -/
noncomputable def modRK (m d : ℕ) (t : ℝ) (v : Fin (m + 1) → ℝ)
    (E : JR (m + 1) d → Mono (m + 1) d → ℝ) :
    Mod (m + 1) (Fin (d + 1)) (JR (m + 1) d) (ℝ × (Fin m → ℝ)) (Fin (m + 1) → ℝ) where
  bP := bPE d v
  psP := psPE E
  pi := axialMeasure t v
  ga := stdGauss (Fin (m + 1))
  X := polarState v

/-- The program value in the model: `E_{x∼Q} Φ₁(x)`, `Q` the surrogate. -/
noncomputable def gqRK (m d K : ℕ) (t : ℝ) (v : Fin (m + 1) → ℝ)
    (E : JR (m + 1) d → Mono (m + 1) d → ℝ)
    (P : MvPolynomial (Fin (d + 1) ⊕ Fin (m + 1)) ℝ) : ℝ :=
  ∫ x, Phi (modRK m d t v E) P 1 x ∂surrRK (m + 1) K t v

/-- **Existence of the completion** `E`. -/
def RotExists (n d : ℕ) : Prop :=
  ∀ v : Fin n → ℝ, UnitV v → ∃ E : JR n d → Mono n d → ℝ, RotE v E

/-- **Facts of the rotation** `Z ↦ (U, W)`. -/
def RotFacts (n d : ℕ) : Prop :=
  ∀ (v : Fin n → ℝ), UnitV v → ∀ E : JR n d → Mono n d → ℝ, RotE v E →
    MeasurePreserving (fun Z : CoefIdxD n d → ℝ => (Uof v Z, Wof E Z))
      (stdGauss (CoefIdxD n d))
      ((stdGauss (Fin (d + 1) × Fin n)).prod (stdGauss (JR n d × Fin n))) ∧
    (∀ Z : CoefIdxD n d → ℝ, ∑ α, Z α ^ 2 = ∑ a, Uof v Z a ^ 2 + ∑ a, Wof E Z a ^ 2) ∧
    (∀ (Z : CoefIdxD n d → ℝ) (x : Fin n → ℝ) (i : Fin n),
      mapMD Z x i = ∑ j : Fin (d + 1), MvPolynomial.eval x (bPE d v j) * Uof v Z (j, i) +
        zv (Wof E Z) (fun q => MvPolynomial.eval x (psPE E q)) i) ∧
    (∀ x y : Fin n → ℝ, ∑ q, MvPolynomial.eval x (psPE E q) * MvPolynomial.eval y (psPE E q) =
      KR d v x y) ∧
    (∀ c : JR n d → ℝ, ∃ c' : Mono n d → ℝ, ∑ p, c' p ^ 2 = ∑ q, c q ^ 2 ∧
      ∀ x : Fin n → ℝ, ∑ q, c q * MvPolynomial.eval x (psPE E q) =
        ∑ p, c' p * residualFeature v x p) ∧
    TwoPt n (JR n d)

/-- The constant of the slice feature operator bound, as a natural number:
`(d(d+1)/2) Σ_{b=1}^d C(d,b)² (2b−1)!!` (`21` at `d = 2`, `306` at `d = 3`). -/
def CLn (d : ℕ) : ℕ :=
  (d * (d + 1) / 2) * ∑ b ∈ Finset.Icc 1 d, (d.choose b) ^ 2 * (2 * b - 1).doubleFactorial

/-- The constant of the slice feature operator bound, as a real number. -/
noncomputable def CL86 (d : ℕ) : ℝ := (CLn d : ℝ)

/-- The threshold: `70000 (2k+1)² C_Λ(d) 9^{dk}`. -/
def N86 (d k : ℕ) : ℕ := 70000 * (2 * k + 1) ^ 2 * CLn d * 9 ^ (d * k)

/-- **Slice feature operator bound for `D_{t,v}`**, in dimension `m + 1`: on the slice
`x = S v + R w` (`w` uniform on the unit sphere of `v^⊥`, `S = axialS a r`, `R = axialR a r`),
`τ(x) ≥ R²` almost surely and `E_w (c · ψ(x))² ≤ (C_Λ/m) R² ‖c‖²`, `ψ` the residual feature. -/
def SliceOpRK (m d : ℕ) (CLam : ℝ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, UnitV v → ∀ a r : ℝ, 0 ≤ r →
    (∀ᵐ g ∂stdGauss (Fin (m + 1)),
      axialR a r ^ 2 ≤ tauR d v (polarPoint v (perpDir v g) a r)) ∧
    ∀ c : Mono (m + 1) d → ℝ,
      ∫ g, (∑ p, c p * residualFeature v (polarPoint v (perpDir v g) a r) p) ^ 2
          ∂stdGauss (Fin (m + 1)) ≤
        CLam / (m : ℝ) * axialR a r ^ 2 * ∑ p, c p ^ 2

/-- **Slice reverse Hölder inequality for `D_{t,v}`**: for every polynomial `Q` of degree `≤ D`,
`E_w Q(x)⁴ ≤ 8 · 9^D (E_w Q(x)²)²` on every slice. -/
def SliceRHRK (m D : ℕ) : Prop :=
  ∀ v : Fin (m + 1) → ℝ, UnitV v → ∀ a r : ℝ,
    ∀ Q : MvPolynomial (Fin (m + 1)) ℝ, Q.totalDegree ≤ D →
      ∫ g, (MvPolynomial.eval (polarPoint v (perpDir v g) a r) Q) ^ 4 ∂stdGauss (Fin (m + 1)) ≤
        8 * 9 ^ D * (∫ g, (MvPolynomial.eval (polarPoint v (perpDir v g) a r) Q) ^ 2
          ∂stdGauss (Fin (m + 1))) ^ 2

/-- The failure set of Theorem 1 on the coefficient sphere, at `ε = 1/2`, with the weight form of
the program at the surrogate of order `K`. -/
def SphereFail86 (n d k K : ℕ) (t : ℝ) (v : Fin n → ℝ) (f0 : ℝ) (T : Tens n) :
    Set (CoefIdxD n d → ℝ) :=
  {Z | Z ≠ 0 ∧ (1 / 2 : ℝ) ^ 2 * varFQ (lawRK n t v) k f0 T (unitOfD Z) <
    (BofQ (lawRK n t v) k f0 T (unitOfD Z) -
      gLineW (surrRK n K t v) k f0 T v (unitOfD Z)) ^ 2}

/-- **Identification** of the sphere quantities with the model quantities: for `Z` with
`(U, W) = (Uof v Z, Wof E Z)`, `W ≠ 0`, `r² = ‖U‖² + ‖W‖²`, the polynomial `PU … U r σ`, the
scale `λ₀` and the point `√D_W · W/‖W‖`. -/
def Ident86 (m d k K : ℕ) : Prop :=
  ∀ (t : ℝ) (v : Fin (m + 1) → ℝ), 0 ≤ t → UnitV v →
    ∀ E : JR (m + 1) d → Mono (m + 1) d → ℝ, RotE v E →
    ∀ (f0 : ℝ) (T : Tens (m + 1)), TSymm k T →
    ∀ Z : CoefIdxD (m + 1) d → ℝ, Wof E Z ≠ 0 →
      BofQ (lawRK (m + 1) t v) k f0 T (unitOfD Z) =
        Bm (modRK m d t v E)
          (PU k f0 T (Uof v Z) (Real.sqrt (∑ a, Uof v Z a ^ 2 + radF53 (Wof E Z) ^ 2))
            (1 / Real.sqrt (DD (m + 1) d)))
          (lam0 (DD (m + 1) d) (DWr (m + 1) (JR (m + 1) d)) (Uof v Z) (radF53 (Wof E Z)))
          (Real.sqrt (DWr (m + 1) (JR (m + 1) d)) • unitF53 (Wof E Z)) ∧
      varFQ (lawRK (m + 1) t v) k f0 T (unitOfD Z) =
        Vm (modRK m d t v E)
          (PU k f0 T (Uof v Z) (Real.sqrt (∑ a, Uof v Z a ^ 2 + radF53 (Wof E Z) ^ 2))
            (1 / Real.sqrt (DD (m + 1) d)))
          (lam0 (DD (m + 1) d) (DWr (m + 1) (JR (m + 1) d)) (Uof v Z) (radF53 (Wof E Z)))
          (Real.sqrt (DWr (m + 1) (JR (m + 1) d)) • unitF53 (Wof E Z)) ∧
      gLineW (surrRK (m + 1) K t v) k f0 T v (unitOfD Z) =
        gqRK m d K t v E
          (PU k f0 T (Uof v Z) (Real.sqrt (∑ a, Uof v Z a ^ 2 + radF53 (Wof E Z) ^ 2))
            (1 / Real.sqrt (DD (m + 1) d)))

/-- **Polar reduction**: the failure probability is at most the average, over the anchor
coordinates `U` and an independent radius `ρ = ‖W'‖`, of the failure probability over the
direction of `W`, for the polynomial `PU … U r σ` (`r² = ‖U‖² + ρ²`, `σ = 𝒟^{−1/2}`) at the scale
`λ₀`. -/
def PolarRed86 (m d k K : ℕ) : Prop :=
  ∀ (t : ℝ) (v : Fin (m + 1) → ℝ), 0 ≤ t → UnitV v →
    ∀ E : JR (m + 1) d → Mono (m + 1) d → ℝ, RotE v E →
    ∀ (f0 : ℝ) (T : Tens (m + 1)), TSymm k T →
      stdGauss (CoefIdxD (m + 1) d) (SphereFail86 (m + 1) d k K t v f0 T) ≤
        ∫⁻ U : Fin (d + 1) × Fin (m + 1) → ℝ, ∫⁻ W' : JR (m + 1) d × Fin (m + 1) → ℝ,
          stdGauss (JR (m + 1) d × Fin (m + 1))
            (badSet86 (modRK m d t v E) (gqRK m d K t v E)
              (PU k f0 T U (Real.sqrt (∑ a, U a ^ 2 + radF53 W' ^ 2))
                (1 / Real.sqrt (DD (m + 1) d)))
              (lam0 (DD (m + 1) d) (DWr (m + 1) (JR (m + 1) d)) U (radF53 W')))
          ∂stdGauss (JR (m + 1) d × Fin (m + 1))
          ∂stdGauss (Fin (d + 1) × Fin (m + 1))

/-- **Scale tail**: `P(|λ₀² − 1| > 1/n) ≤ C/n`, in iterated-integral form. -/
def TailIface86 (n d : ℕ) (C : ℝ) : Prop :=
  ∫⁻ U : Fin (d + 1) × Fin n → ℝ, ∫⁻ W' : JR n d × Fin n → ℝ,
      Set.indicator {p : (Fin (d + 1) × Fin n → ℝ) × (JR n d × Fin n → ℝ) |
        1 / (n : ℝ) < |lam0 (DD n d) (DWr n (JR n d)) p.1 (radF53 p.2) ^ 2 - 1|}
        (fun _ => (1 : ℝ≥0∞)) (U, W')
      ∂stdGauss (JR n d × Fin n) ∂stdGauss (Fin (d + 1) × Fin n) ≤ ENNReal.ofReal (C / n)

end inst

end BstLean.Part86
