  removal : ∫ a, removed (stdGauss (Fin (12120 - 1)))
    (rowSplit c wl ws).good a ∂muI 12120 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12120) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12120 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12120) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12120 ≤ mixtureRoot ^ 2
