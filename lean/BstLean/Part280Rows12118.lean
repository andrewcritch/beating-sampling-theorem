  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12120) c (rowSplit c wl ws),
    ((12120 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12120 ≤ energyError ^ 8
