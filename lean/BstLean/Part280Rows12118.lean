        (2 * (1 - eta) * ((1489989 / 250000000)) ^ 2) +
        12119 * ((3879 / 200000000000000000)) / (8 * (1 - eta) ^ 2 * ((1489989 / 250000000)) ^ 4)) := by
      gcongr <;> norm_num
