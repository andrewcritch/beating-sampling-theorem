    ∫ a in K, ((n : ℝ) * VR c a) ^ 2 ∂muI n ≤ (C / ((n : ℝ) - 3)) ^ 2 := by
  have hn1 : 1 ≤ n := by omega
  have hnR : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hb : normSq (bR c) ≠ 0 := by
    intro h
    unfold eR at he
