theorem node_trace_charge_row {wr : WRet 12235} (hw : windowW wr) :
    (gaussMat (mA 12235) 12235 (2 / (12235 : ℝ))).real {X | ∃ g < Js 12235,
      vsig2 (mkR wr (X, 0)) (nodeS (mkR wr (X, 0)) g) < 17 / (100 * (12235 : ℝ)) ∨
