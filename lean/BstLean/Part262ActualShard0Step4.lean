noncomputable def rootInputs_of_events {t : ℝ} {c : Ret 12242}
    (hw : WINDOW (paperDesignP 12242) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) :
    BstLean.Part243.RootInputs 12242 t c BstLean.Part259.agent12242.root :=
