/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12231) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12231) c (rowSplit c wl ws),
    ((12231 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12231 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12231) c (rowSplit c wl ws),
    ((12231 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12231 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12231 - 1)))
    (rowSplit c wl ws).good a ∂muI 12231 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12231) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12231 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12231) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12231 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12231) c (rowSplit c wl ws),
    hellG2 12231 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12231 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 12231}
    (hw : WINDOW (paperDesignP 12231) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
  window := hw
  energy_pos := he
  centre := pass_centre_of_events c hc
  moments := pass_moments_of_events c hw he hc _ R.energy_table R.location_table
  removal := R.removal
  mixture := R.mixture
  displacement := R.displacement

/-- This structure value can be passed directly to Part243 once the five remainder bounds hold. -/
noncomputable def rootInputs_of_events {t : ℝ} {c : Ret 12231}
    (hw : WINDOW (paperDesignP 12231) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) :
    BstLean.Part243.RootInputs 12231 t c BstLean.Part259.agent12231.root :=
  rootInputs (rootSource_of_events hw he hc R)

end BstLean.Part262.Row12231

/-! The analytic base has an unconditional payment. The null output-centre
exception adds no payment. This event does not supply the stored-table bounds. -/
namespace BstLean.Part262.Row12231
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part157 BstLean.Part169

def paidBaseEvent : Set (Ret 12231) :=
  analyticBase ∩ positiveOutputEvent (paperCentres 12231)

theorem paidBaseEvent_measurable : MeasurableSet paidBaseEvent :=
  analyticBase_measurable.inter (positiveOutputEvent_measurable _)

theorem paidBaseEvent_charge :
    (retDist (paperCentres 12231)).real paidBaseEventᶜ ≤ analyticCharge := by
  unfold paidBaseEvent
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans
    (add_le_add analyticBase_charge (positiveOutputEvent_charge (by norm_num) _))).trans
      (by simp)

structure PaidBaseCertificate (H : Set (Ret 12231)) : Prop where
  measurable : MeasurableSet paidBaseEvent
  charge : (retDist (paperCentres 12231)).real (H ∩ paidBaseEventᶜ) ≤
    BstLean.Part249.baseChargeAllowance
  analytic : paidBaseEvent ⊆ analyticBase
  positive_output : paidBaseEvent ⊆ positiveOutputEvent (paperCentres 12231)

theorem paidBaseCertificate (H : Set (Ret 12231)) : PaidBaseCertificate H := by
  refine ⟨paidBaseEvent_measurable, ?_, fun _ h => h.1, fun _ h => h.2⟩
  exact ((measureReal_mono inter_subset_right (measure_ne_top _ _)).trans
    paidBaseEvent_charge).trans (by
      norm_num [analyticCharge, BstLean.Part249.baseChargeAllowance,
        BstLean.Part243.proposedRetainedCharge])

