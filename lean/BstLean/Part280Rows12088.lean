  have hpm := BstLean.Part280.Gen.Row12092.pass_moments_of_events c hw he hc _ (htab.1.trans hw8) (htab.2.trans hf8)
  have hm : PaperMoments c (keptIx (paperDesignP 12092) c (BstLean.Part280.Gen.Row12092.hqSplit c))
      BstLean.Part280.Gen.Row12092.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12092.locationNorm BstLean.Part280.Gen.Row12092.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
