    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12091 - 1))).real
      {v | sgA (paperDesignP 12091) c a v < rowSigma} ∂BstLean.Part161.muI 12091 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
