    simpa only [measure_univ, one_mul, chiUp, normSq, Measure.real] using hU
  refine (charge_of_noise D (outputCentreEvent_measurable D) hT ?_).trans ht
  intro x hx
  have hx' : normSq x.2.1.2 < chiUp n := not_le.mp hx
