  all_goals clear * - hV0 hV1 hE0 hE1 hi80 hi81 hi120 hi121 hc20 hc21 hc30 hc31 hVl hVs hVl0 hVs0 hl4 hl6 hs4 hs6 hl40 hl60 hs40 hs60 hinv hinv0 hσ0 hσ hca0 hroot0 hroot
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((28427965207 / 250000) : ℝ) * ((1003 / 1000) * ((3623403 / 1000000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ ((959 / 500) : ℝ) / ((5967347 / 1000000000)) ^ 2 * ((1003 / 1000) * ((7300553 / 200000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((6744239 / 20000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 32 / 10000) * ((2713194991 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5967347 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((34040473 / 62500000000))) := by
        gcongr
