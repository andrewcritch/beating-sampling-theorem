    (sqrt_nonneg _) he BstLean.Part280.Gen.Row12092.bias_floor_ge (by norm_num [BstLean.Part280.Gen.Row12092.epsilon]) BstLean.Part280.Gen.Row12092.bias_threshold_pos
    (by norm_num [sharpAw]) (by norm_num [sharpAf]) (by norm_num [BstLean.Part280.Gen.Row12092.locationNorm])
