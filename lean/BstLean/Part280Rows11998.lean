    ∫ a, (∫ v, (sgA (paperDesignP 12000) c a v - gbar (paperDesignP 12000) c a) ^ 2
      ∂stdGauss (Fin (12000 - 1))) ^ 2 ∂muI 12000 ≤ residualVarianceBudget ^ 2 := by
