theorem location_variance_on_event {c : Ret 12002}
    (hw : WINDOW (paperDesignP 12002) c) (he : 0 < eR c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (lA (paperDesignP 12002) c a v - lbar (paperDesignP 12002) c a) ^ 2
      ∂stdGauss (Fin (12002 - 1))) ^ 2 ∂muI 12002 ≤ locationVarianceBudget c ^ 2 := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
  have hh := fresh_LG_variance_lambda (by norm_num) (paperDesignP 12002)
    (paperDesign_agentCentre _ _ _ _) c fresh_latitude_constant_pos_row he hL
