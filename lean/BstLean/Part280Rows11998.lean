  have hn : √(12002 : ℝ) ≤ (2738841 / 25000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12002 : ℝ) + 2 * √12002 ≤ (152763841 / 12500) := by linarith
