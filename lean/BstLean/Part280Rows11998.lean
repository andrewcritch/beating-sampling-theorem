  removal : ∫ a, removed (stdGauss (Fin (12000 - 1)))
    (rowSplit c wl ws).good a ∂muI 12000 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12000) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12000 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12000) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
