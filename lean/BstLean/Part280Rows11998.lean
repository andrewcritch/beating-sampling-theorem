theorem full_residual_budget_row : fullResidualBudget ≤ (647 / 50000) := by
  have hs : √(2 / (12000 : ℝ)) ≤ (1291 / 100000) := sqrt_le_iff.mpr (by norm_num)
  unfold fullResidualBudget locationNorm
  linarith

theorem scale_variance_budget_row : scaleVarianceBudget ≤ (4033 / 200000000000000000) := by
