    LBound.const (by norm_num : (8 : ℕ) ≠ 0) (by simp [μ]) (by norm_num)
  have hn := (h1.add (by norm_num) h8).scale (by norm_num : (8 : ℕ) ≠ 0)
    (sqrt_nonneg (2 / (11999 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 11999) c p.1 p.2)
      (√(2 / (11999 : ℝ)) * (1 + BstLean.Part222.energyAllowance 11999)) := by
