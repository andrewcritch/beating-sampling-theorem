noncomputable def splitResidualWidth : ℝ := 4 * residualMomentBudget 12
noncomputable def lowMassBudget : ℝ := 4 / 10 ^ 12

theorem removal_of_low_mass {c : Ret 12002}
    (hw : WINDOW (paperDesignP 12002) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12002 - 1))).real
      {v | sgA (paperDesignP 12002) c a v < √(2 / (12002 : ℝ) * mixtureFloor)}
      ∂muI 12002 ≤ lowMassBudget) :
