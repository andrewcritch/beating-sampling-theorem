theorem exactTableMoments_of_N {c : Ret 12062} (hw : WINDOW (paperDesignP 12062) c)
    (hθ : BstLean.Part280.m2Guard 12062 c) (hc : c ∈ BstLean.Part280.sharpTableN 12062)
