theorem first_matrix_row (c : Ret 12058) (hc : A1 c ∈ Eop 12058) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12058 : ℝ)) ≤ (6439429049 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12058 : ℝ) ≤ (4392357 / 40000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12058 : ℝ) + 2 * √12058 ≤ (245552357 / 20000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12058) (hc : c ∈ BstLean.Part164.Eop2 12058) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12058 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12058) := by
