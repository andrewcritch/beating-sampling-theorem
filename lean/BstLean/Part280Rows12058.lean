theorem variance_of_matrix_events (c : Ret 12060) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12060).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12060) (FirstMatrix 12060))
