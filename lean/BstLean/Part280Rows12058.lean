theorem full_residual_eighth {c : Ret 12062}
    (hw : WINDOW (paperDesignP 12062) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12062) c a v ^ 8
      ∂stdGauss (Fin (12062 - 1)) ∂muI 12062 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12062).prod (stdGauss (Fin (12062 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
