  have hn : √(12060 : ℝ) ≤ (6863627 / 62500) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12060 : ℝ) + 2 * √12060 ≤ (383738627 / 31250) := by linarith
