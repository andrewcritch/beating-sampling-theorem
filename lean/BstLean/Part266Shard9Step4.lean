    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12577 - 1))).real
      {v | sgA (paperDesignP 12577) c a v < rowSigma} ∂BstLean.Part161.muI 12577 ≤ lowMassBudget) :
