        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((170344717 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((51099179 / 10000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5904697 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((523257423 / 1000000000000))) := by
        gcongr
