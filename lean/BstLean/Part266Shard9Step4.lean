theorem hq_output_bounds {c : Ret 12583}
    (hw : WINDOW (paperDesignP 12583) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12583)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
