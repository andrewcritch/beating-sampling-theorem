    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12588 - 1))).real
      {v | sgA (paperDesignP 12588) c a v < rowSigma} ∂BstLean.Part161.muI 12588 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
