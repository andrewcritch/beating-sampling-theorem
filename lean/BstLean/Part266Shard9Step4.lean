      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((1475471 / 250000000)) ^ 2 * ((1003 / 1000) * ((8407093 / 250000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((34084993 / 100000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((5102615119 / 1000000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((1475471 / 250000000)) * ((1001 / 1000 + 52 / 1000) * ((522758707 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
