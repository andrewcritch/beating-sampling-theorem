def LowResidualMass (c : Ret 12579) : Prop :=
  ∫ a, (stdGauss (Fin (12579 - 1))).real
    {v | sgA (paperDesignP 12579) c a v < rowSigma} ∂muI 12579 ≤ lowMassBudget

