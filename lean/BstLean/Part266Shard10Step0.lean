    exact h2.trans (by norm_num)
  unfold latitudeJacobianSquared160 jacobianConstantSquared160
  have hh : √(planeEnvelopeSquared160 12600 4 +
      2 / (mA 12600 : ℝ) * frobEnvelopeSquared160 12600) +
      transverseConstant160 * √(2 / (mA 12600 : ℝ)) * operatorEnvelope160 12600 ≤ 9 / 4 := by
    linarith
  have hh0 : 0 ≤ √(planeEnvelopeSquared160 12600 4 +
      2 / (mA 12600 : ℝ) * frobEnvelopeSquared160 12600) +
      transverseConstant160 * √(2 / (mA 12600 : ℝ)) * operatorEnvelope160 12600 :=
    add_nonneg (sqrt_nonneg _) (mul_nonneg
      (mul_nonneg (gaussMomConst_nonneg 80) (sqrt_nonneg _))
