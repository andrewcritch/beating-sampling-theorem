/-! The pointwise variance budget follows from ordinary matrix operator bounds. -/
namespace BstLean.Part266.Row12600
open BstLean.Part252
open MeasureTheory Real
open BstLean.Part130 BstLean.Part157 BstLean.Part161 BstLean.Part169
open BstLean.Part162 (psiA)
open BstLean.Part53 (unitF53)
open BstLean.Part29 (stdGauss)

theorem variance_pointwise_row (c : Ret 12600) (hb : normSq (bR c) ≠ 0)
    (h1 : OpB (A1 c) 162) (h2 : OpB (A2 c) (283 / 100)) (a : Ix 12600) :
    |VR c a| ≤ varianceMax := by
  have h := variance_pointwise (by norm_num) c hb h1 h2 (by norm_num) (by norm_num) a
  rw [abs_of_nonneg h.1]
  refine h.2.trans ?_
  norm_num only [Nat.cast_ofNat]
  rw [div_pow, sq_sqrt (by norm_num : (0 : ℝ) ≤ 12600)]
  norm_num [varianceMax]

end BstLean.Part266.Row12600

/-! The ordinary operator events supply the pointwise variance guard. -/
namespace BstLean.Part266.Row12600
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part130 BstLean.Part153 BstLean.Part157 BstLean.Part160 BstLean.Part169

theorem first_matrix_row (c : Ret 12600) (hc : A1 c ∈ Eop 12600) : OpB (A1 c) 162 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12600 : ℝ)) ≤ (12598815767 / 1000000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12600 : ℝ) ≤ (56124861 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12600 : ℝ) + 2 * √12600 ≤ (3206124861 / 250000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12600) (hc : c ∈ BstLean.Part164.Eop2 12600) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12600 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12600) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12600 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12600) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12600).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12600) (FirstMatrix 12600))
    (h2 : c ∈ BstLean.Part164.Eop2 12600) (a : BstLean.Part161.Ix 12600) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
    unfold eR at he
    rw [hh, zero_div] at he
    exact (lt_irrefl 0 he)
  exact variance_pointwise_row c hb (first_matrix_row c (h1 hτ)) (second_matrix_row c h2) a

end BstLean.Part266.Row12600

