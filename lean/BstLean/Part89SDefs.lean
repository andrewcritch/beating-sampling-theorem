import BstLean.Part89Defs
import BstLean.Part88Even

/-!
# Part 89, frozen definitions for the semicircle sphere step in the slice model

Role: `delegations/statements/p89-spec.md`. Definitions and `Prop`-valued interface statements
only. Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

Part 86 used Lemma R+ (factor `5/2 (2k+1)²`) to go from the Gaussian matrix `W` to the sphere.
Part 88 has a transfer with a factor of order `k/2 + 1` (`Part88.semi_transferE`): an average over
the scale with the semicircle distribution and a Christoffel bound. It needs the variance bound
of the Gaussian model at every scale `|lam| √u`, `u ∈ [1 − β, 1 + β]`, with ONE centre `Vb` and one
level `Lv` (`GMW`). The centre moves little with the scale (`ScaleE`).
-/

namespace BstLean.Part89

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss)
open BstLean.Part86

section model

variable {n : ℕ} {I J S G : Type} [Fintype I] [Fintype J] [MeasurableSpace S] [MeasurableSpace G]

/-- The scale ratio `t = |lam'² − lam²| √n / min(lam², lam'²)`. -/
noncomputable def tSc (n : ℕ) (lam lam' : ℝ) : ℝ :=
  |lam' ^ 2 - lam ^ 2| * Real.sqrt n / min (lam ^ 2) (lam' ^ 2)

/-- **Scale comparison between two scales, pointwise in `x`** (from `Part84.ScaleIface`):
the mean field `Φ` and the variance over `W`. -/
def ScaleE (M : Mod n I J S G) (k : ℕ) : Prop :=
  ∀ (P : MvPolynomial (I ⊕ Fin n) ℝ), P.totalDegree ≤ k → ∀ lam lam' : ℝ, lam ≠ 0 → lam' ≠ 0 →
    ∀ x : Fin n → ℝ,
      (Phi M P lam' x - Phi M P lam x) ^ 2 ≤
        tSc n lam lam' ^ 2 * (1 + k * tSc n lam lam') ^ k *
          ∫ W : J × Fin n → ℝ, (Fm M P lam W x - Phi M P lam x) ^ 2 ∂stdGauss (J × Fin n) ∧
      ∫ W : J × Fin n → ℝ, (Fm M P lam' W x - Phi M P lam' x) ^ 2 ∂stdGauss (J × Fin n) ≤
        (1 + k * tSc n lam lam') ^ (2 * k) *
          ∫ W : J × Fin n → ℝ, (Fm M P lam W x - Phi M P lam x) ^ 2 ∂stdGauss (J × Fin n)

/-- **The Gaussian model on a scale window**, for one polynomial `P` and a base scale `lam`: as
`GMP`, but the variance bound holds at every scale `|lam| √u`, `u ∈ [1 − β, 1 + β]`, with the same
centre `Vb` and level `Lv`. -/
def GMW (M : Mod n I J S G) (P : MvPolynomial (I ⊕ Fin n) ℝ) (lam c1 cV efl β : ℝ) : Prop :=
  ∃ Lv Vb : ℝ, 0 ≤ Lv ∧ (1 - efl) * Lv ≤ Vb ∧
    Integrable (fun W : J × Fin n → ℝ => Esl M P lam W) (stdGauss (J × Fin n)) ∧
    ∫ W : J × Fin n → ℝ, Esl M P lam W ∂stdGauss (J × Fin n) ≤ c1 / (n : ℝ) * Lv ∧
    R1 M P ≤ 2 * Lv ∧
    ∀ u : ℝ, 1 - β ≤ u → u ≤ 1 + β →
      Integrable (fun W : J × Fin n → ℝ => (Vdn M P (|lam| * Real.sqrt u) W - Vb) ^ 2)
        (stdGauss (J × Fin n)) ∧
      ∫ W : J × Fin n → ℝ, (Vdn M P (|lam| * Real.sqrt u) W - Vb) ^ 2 ∂stdGauss (J × Fin n) ≤
        cV / (n : ℝ) * Lv ^ 2

end model

/-- The scale ratio of the semicircle window: `β √n / (1 − β)`. -/
noncomputable def tS (n : ℕ) (β : ℝ) : ℝ := β * Real.sqrt n / (1 - β)

/-- `(1 + k t)^{2k} − 1`. -/
noncomputable def a1S (k : ℕ) (t : ℝ) : ℝ := (1 + k * t) ^ (2 * k) - 1

/-- `t (1 + k t)^k`. -/
noncomputable def tauS (k : ℕ) (t : ℝ) : ℝ := t * (1 + k * t) ^ k

/-- The relative growth of the level in the window. -/
noncomputable def e1S (k : ℕ) (t : ℝ) : ℝ := a1S k t + tauS k t + tauS k t ^ 2

/-- The relative drift of the centre in the window. -/
noncomputable def e2S (k : ℕ) (t Lam : ℝ) : ℝ :=
  a1S k t + tauS k t * (1 + tauS k t) + Lam * (2 + e1S k t)

/-- The variance constant on the window (without the factor `n`): from the constant `cV0` at one
scale. -/
noncomputable def cVW (k : ℕ) (t Lam cV0 ϑ : ℝ) : ℝ :=
  (1 + ϑ) * cV0 * (1 + e1S k t) ^ 2 + (1 + 1 / ϑ) * e2S k t Lam ^ 2

/-- The bound of the sphere step: Lemma R+ and a Markov level `a` for the error; the semicircle
transfer (`Part88.SE`) and a Chebyshev level `b` for the variance. `N` is the dimension of `W`. -/
noncomputable def semiBound89 (n k : ℕ) (N c1 cV efl a b β ξ : ℝ) : ℝ :=
  5 / 2 * ((k : ℝ) + 1) ^ 2 * c1 / (a * n) +
    BstLean.Part88.SE (2 * k) β ξ * cV / ((1 - b) ^ 2 * (1 - efl) ^ 2 * n) /
      ((1 - ξ ^ 2) * (1 - 2 / (N * (99 / 100 * ξ * β) ^ 2)))

end BstLean.Part89
