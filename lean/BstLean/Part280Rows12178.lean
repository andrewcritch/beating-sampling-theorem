noncomputable def residualVarianceBudget : ℝ :=
  (2 * latitudeC / 12182) / ((12182 : ℝ) * (12182 - 3))

theorem location_variance_on_event {c : Ret 12182}
    (hw : WINDOW (paperDesignP 12182) c) (he : 0 < eR c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (lA (paperDesignP 12182) c a v - lbar (paperDesignP 12182) c a) ^ 2
      ∂stdGauss (Fin (12182 - 1))) ^ 2 ∂muI 12182 ≤ locationVarianceBudget c ^ 2 := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
  have hh := fresh_LG_variance_lambda (by norm_num) (paperDesignP 12182)
    (paperDesign_agentCentre _ _ _ _) c fresh_latitude_constant_pos_row he hL
