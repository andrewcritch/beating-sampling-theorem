theorem root_le_of_pow {x b : ℝ} {k : ℕ} (hk : k ≠ 0)
    (hx : 0 ≤ x) (hb : 0 ≤ b) (h : x ≤ b ^ k) :
    x ^ (1 / (k : ℝ)) ≤ b := by
  apply le_of_pow_le_pow_left₀ hk hb
  rw [one_div, rpow_inv_natCast_pow hx hk]
  exact h

theorem gaussian80_le : gaussMomConst 80 ≤ 8 := by
