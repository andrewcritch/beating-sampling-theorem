    (sqrt_le_iff.mp hcert).2
  obtain ⟨MV, bV⟩ := bdd_VR hn1 c
  have iV : Integrable (fun a => ((n : ℝ) * VR c a) ^ 2) (muI n) := by
    have hh := intOn_of_bdd (((measurable_VR c).const_mul (n : ℝ)).pow_const 2)
