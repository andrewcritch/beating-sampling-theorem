  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12030) c (rowSplit c wl ws),
    ((12030 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12030 ≤ energyError ^ 8
