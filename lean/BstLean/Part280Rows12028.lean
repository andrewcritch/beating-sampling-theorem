  have hn : √(12030 : ℝ) ≤ (109681357 / 1000000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12030 : ℝ) + 2 * √12030 ≤ (6124681357 / 500000) := by linarith
