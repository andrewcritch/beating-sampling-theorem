theorem variance_of_matrix_events (c : Ret 12030) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12030).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12030) (FirstMatrix 12030))
    (h2 : c ∈ BstLean.Part164.Eop2 12030) (a : BstLean.Part161.Ix 12030) :
