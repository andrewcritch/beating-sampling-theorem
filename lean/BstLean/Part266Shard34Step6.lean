noncomputable def certifiedTablePayment (H : Set (Ret 13200)) : TablePayment H := by
  refine ⟨?_⟩
  exact ((measureReal_mono inter_subset_right (measure_ne_top _ _)).trans
    tableEvent_ret_charge).trans table_charge_price

theorem certifiedBaseEvent (H : Set (Ret 13200)) : BaseEventCertificate H tableEvent :=
