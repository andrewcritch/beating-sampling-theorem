    (√(tA 13202 * ((166 : ℝ) ^ 2 / (13202 - 2))) * √((42 / 10 : ℝ) / 13202) *
      energyCoefficient18 13202) ^ 18 * (61 / 100 : ℝ) ^ 18 ≤
