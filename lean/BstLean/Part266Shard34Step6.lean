  have hlam : √(tA 13208 * ((166 : ℝ) ^ 2 / (13208 - 2))) ^ 18 =
      (tA 13208 * ((166 : ℝ) ^ 2 / (13208 - 2))) ^ 9 := by
    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num [tA, mA])]
  have hσ : √((42 / 10 : ℝ) / 13208) ^ 18 = ((42 / 10 : ℝ) / 13208) ^ 9 := by
    rw [show (18 : ℕ) = 2 * 9 from rfl, pow_mul, sq_sqrt (by norm_num)]
  simp only [mul_pow, hlam, hσ]
  calc
    _ ≤ (tA 13208 * ((166 : ℝ) ^ 2 / (13208 - 2))) ^ 9 *
        ((42 / 10 : ℝ) / 13208) ^ 9 *
        (2 * 13208 * (212 / 100 : ℝ) + (269 / 10) * 8) ^ 18 * (61 / 100 : ℝ) ^ 18 := by
      gcongr <;> first
