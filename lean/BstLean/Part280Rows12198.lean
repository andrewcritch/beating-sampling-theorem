    (hprice : massBound 12199 M H xi E u mixtureFloor ≤ 12199 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12199 - 1))).real
      {v | sgA (paperDesignP 12199) c a v < √(2 / (12199 : ℝ) * mixtureFloor)}
