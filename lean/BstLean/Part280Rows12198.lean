theorem hq_location_bounds {c : Ret 12201} (he : (6 / 10 : ℝ) ≤ eR c) :
    0 ≤ hqLocation c ∧ hqLocation c ≤ (1696491003 / 1000000000) := by
  have hw := split_width_bounds he
