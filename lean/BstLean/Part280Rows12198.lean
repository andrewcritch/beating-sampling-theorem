def LowResidualMass (c : Ret 12199) : Prop :=
  ∫ a, (stdGauss (Fin (12199 - 1))).real
    {v | sgA (paperDesignP 12199) c a v < rowSigma} ∂muI 12199 ≤ lowMassBudget

noncomputable def hqSplit (c : Ret 12199) : SplitData 12199 :=
  rowSplit c (splitLocationWidth c) splitResidualWidth

theorem hq_output_bounds {c : Ret 12199}
    (hw : WINDOW (paperDesignP 12199) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12199)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
  have he := centre_energy_range hw ha
  have hpass := analyticBaseCertificate.pass_fields ha
  have hcap := pass_centre_of_events c hpass
  have hb : 0 < normSq ((paperCentres 12199).bA c.1 c.2.1.1) := by
    change 0 < normSq (bR c)
    have he0 : 0 < eR c := by linarith
    unfold eR at he0
    exact (div_pos_iff.mp he0).elim (fun h => h.1) (fun h => by norm_num at h)
  refine ⟨hp hb, ?_⟩
  norm_num [chi, hqCentreCap] at hcap ⊢
  linarith [he.2]

theorem hq_fluctuation {c : Ret 12199} (t : ℝ)
    (hw : WINDOW (paperDesignP 12199) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12199)) (hm : LowResidualMass c) :
    FLUCT_hyp (paperDesignP 12199) t c (hqSplit c) (25 / 10000) := by
  have he := (centre_energy_range hw ha).1
  have he0 : 0 < eR c := by linarith
  have hc := analyticBaseCertificate.pass_fields ha
  have ho := hq_output_bounds hw ha hp
  have hs := split_width_bounds he
  exact BstLean.Part180.fluct_of_latMom_hq (by norm_num) (paperDesignP 12199) c t
    hs.1 hs.2.2.1 sigma_pos eta_pos eta_lt_one ho.1 ho.2
    (by change hqEpsilon < 1; linarith [hq_epsilon_bounds.2] :
      eps0 splitResidualWidth rowSigma < 1)
    (latitudeMoments hw he0 hc hm) (by norm_num : (0 : ℝ) < 85 / 100)
    (by norm_num) (by norm_num : (0 : ℝ) < 64 / 100) (by norm_num)
    (hq_root_price he hw hc hm)

end BstLean.Part280.Gen.Row12199

/-! The root constructor after the charged pass events have supplied their fields. -/
namespace BstLean.Part280.Gen.Row12199
open BstLean.Part252
open MeasureTheory Real Set
open BstLean.Part130 BstLean.Part157 BstLean.Part161 BstLean.Part169
open BstLean.Part29 (stdGauss)

/-- The remaining numerical bounds concern the actual tables and original conditional mixture.
No field in this record asserts the replacement conclusion. -/
structure RootRemainder (t : ℝ) (c : Ret 12199) where
  wl : ℝ
  ws : ℝ
  energy_table : ∫ a in keptIx (paperDesignP 12199) c (rowSplit c wl ws),
    ((12199 : ℝ) * (wbR c a - wtR c a)) ^ 8 ∂muI 12199 ≤ energyError ^ 8
  location_table : ∫ a in keptIx (paperDesignP 12199) c (rowSplit c wl ws),
    ((12199 : ℝ) * (fbR c a - ftR c a)) ^ 8 ∂muI 12199 ≤ locationError ^ 8
  removal : ∫ a, removed (stdGauss (Fin (12199 - 1)))
    (rowSplit c wl ws).good a ∂muI 12199 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12199) c (rowSplit c wl ws),
    (√(goodMean (stdGauss (Fin (12199 - 1))) (rowSplit c wl ws).good
      (pLat (paperDesignP 12199) t c) a) - √(q0Lat t c (rowSplit c wl ws) a)) ^ 2
      ∂muI 12199 ≤ mixtureRoot ^ 2
  displacement : ∫ a in keptIx (paperDesignP 12199) c (rowSplit c wl ws),
    hellG2 12199 (((rowSplit c wl ws).lam0 a - (rowSplit c wl ws).lamb a) ^ 2 *
      normSq c.2.1.2) ((rowSplit c wl ws).S0 a) ((rowSplit c wl ws).Sb a)
      ∂muI 12199 ≤ displacementBudget

noncomputable def rootSource_of_events {t : ℝ} {c : Ret 12199}
    (hw : WINDOW (paperDesignP 12199) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) : RootSource t c where
  wl := R.wl
  ws := R.ws
  window := hw
  energy_pos := he
  centre := pass_centre_of_events c hc
  moments := pass_moments_of_events c hw he hc _ R.energy_table R.location_table
  removal := R.removal
  mixture := R.mixture
  displacement := R.displacement

/-- This structure value can be passed directly to Part243 once the five remainder bounds hold. -/
noncomputable def rootInputs_of_events {t : ℝ} {c : Ret 12199}
    (hw : WINDOW (paperDesignP 12199) c) (he : 0 < eR c)
    (hc : c ∈ passEvent) (R : RootRemainder t c) :
    BstLean.Part243.RootInputs 12199 t c BstLean.Part280.Gen.agent12199.root :=
  rootInputs (rootSource_of_events hw he hc R)

