theorem location_variance_on_event {c : Ret 12202}
    (hw : WINDOW (paperDesignP 12202) c) (he : 0 < eR c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (lA (paperDesignP 12202) c a v - lbar (paperDesignP 12202) c a) ^ 2
      ∂stdGauss (Fin (12202 - 1))) ^ 2 ∂muI 12202 ≤ locationVarianceBudget c ^ 2 := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
    (window_winC (by norm_num) c hw)
