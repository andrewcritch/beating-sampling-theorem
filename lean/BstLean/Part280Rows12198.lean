theorem variance_pointwise {n : ℕ} (hn : 3 ≤ n) (c : Ret n)
    (hb : normSq (bR c) ≠ 0) {O₁ O₂ : ℝ}
    (h1 : OpB (A1 c) O₁) (h2 : OpB (A2 c) O₂)
