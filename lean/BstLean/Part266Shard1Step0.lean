theorem plane_squared_row : planeEnvelopeSquared160 12375 4 ≤ (12 / 5 : ℝ) := by
  have hr : (mA 12375 : ℝ) ^ (1 / (80 * 4) : ℝ) ≤ 107 / 100 := by
    norm_num only [show (80 * 4 : ℝ) = 320 by norm_num]
    have hp : (mA 12375 : ℝ) ≤ (107 / 100 : ℝ) ^ (320 : ℕ) := by
