    splitResidualWidth / rowSigma ≤ (36 / 10 ^ 6 : ℝ) / (593 / 10 ^ 5) := by
  refine ⟨div_nonneg residual_width_bounds.1.le sigma_pos.le, ?_⟩
  exact div_le_div₀ (by norm_num) residual_width_bounds.2 (by norm_num) sigma_bounds.1

