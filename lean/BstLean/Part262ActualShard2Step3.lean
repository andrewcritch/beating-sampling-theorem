  4 * residualMomentBudget 4 ^ 2 * fullResidualBudget ^ 2

theorem scale_variance_on_event {c : Ret 12282}
    (hw : WINDOW (paperDesignP 12282) c) (hc : c ∈ passEvent) :
    ∫ a, (∫ v, (sA (paperDesignP 12282) c a v -
      ∫ w, sA (paperDesignP 12282) c a w ∂stdGauss (Fin (12282 - 1))) ^ 2
      ∂stdGauss (Fin (12282 - 1))) ^ 2 ∂muI 12282 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12282) c
    (residualMomentBudget_pos (by norm_num : 4 ≤ 12)).le
    (by unfold fullResidualBudget locationNorm; positivity)
    (residual_moment_on_event hw hc (by norm_num : 1 ≤ 4) (by norm_num))
