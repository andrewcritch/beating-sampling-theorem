theorem residual_sq_le_energy (c : Ret 12292)
    (p : Ix 12292 × (Fin (12292 - 1) → ℝ)) :
    sgA (paperDesignP 12292) c p.1 p.2 ^ 2 ≤
      (2 / (12292 : ℝ)) * wLatitude c p := by
