theorem low_mass_of_interfaces {c : Ret 12290}
    (hw : WINDOW (paperDesignP 12290) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12290).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12290) c M H xi)
