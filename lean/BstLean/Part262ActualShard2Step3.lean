theorem removal_of_low_mass {c : Ret 12295}
    (hw : WINDOW (paperDesignP 12295) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12295 - 1))).real
