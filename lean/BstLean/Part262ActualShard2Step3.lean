    (hw : WINDOW (paperDesignP 12281) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12281) c a v ^ 8
      ∂stdGauss (Fin (12281 - 1)) ∂muI 12281 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12281).prod (stdGauss (Fin (12281 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12281) c (hc.1.1.1.1 hw.2.1)
