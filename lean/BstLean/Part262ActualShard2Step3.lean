theorem low_mass_of_interfaces {c : Ret 12276}
    (hw : WINDOW (paperDesignP 12276) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12276).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12276) c M H xi)
