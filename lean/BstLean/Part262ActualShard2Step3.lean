theorem removal_of_low_mass {c : Ret 12286}
    (hw : WINDOW (paperDesignP 12286) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12286 - 1))).real
