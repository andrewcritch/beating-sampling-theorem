theorem sigma_bounds : ((5847127 / 1000000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (730891 / 125000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

theorem sigma_pos : 0 < rowSigma := by linarith [sigma_bounds.1]

theorem split_width_bounds {c : Ret 12832} (he : (6 / 10 : ℝ) ≤ eR c) :
