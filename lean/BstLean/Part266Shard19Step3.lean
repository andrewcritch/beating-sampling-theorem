theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (4965937209 / 1000000000000000) ∧
    residualMomentBudget 6 ≤ (3049735653 / 500000000000000) ∧
    residualMomentBudget 12 ≤ (836890939 / 100000000000000) := by
