/-- All twenty-eight fields concern the original retained network and latitude measure. -/
noncomputable def latitudeMoments {c : Ret 12829}
    (hw : WINDOW (paperDesignP 12829) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12829 - 1))).real
      {v | sgA (paperDesignP 12829) c a v < √(2 / (12829 : ℝ) * mixtureFloor)}
      ∂muI 12829 ≤ lowMassBudget) :
    LatMom (paperDesignP 12829) c (√(2 / (12829 : ℝ) * mixtureFloor)) 24 where
