      ∫ w, sA (paperDesignP 12846) c a w ∂stdGauss (Fin (12846 - 1))) ^ 2
      ∂stdGauss (Fin (12846 - 1))) ^ 2 ∂muI 12846 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12846) c
