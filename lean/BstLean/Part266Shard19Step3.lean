      ∫ w, sA (paperDesignP 12826) c a w ∂stdGauss (Fin (12826 - 1))) ^ 2
      ∂stdGauss (Fin (12826 - 1))) ^ 2 ∂muI 12826 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12826) c
