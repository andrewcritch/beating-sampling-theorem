    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12828) c M H xi)
    (hE : centreEnergy (paperDesignP 12828) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12828 : ℝ))))
    (hprice : massBound 12828 M H xi E u mixtureFloor ≤ 12828 * lowMassBudget) :
