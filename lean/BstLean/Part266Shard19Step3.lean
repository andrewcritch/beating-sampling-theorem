theorem residual_moment_on_event {c : Ret 12829}
    (hw : WINDOW (paperDesignP 12829) c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12829) c a v - gbar (paperDesignP 12829) c a| ^ (2 * q)
      ∂stdGauss (Fin (12829 - 1)) ∂muI 12829 ≤ residualMomentBudget q ^ (2 * q) := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
