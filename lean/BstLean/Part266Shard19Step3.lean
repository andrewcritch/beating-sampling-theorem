    (hmass : ∫ a, (stdGauss (Fin (12832 - 1))).real
      {v | sgA (paperDesignP 12832) c a v < √(2 / (12832 : ℝ) * mixtureFloor)}
      ∂muI 12832 ≤ lowMassBudget) :
