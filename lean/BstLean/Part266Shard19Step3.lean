theorem variance_budgets_row {c : Ret 12825} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (6486577 / 200000000000000) ∧ residualVarianceBudget ≤ (94833 / 31250000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
