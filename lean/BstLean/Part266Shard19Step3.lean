theorem residual_width_bounds : 0 < splitResidualWidth ∧ splitResidualWidth ≤ (2090514467 / 62500000000000) := by
  have hs := residual_budgets_row.2.2
  have hs0 := residualMomentBudget_pos (by norm_num : 12 ≤ 12)
