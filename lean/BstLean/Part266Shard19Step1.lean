  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12832)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12832) (CentreSources 12832 12832)
  direction : analyticBase ⊆ agentEv (paperDesignP 12832) (DirectionError 12832)
  angles : analyticBase ⊆ worldAngles

