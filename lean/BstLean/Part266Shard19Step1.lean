  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12834)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12834) (CentreSources 12834 12834)
  direction : analyticBase ⊆ agentEv (paperDesignP 12834) (DirectionError 12834)
  angles : analyticBase ⊆ worldAngles

