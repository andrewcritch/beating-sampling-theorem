  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12848)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12848) (CentreSources 12848 12848)
  direction : analyticBase ⊆ agentEv (paperDesignP 12848) (DirectionError 12848)
  angles : analyticBase ⊆ worldAngles

