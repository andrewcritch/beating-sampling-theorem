  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12837)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12837) (CentreSources 12837 12837)
  direction : analyticBase ⊆ agentEv (paperDesignP 12837) (DirectionError 12837)
  angles : analyticBase ⊆ worldAngles

