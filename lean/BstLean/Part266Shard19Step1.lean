  have hκ := kappa_monotoneOn (by norm_num : (57 / 100 : ℝ) ∈ Icc (-1) 1)
    (show meanLowerRoot 12846 θ ^ 2 / gPlus 12846 ∈ Icc (-1 : ℝ) 1 by
      exact ⟨by linarith, hr1⟩) hr
  have hbr : (65 / 100 : ℝ) - 2 / 12846 ^ 2 ≤
      kappa (meanLowerRoot 12846 θ ^ 2 / gPlus 12846) - 2 / (12846 : ℝ) ^ 2 := by
    linarith
  have hs : (805 / 1000 : ℝ) ≤ √(gMinus 12846 *
      (kappa (meanLowerRoot 12846 θ ^ 2 / gPlus 12846) - 2 / (12846 : ℝ) ^ 2)) := by
    apply le_sqrt_of_sq_le
    have hp := mul_le_mul hg.1 hbr (by norm_num : (0 : ℝ) ≤ 65 / 100 - 2 / 12846 ^ 2)
      (by linarith [hg.1] : 0 ≤ gMinus 12846)
    linarith
  have ht : √(12 * gPlus 12846) ≤ 7 / 2 :=
    sqrt_le_iff.mpr ⟨by norm_num, by linarith [hg.2.2]⟩
  have hn : (110 : ℝ) ≤ √12846 := le_sqrt_of_sq_le (by norm_num)
  have hf := finite_centre_upper
  have hfd : finiteEnergy 12846 12846 (11 / 1000) / √12846 ≤ 1 / 10000 := by
    rw [div_le_iff₀ (by linarith : (0 : ℝ) < √12846)]
