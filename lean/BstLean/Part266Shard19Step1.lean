  have h1 := ethm_charge (paperCentres 12836)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12836) (paperCentres 12836)
  have he : exp (-(45 / 10000 * (12836 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
