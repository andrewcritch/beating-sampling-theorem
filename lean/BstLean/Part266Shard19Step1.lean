  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12835)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12835) (CentreSources 12835 12835)
  direction : analyticBase ⊆ agentEv (paperDesignP 12835) (DirectionError 12835)
  angles : analyticBase ⊆ worldAngles

