  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12833)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12833) (CentreSources 12833 12833)
  direction : analyticBase ⊆ agentEv (paperDesignP 12833) (DirectionError 12833)
  angles : analyticBase ⊆ worldAngles

