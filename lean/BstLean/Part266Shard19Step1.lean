theorem computed_energy_eq (c : Ret 12840) (hτ : 0 < (paperDesignP 12840).tau0 c) :
    eR c = (2 / (mA 12840 : ℝ)) *
      normSq (BstLean.Part150.bT 12840 12840 (A1 c) (A2 c) c.1.2
        ((paperDesignP 12840).tau0 c)) /
