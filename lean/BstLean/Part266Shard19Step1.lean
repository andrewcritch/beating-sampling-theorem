  have h1 := ethm_charge (paperCentres 12837)
  have h2 := ethp_charge (by norm_num : 1 ≤ 12837) (paperCentres 12837)
  have he : exp (-(45 / 10000 * (12837 : ℝ))) ≤ (1 / 10 ^ 10 : ℝ) := by
    have h : exp (-(45 / 10000 * (12837 : ℝ))) ≤ exp (-12) ^ 2 := by
