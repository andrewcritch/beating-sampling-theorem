    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (12838 - 1))).real
      {v | sgA (paperDesignP 12838) c a v < rowSigma} ∂BstLean.Part161.muI 12838 ≤ lowMassBudget) :
