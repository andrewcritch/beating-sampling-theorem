theorem hq_output_bounds {c : Ret 12844}
    (hw : WINDOW (paperDesignP 12844) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12844)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
