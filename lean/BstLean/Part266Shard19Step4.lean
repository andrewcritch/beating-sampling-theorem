  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((172101871 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((198127349 / 40000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
