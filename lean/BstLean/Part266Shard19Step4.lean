def LowResidualMass (c : Ret 12847) : Prop :=
  ∫ a, (stdGauss (Fin (12847 - 1))).real
    {v | sgA (paperDesignP 12847) c a v < rowSigma} ∂muI 12847 ≤ lowMassBudget

