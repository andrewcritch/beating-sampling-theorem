theorem finite_centre_upper : BstLean.Part211.finiteEnergy 12475 12475 (11 / 1000) ≤
    0.008646 := by
  have ha := BstLean.Part150.alphaJ_le (by norm_num : 1000 ≤ 12475)
  have hb := BstLean.Part150.betaJ_le (by norm_num : 4096 ≤ 12475)
  norm_num only [Nat.cast_ofNat] at ha hb
  have ha0 := BstLean.Part150.alphaJ_nonneg 12475
  have hb0 := BstLean.Part150.betaJ_nonneg 12475
  have hw := wn_upper
  have hw0 : 0 ≤ BstLean.Part153.wn 12475 := by unfold BstLean.Part153.wn; positivity
  have hc := cs_lower
  have hdc := deltaChi_upper
  have hdc0 : 0 ≤ BstLean.Part154.deltaChi 12475 12 := by
    unfold BstLean.Part154.deltaChi
    positivity
  have hp := pi_gt_d6.le
  have h2pi : (2.506628 : ℝ) ≤ √(2 * π) := le_sqrt_of_sq_le (by linarith)
  have hroot1 : √(2 * (1 + (11 / 1000 : ℝ)) *
      (1 + 2 * BstLean.Part153.wn 12475 * BstLean.Part150.betaJ 12475) * 12475) ≤
      (7941157 / 50000) := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ 2 * (1 + (11 / 1000 : ℝ)) *
          (1 + 2 * 1.036505 * (81 / 1000 / 12475)) * 12475 := by gcongr <;> linarith
      _ ≤ ((7941157 / 50000) : ℝ) ^ 2 := by norm_num
  have hroot2 : √(2 * (1 + (11 / 1000 : ℝ)) * BstLean.Part153.wn 12475 * 12475 *
      (1 + BstLean.Part154.deltaChi 12475 12 + 2 / π) / BstLean.Part154.csC) ≤
      (181792339 / 1000000) := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ 2 * (1 + (11 / 1000 : ℝ)) * 1.036505 * 12475 *
          (1 + 0.0005669 + 2 / 3.141592) / 1.29521 := by gcongr <;> linarith
      _ ≤ ((181792339 / 1000000) : ℝ) ^ 2 := by norm_num
  have hroot3 : √((12475 : ℝ) / BstLean.Part154.csC) ≤ (49070467 / 500000) := by
    apply sqrt_le_iff.mpr
    refine ⟨by norm_num, ?_⟩
    calc
      _ ≤ (12475 : ℝ) / 1.29521 := div_le_div_of_nonneg_left (by norm_num) (by norm_num) hc
      _ ≤ ((49070467 / 500000) : ℝ) ^ 2 := by norm_num
  unfold BstLean.Part211.finiteEnergy BstLean.Part150.epsJ
  simp only [Nat.cast_ofNat]
  calc
    _ ≤ (1792 / 10000 / 12475 : ℝ) * (7941157 / 50000) +
        2 * (1792 / 10000 / 12475) * (181792339 / 1000000) +
        4 * (1 / 2.506628) * 1.036505 * (49070467 / 500000) *
          (81 / 1000 / 12475 + (1792 / 10000 / 12475) ^ 2) := by gcongr <;> linarith
    _ ≤ (0.008646 : ℝ) := by norm_num

