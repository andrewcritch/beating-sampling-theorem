theorem baseEvent_charge {H T : Set (Ret 12498)}
    (hT : (retDist (paperCentres 12498)).real (H ∩ Tᶜ) ≤ tableChargeAllowance) :
    (retDist (paperCentres 12498)).real (H ∩ (baseEvent T)ᶜ) ≤
      BstLean.Part249.baseChargeAllowance := by
