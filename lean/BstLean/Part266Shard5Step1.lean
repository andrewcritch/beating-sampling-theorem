  unfold worldAngles
  rw [compl_inter]
  exact ((measureReal_union_le _ _).trans (add_le_add (h1.trans he)
    (h2.trans exp_neg12_row))).trans (by norm_num)

def analyticBase : Set (Ret 12490) :=
  (passEvent ∩ agentEv (paperDesignP 12490) (DirectionError 12490) ∩
    agentEv (paperDesignP 12490) (CentreSources 12490 12490)) ∩ worldAngles

