  measurable : MeasurableSet analyticBase
  charge : (retDist (paperCentres 12487)).real analyticBaseᶜ ≤ analyticCharge
  pass_fields : analyticBase ⊆ passEvent
  centre_sources : analyticBase ⊆
    agentEv (paperDesignP 12487) (CentreSources 12487 12487)
  direction : analyticBase ⊆ agentEv (paperDesignP 12487) (DirectionError 12487)
  angles : analyticBase ⊆ worldAngles

