    (hw : WINDOW (paperDesignP 12435) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12435) c a v ^ 8
      ∂stdGauss (Fin (12435 - 1)) ∂muI 12435 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12435).prod (stdGauss (Fin (12435 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
    (paperDesignP 12435) c (hc.1.1.1.1 hw.2.1)
