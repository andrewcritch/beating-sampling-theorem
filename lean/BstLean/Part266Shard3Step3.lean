theorem low_mass_of_interfaces {c : Ret 12448}
    (hw : WINDOW (paperDesignP 12448) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12448).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12448) c M H xi)
    (hE : centreEnergy (paperDesignP 12448) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12448 : ℝ))))
    (hprice : massBound 12448 M H xi E u mixtureFloor ≤ 12448 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12448 - 1))).real
      {v | sgA (paperDesignP 12448) c a v < √(2 / (12448 : ℝ) * mixtureFloor)}
        ∂muI 12448 ≤ lowMassBudget := by
