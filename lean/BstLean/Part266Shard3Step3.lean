      ∂stdGauss (Fin (12449 - 1)) ∂muI 12449 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12449).prod (stdGauss (Fin (12449 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
