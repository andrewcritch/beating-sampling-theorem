theorem removal_of_low_mass {c : Ret 12428}
    (hw : WINDOW (paperDesignP 12428) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12428 - 1))).real
      {v | sgA (paperDesignP 12428) c a v < √(2 / (12428 : ℝ) * mixtureFloor)}
      ∂muI 12428 ≤ lowMassBudget) :
