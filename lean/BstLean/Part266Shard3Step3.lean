      ∫ w, sA (paperDesignP 12429) c a w ∂stdGauss (Fin (12429 - 1))) ^ 2
      ∂stdGauss (Fin (12429 - 1))) ^ 2 ∂muI 12429 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12429) c
