theorem low_mass_of_interfaces {c : Ret 12432}
    (hw : WINDOW (paperDesignP 12432) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12432).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12432) c M H xi)
    (hE : centreEnergy (paperDesignP 12432) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12432 : ℝ))))
    (hprice : massBound 12432 M H xi E u mixtureFloor ≤ 12432 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12432 - 1))).real
      {v | sgA (paperDesignP 12432) c a v < √(2 / (12432 : ℝ) * mixtureFloor)}
        ∂muI 12432 ≤ lowMassBudget := by
