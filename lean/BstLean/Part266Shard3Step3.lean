    (hw : WINDOW (paperDesignP 12448) c) (hc : c ∈ passEvent)
    {q : ℕ} (hq : 1 ≤ q) (hq12 : q ≤ 12) :
    ∫ a, ∫ v, |sgA (paperDesignP 12448) c a v - gbar (paperDesignP 12448) c a| ^ (2 * q)
      ∂stdGauss (Fin (12448 - 1)) ∂muI 12448 ≤ residualMomentBudget q ^ (2 * q) := by
