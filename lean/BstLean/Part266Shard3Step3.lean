theorem low_mass_of_interfaces {c : Ret 12426}
    (hw : WINDOW (paperDesignP 12426) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12426).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12426) c M H xi)
