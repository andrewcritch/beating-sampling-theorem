      ∂stdGauss (Fin (12431 - 1)) ∂muI 12431 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12431).prod (stdGauss (Fin (12431 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
