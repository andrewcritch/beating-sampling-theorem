theorem removal_of_low_mass {c : Ret 12405}
    (hw : WINDOW (paperDesignP 12405) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12405 - 1))).real
      {v | sgA (paperDesignP 12405) c a v < √(2 / (12405 : ℝ) * mixtureFloor)}
      ∂muI 12405 ≤ lowMassBudget) :
    ∫ a, removed (stdGauss (Fin (12405 - 1)))
      (rowSplit c (splitLocationWidth c) splitResidualWidth).good a ∂muI 12405 ≤
        removalBudget := by
