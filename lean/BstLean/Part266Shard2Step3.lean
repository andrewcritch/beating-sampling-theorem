      ∫ w, sA (paperDesignP 12422) c a w ∂stdGauss (Fin (12422 - 1))) ^ 2
      ∂stdGauss (Fin (12422 - 1))) ^ 2 ∂muI 12422 ≤ scaleVarianceBudget ^ 2 :=
