    (hw : WINDOW (paperDesignP 12410) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12410) c a v ^ 8
      ∂stdGauss (Fin (12410 - 1)) ∂muI 12410 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12410).prod (stdGauss (Fin (12410 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
