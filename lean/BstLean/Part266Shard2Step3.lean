noncomputable def fullResidualBudget : ℝ := √(2 / (12405 : ℝ)) * locationNorm

theorem residual_sq_le_energy (c : Ret 12405)
    (p : Ix 12405 × (Fin (12405 - 1) → ℝ)) :
    sgA (paperDesignP 12405) c p.1 p.2 ^ 2 ≤
      (2 / (12405 : ℝ)) * wLatitude c p := by
