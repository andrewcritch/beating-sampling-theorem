    ∫ a, (∫ v, (sgA (paperDesignP 12400) c a v - gbar (paperDesignP 12400) c a) ^ 2
      ∂stdGauss (Fin (12400 - 1))) ^ 2 ∂muI 12400 ≤ residualVarianceBudget ^ 2 := by
  have hL := freshRetainedEvent160_fields (hc.1.1.1.2 hw.2.1)
