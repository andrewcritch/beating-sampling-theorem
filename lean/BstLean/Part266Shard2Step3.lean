theorem residual_sq_le_energy (c : Ret 12420)
    (p : Ix 12420 × (Fin (12420 - 1) → ℝ)) :
    sgA (paperDesignP 12420) c p.1 p.2 ^ 2 ≤
      (2 / (12420 : ℝ)) * wLatitude c p := by
