theorem low_mass_of_interfaces {c : Ret 12401}
    (hw : WINDOW (paperDesignP 12401) c) (he : 0 < eR c)
    (hb0 : ∀ j, 0 ≤ (paperDesignP 12401).bA c.1 c.2.1.1 j)
    {M H xi E u : ℝ} (hI : WFInterfaces (paperDesignP 12401) c M H xi)
    (hE : centreEnergy (paperDesignP 12401) c ≤ E)
    (hu : 0 < u) (hu1 : u < 1) (hd : mixtureFloor < (1 - u) ^ 2)
    (hg : 0 < √((1 - u) ^ 2 - mixtureFloor) - (√E + √(xi / (12401 : ℝ))))
    (hprice : massBound 12401 M H xi E u mixtureFloor ≤ 12401 * lowMassBudget) :
    ∫ a, (stdGauss (Fin (12401 - 1))).real
      {v | sgA (paperDesignP 12401) c a v < √(2 / (12401 : ℝ) * mixtureFloor)}
        ∂muI 12401 ≤ lowMassBudget := by
