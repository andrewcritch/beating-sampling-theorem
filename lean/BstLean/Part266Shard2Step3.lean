    (hw : WINDOW (paperDesignP 12424) c) (hc : c ∈ passEvent) :
    ∫ a, ∫ v, sgA (paperDesignP 12424) c a v ^ 8
      ∂stdGauss (Fin (12424 - 1)) ∂muI 12424 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12424).prod (stdGauss (Fin (12424 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
