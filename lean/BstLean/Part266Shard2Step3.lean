theorem removal_of_low_mass {c : Ret 12403}
    (hw : WINDOW (paperDesignP 12403) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12403 - 1))).real
      {v | sgA (paperDesignP 12403) c a v < √(2 / (12403 : ℝ) * mixtureFloor)}
