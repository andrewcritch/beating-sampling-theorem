      ∂stdGauss (Fin (12412 - 1)) ∂muI 12412 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12412).prod (stdGauss (Fin (12412 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
