theorem residual_sq_le_energy (c : Ret 12422)
    (p : Ix 12422 × (Fin (12422 - 1) → ℝ)) :
    sgA (paperDesignP 12422) c p.1 p.2 ^ 2 ≤
      (2 / (12422 : ℝ)) * wLatitude c p := by
  have hh := BstLean.Part162.normSq_res_le ((paperDesignP 12422).bA c.1 c.2.1.1)
    (hid2 (A1 c) (A2 c) (xLat c (latC (paperDesignP 12422) c p.1)
      (BstLean.Part53.unitF53 p.2)))
  unfold sgA sigX BstLean.Part134.sig
  rw [mul_pow, sq_sqrt (by norm_num [mA] : (0 : ℝ) ≤ 2 / (mA 12422 : ℝ)),
    sq_sqrt (normSq_nonneg _)]
  change 2 / (mA 12422 : ℝ) * _ ≤ 2 / 12422 *
    (normSq (hid2 (A1 c) (A2 c) _) / 12422)
  norm_num [mA]
