import BstLean.Part108All

/-!
# Part 109, frozen definitions: Theorem W9 (the nested form of Option A)

Role: `delegations/statements/p109-spec.md`. Paper sources: `oaW9-opus-prover.md`,
`oaW9c-cx.md`. This file holds definitions and `Prop`-valued interface statements only.
Do not edit this file. Do not use `sorry`, `native_decide` or `axiom`.

Statistics of a fixed `W` (kernel `κ(x·x′)`, `x = W(u)/|W(u)|`, `u, u′` uniform on the sphere):
* `kW` = `E κ(x·x)` (it is `K = d_A + 1` when `W(u) ≠ 0` almost surely);
* `vW` = `E κ(x·x′)`; `SW c` = `E (κ(x·x′) − c)²`; `mW u` = `E_{u′} κ(x·x′)`;
* `HW` = `E κ² − 2 E m² + v²`: the squared Hilbert–Schmidt norm of the centred kernel;
* `qBad` = the probability over `(u, u′)` that `x·x′` is outside `[−1/25, 9/25]`.
Error of the linear part for fixed `(W, ℓ)` and blocks `ω` (a centred Gaussian variable in `A₁`):
* `Vtot` = its variance over `A₁`; `Vsamp` = the variance of the sampling part;
  `VWd` = the variance of the part "stand-in against `μ_W`".
The terms of degree `j` of `F`: `homF F j`, and `mF F j = E homF F j (g)²`, `g` standard Gaussian.
-/

namespace BstLean.Part109

open MeasureTheory ProbabilityTheory
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part105
open BstLean.Part107 (kap qLin cosA aR gg rW)
open BstLean.Part108

/-! ## Definitions -/

section defs

variable {N n dW : ℕ}

/-- `E κ(x·x)`, `x = W(u)/|W(u)|`. -/
noncomputable def kW (dA : ℕ) (W : CoefIdx N n dW → ℝ) : ℝ :=
  ∫ u, kap dA (cosA (bwEval W u) (bwEval W u)) ∂uniformSphere N

/-- `m_W(u) = E_{u′} κ(x·x′)`. -/
noncomputable def mW (dA : ℕ) (W : CoefIdx N n dW → ℝ) (u : Fin N → ℝ) : ℝ :=
  ∫ u', kap dA (cosA (bwEval W u) (bwEval W u')) ∂uniformSphere N

/-- `v_W = E κ(x·x′)`. -/
noncomputable def vW (dA : ℕ) (W : CoefIdx N n dW → ℝ) : ℝ :=
  ∫ u, ∫ u', kap dA (cosA (bwEval W u) (bwEval W u')) ∂uniformSphere N ∂uniformSphere N

/-- `S_W(c) = E (κ(x·x′) − c)²`. -/
noncomputable def SW (dA : ℕ) (W : CoefIdx N n dW → ℝ) (c : ℝ) : ℝ :=
  ∫ u, ∫ u', (kap dA (cosA (bwEval W u) (bwEval W u')) - c) ^ 2 ∂uniformSphere N ∂uniformSphere N

/-- `H_W`: the squared Hilbert–Schmidt norm of the kernel centred in both variables,
`E κ² − 2 E m_W² + v_W²`. -/
noncomputable def HW (dA : ℕ) (W : CoefIdx N n dW → ℝ) : ℝ :=
  (∫ u, ∫ u', kap dA (cosA (bwEval W u) (bwEval W u')) ^ 2 ∂uniformSphere N ∂uniformSphere N) -
    2 * (∫ u, mW dA W u ^ 2 ∂uniformSphere N) + vW dA W ^ 2

/-- The probability over `(u, u′)` that `x·x′ ∉ [−1/25, 9/25]`. -/
noncomputable def qBad (W : CoefIdx N n dW → ℝ) : ℝ :=
  ∫ u, ∫ u', (if cosA (bwEval W u) (bwEval W u') < -1 / 25 ∨
      9 / 25 < cosA (bwEval W u) (bwEval W u') then (1 : ℝ) else 0)
    ∂uniformSphere N ∂uniformSphere N

/-- The mean of `φ` under the stand-in (`∫ φ dν_W`), written with one block. -/
noncomputable def Bnu (W : CoefIdx N n dW → ℝ) (τ : ℝ) (φ : (Fin n → ℝ) → ℝ) : ℝ :=
  ∫ p, φ (BstLean.Part106.standIn W τ p) ∂((uniformSphere N).prod (stdGauss (Fin n)))

/-- The variance over `A₁` of the error `g − B` of the linear part, for fixed `W`, `ℓ`, blocks. -/
noncomputable def Vtot {k : ℕ} (dA : ℕ) (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ℓ : Fin n → ℝ)
    (ω : Draws N n k) : ℝ :=
  ∫ A, Err W τ (fun y => qLin A ℓ y) ω ^ 2 ∂bwGauss n n dA 1

/-- The sampling part: the variance over `A₁` of `g − ∫ φ dν_W`. -/
noncomputable def Vsamp {k : ℕ} (dA : ℕ) (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ℓ : Fin n → ℝ)
    (ω : Draws N n k) : ℝ :=
  ∫ A, (BstLean.Part106.gVal W τ (fun y => qLin A ℓ y) ω - Bnu W τ (fun y => qLin A ℓ y)) ^ 2
    ∂bwGauss n n dA 1

/-- `V_W`: the variance over `A₁` of `∫ φ dν_W − ∫ φ dμ_W`. -/
noncomputable def VWd (dA : ℕ) (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ℓ : Fin n → ℝ) : ℝ :=
  ∫ A, (Bnu W τ (fun y => qLin A ℓ y) - Bu W (fun y => qLin A ℓ y)) ^ 2 ∂bwGauss n n dA 1

/-- The terms of degree exactly `j` of `F(y)`. -/
noncomputable def homF {dF : ℕ} (F : CoefIdx n 1 dF → ℝ) (j : ℕ) (y : Fin n → ℝ) : ℝ :=
  ∑ m : MonoIdx n dF, if m.deg = j then F (0, m) * monoVal y m else 0

/-- `m_j(F)² = E F_j(g)²`, `g` standard Gaussian in `ℝⁿ`. -/
noncomputable def mF {dF : ℕ} (F : CoefIdx n 1 dF → ℝ) (j : ℕ) : ℝ :=
  ∫ g, homF F j g ^ 2 ∂stdGauss (Fin n)

end defs

/-! ## Constants of the budget -/

/-- The centre `c` of the interval `[κ(−1/25), κ(9/25)]`. -/
noncomputable def cMid (dA : ℕ) : ℝ := if dA = 3 then 12489 / 10000 else 12573 / 10000

/-- The half-width of the interval `[κ(−1/25), κ(9/25)]`. -/
noncomputable def hwid (dA : ℕ) : ℝ := if dA = 3 then 2874 / 10000 else 2958 / 10000

/-- The threshold `s` for `S_W(c)`: `hwid² + K²·10⁻⁴`. -/
noncomputable def sPar (dA : ℕ) : ℝ := hwid dA ^ 2 + ((dA : ℝ) + 1) ^ 2 / 10 ^ 4

/-- The inner failure bound for a fixed good `(W, F)` at the ideal noise level:
the lower tail of the spread, the draws, the Gaussian tail of the error, the terms of degree
`≥ 2` of `F`, the radius of `A₁`. -/
noncomputable def coreB (n dA dF : ℕ) (θ ι δd c s x : ℝ) : ℝ :=
  Real.exp (-(θ ^ 2 * (((dA : ℝ) + 1 - c) ^ 2 - s) / (4 * s))) + δd +
    2 * Real.exp (-x ^ 2 / 2) +
    17 * ((dF : ℝ) - 1) * Ssum n dA dF (4 / (Fintype.card (CoefIdx n n dA) : ℝ)) /
      (ι ^ 2 * ((1 - θ) * ((n : ℝ) / 2 * ((dA : ℝ) + 1 - c - Real.sqrt s))) / 4) +
    32 / (9 * (Fintype.card (CoefIdx n n dA) : ℝ))

/-! ## Interface statements: Gaussian tools -/

/-- **Laurent–Massart, lower tail** (diagonal form): for `λ_i ≥ 0`,
`Pr(Σ λ_i(ξ_i² − 1) < −2√(x Σλ_i²)) ≤ e^{−x}`. (Strict inequality in the event, so that the
statement holds when every `λ_i` is `0`.) -/
def LMLower109 : Prop :=
  ∀ (ι : Type) [Fintype ι] (lam : ι → ℝ), (∀ i, 0 ≤ lam i) → ∀ x : ℝ, 0 ≤ x →
    (stdGauss ι).real {ξ | ∑ i, lam i * (ξ i ^ 2 - 1) < -(2 * Real.sqrt (x * ∑ i, lam i ^ 2))} ≤
      Real.exp (-x)

/-- Chebyshev, upper tail (diagonal form): `Pr(Σ λ_i(ξ_i² − 1) ≥ t) ≤ 2Σλ_i²/t²`. -/
def DiagCheb109 : Prop :=
  ∀ (ι : Type) [Fintype ι] (lam : ι → ℝ) (t : ℝ), 0 < t →
    (stdGauss ι).real {ξ | t ≤ ∑ i, lam i * (ξ i ^ 2 - 1)} ≤ 2 * (∑ i, lam i ^ 2) / t ^ 2

/-- Chernoff, upper tail of a chi-square: `Pr(|ξ|² ≥ (1+η)m) ≤ exp(−m(η²/4 − η³/6))`. -/
def ChiUpper109 : Prop :=
  ∀ (ι : Type) [Fintype ι] (η : ℝ), 0 < η → η ≤ 1 →
    (stdGauss ι).real {ξ | (1 + η) * (Fintype.card ι : ℝ) ≤ ∑ i, ξ i ^ 2} ≤
      Real.exp (-((Fintype.card ι : ℝ) * (η ^ 2 / 4 - η ^ 3 / 6)))

/-- **Gaussian tail of a linear functional**: `Pr(|d·ξ| > t|d|) ≤ 2e^{−t²/2}`. -/
def LinTail109 : Prop :=
  ∀ (ι : Type) [Fintype ι] (d : ι → ℝ) (t : ℝ), 0 ≤ t →
    (stdGauss ι).real {ξ | t * Real.sqrt (∑ i, d i ^ 2) < |∑ i, d i * ξ i|} ≤
      2 * Real.exp (-t ^ 2 / 2)

/-- **Laurent–Massart, lower tail, for a positive semidefinite form given as a Gram form**:
`Q(ξ) = ∫ (Σ_c ξ_c f_c)² dμ`, trace `Σ_c ∫ f_c²`, squared Hilbert–Schmidt norm
`Σ_{c,c′} (∫ f_c f_c′)²`. -/
def GramLower109 : Prop :=
  ∀ (ι X : Type) [Fintype ι] [MeasurableSpace X] (μ : Measure X) [IsFiniteMeasure μ]
    (f : ι → X → ℝ), (∀ c, MemLp (f c) 2 μ) → ∀ x : ℝ, 0 ≤ x →
    (stdGauss ι).real {ξ | ∫ y, (∑ c, ξ c * f c y) ^ 2 ∂μ <
        ∑ c, ∫ y, f c y ^ 2 ∂μ -
          2 * Real.sqrt (x * ∑ c, ∑ c', (∫ y, f c y * f c' y ∂μ) ^ 2)} ≤
      Real.exp (-x)

/-- Chebyshev, upper tail, for a Gram form. -/
def GramUpper109 : Prop :=
  ∀ (ι X : Type) [Fintype ι] [MeasurableSpace X] (μ : Measure X) [IsFiniteMeasure μ]
    (f : ι → X → ℝ), (∀ c, MemLp (f c) 2 μ) → ∀ t : ℝ, 0 < t →
    (stdGauss ι).real {ξ | ∑ c, ∫ y, f c y ^ 2 ∂μ + t ≤ ∫ y, (∑ c, ξ c * f c y) ^ 2 ∂μ} ≤
      2 * (∑ c, ∑ c', (∫ y, f c y * f c' y ∂μ) ^ 2) / t ^ 2

/-! ## Interface statements: the event of `W` -/

/-- **The angle of a correlated Gaussian pair** is in `[−1/25, 9/25]` except with probability
`2·10⁻⁸`, for every correlation `r ∈ [1/10, 4/25]` and every `n ≥ 4096`. -/
def PairRange109 : Prop :=
  ∀ (n : ℕ) (r : ℝ), 4096 ≤ n → 1 / 10 ≤ r → r ≤ 4 / 25 →
    (gg n).real {p | aR r p < -1 / 25 ∨ 9 / 25 < aR r p} ≤ 2 / 10 ^ 8

/-- **The event of `W` for the effective rank**: `Pr_W(qBad W > 10⁻⁴) ≤ 21·10⁻⁵`. -/
def BadPairs109 : Prop :=
  ∀ (n dA : ℕ), 4096 ≤ n → (dA = 3 ∨ dA = 4) →
    (bwGauss (2 * n) n (2 * dA) 1).real {W | 1 / 10 ^ 4 < qBad W} ≤ 21 / 10 ^ 5

/-- For almost every Gaussian `W`: `W(u) ≠ 0` for almost every `u`. -/
def NonZeroAE109 : Prop :=
  ∀ (N n d : ℕ), 1 ≤ N → 1 ≤ n →
    ∀ᵐ W ∂bwGauss N n d 1, ∀ᵐ u ∂uniformSphere N, bwEval W u ≠ 0

/-- `E κ(x·x) = K` when `W(u) ≠ 0` almost surely. -/
def KW109 : Prop :=
  ∀ (N n dW dA : ℕ), 1 ≤ N → ∀ W : CoefIdx N n dW → ℝ,
    (∀ᵐ u ∂uniformSphere N, bwEval W u ≠ 0) → kW dA W = (dA : ℝ) + 1

/-- `S_W(c) ≤ hwid² + K²·qBad W` at `c = cMid`. -/
def SWfromBad109 : Prop :=
  ∀ (N n dW dA : ℕ), 1 ≤ N → (dA = 3 ∨ dA = 4) → ∀ W : CoefIdx N n dW → ℝ,
    SW dA W (cMid dA) ≤ hwid dA ^ 2 + ((dA : ℝ) + 1) ^ 2 * qBad W

/-! ## Interface statements: the spread of the linear part for a fixed `(W, ℓ)` -/

/-- **Lemma S′**: for fixed `(W, ℓ)`, the spread of the linear part is a positive semidefinite
Gaussian quadratic form in `A₁` with trace `|ℓ|²·(kW − vW)` and squared Hilbert–Schmidt norm
`|ℓ|⁴·HW`; its lower tail (Laurent–Massart). -/
def SpreadTail109 : Prop :=
  ∀ (N n dW dA : ℕ), 1 ≤ N → ∀ (W : CoefIdx N n dW → ℝ) (ℓ : Fin n → ℝ) (x : ℝ), 0 ≤ x →
    (bwGauss n n dA 1).real {A | Vu W (fun y => qLin A ℓ y) <
        dot ℓ ℓ * (kW dA W - vW dA W) -
          2 * Real.sqrt (x * (dot ℓ ℓ ^ 2 * HW dA W))} ≤
      Real.exp (-x)

/-- **Lemma D**: `H_W + (v_W − c)² ≤ S_W(c)`, and `0 ≤ H_W`. -/
def LemmaD109 : Prop :=
  ∀ (N n dW dA : ℕ), 1 ≤ N → ∀ (W : CoefIdx N n dW → ℝ) (c : ℝ),
    0 ≤ HW dA W ∧ HW dA W + (vW dA W - c) ^ 2 ≤ SW dA W c

/-- **Lemma R** (algebra): from `H + (v − c)² ≤ s < (K − c)²`:
`K − v ≥ K − c − √s` and `H·((K − c)² − s) ≤ s·(K − v)²`. -/
def LemmaR109 : Prop :=
  ∀ (K c s H v : ℝ), 0 < s → s < (K - c) ^ 2 → c < K → 0 ≤ H → H + (v - c) ^ 2 ≤ s →
    K - c - Real.sqrt s ≤ K - v ∧ H * ((K - c) ^ 2 - s) ≤ s * (K - v) ^ 2

/-! ## Interface statements: the error of the linear part for a fixed `(W, ℓ)` -/

/-- **Lemma V**: for fixed `(W, ℓ)` and blocks, the error of the linear part is a centred
Gaussian variable in `A₁` with variance `Vtot`; its tail. -/
def LinErrTail109 : Prop :=
  ∀ (N n dW dA k : ℕ), 1 ≤ N → 1 ≤ k →
    ∀ (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ℓ : Fin n → ℝ) (ω : Draws N n k) (t : ℝ), 0 ≤ t →
      (bwGauss n n dA 1).real {A | t * Real.sqrt (Vtot dA W τ ℓ ω) <
          |Err W τ (fun y => qLin A ℓ y) ω|} ≤
        2 * Real.exp (-t ^ 2 / 2)

/-- `√Vtot ≤ √Vsamp + √V_W` (the triangle inequality in `L²` of `A₁`). -/
def VtotLe109 : Prop :=
  ∀ (N n dW dA k : ℕ), 1 ≤ N → 1 ≤ k →
    ∀ (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ℓ : Fin n → ℝ) (ω : Draws N n k),
      Real.sqrt (Vtot dA W τ ℓ ω) ≤
        Real.sqrt (Vsamp dA W τ ℓ ω) + Real.sqrt (VWd dA W τ ℓ)

/-- The sampling part: Markov over the blocks, `E Vsamp ≤ d_A|ℓ|²/k`. -/
def VsampProb109 : Prop :=
  ∀ (N n dW dA k : ℕ), 1 ≤ N → 1 ≤ k →
    ∀ (W : CoefIdx N n dW → ℝ) (τ : ℝ) (ℓ : Fin n → ℝ) (δ : ℝ), 0 < δ →
      (drawM N n k).real {ω | (dA : ℝ) * dot ℓ ℓ / ((k : ℝ) * δ) < Vsamp dA W τ ℓ ω} ≤ δ

/-- **Lemma M**: Markov over the Gaussian `W` with Theorem 1, `E_W V_W ≤ λ_0 d_A |ℓ|²`
(jointly with the Gaussian version of `F`, `ℓ` its linear coefficients). -/
def VWProb109 : Prop :=
  ∀ (n dA dF : ℕ) (hd : 1 ≤ dF), 1 ≤ n → 1 ≤ dA → ∀ δ : ℝ, 0 < δ →
    ((bwGauss (2 * n) n (2 * dA) 1).prod (bwGauss n 1 dF 1)).real
        {wf | lam0 (2 * n) (2 * dA) * (dA : ℝ) * dot (linF hd wf.2) (linF hd wf.2) / δ <
          VWd dA wf.1 (tauOf (2 * dA) 1) (linF hd wf.2)} ≤ δ

/-! ## Interface statements: the terms of degree `≥ 2` of `F`, for a fixed `F` -/

/-- **Lemma Δ, conditional form**: for fixed `W`, `τ`, `F`: Markov over `(A₁, blocks)` for
`(|g − B| + sd_μ/2)²` of the perturbation, on the event `ρ_A² ≥ 1/c₂`. -/
def PertProb109 : Prop :=
  ∀ (N n dW dA dF k : ℕ) (hd : 1 ≤ dF), 1 ≤ N → 1 ≤ k →
    ∀ (W : CoefIdx N n dW → ℝ) (τ : ℝ) (F : CoefIdx n 1 dF → ℝ) (c2 t : ℝ), 0 ≤ c2 → 0 < t →
      ((bwGauss n n dA 1).prod (drawM N n k)).real
          {p | 1 ≤ c2 * bwNormSq p.1 ∧
            t < (|Err W τ (psi hd (Real.sqrt (bwNormSq p.1)) p.1 F) p.2| +
              1 / 2 * Real.sqrt (Vu W (psi hd (Real.sqrt (bwNormSq p.1)) p.1 F))) ^ 2} ≤
        17 / 2 * ((dF : ℝ) - 1) *
          (∑ j ∈ Finset.Icc 2 dF, c2 ^ (j - 1) * ((dA : ℝ) + 1) ^ j * mF F j) / t

/-- **The event of `F`** (Gaussian version): `|ℓ|² ≥ n/2` and `m_j(F)² ≤ 2·E|g|^{2j}` for
`j = 2, …, d_F`, except with probability `2·10⁻⁵`. -/
def FEvent109 : Prop :=
  ∀ (n dF : ℕ) (hd : 1 ≤ dF), 4096 ≤ n → (dF = 3 ∨ dF = 4) →
    (bwGauss n 1 dF 1).real
        {F | dot (linF hd F) (linF hd F) < (n : ℝ) / 2 ∨
          ∃ j ∈ Finset.Icc 2 dF, 2 * gmom n j < mF F j} ≤ 2 / 10 ^ 5

/-! ## Interface statement: the numeric budget -/

/-- **The budget**: `θ = 11/20`, `ι = 1/10`, `δ_d = 2/1000`, `δ_V = 9/1000`, `x = 18/5`. -/
def Budget109 : Prop :=
  ∀ (n dA dF k : ℕ), 4096 ≤ n → (dA = 3 ∨ dA = 4) → (dF = 3 ∨ dF = 4) → 10 ^ 6 ≤ k →
    (0 < sPar dA ∧ sPar dA < ((dA : ℝ) + 1 - cMid dA) ^ 2 ∧ cMid dA < (dA : ℝ) + 1) ∧
    (18 / 5 * (Real.sqrt (lam0 (2 * n) (2 * dA) * (dA : ℝ) / (9 / 1000)) +
        Real.sqrt ((dA : ℝ) / ((k : ℝ) * (2 / 1000)))) ≤
      (1 - 1 / 10) * Real.sqrt ((1 - 11 / 20) * ((dA : ℝ) + 1 - cMid dA - Real.sqrt (sPar dA))) / 2) ∧
    coreB n dA dF (11 / 20) (1 / 10) (2 / 1000) (cMid dA) (sPar dA) (18 / 5) + 64 / 10 ^ 6 ≤
      1 / 100

end BstLean.Part109
