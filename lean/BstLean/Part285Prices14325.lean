theorem energy_fluctuation_priceK (hn : 14325 ≤ n) :
    (√(tA n * ((179 : ℝ) ^ 2 / ((n : ℝ) - 2))) * √((42 / 10 : ℝ) / n) *
      energyCoefficient18 n) ^ 18 * sharpHN ^ 12 * (58 / 100 : ℝ) ^ 6 ≤
