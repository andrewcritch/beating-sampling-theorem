theorem log_mK (hn : 14325 ≤ n) (hn2 : n ≤ 15324) : Real.log (mA n : ℝ) ≤ 20 := by
  have hx : (14325 : ℝ) ≤ n := by exact_mod_cast hn
  have hx2 : (n : ℝ) ≤ 15324 := by exact_mod_cast hn2
  have hmE : (mA n : ℝ) = (n : ℝ) ^ 2 := by unfold mA; push_cast; ring
  have hm : (0 : ℝ) < (mA n : ℝ) := by rw [hmE]; positivity
  rw [Real.log_le_iff_le_exp hm]
  have he := Real.exp_one_gt_d9
  have h19 : Real.exp 20 = Real.exp 1 ^ 20 := by
    rw [← Real.exp_nat_mul]; norm_num
  rw [h19]
  have hp := pow_le_pow_left₀ (by norm_num) he.le 20
  refine le_trans ?_ hp
  rw [hmE]
  calc (n : ℝ) ^ 2 ≤ 15324 ^ 2 := by gcongr
    _ ≤ _ := by norm_num

