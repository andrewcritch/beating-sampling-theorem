      (c * n)) ^ 2 ≤ 2 * 179 ^ 2 * (42 / 10) * c ^ 2 / (14325 * (14325 - 2)) := by
    have e1 : (√(tA n * ((179 : ℝ) ^ 2 / ((n : ℝ) - 2))) * √((42 / 10 : ℝ) / n) *
        (c * n)) ^ 2 = √(tA n * ((179 : ℝ) ^ 2 / ((n : ℝ) - 2))) ^ 2 *
