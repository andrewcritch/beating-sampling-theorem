    rw [e1, sq_sqrt hl0, sq_sqrt (div_nonneg (by norm_num) hx0.le)]
    have h2' : (n : ℝ) - 2 ≠ 0 := h2.ne'
    have hx0' : (n : ℝ) ≠ 0 := hx0.ne'
