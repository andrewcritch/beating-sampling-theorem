theorem coefficient_nonnegK {C : ℝ} (hn : 14325 ≤ n) (hn2 : n ≤ 15324) (hC : 0 ≤ C)
    (hC4 : C ≤ 32 / 10) :
    0 ≤ (envK n C).f0 n 179 ∧ 0 ≤ (envK n C).f1 n 179 ∧ 0 ≤ (envK n C).f2 ∧
    0 ≤ (envK n C).w0 n 179 ∧ 0 ≤ (envK n C).w1 n 179 ∧ 0 ≤ (envK n C).w2 n 179 := by
  let d := envK n C
  have hD : 0 ≤ d.D := (envK_D hn hC hC4).1
  have hH : 0 ≤ d.H := hD
  have hV : 0 ≤ d.V := (envK_V hn hC hC4).1
  have hP : 0 ≤ d.P := (envK_P hn hn2 hC hC4).1
  have hφ0 := (phiG_pos 0).le
  have hφ1 := (phiG_pos 1).le
  have hG : 0 ≤ tA n * (179 : ℝ) ^ 2 + d.Smax := by
    change 0 ≤ tA n * (179 : ℝ) ^ 2 + 26 / (10 * n)
    rw [tA_eq]; positivity
  change 0 ≤ d.f0 n 179 ∧ 0 ≤ d.f1 n 179 ∧ 0 ≤ d.f2 ∧
