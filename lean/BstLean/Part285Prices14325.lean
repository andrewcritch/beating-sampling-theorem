/-- The four Markov prices for every `n` in 14325–15324. -/
theorem four_priceK (hn : 14325 ≤ n) (hn2 : n ≤ 15324) :
    pricesK n 0 / fourA 0 ^ 24 + pricesK n 1 / fourA 1 ^ 16 +
      pricesK n 2 / fourA 2 ^ 18 + pricesK n 3 / fourA 3 ^ 16 ≤ 173 / 10 ^ 6 := by
  have h0 : pricesK n 0 ≤ (235 / 10 ^ 7 : ℝ) * fourA 0 ^ 24 :=
    location_fluctuation_priceK hn
  have h2 : pricesK n 2 ≤ (107 / 10 ^ 6 : ℝ) * fourA 2 ^ 18 :=
    energy_fluctuation_priceK hn
  have hb := bias_pricesK hn hn2 (statistics_constant_posK hn hn2) (statistics_constantK hn hn2)
  have h1 : pricesK n 1 ≤ (8652 / 10 ^ 6 : ℝ) ^ 16 := hb.1
  have h3 : pricesK n 3 ≤ (5742 / 10 ^ 6 : ℝ) ^ 16 := hb.2
  have hd0 : pricesK n 0 / fourA 0 ^ 24 ≤ (235 / 10 ^ 7 : ℝ) := by
    apply (div_le_iff₀ (by norm_num [fourA])).mpr
    exact h0
  have hd2 : pricesK n 2 / fourA 2 ^ 18 ≤ (107 / 10 ^ 6 : ℝ) := by
    apply (div_le_iff₀ (by norm_num [fourA])).mpr
    exact h2
  have hd1 : pricesK n 1 / fourA 1 ^ 16 ≤ (363 / 10 ^ 7 : ℝ) :=
    (div_le_div_of_nonneg_right h1 (by norm_num [fourA])).trans (by norm_num [fourA])
  have hd3 : pricesK n 3 / fourA 3 ^ 16 ≤ (565 / 10 ^ 8 : ℝ) :=
    (div_le_div_of_nonneg_right h3 (by norm_num [fourA])).trans (by norm_num [fourA])
  have hsum : (235 / 10 ^ 7 : ℝ) + 363 / 10 ^ 7 + 107 / 10 ^ 6 + 565 / 10 ^ 8 ≤ 173 / 10 ^ 6 := by norm_num
  linarith

