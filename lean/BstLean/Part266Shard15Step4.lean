  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((34270391 / 100000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((1254819083 / 250000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
