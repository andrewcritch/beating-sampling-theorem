def LowResidualMass (c : Ret 12744) : Prop :=
  ∫ a, (stdGauss (Fin (12744 - 1))).real
    {v | sgA (paperDesignP 12744) c a v < rowSigma} ∂muI 12744 ≤ lowMassBudget

