theorem hq_output_bounds {c : Ret 12739}
    (hw : WINDOW (paperDesignP 12739) c) (ha : c ∈ analyticBase)
    (hp : c ∈ positiveOutputEvent (paperCentres 12739)) :
    0 < normSq c.2.1.2 ∧ normSq c.2.1.2 ≤ hqCentreCap := by
