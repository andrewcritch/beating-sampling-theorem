theorem row_node_geometry {wr : WRet 12739} (hw : windowW wr)
    (θ : AHid 12739) {g : ℕ} (hg : g < Js 12739) :
    0 ≤ nodeS (mkR wr θ) g ∧
      (3969 / 10000 : ℝ) ≤ 1 - nodeS (mkR wr θ) g ^ 2 ∧
      1 - nodeS (mkR wr θ) g ^ 2 ≤ 61 / 100 := by
  let c := mkR wr θ
