      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((73341 / 12500000)) ^ 2 * ((1003 / 1000) * ((32846527 / 1000000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((171418471 / 500000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((156667759 / 31250000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((73341 / 12500000)) * ((1001 / 1000 + 52 / 1000) * ((516644569 / 1000000000000))) := by
        gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
