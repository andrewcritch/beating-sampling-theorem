  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ ((42847969 / 125000) : ℝ) * ((1001 / 1000 + 52 / 1000 + 31 / 10000) * ((2507865057 / 500000000000000))) := by gcongr
      _ ≤ _ := by norm_num
  · refine ⟨by positivity, ?_⟩
    calc
      _ ≤ (1385 / 1000 : ℝ) / ((5868201 / 1000000000)) * ((1001 / 1000 + 52 / 1000) * ((258403419 / 500000000000))) := by
