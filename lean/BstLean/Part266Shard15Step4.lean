  · refine ⟨by positivity, ?_⟩
    unfold hqCentreCap
    calc
      _ ≤ (1918 / 1000 : ℝ) / ((5868201 / 1000000000)) ^ 2 * ((1003 / 1000) * ((16433579 / 500000000000000))) := by
        gcongr
