    (hP : ∀ i, 0 ≤ P i)
    (hM : ∀ i, ∫⁻ g, ∫⁻ M,
      ENNReal.ofReal (|originalFourErrors c i g.val M| ^ biasOrder i)
        ∂gaussMat (mA 12730) (mA 12730) (tA 12730) ∂tableNodeMeasure c.1 ≤
          ENNReal.ofReal (P i)) :
