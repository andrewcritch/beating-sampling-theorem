def LowResidualMass (c : Ret 12741) : Prop :=
  ∫ a, (stdGauss (Fin (12741 - 1))).real
    {v | sgA (paperDesignP 12741) c a v < rowSigma} ∂muI 12741 ≤ lowMassBudget

