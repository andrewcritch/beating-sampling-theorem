theorem exactTableMoments_of_N {c : Ret 12137} (hw : WINDOW (paperDesignP 12137) c)
    (hθ : BstLean.Part280.m2Guard 12137 c) (hc : c ∈ BstLean.Part280.sharpTableN 12137)
