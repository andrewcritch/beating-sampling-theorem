  have hn : √(12134 : ℝ) ≤ (55077219 / 500000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12134 : ℝ) + 2 * √12134 ≤ (3088577219 / 250000) := by linarith
