theorem variance_of_matrix_events (c : Ret 12133) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12133).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12133) (FirstMatrix 12133))
    (h2 : c ∈ BstLean.Part164.Eop2 12133) (a : BstLean.Part161.Ix 12133) :
