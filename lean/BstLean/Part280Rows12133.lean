theorem row_split_floor :
    (2 / (12134 : ℝ)) * biasFloor =
      (1 - eta) * (√(2 / (12134 : ℝ) * mixtureFloor)) ^ 2 := by
  rw [Real.sq_sqrt (by norm_num [mixtureFloor])]
  unfold biasFloor
  ring

/-- The fields are bounds on the actual network integrals, not the replacement conclusion. -/
structure RootSource (t : ℝ) (c : Ret 12134) where
  wl : ℝ
  ws : ℝ
  window : WINDOW (paperDesignP 12134) c
  energy_pos : 0 < eR c
  centre : normSq c.2.1.2 ≤
    (2 / (12134 : ℝ)) * eR c * 12134 * chi
  moments : PaperMoments c (keptIx (paperDesignP 12134) c (rowSplit c wl ws))
    varianceMax energyError locationError locationNorm varianceNorm
  removal : ∫ a, removed (stdGauss (Fin (12134 - 1)))
    (rowSplit c wl ws).good a ∂muI 12134 ≤ removalBudget
  mixture : ∫ a in keptIx (paperDesignP 12134) c (rowSplit c wl ws),
