      BstLean.Part280.Gen.Row12137.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12137.locationNorm BstLean.Part280.Gen.Row12137.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
