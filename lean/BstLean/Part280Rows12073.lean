    show normSq (cOf v (D.bA (retValW D x.1) x.2.1.1) x.2.1.2) = _
    unfold cOf
    rw [normSq_smul, mul_pow, sq_sqrt hv, sq_sqrt hB]
  change normSq (retVal D x).2.1.2 ≤ v * B * chiUp n
