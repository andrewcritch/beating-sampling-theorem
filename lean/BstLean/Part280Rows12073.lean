  have hsub : keptIx (paperDesignP 12077) c (BstLean.Part280.Gen.Row12077.hqSplit c) ⊆ bulkIx (paperDesignP 12077) c :=
    fun _ h => h.1
  have hfirst : A1 c ∈ BstLean.Part153.Eop 12077 := hc.1.1.2 hw.2.1
  have hsecond : c ∈ BstLean.Part164.Eop2 12077 := hc.1.2
