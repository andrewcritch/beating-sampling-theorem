def outputCentreEvent {n : ℕ} (D : Centres n) : Set (Ret n) :=
  {c | normSq c.2.1.2 ≤ 2 / (mA n : ℝ) * normSq (D.bA c.1 c.2.1.1) * chiUp n}

theorem outputCentreEvent_measurable {n : ℕ} (D : Centres n) :
