  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12073 : ℝ)) ≤ (3217713749 / 250000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12073 : ℝ) ≤ (21975441 / 200000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12073 : ℝ) + 2 * √12073 ≤ (1229275441 / 100000) := by linarith
