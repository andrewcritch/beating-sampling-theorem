theorem residual_sq_le_energy (c : Ret 12077)
    (p : Ix 12077 × (Fin (12077 - 1) → ℝ)) :
    sgA (paperDesignP 12077) c p.1 p.2 ^ 2 ≤
      (2 / (12077 : ℝ)) * wLatitude c p := by
