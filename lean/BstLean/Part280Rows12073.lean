      BstLean.Part280.Gen.Row12077.varianceMax sharpAw sharpAf BstLean.Part280.Gen.Row12077.locationNorm BstLean.Part280.Gen.Row12077.varianceNorm :=
    ⟨hpm.variance, htab.1, htab.2, hpm.location4, hpm.location24, hpm.variance2⟩
