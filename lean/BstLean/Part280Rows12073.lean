  rw [nuA, prod_real_fst]
  exact Eop_prob hn

theorem first_matrix_row (c : Ret 12075) (hc : A1 c ∈ Eop 12075) : OpB (A1 c) 160 := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (12075 : ℝ)) ≤ (6434894521 / 500000000000) :=
    (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hn : √(12075 : ℝ) ≤ (21977261 / 200000) := (sqrt_le_iff).mpr ⟨by norm_num, by norm_num⟩
  have hsum : (12075 : ℝ) + 2 * √12075 ≤ (1229477261 / 100000) := by linarith
  exact (mul_le_mul hs hsum (by positivity) (by norm_num)).trans (by norm_num)

theorem second_matrix_row (c : Ret 12075) (hc : c ∈ BstLean.Part164.Eop2 12075) :
    OpB (A2 c) (283 / 100) := by
  apply opB_of_opN
  refine hc.trans ?_
  have hs : √(2 / (mA 12075 : ℝ)) ≤ ((1414214 / 10 ^ 6 : ℝ) / 12075) := by
    apply (sqrt_le_iff).mpr
    norm_num [mA]
  exact (mul_le_mul_of_nonneg_right hs (by norm_num : (0 : ℝ) ≤ 2 * 12075 + 5)).trans
    (by norm_num)

theorem variance_of_matrix_events (c : Ret 12075) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12075).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12075) (FirstMatrix 12075))
    (h2 : c ∈ BstLean.Part164.Eop2 12075) (a : BstLean.Part161.Ix 12075) :
    |VR c a| ≤ varianceMax := by
  have hb : normSq (bR c) ≠ 0 := by
    intro hh
