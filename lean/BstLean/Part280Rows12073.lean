theorem variance_of_matrix_events (c : Ret 12073) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 12073).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 12073) (FirstMatrix 12073))
    (h2 : c ∈ BstLean.Part164.Eop2 12073) (a : BstLean.Part161.Ix 12073) :
