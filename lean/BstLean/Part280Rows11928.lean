theorem hq_root_price {c : Ret 11929} (he : (6 / 10 : ℝ) ≤ eR c)
    (hw : BstLean.Part161.WINDOW (paperDesignP 11929) c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (BstLean.Part29.stdGauss (Fin (11929 - 1))).real
      {v | sgA (paperDesignP 11929) c a v < rowSigma} ∂BstLean.Part161.muI 11929 ≤ lowMassBudget) :
    rootFLH (splitLocationWidth c) splitResidualWidth eta hqCentreCap (85 / 100) (64 / 100)
