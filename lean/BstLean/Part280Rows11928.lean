theorem variance_of_matrix_events (c : Ret 11928) (he : 0 < eR c)
    (hτ : 0 < (paperDesignP 11928).tau0 c)
    (h1 : c ∈ agentEv (paperDesignP 11928) (FirstMatrix 11928))
