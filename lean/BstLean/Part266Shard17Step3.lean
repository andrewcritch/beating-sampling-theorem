    ∫ a, (∫ v, (sA (paperDesignP 12782) c a v -
      ∫ w, sA (paperDesignP 12782) c a w ∂stdGauss (Fin (12782 - 1))) ^ 2
      ∂stdGauss (Fin (12782 - 1))) ^ 2 ∂muI 12782 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12782) c
    (residualMomentBudget_pos (by norm_num : 4 ≤ 12)).le
    (by unfold fullResidualBudget locationNorm; positivity)
    (residual_moment_on_event hw hc (by norm_num : 1 ≤ 4) (by norm_num))
