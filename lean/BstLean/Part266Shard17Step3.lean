      ∂stdGauss (Fin (12793 - 1)) ∂muI 12793 ≤ fullResidualBudget ^ 8 := by
  let μ := (muI 12793).prod (stdGauss (Fin (12793 - 1)))
  have hE := BstLean.Part222.energyMoment_on_event (by norm_num)
