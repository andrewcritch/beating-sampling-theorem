      ∫ w, sA (paperDesignP 12781) c a w ∂stdGauss (Fin (12781 - 1))) ^ 2
      ∂stdGauss (Fin (12781 - 1))) ^ 2 ∂muI 12781 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12781) c
