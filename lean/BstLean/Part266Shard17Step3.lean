theorem removal_of_low_mass {c : Ret 12778}
    (hw : WINDOW (paperDesignP 12778) c) (he : 0 < eR c) (hc : c ∈ passEvent)
    (hmass : ∫ a, (stdGauss (Fin (12778 - 1))).real
      {v | sgA (paperDesignP 12778) c a v < √(2 / (12778 : ℝ) * mixtureFloor)}
