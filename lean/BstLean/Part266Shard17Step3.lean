      ∫ w, sA (paperDesignP 12776) c a w ∂stdGauss (Fin (12776 - 1))) ^ 2
      ∂stdGauss (Fin (12776 - 1))) ^ 2 ∂muI 12776 ≤ scaleVarianceBudget ^ 2 :=
  int_VS_le (by norm_num) (paperDesignP 12776) c
