import BstLean.Part78Defs4

/-!
# Part 82, wave 0: frozen definitions — Theorem 4 at `(d_M, d_f) = (3,3)`, uniform `D`, by
conditioning on the constant column

Source: `delegations/answers/omGD2-opus-prover.md` part (b), `delegations/answers/omGD2-cx-disprover.md`
§1–§4, §6. Role: `delegations/statements/p82-spec.md`. Model: Part 78 (`Part78Defs.lean`).

This file holds definitions and `Prop`-valued interface statements only. A wave-1 file proves one
interface, and may take others as hypotheses. Do not edit this file. Do not use `sorry`,
`native_decide` or `axiom`.

Conventions.
* `n` is the input dimension and the width. `d_M = d_f = 3`. `x` is uniform on the sphere
  (`uniformSphere n`). The features are the raw monomials `phiM x q`, `q : Mono n 3`;
  `default : Mono n 3` is the constant monomial.
* `JJ3 n`: the non-constant monomials. `pf3 x q = phiM x q.1`. `kap3 x y = Σ_q pf3 x q * pf3 y q`.
* The Gaussian coefficient matrix is split into the constant column `u : Fin n → ℝ` and the rest
  `W : WIdx3 n → ℝ` (`WIdx3 n = JJ3 n × Fin n`). `zv W p i = Σ_q W (q, i) * p q` (`Part78.zv`), so
  `m(x) = u + zv W (pf3 x)`.
* `f(y) = f₀ + ℓ·y + yᵀHy + T[y,y,y]` (`cfun f0 ℓ H T`), `H` symmetric, `T` a symmetric 3-tensor.
  `f(u + z) = f(u) + a·z + zᵀH'z + T[z,z,z]` with `a = aU3 ℓ H T u`, `H' = HU3 H T u`.
* `Phi3 a H T W p = a·z + zᵀHz + T[z,z,z]`, `z = zv W p`. `FG3 a H T W x = Phi3 a H T W (pf3 x)`.
* `VG3 = Var_x FG3`, `errG3 = E_x FG3 − (5/3) tr H` (`= B − g₀` in the Gaussian model, given `u`).
* `b = trT T` (`b_i = Σ_j T i j j`), `AA a T s = a + 3 s b` (the first-chaos kernel at `κ(x,x) = s`).
-/

namespace BstLean.Part82

open MeasureTheory
open scoped ENNReal
open BstLean.Part29 (stdGauss uniformSphere)
open BstLean.Part36 (CoefIdxD DD unitOfD mapMD)
open BstLean.Part41 (Mono phiM colM varU)
open BstLean.Part53 (aH)
open BstLean.Part59 (polyEval TopNZ g0Q)
open BstLean.Part78 (nsq frobH trH zv)

variable {n : ℕ}

/-! ## §1 Features -/

/-- The non-constant raw monomials of degree `≤ 3`. -/
abbrev JJ3 (n : ℕ) := {q : Mono n 3 // q ≠ default}

/-- The index of the non-constant part of the coefficient matrix: feature, output index. -/
abbrev WIdx3 (n : ℕ) := JJ3 n × Fin n

/-- The non-constant raw features. -/
noncomputable def pf3 (x : Fin n → ℝ) (q : JJ3 n) : ℝ := phiM x q.1

/-- The kernel `κ(x,y) = Σ_q p_q(x) p_q(y)`. -/
noncomputable def kap3 (x y : Fin n → ℝ) : ℝ := ∑ q : JJ3 n, pf3 x q * pf3 y q

/-- `tG3 = E κ(x,x)`. -/
noncomputable def tG3 (n : ℕ) : ℝ := ∫ x, kap3 x x ∂uniformSphere n

/-! ## §2 The cubic `f` -/

/-- A 3-tensor. -/
abbrev T3 (n : ℕ) := Fin n → Fin n → Fin n → ℝ

/-- Full symmetry of a 3-tensor. -/
def SymT (T : T3 n) : Prop := ∀ i j k, T i j k = T j i k ∧ T i j k = T i k j

/-- `‖T‖_F²`. -/
def frobT (T : T3 n) : ℝ := ∑ i, ∑ j, ∑ k, T i j k ^ 2

/-- The trace vector `b_i = Σ_j T i j j`. -/
def trT (T : T3 n) : Fin n → ℝ := fun i => ∑ j, T i j j

/-- `f(y) = f₀ + ℓ·y + yᵀHy + T[y,y,y]`. -/
def cfun (f0 : ℝ) (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (y : Fin n → ℝ) : ℝ :=
  f0 + ∑ i, ℓ i * y i + ∑ i, ∑ j, H i j * y i * y j + ∑ i, ∑ j, ∑ k, T i j k * y i * y j * y k

/-- `a_u = ∇f(u) = ℓ + 2Hu + 3T[u,u,·]`. -/
def aU3 (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (u : Fin n → ℝ) : Fin n → ℝ :=
  fun i => ℓ i + 2 * ∑ j, H i j * u j + 3 * ∑ j, ∑ k, T i j k * u j * u k

/-- `H_u = ½∇²f(u) = H + 3T[u,·,·]`. -/
def HU3 (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (u : Fin n → ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.of fun i j => H i j + 3 * ∑ k, T i j k * u k

/-- `Φ = a·z + zᵀHz + T[z,z,z]`, `z = zv W p`. -/
def Phi3 {J : Type*} [Fintype J] (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (W : J × Fin n → ℝ) (p : J → ℝ) : ℝ :=
  ∑ i, a i * zv W p i + ∑ i, ∑ j, H i j * zv W p i * zv W p j +
    ∑ i, ∑ j, ∑ k, T i j k * zv W p i * zv W p j * zv W p k

/-- `F_x = Φ` at `p = p(x)`. -/
noncomputable def FG3 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (W : WIdx3 n → ℝ)
    (x : Fin n → ℝ) : ℝ := Phi3 a H T W (pf3 x)

/-- `V = Var_x F_x`. -/
noncomputable def VG3 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (W : WIdx3 n → ℝ) : ℝ := varU (uniformSphere n) (FG3 a H T W)

/-- `B − g₀ = E_x F_x − (5/3) tr H` (Gaussian model, given `u`). -/
noncomputable def errG3 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (W : WIdx3 n → ℝ) : ℝ := ∫ x, FG3 a H T W x ∂uniformSphere n - 5 / 3 * trH H

/-- The gradient `∂_i f(u + z)`, `z = zv W (pf3 x)`: `a_i + 2(Hz)_i + 3T_i[z,z]`. -/
noncomputable def gradF3 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (W : WIdx3 n → ℝ) (x : Fin n → ℝ) (i : Fin n) : ℝ :=
  a i + 2 * ∑ j, H i j * zv W (pf3 x) j +
    3 * ∑ j, ∑ k, T i j k * zv W (pf3 x) j * zv W (pf3 x) k

/-- `τ(x) = E_W ‖∇f(m(x))‖²`. -/
noncomputable def tau3 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (x : Fin n → ℝ) : ℝ := ∫ W, ∑ i, gradF3 a H T W x i ^ 2 ∂stdGauss (WIdx3 n)

/-- `w(x) = E_W (F_x(W) − E_y F_y(W))²`. -/
noncomputable def wQ3 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n)
    (x : Fin n → ℝ) : ℝ :=
  ∫ W, (FG3 a H T W x - ∫ y, FG3 a H T W y ∂uniformSphere n) ^ 2 ∂stdGauss (WIdx3 n)

/-- The first-chaos kernel `A = a + 3 s b`, `b = trT T`, at `κ(x,x) = s`. -/
def AA (a : Fin n → ℝ) (T : T3 n) (s : ℝ) (i : Fin n) : ℝ := a i + 3 * s * trT T i

/-- The two-point function: `E_W[F_x F_y] = C2 a H T κ(x,x) κ(y,y) κ(x,y)`. -/
def C2 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) (sx sy c : ℝ) : ℝ :=
  c * (∑ i, AA a T sx i * AA a T sy i) + trH H ^ 2 * (sx * sy) + 2 * frobH H * c ^ 2 +
    6 * frobT T * c ^ 3

/-- `α = a + 5b` (the first-chaos kernel at the base point `κ = 5/3`). -/
def alphaV (a : Fin n → ℝ) (T : T3 n) : Fin n → ℝ := fun i => a i + 5 * trT T i

/-- The floor of `E_W V`: `1.64‖α‖² + 5.55‖H‖² + 27.7‖T‖²`. -/
noncomputable def Wf3 (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n) : ℝ :=
  164 / 100 * nsq (alphaV a T) + 555 / 100 * frobH H + 277 / 10 * frobT T

/-! ## §3 Interface statements -/

/-- **Two-point (Wick) identity** for the cubic `Φ`, any feature index type `J`, any `p`, `p'`. -/
def Wick3 : Prop :=
  ∀ (J : Type) [Fintype J] (n : ℕ) (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm →
    ∀ T : T3 n, SymT T → ∀ p p' : J → ℝ,
      (∫ W, Phi3 a H T W p ∂stdGauss (J × Fin n) = trH H * ∑ q, p q ^ 2) ∧
      (∫ W, Phi3 a H T W p * Phi3 a H T W p' ∂stdGauss (J × Fin n) =
        C2 a H T (∑ q, p q ^ 2) (∑ q, p' q ^ 2) (∑ q, p q * p' q))

/-- **Regularity.** -/
def RegIface3 (n : ℕ) : Prop :=
  ∀ T : T3 n,
    Continuous (fun p : ((Fin n → ℝ) × Matrix (Fin n) (Fin n) ℝ) × (WIdx3 n → ℝ) =>
      VG3 p.1.1 p.1.2 T p.2) ∧
    Continuous (fun p : ((Fin n → ℝ) × Matrix (Fin n) (Fin n) ℝ) × (WIdx3 n → ℝ) =>
      errG3 p.1.1 p.1.2 T p.2) ∧
    ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (W : WIdx3 n → ℝ), Continuous (FG3 a H T W)

/-- **The exact conditional identities** (given the constant column, that is, for every `a`, `H`). -/
def MeanIds3 (n : ℕ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    Integrable (VG3 a H T) (stdGauss (WIdx3 n)) ∧
    Integrable (fun W => VG3 a H T W ^ 2) (stdGauss (WIdx3 n)) ∧
    Integrable (fun W => errG3 a H T W ^ 2) (stdGauss (WIdx3 n)) ∧
    ∫ W, VG3 a H T W ∂stdGauss (WIdx3 n) =
      (∫ x, C2 a H T (kap3 x x) (kap3 x x) (kap3 x x) ∂uniformSphere n) -
        ∫ x, ∫ y, C2 a H T (kap3 x x) (kap3 y y) (kap3 x y) ∂uniformSphere n ∂uniformSphere n ∧
    ∫ W, errG3 a H T W ^ 2 ∂stdGauss (WIdx3 n) =
      (∫ x, ∫ y, C2 a H T (kap3 x x) (kap3 y y) (kap3 x y) ∂uniformSphere n ∂uniformSphere n) -
        10 / 3 * trH H ^ 2 * tG3 n + 25 / 9 * trH H ^ 2 ∧
    (∀ x : Fin n → ℝ, ∫ W, (FG3 a H T W x - 5 / 3 * trH H) ^ 2 ∂stdGauss (WIdx3 n) =
      C2 a H T (kap3 x x) (kap3 x x) (kap3 x x) - 10 / 3 * trH H ^ 2 * kap3 x x +
        25 / 9 * trH H ^ 2) ∧
    (∀ (x : Fin n → ℝ) (θ : ℝ), 0 < θ →
      wQ3 a H T x ≤ (1 + θ) * ∫ W, (FG3 a H T W x - 5 / 3 * trH H) ^ 2 ∂stdGauss (WIdx3 n) +
        (1 + 1 / θ) * ∫ W, errG3 a H T W ^ 2 ∂stdGauss (WIdx3 n)) ∧
    (∀ x : Fin n → ℝ, tau3 a H T x =
      ∑ i, AA a T (kap3 x x) i ^ 2 + 4 * kap3 x x * frobH H + 18 * kap3 x x ^ 2 * frobT T) ∧
    Continuous (wQ3 a H T) ∧ Continuous (tau3 a H T)

/-- **Sphere constants** for the cubic feature kernel. On the sphere
`κ(x,x) = 5/3 + Σx_i⁴ + (Σx_i⁶)/3`. -/
def SphC3 (n : ℕ) : Prop :=
  (∀ x : Fin n → ℝ, ∑ i, x i ^ 2 = 1 → 5 / 3 ≤ kap3 x x ∧ kap3 x x ≤ 3) ∧
  Continuous (fun x : Fin n → ℝ => kap3 x x) ∧
  ∫ x, (kap3 x x - 5 / 3) ∂uniformSphere n ≤ 301 / (100 * (n : ℝ)) ∧
  ∫ x, (kap3 x x - 5 / 3) ^ 2 ∂uniformSphere n ≤ 27 / (n : ℝ) ^ 2 ∧
  ∫ x, (kap3 x x - 5 / 3) ^ 4 ∂uniformSphere n ≤ 2990 / (n : ℝ) ^ 4

/-- **Feature operator bound**: `E (c·p(x))² ≤ (CF/n)‖c‖²`. -/
def FeatOp3 (n : ℕ) (CF : ℝ) : Prop :=
  ∀ c : JJ3 n → ℝ,
    ∫ x, (∑ q, c q * pf3 x q) ^ 2 ∂uniformSphere n ≤ CF / (n : ℝ) * ∑ q, c q ^ 2

/-- **Conditional variance bound, kernel form**: `Var_W V ≤ (c/n) E_x[w(x) τ(x)]`. -/
def VarBoundK3 (n : ℕ) (c : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    ∫ W, (VG3 a H T W - ∫ W', VG3 a H T W' ∂stdGauss (WIdx3 n)) ^ 2 ∂stdGauss (WIdx3 n) ≤
      c / (n : ℝ) * ∫ x, wQ3 a H T x * tau3 a H T x ∂uniformSphere n

/-- **The Gaussian-model bounds given the constant column**: floor, error, mean upper bound, and
the kernel integral. `α = alphaV a T`. -/
def GaussBds (n : ℕ) (CF : ℝ) : Prop :=
  ∀ (a : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ), H.IsSymm → ∀ T : T3 n, SymT T →
    Wf3 a H T ≤ ∫ W, VG3 a H T W ∂stdGauss (WIdx3 n) ∧
    ∫ W, errG3 a H T W ^ 2 ∂stdGauss (WIdx3 n) ≤
      (101 / 100 * CF * nsq (alphaV a T) + (6 * CF + 907 / 100) * frobH H +
        55 * CF * frobT T) / (n : ℝ) ∧
    ∫ W, VG3 a H T W ∂stdGauss (WIdx3 n) ≤
      4 * nsq (alphaV a T) + 19 * frobH H + 163 * frobT T ∧
    ∫ x, wQ3 a H T x * tau3 a H T x ∂uniformSphere n ≤ 185 / 100 * Wf3 a H T ^ 2

/-- **Coefficient form = `(f₀, ℓ, H, T)` form**, and the value of `g₀` at `(3,3)`. -/
def CoefBridge3 (n : ℕ) : Prop :=
  ∀ c : Mono n 3 → ℝ, ∃ (ℓ : Fin n → ℝ) (H : Matrix (Fin n) (Fin n) ℝ) (T : T3 n),
    H.IsSymm ∧ SymT T ∧
    (∀ y : Fin n → ℝ, polyEval 3 c y = cfun (c default) ℓ H T y) ∧
    (TopNZ 3 c → 0 < frobT T) ∧
    (∀ M : CoefIdxD n 3 → ℝ,
      g0Q n 3 3 c M = cfun (c default) ℓ H T (colM M default) +
        aH n 3 * (trH H + 3 * ∑ i, trT T i * colM M default i))

/-- The values of `𝒟` and `a` at `d = 3`. -/
def DDval3 (n : ℕ) : Prop :=
  DD n 3 = (n : ℝ) * ((n : ℝ) + 1) * ((n : ℝ) + 2) * ((n : ℝ) + 3) / 6 ∧
    aH n 3 = 5 / 3 / DD n 3

/-- **The split** of the Gaussian coefficient vector into the constant column `u` and the rest `W`,
as a measure-preserving measurable equivalence. -/
def SplitIface3 (n : ℕ) : Prop :=
  ∃ e : ((Fin n → ℝ) × (WIdx3 n → ℝ)) ≃ᵐ (CoefIdxD n 3 → ℝ),
    MeasurePreserving e ((stdGauss (Fin n)).prod (stdGauss (WIdx3 n))) (stdGauss (CoefIdxD n 3)) ∧
    ∀ (u : Fin n → ℝ) (W : WIdx3 n → ℝ),
      colM (e (u, W)) default = u ∧
      (∀ (x : Fin n → ℝ) (i : Fin n), mapMD (e (u, W)) x i = u i + zv W (pf3 x) i) ∧
      ∑ α, e (u, W) α ^ 2 = ∑ i, u i ^ 2 + ∑ β, W β ^ 2

end BstLean.Part82
