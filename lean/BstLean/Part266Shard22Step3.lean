  have hb : 12900 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon) ≤
      12900 * ((5722651 / 250000000) : ℝ) ^ 2 / 2 + ((1634244423 / 1000000000)) ^ 2 * (1 + (5722651 / 250000000)) := by
    exact add_le_add (by linarith) (mul_le_mul hL2 (by linarith) (by linarith) (by norm_num))
  have hcap : hqKappa * (12900 * hqEpsilon ^ 2 / 2 + hqLocation c ^ 2 * (1 + hqEpsilon)) ≤ 7 := by
    calc
      _ ≤ (1001 / 1000 : ℝ) * (12900 * ((5722651 / 250000000)) ^ 2 / 2 + ((1634244423 / 1000000000)) ^ 2 * (1 + (5722651 / 250000000))) := by
        exact mul_le_mul hk1 hb
