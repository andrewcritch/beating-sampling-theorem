theorem variance_budgets_row {c : Ret 12900} (he : (6 / 10 : ℝ) ≤ eR c) :
    locationVarianceBudget c ≤ (8014203 / 250000000000000) ∧ residualVarianceBudget ≤ (2982029 / 1000000000000000000) := by
  have hC : latitudeC ≤ 16 / 5 := latitude_constant_sharp_row
