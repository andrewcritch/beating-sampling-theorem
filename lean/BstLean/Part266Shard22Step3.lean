theorem sigma_bounds : ((583147 / 100000000) : ℝ) ≤ rowSigma ∧ rowSigma ≤ (5831471 / 1000000000) := by
  constructor
  · apply le_sqrt_of_sq_le
    norm_num [mixtureFloor]
  · apply sqrt_le_iff.mpr
    norm_num [mixtureFloor]

