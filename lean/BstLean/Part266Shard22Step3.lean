theorem residual_budgets_row :
    residualMomentBudget 4 ≤ (307667661 / 62500000000000) ∧
    residualMomentBudget 6 ≤ (6046337799 / 1000000000000000) ∧
    residualMomentBudget 12 ≤ (8295983799 / 1000000000000000) := by
  refine ⟨?_, ?_, ?_⟩
  · exact residual_budget_cap (by norm_num) (by norm_num) (by norm_num)
