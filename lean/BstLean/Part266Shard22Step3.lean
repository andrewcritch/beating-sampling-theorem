    (sqrt_nonneg (2 / (12924 : ℝ)))
  have hs : LBound μ 8 (fun p => sgA (paperDesignP 12924) c p.1 p.2)
      (√(2 / (12924 : ℝ)) * (1 + BstLean.Part222.energyAllowance 12924)) := by
